@pytest.mark.parametrize(
    "error_code", ["TOOL_TIMEOUT", "TOOL_BUSY", "TOOL_EXECUTION_ERROR", "TOOL_CALL_LIMIT_EXCEEDED"]
)
def test_tool_failure_persists_observation_then_fails_without_retry(error_code):
    repository = FakeRepository(initial_state())
    gateway = RecordingGateway(failure_code=error_code)

    result = controller(repository, SequencePlanner([tool_decision()]), gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded is True
    assert result.degraded_reason == error_code
    assert result.state.observations[-1].error_code == error_code
    assert [item[0].status for item in repository.checkpoints][-2:] == [
        AgentStatus.EVALUATING,
        AgentStatus.FAILED,
    ]
    assert len(gateway.calls) == 1


def test_gateway_duplicate_after_durable_registration_is_invariant_failure_not_retry():
    class DuplicateGateway(RecordingGateway):
        def execute(self, context, decision):
            self.calls.append((context, decision))
            raise DuplicateToolCall("gateway already saw fingerprint")

    repository = FakeRepository(initial_state())
    gateway = DuplicateGateway()

    result = controller(repository, SequencePlanner([tool_decision()]), gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded_reason == "GATEWAY_DUPLICATE_INVARIANT"
    assert len(gateway.calls) == 1
    assert [item[0].status for item in repository.checkpoints][-2:] == [
        AgentStatus.EXECUTING,
        AgentStatus.FAILED,
    ]


class FeedbackRecordingPlanner:
    """记录每次 decide 的 feedback 参数，用于验证错误回喂正向路径（评测器纠偏 F6）。"""

    def __init__(self, decisions):
        self.decisions = list(decisions)
        self.feedbacks = []

    def decide(self, *, state, bootstrap, feedback=None):
        self.feedbacks.append(feedback)
        if not self.decisions:
            raise AssertionError("planner called more times than expected")
        return self.decisions.pop(0)


def test_parse_error_is_explicit_degraded_failure_and_never_calls_gateway():
    repository = FakeRepository(initial_state())
    # V2-G2：empty 扇出（无有效证据）→ MISSING_EVIDENCE → replan → planner 才被调用；
    # 两个坏决策 → 回喂重试仍失败 → fail-closed。planner 的坏输出从未触达 gateway。
    gateway = RecordingGateway(empty=True)

    # 两个坏决策：首次 parse 失败触发错误回喂重试，第二次仍失败 → fail-closed
    result = controller(repository, SequencePlanner([{"kind": "unknown"}, {"kind": "unknown"}]), gateway).run(
        "run-a", bootstrap()
    )

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded_reason == "PLANNER_PARSE_ERROR"
    # gateway 仅被服务端扇出（empty 检索）调用一次；planner 的坏 JSON 决策从未触发任何工具
    assert len(gateway.calls) == 1


def test_parse_error_retry_with_feedback_recovers_to_success_path():
    """F6：首轮坏决策触发错误回喂，第二次带反馈重试成功 → 会话继续（不 fail-closed）。

    V2-G2：初始无证据 → 扇出 empty（MISSING_EVIDENCE → replan）→ planner 才被调用。
    坏决策 → 回喂 → 好决策（工具执行返回有效证据）→ SUFFICIENT → DRAFTING。
    """
    repository = FakeRepository(initial_state())
    # outputs 序列：第 1 次调用（服务端扇出）返回空证据；planner 的工具执行返回默认有效证据
    gateway = RecordingGateway(outputs=[empty_laws_output()])
    planner = FeedbackRecordingPlanner([{"kind": "unknown"}, tool_decision()])

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert result.state.status is not AgentStatus.FAILED
    assert len(planner.feedbacks) == 2
    assert planner.feedbacks[0] is None
    assert isinstance(planner.feedbacks[1], str) and "校验失败" in planner.feedbacks[1]


def test_g1_gate_skips_planner_when_sufficient():
    """V2-G1 红：评估器判 SUFFICIENT 后，确定性终稿门应先于 planner 触发（旧实现 planner 被调用 → SequencePlanner([]) 抛 AssertionError → 红）。"""
    repository = FakeRepository(sufficient_state())
    planner = SequencePlanner([])  # 任何 decide 调用都会 AssertionError
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.DRAFTING
    assert planner.calls == []


