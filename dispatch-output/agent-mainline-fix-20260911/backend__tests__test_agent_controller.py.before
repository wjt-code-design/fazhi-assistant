def test_deployment_budgets_are_snapshotted_only_for_bootstrapping_run():
    configured = AgentBudgets(max_steps=17, max_tool_calls=8)
    bootstrap_repository = FakeRepository(initial_state(budgets=AgentBudgets(max_steps=2)))
    result = controller(
        bootstrap_repository,
        SequencePlanner([{"kind": "stop", "reason": "done"}]),
        RecordingGateway(),
        budgets=configured,
    ).run("run-a", bootstrap())
    assert result.state.budgets == configured

    recovered_state = initial_state(budgets=AgentBudgets(max_steps=9)).model_copy(
        update={"status": AgentStatus.PLANNING, "steps": 1}
    )
    recovered_repository = FakeRepository(recovered_state)
    recovered = controller(
        recovered_repository,
        SequencePlanner([{"kind": "stop", "reason": "done"}]),
        RecordingGateway(),
        budgets=configured,
    ).run("run-a", bootstrap())
    assert recovered.state.budgets.max_steps == 9


def test_controller_module_has_no_direct_ai_retrieval_or_cache_imports():
    path = Path(__file__).parents[1] / "agent" / "controller.py"
    tree = ast.parse(path.read_text(encoding="utf-8"))
    forbidden = {"llm", "llm_registry", "retrieval", "rag_chain", "knowledge_service", "cache"}
    imports = {
        alias.name.split(".")[0] for node in ast.walk(tree) if isinstance(node, ast.Import) for alias in node.names
    }
    imports.update((node.module or "").split(".")[0] for node in ast.walk(tree) if isinstance(node, ast.ImportFrom))

    assert imports.isdisjoint(forbidden)


def test_real_sqlite_controller_is_owner_scoped_and_persists_state_step_order_and_evidence(sqlite_db):
    from models import AgentEvidence, AgentRun, AgentStep, Conversation, User

    owner = User(username="controller-owner", password_hash="test")
    other = User(username="controller-other", password_hash="test")
    sqlite_db.add_all([owner, other])
    sqlite_db.commit()
    conversation = Conversation(user_id=owner.id, question="", answer="")
    sqlite_db.add(conversation)
    sqlite_db.commit()
    run = create_run(
        sqlite_db,
        user_id=owner.id,
        conversation_id=conversation.id,
        state=initial_state(),
    )
    output = RetrieveLawsOutput(
        statement="found",
        evidence=[
            ToolEvidence(
                source_id="sqlite-chunk",
                source="中华人民共和国民法典",
                article="第一百八十八条",
                snippet="诉讼时效期间为三年。",
                legal_validity="effective",
            )
        ],
    )
    gateway = ToolGateway(wrapper_overrides={"retrieve_laws": lambda *_: output})
    agent = AgentController(
        planner=SequencePlanner([tool_decision()]),
        gateway=gateway,
        repository=SQLAlchemyControllerRepository(db=sqlite_db, user_id=owner.id),
        budgets=AgentBudgets(),
        run_locks=InMemoryRunLockRegistry(),
        clock=lambda: datetime(2026, 8, 30, 8, 0),
    )
    request = bootstrap(conv_id=conversation.id)

    result = agent.run(run.id, request)

    persisted = sqlite_db.get(AgentRun, run.id)
    assert LegalAgentState.model_validate_json(persisted.state_json) == result.state
    assert result.state.status is AgentStatus.DRAFTING
    steps = sqlite_db.query(AgentStep).filter_by(agent_run_id=run.id).order_by(AgentStep.state_version).all()
    assert [step.status for step in steps] == ["planning", "executing", "evaluating", "drafting"]
    assert [step.decision for step in steps] == ["bootstrap", "tool_call", "tool_result", "evaluation"]
    assert all(step.state_version == index for index, step in enumerate(steps, start=1))
    audit = sqlite_db.query(AgentEvidence).filter_by(agent_run_id=run.id).one()
    assert audit.source_identifier == "sqlite-chunk"
    assert json.loads(audit.provenance)["evidence_id"] == result.state.evidence[0].evidence_id

    foreign_agent = AgentController(
        planner=SequencePlanner([tool_decision()]),
        gateway=gateway,
        repository=SQLAlchemyControllerRepository(db=sqlite_db, user_id=other.id),
        budgets=AgentBudgets(),
    )
    with pytest.raises(PermissionError):
        foreign_agent.run(run.id, request)


def _multi_issue_unknown_state(*, n_issues: int, max_clarifications: int) -> LegalAgentState:
    """构造 n 个无证据 issue，每个都带 unknown_facts（评估器 MISSING_FACT 优先于证据检查）。

    用于复现"扇出被澄清打断"缺陷：第 1 个 issue 检索到证据后立即评估 → MISSING_FACT
    （澄清预算已耗尽）→ _handle_evaluation 强制 DRAFTING 并 return → 剩余 issue 不再扇出。
    """
    from agent.state_machine import transition

    state = transition(
        LegalAgentState(
            budgets=AgentBudgets(max_clarifications=max_clarifications),
            issues=[
                LegalIssue(
                    issue_id=f"issue-{i}",
                    question=f"争点{i}的法律依据",
                    unknown_facts=[UnknownFact(statement=f"事实{i}", why_outcome_changes="影响结论")],
                )
                for i in range(n_issues)
            ],
        ),
        AgentStatus.PLANNING,
    )
    return state


def test_seed_retrievals_covers_every_issue_before_forcing_drafting():
    """扇出内部不得因一次评估推进就 return —— 剩余 issue 必须继续补检索。

    ⚠️ 定位说明（2026-09-10 修正）：本测试抓的是**次生行为**（扇出循环被
    `_handle_evaluation` 的 ControllerResult 打断），**不是**线上 probe-15 C01 失败的
    根因。根因的实证复现见
    `tests/test_agent_chat_integration.py::test_clarify_budget_exhaustion_must_not_skip_unretrieved_issues`
    （澄清预算耗尽时强制 DRAFTING 未校验"每 issue 已检索"）。

    本测试仍有价值：它固定"扇出应尽可能在一轮内补齐所有 issue"这一语义，
    与根因修复方向一致（减少对澄清轮次的依赖）。
    """
    budgets = AgentBudgets(max_clarifications=0)  # 澄清预算已耗尽 → 首个评估即强制 DRAFTING
    state = _multi_issue_unknown_state(n_issues=4, max_clarifications=0)
    repository = FakeRepository(state)
    gateway = RecordingGateway()  # 每次检索都返回有效成文法证据

    result = controller(repository, planner=SequencePlanner([]), gateway=gateway, budgets=budgets).run(
        "run-a", bootstrap()
    )

    retrieved_issues = {call[1].issue_id for call in gateway.calls}
    assert retrieved_issues == {"issue-0", "issue-1", "issue-2", "issue-3"}, (
        f"扇出遗漏 issue：{sorted(retrieved_issues)}"
    )
    observed_issues = {obs.issue_id for obs in result.state.observations if obs.status == "succeeded"}
    assert observed_issues == {"issue-0", "issue-1", "issue-2", "issue-3"}, (
        f"successful observation 覆盖不足：{sorted(observed_issues)}"
    )


# ==================== F12 覆盖缺口补测（2026-09-11 深度审查） ====================
# 覆盖：① _deterministic_finish_gate 第三象限（MISSING_FACT+耗尽+并非每 issue 有证据 → None）
#       ② _handle_evaluation 未知 outcome（FAIL_SAFE）→ fail-closed 失败
#       ③ _handle_evaluation 的 BudgetExceeded → _persist_budget_stop（降级）
#       ④ backfill 分支的 checkpoint reason 落盘断言


class _FixedEvaluator:
    """固定评估决策的假评估器（直调 controller 内部方法用，不经 LLM）。"""

    def __init__(self, decision):
        self._decision = decision

    def evaluate(self, state):
        return self._decision


def _partial_evidence_state(**budget_kwargs) -> LegalAgentState:
    """两个 issue：issue-a 有有效成文法证据 + succeeded observation；issue-b 无证据、无检索指纹。"""
    state = sufficient_state(budgets=AgentBudgets(max_clarifications=0, **budget_kwargs))
    state.issues.append(LegalIssue(issue_id="issue-b", question="另一争点", unknown_facts=[]))
    return state


def test_finish_gate_third_quadrant_returns_none():
    """F12-①：MISSING_FACT + 澄清预算耗尽 + **并非每 issue 都有证据** ⇒ 门必须返回 None。

    这是门与 `_handle_evaluation` backfill 分支之间的边界：门若在此象限放行，
    会让无证据的 issue 被强制 DRAFTING（缺证据绑定）。放行 planner 是正确去向。
    """
    decision = EvaluationDecision(
        outcome=EvaluationOutcome.MISSING_FACT,
        reason_code="OUTCOME_CHANGING_FACT_UNKNOWN",
        issue_id="issue-b",
    )
    repository = FakeRepository(_partial_evidence_state())
    agent = controller(repository, planner=SequencePlanner([]), gateway=None)
    agent._evaluator = _FixedEvaluator(decision)

    state = _partial_evidence_state()
    assert agent._deterministic_finish_gate(state) is None, (
        "第三象限（有 issue 无证据）不得放行——否则无证据 issue 会被强制 DRAFTING"
    )


def test_finish_gate_quadrant_b_still_forces_conditional_analysis():
    """F12-① 正向对照：B 象限（每 issue 都有证据）门必须放行（返回评估决策）。"""
    decision = EvaluationDecision(
        outcome=EvaluationOutcome.MISSING_FACT,
        reason_code="OUTCOME_CHANGING_FACT_UNKNOWN",
        issue_id="issue-a",
    )
    repository = FakeRepository(initial_state())
    agent = controller(repository, planner=SequencePlanner([]), gateway=None)
    agent._evaluator = _FixedEvaluator(decision)

    gate = agent._deterministic_finish_gate(exhausted_with_evidence_state())
    assert gate is not None and gate.outcome is EvaluationOutcome.MISSING_FACT


def test_handle_evaluation_unknown_outcome_fails_closed():
    """F12-②：未知 outcome（FAIL_SAFE 不在 _handle_evaluation 的处理集内）→ fail-closed 失败。

    守卫该分支的存在性：若有人"清理"了这个 else，FAIL_SAFE 会静默落入某个错误分支。
    """
    decision = EvaluationDecision(outcome=EvaluationOutcome.FAIL_SAFE, reason_code="INTEGRITY_NO_ISSUES")
    repository = FakeRepository(initial_state())
    agent = controller(repository, planner=SequencePlanner([]), gateway=None)

    result = agent._handle_evaluation(repository.current, decision)

    assert isinstance(result, ControllerResult)
    last_decision, last_reason = repository.checkpoints[-1][1].decision, repository.checkpoints[-1][1].reason_code
    assert (last_decision, last_reason) == ("failure", "INTEGRITY_NO_ISSUES")


def test_handle_evaluation_budget_exceeded_degrades_to_budget_stop():
    """F12-③：分支内 BudgetExceeded（register_replan 超 replan 预算）→ 降级为预算停。

    该路径此前只有 preflight 测试触达过，分支内的 except 从未被直接执行。
    """
    decision = EvaluationDecision(
        outcome=EvaluationOutcome.MISSING_EVIDENCE,
        reason_code="MISSING_EFFECTIVE_STATUTE",
        issue_id="issue-a",
    )
    repository = FakeRepository(_partial_evidence_state(max_replans=0))  # replans=0，max=0 ⇒ register_replan 必抛
    agent = controller(repository, planner=SequencePlanner([]), gateway=None)

    result = agent._handle_evaluation(repository.current, decision)

    assert result.degraded is True
    assert result.degraded_reason == "AGENT_BUDGET_EXCEEDED"
    last = repository.checkpoints[-1][1]
    assert (last.decision, last.reason_code) == ("stop", "AGENT_BUDGET_EXCEEDED")


def test_handle_evaluation_backfill_records_pending_retrieval_reason():
    """F12-④：backfill 分支（澄清耗尽 + 有 issue 从未发起检索）必须落盘专用 checkpoint reason。

    该分支此前仅集成测试覆盖，无单测断言 checkpoint 元数据——而它正是 C01 无界循环修复的
    终止条件出口（`_every_issue_retrieval_attempted` 为 False 时的去向）。
    """
    decision = EvaluationDecision(
        outcome=EvaluationOutcome.MISSING_FACT,
        reason_code="OUTCOME_CHANGING_FACT_UNKNOWN",
        issue_id="issue-b",
    )
    repository = FakeRepository(_partial_evidence_state())
    agent = controller(repository, planner=SequencePlanner([]), gateway=None)

    result = agent._handle_evaluation(repository.current, decision)

    from agent.controller import ControllerResult as _CR

    assert not isinstance(result, _CR), "backfill 返回 ControllerRun（回 PLANNING），不是终态"
    last = repository.checkpoints[-1][1]
    assert (last.decision, last.reason_code) == (
        "backfill_retrieval",
        "CLARIFY_BUDGET_EXHAUSTED_PENDING_RETRIEVAL",
    )
    assert result.state.status is AgentStatus.PLANNING
