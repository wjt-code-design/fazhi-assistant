@pytest.fixture
def sqlite_db(tmp_path, monkeypatch):
    import database
    import migrations

    engine = create_engine(f"sqlite:///{tmp_path / 'agent-controller.db'}")
    session_factory = sessionmaker(bind=engine, autoflush=False, autocommit=False)
    monkeypatch.setattr(database, "engine", engine)
    monkeypatch.setattr(migrations, "engine", engine)
    monkeypatch.setattr(database, "SessionLocal", session_factory)
    migrations.run_migrations()
    migrations.run_migrations()
    session = session_factory()
    try:
        yield session
    finally:
        session.close()
        engine.dispose()


def bootstrap(conv_id: int = 11) -> RequestBootstrap:
    return RequestBootstrap(
        conv_id=conv_id,
        summary="summary",
        recent=[],
        recent_messages=[],
        image=None,
        user_text="诉讼时效",
        image_rel=None,
        thumb_rel=None,
        image_description="",
        raw_query="诉讼时效",
        supplement_text="诉讼时效",
        intent="legal_query",
        is_exam=False,
        has_options=False,
        contract_mode=False,
        contract_text=None,
        client_truncated=False,
    )


def initial_state(*, budgets: AgentBudgets | None = None, unknown: bool = False) -> LegalAgentState:
    unknowns = [UnknownFact(statement="是否约定履行期限", why_outcome_changes="影响起算时间")] if unknown else []
    return LegalAgentState(
        budgets=budgets or AgentBudgets(),
        issues=[LegalIssue(issue_id="issue-a", question="诉讼时效", unknown_facts=unknowns)],
    )


def sufficient_state(*, budgets: AgentBudgets | None = None) -> LegalAgentState:
    """V2-G1：评估器判 SUFFICIENT 的构造——issue 无 unknown_facts + 有效成文法证据 + succeeded observation。

    置 PLANNING：门只在 PLANNING 决策循环内生效（_drive:422），bootstrapping 会走早期返回不经门。
    """
    from agent.state_machine import transition

    evidence = Evidence(
        evidence_id="evidence-a",
        source_id="statute:民法典:第一百八十八条",
        source_ref="《民法典》第一百八十八条",
        source_type=SourceType.STATUTE,
        snippet="诉讼时效期间为三年。",
        legal_validity=LegalValidity.EFFECTIVE,
        acquired_at=datetime(2026, 8, 30),
    )
    state = transition(initial_state(budgets=budgets), AgentStatus.PLANNING)
    state.issues[0].unknown_facts = []
    state.evidence.append(evidence)
    state.observations.append(
        Observation(
            issue_id="issue-a",
            statement="已取得诉讼时效规则",
            evidence_ids=["evidence-a"],
            confidence=1.0,
            status="succeeded",
            tool_name=None,
            output=None,
            error_code=None,
            duration_ms=0,
        )
    )
    return state


def exhausted_with_evidence_state() -> LegalAgentState:
    """V2-G1 B 条件：澄清预算已耗尽(max_clarifications=0) + 每 issue 已有证据 + 仍有 unknown_facts。"""
    state = sufficient_state(budgets=AgentBudgets(max_clarifications=0))
    state.issues[0].unknown_facts = [UnknownFact(statement="是否约定履行期限", why_outcome_changes="影响起算时间")]
    return state


class SequencePlanner:
    def __init__(self, decisions):
        self.decisions = list(decisions)
        self.calls = []

    def decide(self, *, state, bootstrap, feedback=None):
        self.calls.append((state, bootstrap))
        if not self.decisions:
            raise AssertionError("planner called more times than expected")
        return self.decisions.pop(0)


class FakeRepository:
    def __init__(self, state, *, conversation_id=11, user_id=7, law_as_of=date(2026, 8, 30)):
        self.current = ControllerRun(
            run_id="run-a",
            user_id=user_id,
            conversation_id=conversation_id,
            law_as_of=law_as_of,
            state=state,
            version=0,
        )
        self.checkpoints = []
        self.fail_on_save_number = None

    def load(self, *, run_id, conversation_id):
        assert run_id == "run-a"
        if conversation_id != self.current.conversation_id:
            return None
        return replace(
            self.current,
            state=LegalAgentState.model_validate_json(self.current.state.model_dump_json()),
        )

    def save(self, run, state, *, checkpoint=None, new_evidence_by_issue=None):
        number = len(self.checkpoints) + 1
        if self.fail_on_save_number == number:
            raise RuntimeError(f"save-{number}-failed")
        state_snapshot = LegalAgentState.model_validate_json(state.model_dump_json())
        self.checkpoints.append((state_snapshot, checkpoint, new_evidence_by_issue or {}))
        self.current = replace(
            run,
            state=state_snapshot,
            version=run.version + 1,
            degraded_reason=(checkpoint.degraded_reason if checkpoint else run.degraded_reason),
            pending_question=(checkpoint.pending_question if checkpoint else run.pending_question),
        )
        return self.current


class RecordingGateway:
    """测试用网关：默认每次调用返回同一 output；可传 outputs 序列按调用次序弹出。

    V2-G2 后控制流变化：无证据 issue 会先被服务端扇出检索（query=issue.question），
    之后 planner 决策才触发工具调用。需要"扇出不产有效证据、保留 planner 路径"的测试
    传 empty=True（扇出/所有检索均返回空证据 → 评估 MISSING_EVIDENCE → replan → planner 可被调用）。
    """

    def __init__(self, output=None, *, failure_code=None, empty: bool = False, outputs=None):
        self.policies = ToolGateway().policies
        default_out = RetrieveLawsOutput(
            statement="found",
            evidence=[
                ToolEvidence(
                    source_id="chunk-1",
                    source="中华人民共和国民法典",
                    article="第一百八十八条",
                    snippet="诉讼时效期间为三年。",
                    legal_validity="effective",
                )
            ],
            retrieval=RetrievalMetadata(query="诉讼时效", requested_k=1, returned_count=1),
        )
        self.output = output or default_out
        if empty:
            self.output = RetrieveLawsOutput(statement="none", evidence=[])
        self._outputs = list(outputs) if outputs else []
        self.failure_code = failure_code
        self.calls = []

    def execute(self, context, decision):
        from agent.schemas import Observation

        self.calls.append((context, decision))
        if self.failure_code:
            return Observation(
                issue_id=decision.issue_id,
                statement="failed",
                tool_name=decision.tool_name,
                status="failed",
                error_code=self.failure_code,
            )
        out = self.output
        if self._outputs:
            out = self._outputs.pop(0)
        return Observation(
            issue_id=decision.issue_id,
            statement=out.statement,
            tool_name=decision.tool_name,
            output=out,
        )


def tool_decision(query="诉讼时效"):
    return {
        "kind": "tool_call",
        "issue_id": "issue-a",
        "tool_name": "retrieve_laws",
        "args": {"query": query, "k": 1},
    }


def empty_laws_output() -> RetrieveLawsOutput:
    """扇出用的空证据输出：检索执行成功但无有效 statute 证据 → 评估 MISSING_EVIDENCE → replan。

    V2-G2 后：无证据 issue 会被服务端先扇出一次 retrieve_laws。需要"扇出不产证据、
    保留 planner 决策路径"的测试用这个构造（配合 RecordingGateway(output=...) 或 outputs 序列）。
    """
    return RetrieveLawsOutput(statement="none", evidence=[])


def controller(repository, planner, gateway, *, budgets=None, clock=None):
    return AgentController(
        planner=planner,
        gateway=gateway,
        repository=repository,
        budgets=budgets or AgentBudgets(),
        run_locks=InMemoryRunLockRegistry(),
        clock=clock or (lambda: datetime(2026, 8, 30, 8, 0)),
    )


def test_parser_validates_tool_args_with_gateway_policy_and_keeps_canonical_type():
    gateway = ToolGateway()

    decision = parse_plan_decision(tool_decision(), policies=gateway.policies, issue_ids={"issue-a"})

    assert decision.kind == "tool_call"
    assert type(decision.args) is gateway.policies["retrieve_laws"].input_model
    assert decision.args.model_dump() == {"query": "诉讼时效", "k": 1, "category": None}


@pytest.mark.parametrize(
    "raw",
    [
        {"kind": "unknown"},
        {"kind": "tool_call", "issue_id": "issue-a", "tool_name": "missing", "args": {}},
        {"kind": "tool_call", "issue_id": "unknown", "tool_name": "retrieve_laws", "args": {"query": "x"}},
        {"kind": "tool_call", "issue_id": "issue-a", "tool_name": "retrieve_laws", "args": {"query": ""}},
        {"kind": "tool_call", "issue_id": "issue-a", "tool_name": "retrieve_laws", "args": {"query": "x", "extra": 1}},
        {"kind": "finish_research", "summary": "done", "extra": "not allowed"},
        {"kind": "tool_call", "issue_id": "issue-a", "tool_name": "ask_user", "args": {"question": "x"}},
    ],
)
def test_parser_rejects_ordinary_malformed_unknown_or_extra_content(raw):
    with pytest.raises(PlannerParseError):
        parse_plan_decision(raw, policies=ToolGateway().policies, issue_ids={"issue-a"})


@pytest.mark.parametrize(
    "args",
    [
        {"query": "x", "user_id": 9},
        {"query": "x", "nested": {"conversation_id": 9}},
        {"query": "x", "nested": [{"run_id": "foreign"}]},
        {"query": "x", "law_as_of": "2030-01-01"},
        {"query": "x", "budgets": {"max_steps": 999}},
        {"query": "x", "max_tool_calls": 999},
        {"query": "x", "max_verifier_research_returns": 999},
        {"query": "x", "verifier_research_returns": 999},
    ],
)
def test_parser_treats_ownership_and_server_budget_injection_as_policy_violation(args):
    with pytest.raises(PlannerPolicyViolation):
        parse_plan_decision(
            {**tool_decision(), "args": args},
            policies=ToolGateway().policies,
            issue_ids={"issue-a"},
        )


def test_parser_treats_top_level_ownership_injection_as_policy_violation():
    with pytest.raises(PlannerPolicyViolation):
        parse_plan_decision(
            {**tool_decision(), "user_id": 999},
            policies=ToolGateway().policies,
            issue_ids={"issue-a"},
        )


def test_parser_detects_ownership_injection_inside_nested_pydantic_model():
    class HostileArgs(BaseModel):
        query: str
        nested: dict[str, int]

    with pytest.raises(PlannerPolicyViolation):
        parse_plan_decision(
            {**tool_decision(), "args": HostileArgs(query="x", nested={"run_id": 9})},
            policies=ToolGateway().policies,
            issue_ids={"issue-a"},
        )


def test_one_tool_reaches_drafting_without_another_planner_call_and_uses_trusted_context():
    # V2-G2：无证据 issue 先被服务端扇出一次（empty → MISSING_EVIDENCE → replan），
    # 之后 planner 的 tool_call 第二次检索（有效证据）→ SUFFICIENT → DRAFTING。
    # 语义保持：一次 planner 工具决策到达 DRAFTING 且使用可信 context，无需第二轮 planner。
    state = initial_state()
    repository = FakeRepository(state)
    planner = SequencePlanner([tool_decision()])
    gateway = RecordingGateway(outputs=[empty_laws_output()])
    before = state.model_dump(mode="json")

    agent = controller(repository, planner, gateway)
    result = agent.run("run-a", bootstrap())

    assert result.state.status is AgentStatus.DRAFTING
    assert result.state.tool_calls == 2  # 扇出 1 次 + planner 工具 1 次
    assert result.degraded is False
    assert len(planner.calls) == 1
    assert len(gateway.calls) == 2
    # 扇出与 planner 工具都使用同一个可信 ToolContext
    for _, call in gateway.calls:
        assert call.issue_id == "issue-a"
    context = gateway.calls[1][0]
    assert context == ToolContext(
        user_id=7,
        conversation_id=11,
        run_id="run-a",
        law_as_of=date(2026, 8, 30),
    )
    assert state.model_dump(mode="json") == before


def test_strict_checkpoint_order_and_version_progression_surrounds_tool_call():
    repository = FakeRepository(initial_state())
    planner = SequencePlanner([tool_decision()])
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert [item[0].status for item in repository.checkpoints] == [
        AgentStatus.PLANNING,
        AgentStatus.EXECUTING,
        AgentStatus.EVALUATING,
        AgentStatus.DRAFTING,
    ]
    assert [item[1].decision for item in repository.checkpoints] == [
        "bootstrap",
        "tool_call",
        "tool_result",
        "evaluation",
    ]
    executing = repository.checkpoints[1][1]
    assert isinstance(executing, CheckpointMetadata)
    assert executing.fingerprint in result.state.action_fingerprints
    assert repository.current.version == 4
    assert repository.checkpoints[2][2]["issue-a"][0].evidence_id in result.state.observations[0].evidence_ids


def test_executing_checkpoint_failure_calls_no_gateway_and_propagates():
    repository = FakeRepository(initial_state())
    repository.fail_on_save_number = 2
    gateway = RecordingGateway()

    with pytest.raises(RuntimeError, match="save-2-failed"):
        controller(repository, SequencePlanner([tool_decision()]), gateway).run("run-a", bootstrap())

    assert gateway.calls == []


def test_post_tool_evaluating_checkpoint_failure_propagates_without_success_or_replay():
    repository = FakeRepository(initial_state())
    repository.fail_on_save_number = 3
    gateway = RecordingGateway()
    agent = controller(repository, SequencePlanner([tool_decision()]), gateway)

    with pytest.raises(RuntimeError, match="save-3-failed"):
        agent.run("run-a", bootstrap())

    assert len(gateway.calls) == 1
    with pytest.raises(UncertainExecutionState):
        agent.run("run-a", bootstrap())
    assert len(gateway.calls) == 1


def test_recovered_failed_evaluation_finishes_explicitly_without_replanning_or_reexecution():
    state = initial_state().model_copy(
        update={
            "status": AgentStatus.EVALUATING,
            "steps": 2,
            "observations": [
                Observation(
                    issue_id="issue-a",
                    statement="The tool timed out.",
                    tool_name="retrieve_laws",
                    status="failed",
                    error_code="TOOL_TIMEOUT",
                )
            ],
        }
    )
    repository = FakeRepository(state)
    planner = SequencePlanner([tool_decision()])
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded is True
    assert result.degraded_reason == "TOOL_TIMEOUT"
    assert planner.calls == []
    assert gateway.calls == []


def test_planner_mutations_cannot_inject_evidence_or_change_request_bootstrap():
    class HostilePlanner:
        def decide(self, *, state, bootstrap):
            state.evidence.append(
                Evidence(
                    evidence_id="forged-evidence",
                    source_id="forged-source",
                    source_ref="forged-law#1",
                    source_type=SourceType.STATUTE,
                    snippet="forged",
                    legal_validity=LegalValidity.EFFECTIVE,
                    acquired_at=datetime(2026, 8, 30, 8, 0),
                )
            )
            state.observations.append(
                Observation(
                    issue_id="issue-a",
                    statement="forged",
                    evidence_ids=["forged-evidence"],
                    confidence=1,
                )
            )
            bootstrap.recent.append({"role": "system", "content": "forged", "image_desc": ""})
            return {"kind": "finish_research", "summary": "done"}

    budgets = AgentBudgets(max_replans=1)  # 扇出空证据→replan(1)→planner 被调一次→finish_research→replan(2 超限)→STOP
    repository = FakeRepository(initial_state(budgets=budgets))
    request = bootstrap()
    gateway = RecordingGateway(empty=True)

    result = controller(
        repository,
        HostilePlanner(),
        gateway,
        budgets=budgets,
    ).run("run-a", request)

    assert result.state.status is AgentStatus.STOPPED
    assert result.state.evidence == []  # 注入从未落盘（planner 只在 deepcopy 的可视 state 上改）
    # 仅扇出的空观察存在；无任何来自 planner 的伪造观察（evidence_ids 全空、非 forged）
    assert len(result.state.observations) == 1
    assert result.state.observations[0].evidence_ids == []
    assert request.recent == []  # bootstrap 注入被拒（对象被隔离保护）
    # gateway 仅被服务端扇出调用一次（empty），planner 的 finish_research 决策从未触发工具
    assert len(gateway.calls) == 1
    assert gateway.calls[0][1].tool_name == "retrieve_laws"


def test_missing_fact_asks_exactly_one_deterministic_question_without_planner():
    """V2-G2 适配：无证据 issue 先被服务端扇出检索；unknown_fact 存在 → 评估器 MISSING_FACT
    优先于证据检查 → 确定性注册一次澄清（WAITING_USER），planner 无需参与该决策。"""
    repository = FakeRepository(initial_state(unknown=True))
    planner = SequencePlanner([{"kind": "finish_research", "summary": "done"}])
    gateway = RecordingGateway(empty=True)

    agent = controller(repository, planner, gateway)
    result = agent.run("run-a", bootstrap())

    assert result.state.status is AgentStatus.WAITING_USER
    assert result.pending_question == "是否约定履行期限"
    assert result.state.clarifications == 1
    # G2：澄清由确定性评估器判定，planner 不会在此轮参与（0 次调用）
    assert len(planner.calls) == 0
    # gateway 仅被服务端扇出调用一次（empty 检索）
    assert len(gateway.calls) == 1
    resumed_result = agent.run("run-a", bootstrap())
    assert resumed_result.state.clarifications == 1
    assert resumed_result.pending_question == "是否约定履行期限"
    assert len(planner.calls) == 0


def test_ask_user_forced_to_conditional_analysis_when_clarify_budget_exhausted():
    """Gate 4：澄清预算已耗尽时评估器仍判定 MISSING_FACT → 确定性强制条件化（转 DRAFTING 产出分情形分析）。

    统一门位于 _handle_evaluation 的 MISSING_FACT 分支：无论 Planner 输出 ask_user 还是
    finish_research，都不再注册超出预算的澄清（原行为：register_clarification 触发
    BudgetExceeded→STOP→静默降级，用户最后回答被丢弃）。
    """
    budgets = AgentBudgets(max_clarifications=2)
    state = initial_state(unknown=True, budgets=budgets).model_copy(
        update={"status": AgentStatus.PLANNING, "clarifications": 2}
    )
    repository = FakeRepository(state)
    planner = SequencePlanner([{"kind": "ask_user", "question": "是否约定履行期限"}])
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway, budgets=budgets).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.DRAFTING, f"expected DRAFTING, got {result.state.status}"
    assert result.state.clarifications == 2  # 未注册第 3 次澄清
    reason = repository.checkpoints[-1][1].reason_code
    assert reason == "CLARIFY_BUDGET_EXHAUSTED"
    # V2-G2：无证据 issue 先被扇出检索一次（gateway 被调 1 次），但评估 MISSING_FACT+澄清耗尽
    # 仍确定性强制条件化——不因多了本次检索而继续追问
    assert len(gateway.calls) == 1

    # 预算未耗尽时行为不变：仍然正常发起澄清（对照保护）
    state2 = initial_state(unknown=True, budgets=budgets).model_copy(
        update={"status": AgentStatus.PLANNING, "clarifications": 1}
    )
    repository2 = FakeRepository(state2)
    planner2 = SequencePlanner([{"kind": "ask_user", "question": "是否约定履行期限"}])
    result2 = controller(repository2, planner2, RecordingGateway(), budgets=budgets).run("run-a", bootstrap())
    assert result2.state.status is AgentStatus.WAITING_USER
    assert result2.state.clarifications == 2


def test_finish_research_forced_to_conditional_analysis_when_clarify_budget_exhausted():
    """Gate 4 统一门：Planner 输出 finish_research、评估器仍 MISSING_FACT 且轮数已满 → 同样强制条件化。

    覆盖 C10 实测路径：第三次"澄清"由 finish_research 决策 + 评估器 MISSING_FACT 注册，
    此前仅拦 ask_user 是不足的。
    """
    budgets = AgentBudgets(max_clarifications=2)
    state = initial_state(unknown=True, budgets=budgets).model_copy(
        update={"status": AgentStatus.PLANNING, "clarifications": 2}
    )
    repository = FakeRepository(state)
    planner = SequencePlanner([{"kind": "finish_research", "summary": "done"}])

    result = controller(repository, planner, RecordingGateway(), budgets=budgets).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.DRAFTING
    assert result.state.clarifications == 2
    assert repository.checkpoints[-1][1].reason_code == "CLARIFY_BUDGET_EXHAUSTED"


def test_empty_issue_state_fails_safe_before_planner_or_gateway():
    repository = FakeRepository(LegalAgentState())
    planner = SequencePlanner([tool_decision()])
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded is False
    assert repository.checkpoints[-1][1].reason_code == "INTEGRITY_NO_ISSUES"
    assert planner.calls == []
    assert gateway.calls == []


def test_missing_evidence_replans_then_duplicate_budget_stops_without_reexecution():
    budgets = AgentBudgets(max_replans=3, max_duplicate_attempts_per_issue=1)
    repository = FakeRepository(initial_state(budgets=budgets))
    planner = SequencePlanner([tool_decision(), tool_decision(), tool_decision()])
    gateway = RecordingGateway(output=empty_laws_output())  # 扇出与 planner 均无有效证据

    result = controller(repository, planner, gateway, budgets=budgets).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.STOPPED
    assert result.degraded_reason == "AGENT_BUDGET_EXCEEDED"
    assert result.state.duplicate_attempts_by_issue == {"issue-a": 2}
    # V2-G2：2 次 gateway 调用 = 服务端扇出 1 次 + planner 首次工具执行 1 次；后续重复被去重不重执行
    assert len(gateway.calls) == 2


def test_incomplete_tool_evidence_is_not_materialized_or_linked():
