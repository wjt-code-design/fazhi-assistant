def test_g1_gate_off_when_no_evidence_yet():
    """V2-G1 负例：没有任何有效证据时门不触发，planner 照常被调用（会话正常推进）。

    V2-G2 适配：无证据 issue 先被扇出 empty（MISSING_EVIDENCE → replan），之后 planner 的
    tool_call 第二次检索返回有效证据 → SUFFICIENT → DRAFTING——门在无证据时不拦截 planner。
    """
    repository = FakeRepository(initial_state())
    planner = SequencePlanner([tool_decision()])
    gateway = RecordingGateway(outputs=[empty_laws_output()])

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert planner.calls, "无证据时应走 planner 路径（门未触发）"
    assert isinstance(result, ControllerResult)


def test_g2_issue_fanout_retrieves_for_evidence_less_issues():
    """V2-G2 红：进入 PLANNING 后，无证据 issue 应被服务端自动扇出一次定向检索。

    旧实现不做扇出：gateway.calls 为空且 planner 必须先被调用一次。
    构造：issue-a 无任何证据（initial_state）、gateway 返回 SUFFICIENT 级证据 →
    扇出后的确定性评估应推进到 DRAFTING，全程无需 planner 决策。
    """
    repository = FakeRepository(initial_state())
    planner = SequencePlanner([])  # 任何 decide 调用都会 AssertionError → 扇出必须先行
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert isinstance(result, ControllerResult)
    assert result.state.status is AgentStatus.DRAFTING
    assert any("诉讼时效" in str(call) for call in gateway.calls)  # 扇出检索确实发生
    assert planner.calls == []  # 扇出+评估已足够，无需 planner


def test_g2_fanout_respects_existing_evidence_per_issue():
    """V2-G2 负例：issue 已有证据则不再扇出（避免重复检索浪费预算）。"""
    repository = FakeRepository(sufficient_state())
    planner = SequencePlanner([])
    gateway = RecordingGateway()

    result = controller(repository, planner, gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.DRAFTING
    # 证据已足时 G1 门应先行转 DRAFTING；若扇出未经证据检查，会多一次 gateway 调用
    assert len(gateway.calls) == 0


def test_policy_injection_is_hard_failure_without_fallback_content():
    repository = FakeRepository(initial_state())
    # V2-G2：empty 扇出（无证据→replan）让 planner 的 hostile 决策真实可达，验证注入被 fail-closed
    gateway = RecordingGateway(empty=True)
    hostile = {**tool_decision(), "args": {"query": "x", "user_id": 999}}

    result = controller(repository, SequencePlanner([hostile]), gateway).run("run-a", bootstrap())

    assert result.state.status is AgentStatus.FAILED
    assert result.degraded is False
    assert result.degraded_reason is None
    assert result.pending_question is None
    # 仅服务端扇出 1 次；hostile 决策在 parse 层被拒，从未触达 gateway
    assert len(gateway.calls) == 1


