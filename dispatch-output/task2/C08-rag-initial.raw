data: {"type": "status", "msg": "正在思考…"}

data: {"content": "1"}

data: {"content": ". 首先"}

data: {"content": "判断保证"}

data: {"content": "方式。根据"}

data: {"content": "《民法典》第六"}

data: {"content": "百八十六条，"}

data: {"content": "当事"}

data: {"content": "人在保证合同中对"}

data: {"content": "保证方式没有"}

data: {"content": "约定或者约定不"}

data: {"content": "明确的，按照一般"}

data: {"content": "保证承担保证责任。"}

data: {"content": "因此，你的担保"}

data: {"content": "属于一般保证。"}

data: {"content": "\n\n"}

data: {"content": "2. 其次"}

data: {"content": "确定保证期间。"}

data: {"content": "根据《民法典》"}

data: {"content": "第六百九十二条"}

data: {"content": "，没有"}

data: {"content": "约定或者约定不"}

data: {"content": "明确的，保证期间"}

data: {"content": "为主"}

data: {"content": "债务履行期限届满"}

data: {"content": "之日起六个月。债权人"}

data: {"content": "必须在该六个月内"}

data: {"content": "向你主张权利。"}

data: {"content": "\n\n3."}

data: {"content": " 最后分析还款"}

data: {"content": "义务与抗辩"}

data: {"content": "权。\n第一"}

data: {"content": "，关于是否“"}

data: {"content": "必须还”。根据"}

data: {"content": "《民法典》第六"}

data: {"content": "百九十三条，"}

data: {"content": "一般保证的"}

data: {"content": "债权人未在保证期间"}

data: {"content": "对债务人提起诉讼或者"}

data: {"content": "申请仲裁的，"}

data: {"content": "保证人不再承担"}

data: {"content": "保证责任。如果债权"}

data: {"content": "人在主债务到期"}

data: {"content": "后六个月内未"}

data: {"content": "起诉或仲裁债务人"}

data: {"content": "，你将免除保证责任"}

data: {"content": "。\n第二"}

data: {"content": "，关于还款顺序"}

data: {"content": "。根据"}

data: {"content": "《民法典》第六"}

data: {"content": "百八十七条，"}

data: {"content": "一般保证"}

data: {"content": "的保证人在主合同纠纷"}

data: {"content": "未经审判或者仲裁"}

data: {"content": "，并就债务人财产"}

data: {"content": "依法强制执行"}

data: {"content": "仍不能履行债务"}

data: {"content": "前，有权拒绝"}

data: {"content": "向债权人承担"}

data: {"content": "保证责任（即享有"}

data: {"content": "先诉抗辩"}

data: {"content": "权）。这意味着债权人"}

data: {"content": "必须先"}

data: {"content": "起诉你朋友并"}

data: {"content": "强制执行其财产，"}

data: {"content": "只有在"}

data: {"content": "确实无法清偿时"}

data: {"content": "，才能"}

data: {"content": "要求你还钱。"}

data: {"content": "\n\n结论："}

data: {"content": "只要债权人在主"}

data: {"content": "债务到期"}

data: {"content": "后的六个月内未"}

data: {"content": "对你"}

data: {"content": "朋友提起诉讼或申请"}

data: {"content": "仲裁，"}

data: {"content": "你就不必承担"}

data: {"content": "还款责任"}

data: {"content": "；若已起诉"}

data: {"content": "，在你朋友财产"}

data: {"content": "被依法强制执行仍"}

data: {"content": "不能清偿前，"}

data: {"content": "你也有"}

data: {"content": "权拒绝直接还款"}

data: {"content": "。"}

