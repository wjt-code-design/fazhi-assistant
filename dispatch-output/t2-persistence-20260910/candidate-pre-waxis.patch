+def _deficient_issue_ids(state: Any, draft: Any) -> set[str]:
+    """缺绑定 issue 集合。**谓词单一真源**见 `writer.issue_is_deficient`（F5，2026-09-10 审查收敛）。
+
+    本处只提供**证据视图**：用 `state.evidence`（全局）；writer 侧用 per-issue 证据视图。
+    原先两处各有一份同义谓词实现——复制漂移会造成"该重写的不重写／不该重写的重写"这类**静默分流错误**。
+    verifier.py 因冻结保留原实现（口径一致，执行书 T0 红线）。
+    """
+    claims = [*draft.conclusion, *draft.issue_analysis, *draft.risks]
+    evidence_by_id = {evidence.evidence_id: evidence for evidence in state.evidence}
+    return {issue.issue_id for issue in state.issues if issue_is_deficient(issue.issue_id, claims, evidence_by_id)}
