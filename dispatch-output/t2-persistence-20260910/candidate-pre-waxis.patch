+        payload = build_writer_payload(state)
+    except _WriterFailure:
+        return None
+    claims = [*draft.conclusion, *draft.issue_analysis, *draft.risks]
+    deficient_issues: list[WriterIssue] = []
+    for issue in payload.issues:
+        # 证据视图 = 该 issue 自己的证据列表（与 service 的全局视图不同，见 issue_is_deficient 文档）
+        evidence_by_id = {evidence.evidence_id: evidence for evidence in issue.evidence}
+        if issue_is_deficient(issue.issue_id, claims, evidence_by_id):
+            deficient_issues.append(issue)
+    if not deficient_issues:
+        return None
+    lines = [
+        "以下争点缺少绑定生效成文法证据（legal_validity=effective 的 STATUTE 证据）的 claim。"
+        "请为每个争点至少新增一个 claim，其 evidence_ids 必须引用该争点证据列表中标注"
