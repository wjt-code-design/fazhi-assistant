+def _rewrite_worth_attempting(state: Any, draft: Any) -> bool:
+    """V2-T3（2026-09-09）修复分流（教学手册第四课）：writer 只能修"证据已齐但 claim 未绑定"。
+
+    - 存在未解决 critical conflict → writer 无法解除 conflict，重写必仍 deficient：不外呼；
+    - 任一缺绑定 issue 没有成功 observation 链接的生效成文法证据 → writer 创造不了法条：不外呼；
+    - 仅当全部缺绑定 issue 均有可用证据（纯 binding 缺口）才允许消耗重写预算。
+    与 verifier 的差异口径：本判定只做"可修复性"预判，不改变任何 verifier 裁决。
+    """
+    if any(conflict.critical and not conflict.resolved for conflict in state.conflicts):
+        return False
+    deficient = _deficient_issue_ids(state, draft)
+    if not deficient:
+        return False
+    evidence_by_id = {evidence.evidence_id: evidence for evidence in state.evidence}
+    linked_by_issue: dict[str, set[str]] = {}
+    for observation in state.observations:
+        if observation.status != "succeeded":
+            continue
+        linked_by_issue.setdefault(observation.issue_id, set()).update(observation.evidence_ids)
+    for issue_id in deficient:
+        has_usable = any(
+            is_effective_statute(evidence_by_id.get(evidence_id))
+            for evidence_id in linked_by_issue.get(issue_id, set())
+        )
+        if not has_usable:
+            return False
+    return True
+
