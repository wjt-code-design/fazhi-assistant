+    """
+    if getattr(exc, "status_code", None) != 400:
+        return False
+    body = getattr(exc, "body", "")
+    text = f"{exc}{body}".lower()
+    return any(marker in text for marker in _SCHEMA_REJECTION_MARKERS)
