+def _fit_budgets_to_max_decomposition(budgets: AgentBudgets) -> AgentBudgets:
+    """把预算上限抬到"装得下契约允许的最大分解"（幂等、只放宽、结果恒定）。
+
+    `max_tool_calls` 必须一并抬高：8 个争点要 8 次检索，而默认 10 次只剩 2 次余量——
+    只抬 `max_steps` 会在**下一个天花板**上撞回来。
+    """
+    required_steps = _BUDGET_FIXED_STEPS + _BUDGET_STEPS_PER_ISSUE * _MAX_ISSUES + _BUDGET_STEP_SLACK
+    required_tools = _MAX_ISSUES + _BUDGET_TOOL_SLACK
+    return budgets.model_copy(
+        update={
+            "max_steps": max(budgets.max_steps, required_steps),
+            "max_tool_calls": max(budgets.max_tool_calls, required_tools),
+        }
+    )
