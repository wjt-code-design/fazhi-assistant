+_MULTI_ISSUE_QUERY = "公司拖欠工资且未签合同，现在要解除劳动关系，能否主张补偿"
+_MULTI_ISSUE_QUOTES = ["公司拖欠工资", "未签合同", "解除劳动关系", "主张补偿"]
