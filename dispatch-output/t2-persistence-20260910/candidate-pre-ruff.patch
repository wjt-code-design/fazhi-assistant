+def test_budgets_fit_contract_max_decomposition_and_never_narrow():
+    """V2-T8 预算上限：必须装得下契约允许的**最大分解**，且从不收紧、幂等、有界。
+
+    **期望值全部独立手算，不引用实现常量与函数**（CONTRIBUTING：期望值来自独立来源）：
+      · 契约允许 8 个争点；冻结实测「5 争点 = **19 步**」（run-15 C08），线性趋势 ≈ 8 + 2N
+        ⇒ 8 争点约需 **24–26 步** ⇒ 上限下界取 **26**；
+      · 工具预算 = 8 次检索 + 查询余量 ⇒ 下界取 **11**；
+      · 上界受 settings 的 `le=32` 防失控约束。
+
+    watch-it-fail：加固前装配层直接用 settings 的 16 步 ⇒ 5 争点（需 19 步）必然 AGENT_BUDGET_EXCEEDED。
+    """
+    from agent.runtime import _fit_budgets_to_max_decomposition
+
+    base = AgentBudgets(max_steps=16, max_tool_calls=10)
+    fitted = _fit_budgets_to_max_decomposition(base)
+
+    assert fitted.max_steps >= 26, "必须装得下契约允许的最大分解（8 争点按实测趋势约需 24–26 步）"
+    assert fitted.max_steps >= 19, "冻结题实测 5 争点需 19 步，必须覆盖"
+    assert fitted.max_steps <= 32, "不得突破 settings 的 le=32 防失控上限"
+    assert fitted.max_tool_calls >= 11, "工具预算必须同步抬高（8 次检索 + 余量），否则会在下一个天花板撞回来"
+
+    assert _fit_budgets_to_max_decomposition(fitted) == fitted, "必须幂等（上限恒定 ⇒ 跨 run 可比）"
+
+    higher = AgentBudgets(max_steps=30, max_tool_calls=10)
+    raised = _fit_budgets_to_max_decomposition(higher)
+    assert raised.max_steps == 30, "算子调高下限时不得收紧"
+    assert raised.max_tool_calls >= 11, "抬高后仍须满足契约下界"
