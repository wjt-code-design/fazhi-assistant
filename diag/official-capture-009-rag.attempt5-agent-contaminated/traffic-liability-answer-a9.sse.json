 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n本案"
 },
 {
  "content": "为两机动车"
 },
 {
  "content": "追尾事故，"
 },
 {
  "content": "交警已"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任。争议"
 },
 {
  "content": "焦点在于前车"
 },
 {
  "content": "损失的赔偿主体及"
 },
 {
  "content": "法定"
 },
 {
  "content": "赔偿顺位。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n《道路交通安全法"
 },
 {
  "content": "》第七十六条第一款"
 },
 {
  "content": "第（一）"
 },
 {
  "content": "项；《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条；《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十五条。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，后车"
 },
 {
  "content": "作为全责方"
 },
 {
  "content": "，其过错行为"
 },
 {
  "content": "与前车损失"
 },
 {
  "content": "存在直接"
 },
 {
  "content": "因果关系。根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十五条，"
 },
 {
  "content": "行为人因过错"
 },
 {
  "content": "侵害他人民事"
 },
 {
  "content": "权益造成损害的"
 },
 {
  "content": "，应当承担侵权"
 },
 {
  "content": "责任。\n第二"
 },
 {
  "content": "，赔偿顺位"
 },
 {
  "content": "依法进行。根据"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第七十六条及《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条，前"
 },
 {
  "content": "车损失应先"
 },
 {
  "content": "由承保后"
 },
 {
  "content": "车机动车强制保险"
 },
 {
  "content": "的保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿。\n"
 },
 {
  "content": "第三，交强"
 },
 {
  "content": "险赔偿不足的部分"
 },
 {
  "content": "，若后车"
 },
 {
  "content": "投保了机动车商业"
 },
 {
  "content": "保险（如第三者"
 },
 {
  "content": "责任险），由"
 },
 {
  "content": "承保商业险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿。"
 },
 {
  "content": "\n第四，若"
 },
 {
  "content": "交强险与"
 },
 {
  "content": "商业险赔偿后"
 },
 {
  "content": "仍有不足，或者"
 },
 {
  "content": "后车根本"
 },
 {
  "content": "未投保商业险"
 },
 {
  "content": "，则由侵权人"
 },
 {
  "content": "（后车驾驶人"
 },
 {
  "content": "/所有人）"
 },
 {
  "content": "自行承担剩余部分的"
 },
 {
  "content": "赔偿。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：前车的"
 },
 {
  "content": "损失由后车"
 },
 {
  "content": "一方承担，赔偿"
 },
 {
  "content": "顺位依次为后"
 },
 {
  "content": "车的交强险"
 },
 {
  "content": "、商业险及"
 },
 {
  "content": "侵权人个人。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "若后车未"
 },
 {
  "content": "投保交强险"
 },
 {
  "content": "或商业险，"
 },
 {
  "content": "或保额不足"
 },
 {
  "content": "，且侵权人"
 },
 {
  "content": "个人缺乏履行能力"
 },
 {
  "content": "，前车可能"
 },
 {
  "content": "面临无法全额获"
 },
 {
  "content": "赔的执行风险。"
 },
 {
  "content": "建议前车及时"
 },
 {
  "content": "固定损失"
 },
 {
  "content": "证据，必要时向"
 },
 {
  "content": "法院申请财产保全"
 },
 {
  "content": "以保障权益"
 },
 {
  "content": "。"
 },
 {
  "content": "\n\n本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
