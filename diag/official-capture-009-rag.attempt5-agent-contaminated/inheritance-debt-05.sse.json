[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n父亲去世时"
 },
 {
  "content": "遗留了房子和"
 },
 {
  "content": "信用卡欠款。核心"
 },
 {
  "content": "争议在于：子女"
 },
 {
  "content": "是否必须使用个人"
 },
 {
  "content": "自有财产来偿还"
 },
 {
  "content": "父亲的信用卡欠款。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千一百二十二"
 },
 {
  "content": "条、第一千一百"
 },
 {
  "content": "六十一条、第一千"
 },
 {
  "content": "一百六十三条，"
 },
 {
  "content": "以及《民事诉讼法"
 },
 {
  "content": "》第二百四十三条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "父亲遗留的房子"
 },
 {
  "content": "属于其遗产。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百二十二条"
 },
 {
  "content": "，遗产是自然人"
 },
 {
  "content": "死亡时遗留的个人"
 },
 {
  "content": "合法财产，该"
 },
 {
  "content": "房子依法属于遗产"
 },
 {
  "content": "范围。\n"
 },
 {
  "content": "其次，子女对"
 },
 {
  "content": "父亲的债务承担的是"
 },
 {
  "content": "“限定继承”"
 },
 {
  "content": "责任。根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条，继承"
 },
 {
  "content": "人以所得遗产实际"
 },
 {
  "content": "价值为限清偿"
 },
 {
  "content": "被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务。超过遗产"
 },
 {
  "content": "实际价值部分，"
 },
 {
  "content": "继承人自愿偿还的不"
 },
 {
  "content": "在此限。这意味着"
 },
 {
  "content": "，子女仅需用"
 },
 {
  "content": "继承的遗产（"
 },
 {
  "content": "如房子折价"
 },
 {
  "content": "或变卖所得"
 },
 {
  "content": "价款"
 },
 {
  "content": "）来"
 },
 {
  "content": "偿还信用卡欠款，"
 },
 {
  "content": "对于"
 },
 {
  "content": "超出遗产价值的"
 },
 {
  "content": "债务部分"
 },
 {
  "content": "，子女没有必须"
 },
 {
  "content": "用自己个人财产偿还"
 },
 {
  "content": "的法定义务。"
 },
 {
  "content": "\n再次，子女"
 },
 {
  "content": "享有放弃继承的权利"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条第二款，继承人"
 },
 {
  "content": "放弃继承的，"
 },
 {
  "content": "对被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务可以不负清偿"
 },
 {
  "content": "责任。\n最后"
 },
 {
  "content": "，关于债务"
 },
 {
  "content": "清偿顺序"
 },
 {
  "content": "与执行。"
 },
 {
  "content": "根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十三条，既有法定"
 },
 {
  "content": "继承又有遗嘱继承"
 },
 {
  "content": "、遗赠的"
 },
 {
  "content": "，由法定继承人"
 },
 {
  "content": "清偿被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务；超过"
 },
 {
  "content": "法定继承遗产实际"
 },
 {
  "content": "价值部分，由"
 },
 {
  "content": "遗嘱继承人和受"
 },
 {
  "content": "遗赠人按比例"
 },
 {
  "content": "以所得遗产清偿"
 },
 {
  "content": "。同时，根据"
 },
 {
  "content": "《民事诉讼法》"
 },
 {
  "content": "第二百四十三条，作为"
 },
 {
  "content": "被执行人的公民死亡的"
 },
 {
  "content": "，以其遗产偿还"
 },
 {
  "content": "债务。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：子女并非"
 },
 {
  "content": "必须拿自己的个人"
 },
 {
  "content": "钱款偿还父亲的"
 },
 {
  "content": "信用卡欠款，仅在"
 },
 {
  "content": "继承遗产的实际价值"
 },
 {
  "content": "范围内承担清偿责任"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：若子女未"
 },
 {
  "content": "放弃继承且已"
 },
 {
  "content": "实际管理遗产，"
 },
 {
  "content": "需在遗产价值范围内"
 },
 {
  "content": "配合清偿"
 },
 {
  "content": "债务。若存在"
 },
 {
  "content": "恶意转移、隐匿"
 },
 {
  "content": "遗产以逃避债务"
 },
 {
  "content": "的行为，可能需"
 },
 {
  "content": "承担相应法律责任。"
 },
 {
  "content": "此外，若子女"
 },
 {
  "content": "为该信用卡欠款的"
 },
 {
  "content": "担保人或共同债务人"
 },
 {
  "content": "，则需依据"
 },
 {
  "content": "担保或"
 },
 {
  "content": "借贷关系承担相应"
 },
 {
  "content": "还款责任，此"
 },
 {
  "content": "情形下则不以"
 },
 {
  "content": "遗产为限。"
 },
