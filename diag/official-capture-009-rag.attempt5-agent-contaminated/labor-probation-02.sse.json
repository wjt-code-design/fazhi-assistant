 },
 {
  "content": "六个月。3"
 },
 {
  "content": "年期的"
 },
 {
  "content": "劳动合同约定"
 },
 {
  "content": "6个月试用期本身"
 },
 {
  "content": "合法"
 },
 {
  "content": "，但延长2"
 },
 {
  "content": "个月后总试用期达到"
 },
 {
  "content": "8个月，明显"
 },
 {
  "content": "突破了"
 },
 {
  "content": "法定"
