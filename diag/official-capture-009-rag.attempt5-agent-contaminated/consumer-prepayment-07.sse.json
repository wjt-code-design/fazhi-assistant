[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n消费者在"
 },
 {
  "content": "健身房预付办卡"
 },
 {
  "content": "，后健身房关门"
 },
 {
  "content": "停业，且"
 },
 {
  "content": "双方合同约定“概"
 },
 {
  "content": "不退款”。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "该“概不"
 },
 {
  "content": "退款”条款是否"
 },
 {
  "content": "具有法律效力；"
 },
 {
  "content": "健身房关门导致合同"
 },
 {
  "content": "无法履行时，"
 },
 {
  "content": "消费者是否有权要求"
 },
 {
  "content": "退还剩余费用。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n主要涉及"
 },
 {
  "content": "《民法典》关于"
 },
 {
  "content": "格式条款的效力"
 },
 {
  "content": "、合同解除及"
 },
 {
  "content": "违约责任的规定，"
 },
 {
  "content": "以及《消费者权益保护法"
 },
 {
  "content": "》关于经营者"
 },
 {
  "content": "使用格式条款的"
 },
 {
  "content": "禁止性规定。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n第一"
 },
 {
  "content": "，“概不退款"
 },
 {
  "content": "”条款属于无效"
 },
 {
  "content": "格式条款。健身房"
 },
 {
  "content": "为了重复使用而"
 },
 {
  "content": "预先拟定且未"
 },
 {
  "content": "与消费者协商的"
 },
 {
  "content": "条款，属于格式"
 },
 {
  "content": "条款。根据《"
 },
 {
  "content": "民法典》第四百九"
 },
 {
  "content": "十七条，提供格式"
 },
 {
  "content": "条款一方排除对方"
 },
 {
  "content": "主要权利的，该"
 },
 {
  "content": "条款无效。同时"
 },
 {
  "content": "，根据《消费者权益"
 },
 {
  "content": "保护法》第二十六条，"
 },
 {
  "content": "经营者不得以格式条款"
 },
 {
  "content": "等方式作出排除或者"
 },
 {
  "content": "限制消费者权利、"
 },
 {
  "content": "减轻或者免除经营者"
 },
 {
  "content": "责任等对消费者"
 },
 {
  "content": "不公平、不合理的规定"
 },
 {
  "content": "，该“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款排除了消费者"
 },
 {
  "content": "在经营者无法提供服务"
 },
 {
  "content": "时的合法求偿"
 },
 {
  "content": "权，应属"
 },
 {
  "content": "无效，不能作为"
 },
 {
  "content": "健身房免责的依据"
 },
 {
  "content": "。\n\n"
 },
 {
  "content": "第二，健身房关门"
 },
 {
  "content": "构成根本违约，"
 },
 {
  "content": "消费者有权解除合同"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百六十三条"
 },
 {
  "content": "，当事人一方有其他"
 },
 {
  "content": "违约行为致使不能"
 },
 {
  "content": "实现合同目的，"
 },
 {
  "content": "当事人可以解除合同"
 },
 {
  "content": "。健身房关门停业"
 },
 {
  "content": "，无法"
 },
 {
  "content": "继续提供健身服务"
 },
 {
  "content": "，导致消费者订立"
 },
 {
  "content": "合同的目的完全落空"
 },
 {
  "content": "，消费者依法"
 },
 {
  "content": "享有合同解除权"
 },
 {
  "content": "。\n\n第三，"
 },
 {
  "content": "合同解除后消费者"
 },
 {
  "content": "有权要求退款。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百七十七条，"
 },
 {
  "content": "当事人一方不履行"
 },
 {
  "content": "合同义务或者履行"
 },
 {
  "content": "合同义务不符合约定的"
 },
 {
  "content": "，应当承担赔偿"
 },
 {
  "content": "损失等违约责任"
 },
 {
  "content": "。健身房应当退还"
 },
 {
  "content": "消费者尚未消费"
 },
 {
  "content": "部分的预付款项。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：消费者有权要求"
 },
 {
  "content": "健身房退还剩余费用"
 },
 {
  "content": "，合同中的“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款无效。\n"
 },
 {
  "content": "风险提示：虽然"
 },
 {
  "content": "法律上消费者享有"
 },
 {
  "content": "胜诉权，"
 },
 {
  "content": "但若健身房已经"
 },
 {
  "content": "注销、经营者"
 },
 {
  "content": "跑路或无"
 },
 {
  "content": "财产可供执行，"
 },
 {
  "content": "消费者实际拿"
 },
 {
  "content": "回款项可能面临"
 },
 {
  "content": "执行难的风险。"
 },
 {
  "content": "建议消费者及时收集"
 },
 {
  "content": "办卡合同、"
 },
 {
  "content": "付款凭证、健身房"
 },
 {
  "content": "关门公告等证据"
 },
 {
  "content": "，向市场监管部门"
 },
 {
  "content": "投诉、请求消费者"
 },
 {
  "content": "协会调解或向"
 },
 {
  "content": "法院提起诉讼以"
 },
 {
  "content": "维护自身权益。"
 },
 {
  "content": "\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
