  "content": "① "
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案"
 },
 {
  "content": "中"
 },
 {
  "content": "，公司欠付"
 },
 {
  "content": "货款属于公司债务"
 },
 {
  "content": "，但"
 },
 {
  "content": "法定代表人"
 },
 {
  "content": "要求股东个人先行"
 },
 {
  "content": "签署承诺。争议"
 },
 {
  "content": "焦点"
 },
 {
  "content": "在于：供应商能否"
 },
 {
  "content": "突破公司的"
 },
 {
  "content": "法人独立地位，"
 },
 {
  "content": "直接起诉股东要求"
 },
 {
  "content": "其"
 },
 {
  "content": "承担付款责任。"
 },
 {
  "content": "\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "，"
 },
 {
  "content": "公司股东滥用公司"
 },
 {
  "content": "法人独立地位和"
 },
 {
  "content": "股东有限责任，逃避"
 },
 {
  "content": "债务，严重损害"
 },
 {
  "content": "公司债权人利益的，"
 },
 {
  "content": "应当对公司债务承担"
 },
 {
  "content": "连带责任。股东"
 },
 {
  "content": "利用其控制的两个"
 },
 {
  "content": "以上公司实施前款"
 },
 {
  "content": "规定行为的，各"
 },
 {
  "content": "公司应当对任一公司的"
 },
 {
  "content": "债务承担连带责任"
 },
 {
  "content": "。只有一个股东的公司"
 },
 {
  "content": "，股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己的财产的"
 },
 {
  "content": "，应当对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n1"
 },
 {
  "content": ". 一般"
 },
 {
  "content": "原则：公司具有"
 },
 {
  "content": "独立的法人资格，以其"
 },
 {
  "content": "全部财产对"
 },
 {
  "content": "公司的债务承担责任。"
 },
 {
  "content": "股东"
 },
 {
  "content": "仅以其认"
 },
 {
  "content": "缴的出资额为"
 },
 {
  "content": "限对公司承担责任。"
 },
 {
  "content": "因此，仅凭"
 },
 {
  "content": "公司欠付"
 },
 {
  "content": "货款这一事实，"
 },
 {
  "content": "供应商通常不能直接"
 },
 {
  "content": "起诉股东个人"
 },
 {
  "content": "要求还款"
 },
 {
  "content": "。\n2."
 },
 {
  "content": " 例外"
 },
 {
  "content": "情形一：股东"
 },
 {
  "content": "滥用法人独立地位"
 },
 {
  "content": "。"
 },
 {
  "content": "根据《公司法》"
 },
 {
  "content": "第二十三条第一款和第二款"
 },
 {
  "content": "，如果"
 },
 {
  "content": "股东"
 },
 {
  "content": "滥用"
 },
 {
  "content": "公司法人独立地位"
 },
 {
  "content": "和股东有限责任来"
 },
 {
  "content": "逃避债务，且"
 },
 {
  "content": "严重损害了"
 },
 {
  "content": "公司债权人（"
 },
 {
  "content": "即供应商）的利益"
 },
 {
  "content": "，该"
 },
 {
  "content": "股东应当对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "此时"
 },
 {
  "content": "，"
 },
 {
  "content": "供应商可以起诉股东"
 },
 {
  "content": "，但需承担"
 },
 {
  "content": "相应的"
 },
 {
  "content": "举证责任。"
 },
 {
  "content": "\n3. "
 },
 {
  "content": "例外情形二："
 },
 {
  "content": "一人公司财产混"
 },
 {
  "content": "同。根据《"
 },
 {
  "content": "公司法》第二十三条第三"
 },
 {
  "content": "款，若"
 },
 {
  "content": "该公司为一人有限责任公司"
 },
 {
  "content": "，股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己"
 },
 {
  "content": "财产的，应当"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "责任。此时"
 },
 {
  "content": "举证责任倒置"
 },
 {
  "content": "，由"
 },
 {
  "content": "股东自证"
 },
 {
  "content": "清白"
 },
 {
  "content": "。\n4."
 },
 {
  "content": " 关于“个人"
 },
 {
  "content": "承诺”："
 },
 {
  "content": "法定代表人要求"
 },
 {
  "content": "股东个人"
 },
 {
  "content": "签署承诺"
 },
 {
  "content": "，该"
 },
 {
  "content": "承诺的法律"
 },
 {
  "content": "性质需结合具体内容"
 },
 {
  "content": "判断。如果承诺"
 },
 {
  "content": "内容构成"
 },
 {
  "content": "“"
 },
 {
  "content": "债务加入”（即"
 },
 {
  "content": "股东自愿加入公司"
 },
 {
  "content": "债务，"
 },
 {
  "content": "与公司共同向"
 },
 {
  "content": "供应商"
 },
 {
  "content": "承担责任）或“"
 },
 {
  "content": "保证担保”，供应商"
 },
 {
  "content": "可依据该承诺"
 },
 {
  "content": "直接起诉"
 },
 {
  "content": "股东。但承诺"
 },
 {
  "content": "的具体性质"
 },
 {
  "content": "及"
 },
 {
  "content": "效力"
 },
 {
  "content": "需结合承诺文件"
 },
 {
  "content": "的具体"
 },
 {
  "content": "措"
 },
 {
  "content": "辞、签署背景"
 },
 {
  "content": "等综合认定，"
 },
 {
  "content": "存在法律不确定性。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n供应商"
 },
 {
  "content": "通常不能仅"
 },
 {
  "content": "因公司欠款"
 },
 {
  "content": "而"
 },
 {
  "content": "直接起诉股东，"
 },
 {
  "content": "除非存在股东"
 },
 {
  "content": "滥用法人独立地位"
 },
 {
  "content": "逃避债务、一人"
 },
 {
  "content": "公司财产混同等"
 },
 {
  "content": "法定"
 },
 {
  "content": "情形，或者股东"
 },
 {
  "content": "签署的承诺构成了"
 },
 {
  "content": "债务加入或保证"
 },
 {
  "content": "担保。对于"
 },
 {
  "content": "股东而言，应"
 },
 {
  "content": "极其"
 },
 {
  "content": "审慎地"
 },
 {
  "content": "对待此类"
 },
 {
  "content": "个人承诺"
 },
 {
  "content": "的签署，避免"
 },
 {
  "content": "因"
 },
 {
  "content": "承诺内容界定"
 },
 {
  "content": "不清或"
 },
 {
  "content": "构成"
 },
 {
  "content": "债务加入/"
 },
 {
  "content": "保证"
 },
 {
  "content": "，导致个人被"
 },
 {
  "content": "供应商"
 },
 {
  "content": "直接起诉并承担"
 },
 {
  "content": "连带责任"
 },
 {
  "content": "的风险。"
