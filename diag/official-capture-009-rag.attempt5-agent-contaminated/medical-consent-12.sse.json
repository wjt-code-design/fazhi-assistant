[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n"
 },
 {
  "content": "本案中，医院"
 },
 {
  "content": "在手术前未"
 },
 {
  "content": "向患者说明医疗"
 },
 {
  "content": "风险，术后患者"
 },
 {
  "content": "出现后遗症，医院"
 },
 {
  "content": "以患者已签字"
 },
 {
  "content": "为由拒绝承担责任。"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "医院仅凭患者"
 },
 {
  "content": "签字能否免除其"
 },
 {
  "content": "未充分告知医疗"
 },
 {
  "content": "风险的法律责任，"
 },
 {
  "content": "以及术后后遗症是否"
 },
 {
  "content": "构成医疗损害。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第一千二百一十九条"
 },
 {
  "content": "、《基本医疗卫生与健康"
 },
 {
  "content": "促进法》第三十二条"
 },
 {
  "content": "、《医师法》"
 },
 {
  "content": "第二十五条、《民法典》"
 },
 {
  "content": "第一千二百一十八条"
 },
 {
  "content": "、《民法典》第一千"
 },
 {
  "content": "二百二十一条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "医院的告知义务是法定义务，不仅"
 },
 {
  "content": "限于让患者签字"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十九条、《基本医疗卫生"
 },
 {
  "content": "与健康促进法》"
 },
 {
  "content": "第三十二条及《医师"
 },
 {
  "content": "法》第二十五条，"
 },
 {
  "content": "医务人员在需要实施"
 },
 {
  "content": "手术时，必须"
 },
 {
  "content": "向患者具体说明"
 },
 {
  "content": "医疗风险、替代"
 },
 {
  "content": "医疗方案等情况，"
 },
 {
  "content": "并取得其明确同意"
 },
 {
  "content": "。如果医院术前"
 },
 {
  "content": "未说明风险，"
 },
 {
  "content": "即使患者签了"
 },
 {
  "content": "字，也属于"
 },
 {
  "content": "未尽到法定的"
 },
 {
  "content": "说明告知义务，"
 },
 {
  "content": "该签字不能代表"
 },
 {
  "content": "患者真正行使了"
 },
 {
  "content": "知情同意权。"
 },
 {
  "content": "\n第二，医院"
 },
 {
  "content": "不能仅凭签字"
 },
 {
  "content": "免除责任。根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十八条，"
 },
 {
  "content": "医疗损害责任适用"
 },
 {
  "content": "过错责任原则，"
 },
 {
  "content": "医院未说明风险"
 },
 {
  "content": "即存在过错。"
 },
 {
  "content": "同时，根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "二十一条，若"
 },
 {
  "content": "医务人员在诊疗活动中"
 },
 {
  "content": "未尽到与当时的"
 },
 {
  "content": "医疗水平相应的诊疗"
 },
 {
  "content": "义务，造成患者"
 },
 {
  "content": "损害的，医疗机构"
 },
 {
  "content": "应当承担赔偿责任。"
 },
 {
  "content": "\n第三，关于"
 },
 {
  "content": "术后后遗症的"
 },
 {
  "content": "因果关系与免责"
 },
 {
  "content": "。后遗症是否属于"
 },
 {
  "content": "可避免的损害"
 },
 {
  "content": "，以及未告知"
 },
 {
  "content": "风险与后遗症之间"
 },
 {
  "content": "是否存在因果关系，"
 },
 {
  "content": "是判定医院责任"
 },
 {
  "content": "大小的关键。根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百二十四条，"
 },
 {
  "content": "限于当时的医疗水平"
 },
 {
  "content": "难以诊疗的，"
 },
 {
  "content": "医疗机构不承担赔偿责任。"
 },
 {
  "content": "如果后遗症是现有"
 },
 {
  "content": "医疗水平下"
 },
 {
  "content": "难以完全避免的"
 },
 {
  "content": "并发症，且医院"
 },
 {
  "content": "在诊疗操作上"
 },
 {
  "content": "无过错，医院"
 },
 {
  "content": "可能不承担责任；"
 },
 {
  "content": "但如果未告知风险"
 },
 {
  "content": "导致患者丧失了"
 },
 {
  "content": "选择是否手术的机会"
 },
 {
  "content": "，或者后遗症是因"
 },
 {
  "content": "手术操作不当所致"
 },
 {
  "content": "，医院则需"
 },
 {
  "content": "承担相应赔偿责任。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n医院“"
 },
 {
  "content": "签字了就没责任"
 },
 {
  "content": "”的说法没有法律"
 },
 {
  "content": "依据。术前未"
 },
 {
  "content": "说明风险违反了法定"
 },
 {
  "content": "告知义务，医院"
 },
 {
  "content": "存在过错。患者"
 },
 {
  "content": "术后留下后遗症，"
 },
 {
  "content": "若该损害与"
 },
 {
  "content": "医疗过错存在因果"
 },
 {
  "content": "关系，医院应当"
 },
 {
  "content": "承担赔偿责任。建议"
 },
 {
  "content": "患者及时复印并"
 },
 {
  "content": "封存病历（依据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百二十五条），"
 },
 {
  "content": "通过医疗损害鉴定"
 },
 {
  "content": "明确后遗症与医疗"
 },
 {
  "content": "行为之间的因果关系"
 },
 {
  "content": "及原因力大小"
 },
 {
  "content": "，进而依法维权"
 },
 {
  "content": "。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
