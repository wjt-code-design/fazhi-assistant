 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "第一款规定：“劳动合同"
 },
 {
  "content": "期限三个月以上不满"
 },
 {
  "content": "一年的，试用期不得超过"
 },
 {
  "content": "一个月；劳动合同期限"
 },
 {
  "content": "一年以上"
 },
 {
  "content": "不满三年的，试用期"
 },
 {
  "content": "不得超过二个月；"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "。”\n\n**分析"
 },
 {
  "content": "说明"
 },
 {
  "content": "：**\n1."
 },
 {
  "content": " 题目"
 },
 {
  "content": "中公司与"
 },
 {
  "content": "员工签订的劳动合同"
 },
 {
  "content": "期限为三年，属于"
 },
 {
  "content": "“三年以上固定"
 },
 {
  "content": "期限劳动合同"
 },
 {
  "content": "”。"
 },
 {
  "content": "\n2. "
 },
 {
  "content": "法律"
 },
 {
  "content": "针对"
 },
 {
  "content": "此类合同规定的试用期"
 },
 {
  "content": "上限为六个月，"
 },
 {
  "content": "公司约定的试用期正好"
 },
 {
  "content": "为六个月，未"
 },
 {
  "content": "超过法定最高"
 },
 {
  "content": "限制"
 },
 {
  "content": "。\n3."
 },
 {
  "content": " 此外，该"
 },
 {
  "content": "约定属于第一次"
 },
 {
  "content": "约定试用期"
 },
 {
  "content": "，符合"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第二款“同一"
 },
 {
  "content": "用人单位与同一劳动者"
 },
 {
  "content": "只能约定一次试用期"
 },
 {
  "content": "”的规定。\n\n"
 },
 {
  "content": "因此，公司与"
 },
 {
  "content": "员工在"
 },
 {
  "content": "三年期劳动合同中"
 },
 {
  "content": "约定六个月试用期，"
 },
 {
  "content": "符合"
 },
 {
  "content": "法律规定，属于"
 },
 {
  "content": "合法有效的"
 },
 {
