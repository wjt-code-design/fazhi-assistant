[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n消费者在"
 },
 {
  "content": "健身房办卡后"
 },
 {
  "content": "，健身房关门停业"
 },
 {
  "content": "，消费者要求退款"
 },
 {
  "content": "，但合同中"
 },
 {
  "content": "写明“概"
 },
 {
  "content": "不退款”。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "健身房单"
 },
 {
  "content": "方制定的“概"
 },
 {
  "content": "不退款”条款"
 },
 {
  "content": "是否有效？"
 },
 {
  "content": "消费者是否有权要求"
 },
 {
  "content": "退还剩余费用？"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第四百九十六条"
 },
 {
  "content": "，格式条款是"
 },
 {
  "content": "当事人为了重复使用"
 },
 {
  "content": "而预先拟定，"
 },
 {
  "content": "并在订立合同时"
 },
 {
  "content": "未与对方协商"
 },
 {
  "content": "的条款。\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第四百九十七条，"
 },
 {
  "content": "提供格式条款一方"
 },
 {
  "content": "不合理地免除或者"
 },
 {
  "content": "减轻其责任、"
 },
 {
  "content": "加重对方责任、"
 },
 {
  "content": "限制对方主要权利"
 },
 {
  "content": "或排除对方主要"
 },
 {
  "content": "权利的，该格式"
 },
 {
  "content": "条款无效。\n"
 },
 {
  "content": "根据《消费者权益保护法"
 },
 {
  "content": "》第二十六条，经营者"
 },
 {
  "content": "不得以格式条款等方式"
 },
 {
  "content": "作出排除或者限制"
 },
 {
  "content": "消费者权利、减轻"
 },
 {
  "content": "或者免除经营者责任"
 },
 {
  "content": "等对消费者不公平"
 },
 {
  "content": "、不合理的规定；"
 },
 {
  "content": "含有该内容的，"
 },
 {
  "content": "其内容无效。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款属于格式条款"
 },
 {
  "content": "。健身房为了重复"
 },
 {
  "content": "使用预先拟定，"
 },
 {
  "content": "未与消费者协商"
 },
 {
  "content": "，符合格式条款"
 },
 {
  "content": "的特征。\n其次"
 },
 {
  "content": "，健身房关门停业"
 },
 {
  "content": "，导致消费者"
 },
 {
  "content": "无法继续接受健身"
 },
 {
  "content": "服务，合同目的"
 },
 {
  "content": "已无法实现，"
 },
 {
  "content": "构成根本违约。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百六十三条及"
 },
 {
  "content": "第五百七十七条，"
 },
 {
  "content": "消费者有权解除合同"
 },
 {
  "content": "并要求"
 },
 {
  "content": "退还剩余费用、"
 },
 {
  "content": "赔偿损失。\n"
 },
 {
  "content": "最后，“概不"
 },
 {
  "content": "退款”条款排"
 },
 {
  "content": "除了消费者在经营者"
 },
 {
  "content": "违约时要求"
 },
 {
  "content": "退款的主要权利，"
 },
 {
  "content": "免除了经营者自身的"
 },
 {
  "content": "退款责任。根据"
 },
 {
  "content": "前述法律规定"
 },
 {
  "content": "，该条款属于"
 },
 {
  "content": "不合理地限制消费者"
 },
 {
  "content": "主要权利、免除"
 },
 {
  "content": "经营者责任的情形，"
 },
 {
  "content": "依法应当认定为"
 },
 {
  "content": "无效。健身房"
 },
 {
  "content": "不能以此无效"
 },
 {
  "content": "条款拒绝退款。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "合同中的“概"
 },
 {
  "content": "不退款”条款"
 },
 {
  "content": "无效，消费者有权"
 },
 {
  "content": "要求健身房退还剩余"
 },
 {
  "content": "费用。\n风险"
 },
 {
  "content": "提示：虽然法律"
 },
 {
  "content": "上消费者处于"
 },
 {
  "content": "有利地位，但"
 },
 {
  "content": "实务中健身房"
 },
 {
  "content": "关门往往伴随着"
 },
 {
  "content": "经营者跑路"
 },
 {
  "content": "或资不抵"
 },
 {
  "content": "债，消费者即使"
 },
 {
  "content": "胜诉也可能面临"
 },
 {
  "content": "执行难"
 },
 {
  "content": "的风险。建议消费者"
 },
 {
  "content": "妥善保留合同"
 },
 {
  "content": "、付款凭证等"
 },
 {
  "content": "证据，及时向"
 },
 {
  "content": "市场监管部门投诉或"
 },
 {
  "content": "向法院"
 },
 {
  "content": "提起诉讼，并尽可能"
 },
 {
  "content": "申请财产保全。"
 },
