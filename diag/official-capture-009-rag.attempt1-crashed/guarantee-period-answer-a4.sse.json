 {
  "content": "保证期间认定为主"
 },
 {
  "content": "债务履行期限届满之日起六个月。\n\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第六百九十二条第二款"
 },
 {
  "content": "的规定，债权人与"
 },
 {
  "content": "保证人可以约定保证"
 },
 {
  "content": "期间，但是约定的"
 },
 {
  "content": "保证期间早于"
 },
 {
  "content": "主债务履行期限"
 },
 {
  "content": "或者与主债务"
 },
 {
  "content": "履行期限同时届满"
 },
 {
  "content": "的，视为没有"
 },
 {
  "content": "约定；没有约定"
 },
 {
  "content": "或者约定不明确的"
 },
 {
  "content": "，保证期间为主"
 },
 {
  "content": "债务履行期限届满"
 },
 {
  "content": "之日起六个月。\n\n"
 },
 {
  "content": "合同中“"
 },
 {
  "content": "承担保证责任直至"
 },
 {
  "content": "借款本息还"
 },
 {
  "content": "清为止”的"
 },
 {
  "content": "约定，属于对"
 },
 {
  "content": "保证期间的约定不"
 },
 {
  "content": "明确。"
 },
 {
  "content": "因为借款"
 },
 {
  "content": "本息还清"
 },
 {
  "content": "的时间点具有不确定性"
 },
 {
  "content": "，无法明确具体的"
 },
 {
  "content": "保证期间截止点"
 },
 {
  "content": "，故应适用"
 },
 {
  "content": "上述“约定不"
 },
 {
  "content": "明确”的规定，"
 },
 {
  "content": "认定保证"
 },
 {
  "content": "期间为六个月。"
 },
 {
  "content": "\n\n重要：债权人"
 },
 {
  "content": "需特别注意在主债务"
 },
 {
  "content": "履行期限届满之日起"
 },
 {
  "content": "六个月内向保证"
 },
 {
  "content": "人主张权利。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第六百九十三条的规定"
 },
 {
  "content": "，若未在此期间"
 },
 {
  "content": "主张，保证人"
 },
 {
  "content": "可能不再承担保证"
 },
 {
  "content": "责任。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
