 {
  "content": "案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案中，房屋"
 },
 {
  "content": "买卖总价款为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，双方约定的定金"
 },
 {
  "content": "数额高达"
 },
 {
  "content": "80万元。"
 },
 {
  "content": "核心争议焦点在于"
 },
 {
  "content": "：该定金条款"
 },
 {
  "content": "的效力如何认定"
 },
 {
  "content": "，以及超出法定"
 },
 {
  "content": "比例部分的定金如何处理"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条规定，定"
 },
 {
  "content": "金的数额由当事人"
 },
 {
  "content": "约定，但"
 },
 {
  "content": "不得超过主合同标的"
 },
 {
  "content": "额的百分之二十，"
 },
 {
  "content": "超过部分不产生"
 },
 {
  "content": "定金的效力。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "计算法定定金"
 },
 {
  "content": "上限。本案房屋"
 },
 {
  "content": "总价款为1"
 },
 {
  "content": "00万元，"
 },
 {
  "content": "按百分之二十计算"
 },
 {
  "content": "，定金的法定"
 },
 {
  "content": "上限为20"
 },
 {
  "content": "万元。\n其次"
 },
 {
  "content": "，认定条款效力"
 },
 {
  "content": "。双方约定的8"
 },
 {
  "content": "0万元定金中"
 },
 {
  "content": "，20万元"
 },
 {
  "content": "未超过"
 },
 {
  "content": "法定上限，该"
 },
 {
  "content": "部分定金合法有效"
 },
 {
  "content": "，产生定金效力"
 },
 {
  "content": "，适用定金罚"
 },
 {
  "content": "则。\n最后"
 },
 {
  "content": "，处理超出"
 },
 {
  "content": "部分。约定的8"
 },
 {
  "content": "0万元定金中"
 },
 {
  "content": "，超出法定上限"
 },
 {
  "content": "的60万元"
 },
 {
  "content": "部分，依法不"
 },
 {
  "content": "产生定金的效力"
 },
 {
  "content": "。该60"
 },
 {
  "content": "万元不能适用定金"
 },
 {
  "content": "罚则，若"
 },
 {
  "content": "发生违约，收受"
 },
 {
  "content": "方仅需返还该"
 },
 {
  "content": "60万元本金"
 },
 {
  "content": "，而无法"
 },
 {
  "content": "适用双倍返还的规则"
 },
 {
  "content": "。该部分"
 },
 {
  "content": "款项的性质通常可能被"
 },
 {
  "content": "认定为预付款或不当"
 },
 {
  "content": "得利，应当予以"
 },
 {
  "content": "返还。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：该定金"
 },
 {
  "content": "条款属于部分有效"
 },
 {
  "content": "、部分无效。"
 },
 {
  "content": "20万元以内的"
 },
 {
  "content": "部分有效"
 },
 {
  "content": "，产生定金效力"
 },
 {
  "content": "；超"
 },
 {
  "content": "出的60万元"
 },
 {
  "content": "部分无效，不"
 },
 {
  "content": "产生定金效力。"
 },
 {
  "content": "\n风险提示"
 },
 {
  "content": "：若卖方违约"
 },
 {
  "content": "，买方仅"
 },
 {
  "content": "能就20"
 },
 {
  "content": "万元主张双倍返还"
 },
 {
  "content": "（合计40"
 },
 {
  "content": "万元），对于6"
 },
 {
  "content": "0万元部分只能"
 },
 {
  "content": "要求返还本金，"
 },
 {
  "content": "无法获得额外的"
 },
 {
  "content": "定金惩罚性"
 },
 {
  "content": "赔偿。建议在购房"
 },
 {
  "content": "交易中合理约定定金"
 },
 {
  "content": "数额，避免因"
 },
 {
  "content": "超过法定上限导致"
 },
 {
  "content": "定金罚则无法"
 },
 {
  "content": "完全适用，从而"
