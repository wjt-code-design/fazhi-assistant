[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，公司对外"
 },
 {
  "content": "欠付"
 },
 {
  "content": "货款，法定代表人要求"
 },
 {
  "content": "股东个人先签署"
 },
 {
  "content": "承诺。核心"
 },
 {
  "content": "争议焦点"
 },
 {
  "content": "在于：供应商能否"
 },
 {
  "content": "突破公司的"
 },
 {
  "content": "法人独立地位"
 },
 {
  "content": "直接"
 },
 {
  "content": "起诉股东，以及"
 },
 {
  "content": "股东签署的承诺"
 },
 {
  "content": "将产生何种法律"
 },
 {
  "content": "后果"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "公司法》第二十三条关于"
 },
 {
  "content": "法人人格否认的规定"
 },
 {
  "content": "，"
 },
 {
  "content": "以及《民法典》"
 },
 {
  "content": "第五百零二"
 },
 {
  "content": "条、"
 },
 {
  "content": "第五百七十七条关于"
 },
 {
  "content": "合同效力"
 },
 {
  "content": "与违约责任的规定"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，公司具有"
 },
 {
  "content": "独立的法人资格"
 },
 {
  "content": "，原则上应"
 },
 {
  "content": "以其全部财产对"
 },
 {
  "content": "公司的债务承担责任，"
 },
 {
  "content": "股东仅以其认"
 },
 {
  "content": "缴的出资额为"
 },
 {
  "content": "限对公司承担责任。"
 },
 {
  "content": "因此，一般情况下，"
 },
 {
  "content": "供应商不能仅因"
 },
 {
  "content": "公司欠款而"
 },
 {
  "content": "直接起诉股东要求"
 },
 {
  "content": "其承担还款责任"
 },
 {
  "content": "。\n\n"
 },
 {
  "content": "其次，根据《"
 },
 {
  "content": "公司法》第二十三条，"
 },
 {
  "content": "存在两种例外情形"
 },
 {
  "content": "：一是公司"
 },
 {
  "content": "股东滥用公司法人"
 },
 {
  "content": "独立地位和股东"
 },
 {
  "content": "有限责任，逃避债务"
 },
 {
  "content": "，严重损害公司"
 },
 {
  "content": "债权人利益的，应当"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "责任；二"
 },
 {
  "content": "是一人有限责任公司中"
 },
 {
  "content": "，股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己的财产的"
 },
 {
  "content": "，应当对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "若供应商有确切"
 },
 {
  "content": "证据证明股东存在"
 },
 {
  "content": "上述滥用"
 },
 {
  "content": "行为（如转移"
 },
 {
  "content": "公司资产"
 },
 {
  "content": "、财务"
 },
 {
  "content": "混"
 },
 {
  "content": "同等逃避"
 },
 {
  "content": "债务），则"
 },
 {
  "content": "可以直接起诉股东要求"
 },
 {
  "content": "其承担连带责任"
 },
 {
  "content": "。\n\n最后，"
 },
 {
  "content": "关于股东签署承诺"
 },
 {
  "content": "的问题。法定代表人要求"
 },
 {
  "content": "股东个人签署"
 },
 {
  "content": "承诺，需"
 },
 {
  "content": "审查承诺的具体内容"
 },
 {
  "content": "。如果承诺"
 },
 {
  "content": "内容构成债务"
 },
 {
  "content": "加入或者保证担保"
 },
 {
  "content": "，则"
 },
 {
  "content": "该承诺属于"
 },
 {
  "content": "双方"
 },
 {
  "content": "当事人的真实"
 },
 {
  "content": "意思表示，"
 },
 {
  "content": "根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "零二条，"
 },
 {
  "content": "依法成立的合同自"
 },
 {
  "content": "成立时生效。"
 },
 {
  "content": "一旦承诺"
 },
 {
  "content": "生效，该股东"
 },
 {
  "content": "将依据该承诺"
 },
 {
  "content": "承担相应的清偿"
 },
 {
  "content": "责任。供应商"
 },
 {
  "content": "可以"
 },
 {
  "content": "依据该承诺及"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "七十七条关于违约"
 },
 {
  "content": "责任的规定，直接"
 },
 {
  "content": "起诉该股东。"
 },
 {
  "content": "\n\n④结论与风险\n供应商能否"
 },
 {
  "content": "直接起诉股东，"
 },
 {
  "content": "需结合具体案情"
 },
 {
  "content": "判断。若不存在"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "规定的滥用法人独立"
 },
 {
  "content": "地位情形，且"
 },
 {
  "content": "股东未签署承诺"
 },
 {
  "content": "或承诺"
 },
 {
  "content": "内容不构成债务"
 },
 {
  "content": "加入、"
 },
 {
  "content": "保证担保"
 },
 {
  "content": "，则供应商难以"
 },
 {
  "content": "直接起诉股东。"
 },
 {
  "content": "反之，若存在"
 },
 {
  "content": "滥用情形"
 },
 {
  "content": "或签署了合法"
 },
 {
  "content": "有效的承诺，则"
 },
 {
  "content": "存在"
 },
 {
  "content": "起诉并获得"
 },
 {
  "content": "支持的风险"
 },
 {
  "content": "。建议供应商审查"
 },
 {
  "content": "股东签署"
 },
 {
  "content": "的承诺文件内容"
 },
 {
  "content": "，并搜集是否存在"
 },
 {
  "content": "财产混同或"
 },
 {
  "content": "逃避债务的证据。"
 },
