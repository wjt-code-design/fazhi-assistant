 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n父亲"
 },
 {
  "content": "去世时遗留有"
 },
 {
  "content": "房产及信用卡欠款"
 },
 {
  "content": "。本案争议焦点"
 },
 {
  "content": "为：子女是否"
 },
 {
  "content": "必须以个人固有"
 },
 {
  "content": "财产偿还父亲生"
 },
 {
  "content": "前的信用卡欠款。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千一百二十二"
 },
 {
  "content": "条、第一千一百"
 },
 {
  "content": "六十一条、第一千"
 },
 {
  "content": "一百六十三条，"
 },
 {
  "content": "以及《民事诉讼法"
 },
 {
  "content": "》第二百四十三条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "我国法律"
 },
 {
  "content": "确立的是"
 },
 {
  "content": "“"
 },
 {
  "content": "限定继承”原则"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条，继承人以"
 },
 {
  "content": "所得遗产实际价值"
 },
 {
  "content": "为限清偿被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "。超过"
 },
 {
  "content": "遗产实际价值部分"
 },
 {
  "content": "，继承人自愿偿还"
 },
 {
  "content": "的不在此限。"
 },
 {
  "content": "因此，子女仅在"
 },
 {
  "content": "继承遗产的价值范围内"
 },
 {
  "content": "承担清偿责任，"
 },
 {
  "content": "对于超过"
 },
 {
  "content": "遗产价值的"
 },
 {
  "content": "信用卡欠款，子女"
 },
 {
  "content": "并非必须拿自己的"
 },
 {
  "content": "钱偿还。"
 },
 {
  "content": "\n"
 },
 {
  "content": "第二，子女享有"
 },
 {
  "content": "放弃继承的权利。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十一条"
 },
 {
  "content": "第二款，继承人放弃"
 },
 {
  "content": "继承的，对被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。若子女不愿"
 },
 {
  "content": "承担"
 },
 {
  "content": "债务风险"
 },
 {
  "content": "，可以选择放弃继承"
 },
 {
  "content": "父亲的房产，从而"
 },
 {
  "content": "免除清偿"
 },
 {
  "content": "义务。\n第三"
 },
 {
  "content": "，遗产是清偿"
 },
 {
  "content": "债务的首要来源"
 },
 {
  "content": "。父亲的房子属于"
 },
 {
  "content": "其死亡"
 },
 {
  "content": "时遗留的个人合法"
 },
 {
  "content": "财产，即遗产"
 },
 {
  "content": "（依据《民法典"
 },
 {
  "content": "》第一千一百二十二"
 },
 {
  "content": "条）。该房产"
 },
 {
  "content": "应首先用于清偿"
 },
 {
  "content": "信用卡欠款。若"
 },
 {
  "content": "存在多种"
 },
 {
  "content": "继承方式，根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十三条，"
 },
 {
  "content": "先"
 },
 {
  "content": "由法定继承人以"
 },
 {
  "content": "所得遗产清偿，"
 },
 {
  "content": "不足部分再由遗嘱"
 },
 {
  "content": "继承人和受遗"
 },
 {
  "content": "赠人按比例以"
 },
 {
  "content": "所得遗产清偿。"
 },
 {
  "content": "\n第四，执行"
 },
 {
  "content": "程序亦遵循"
 },
 {
  "content": "遗产偿债原则。"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第二百四十三条，"
 },
 {
  "content": "作为被执行人的公民"
 },
 {
  "content": "死亡的，以其遗产"
 },
 {
  "content": "偿还债务，这"
 },
 {
  "content": "进一步明确了债务不"
 },
 {
  "content": "当然由"
 },
 {
  "content": "继承人个人财产承担"
 },
 {
  "content": "。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "子女并非必须拿"
 },
 {
  "content": "自己的钱偿还父亲的"
 },
 {
  "content": "信用卡欠款，仅在"
 },
 {
  "content": "继承遗产价值"
 },
 {
  "content": "范围内承担责任，或"
 },
 {
  "content": "可通过"
 },
 {
  "content": "选择"
 },
 {
  "content": "放弃继承以免"
 },
 {
  "content": "责。\n风险"
 },
 {
  "content": "提示：若子女"
 },
 {
  "content": "已实际继承遗产"
 },
 {
  "content": "却未在遗产"
 },
 {
  "content": "范围内清偿债务，"
 },
 {
  "content": "债权人有权提起诉讼要求"
 },
 {
  "content": "其在继承遗产实际"
 },
 {
  "content": "价值内偿还；"
 },
 {
  "content": "若存在恶意转移"
 },
 {
  "content": "遗产以逃避债务"
 },
 {
  "content": "的行为，可能面临"
 },
 {
  "content": "相应的法律风险。"
 },
 {
  "content": "\n\n本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
