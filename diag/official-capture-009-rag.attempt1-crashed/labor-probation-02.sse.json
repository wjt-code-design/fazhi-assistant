[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "本案涉及"
 },
 {
  "content": "劳动合同试用期的约定"
 },
 {
  "content": "及延长问题，"
 },
 {
  "content": "具体分析如下："
 },
 {
  "content": "\n\n① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "公司与劳动者"
 },
 {
  "content": "签订三年期"
 },
 {
  "content": "劳动合同，约定试用期"
 },
 {
  "content": "六个月，后又延长"
 },
 {
  "content": "两个月。核心"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "公司延长试用"
 },
 {
  "content": "期的行为是否合法，以及违法延长"
 },
 {
  "content": "试用期需承担何种"
 },
 {
  "content": "法律后果。\n\n"
 },
 {
  "content": "② 法律依据"
 },
 {
  "content": "与逐项论证"
 },
 {
  "content": "\n首先，关于"
 },
 {
  "content": "试用期上限及"
 },
 {
  "content": "次数。根据《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "，三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月；同一用人单位"
 },
 {
  "content": "与同一劳动者只能"
 },
 {
  "content": "约定一次试用期。"
 },
 {
  "content": "本案中，三年"
 },
 {
  "content": "期合同约定六个月试用期"
 },
 {
  "content": "本身符合"
 },
 {
  "content": "法律规定，但公司"
 },
 {
  "content": "再行延长两个月，"
 },
 {
  "content": "导致实际试用期长达"
 },
 {
  "content": "八个月，超出了"
 },
 {
  "content": "六个月的法定上限"
 },
 {
  "content": "，且实质"
 },
 {
  "content": "上构成了对试用"
 },
 {
  "content": "期的再次约定，"
 },
 {
  "content": "违反了“只能约定"
 },
 {
  "content": "一次试用期”的"
 },
 {
  "content": "强制性规定。\n\n"
 },
 {
  "content": "其次，关于合同"
 },
 {
  "content": "变更的原则。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第三条，订立劳动合同"
 },
 {
  "content": "应当遵循平等"
 },
 {
  "content": "自愿、协商一致"
 },
 {
  "content": "的原则"
 },
 {
  "content": "。试用期属于"
 },
 {
  "content": "劳动合同的重要条款，"
 },
 {
  "content": "其变更需双方"
 },
 {
  "content": "协商一致。公司"
 },
 {
  "content": "单方面"
 },
 {
  "content": "决定"
 },
 {
  "content": "延长两个月，未"
 },
 {
  "content": "与劳动者协商"
 },
 {
  "content": "一致，违反了"
 },
 {
  "content": "协商一致原则。"
 },
 {
  "content": "\n\n最后，关于"
 },
 {
  "content": "违法试用期的法律"
 },
 {
  "content": "后果。根据《"
 },
 {
  "content": "劳动合同法》第八"
 },
 {
  "content": "十三条，用人单位违反"
 },
 {
  "content": "本法规定与劳动者"
 },
 {
  "content": "约定试用期的，"
 },
 {
  "content": "由劳动行政部门责令改正"
 },
 {
  "content": "；违法约定的试用期"
 },
 {
  "content": "已经履行的，"
 },
 {
  "content": "由用人单位以劳动者"
 },
 {
  "content": "试用期满月工资为标准"
 },
 {
  "content": "，按已经履"
 },
 {
  "content": "行的超过法定试用"
 },
 {
  "content": "期的期间向劳动者"
 },
 {
  "content": "支付赔偿金。"
 },
 {
  "content": "\n\n③ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：公司延长两个月"
 },
 {
  "content": "试用期的行为违法"
 },
 {
  "content": "。\n\n风险提示"
 },
 {
  "content": "：对于劳动者而言"
 },
 {
  "content": "，超期的两个月"
 },
 {
  "content": "属于违法"
 },
 {
  "content": "试用期，劳动者有权"
 },
 {
  "content": "要求公司按试用期"
 },
 {
  "content": "满月工资标准支付"
 },
 {
  "content": "该期间的赔偿金"
 },
 {
  "content": "。对于用人单位而言"
 },
 {
  "content": "，单方面延长"
 },
 {
  "content": "试用期不仅面临支付"
 },
 {
  "content": "赔偿金的风险，"
 },
 {
  "content": "还可能因违反协商"
 },
 {
  "content": "一致原则引发劳动争议"
 },
 {
  "content": "，存在败"
 },
 {
  "content": "诉风险。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
