 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "该定金条款"
 },
 {
  "content": "并非全部有效。"
 },
 {
  "content": "其中20万元"
 },
 {
  "content": "的部分产生定金效力"
 },
 {
  "content": "，超过的6"
 },
 {
  "content": "0万元部分不"
 },
 {
  "content": "产生定金效力。"
 },
 {
  "content": "\n\n根据《民法典"
 },
 {
  "content": "》第五百八十六条"
 },
 {
  "content": "，定金的数额"
 },
 {
  "content": "由当事人约定，"
 },
 {
  "content": "但是不得超过主合同"
 },
 {
  "content": "标的额的百分之二十"
 },
 {
  "content": "，超过部分不"
 },
 {
  "content": "产生定金的效力"
 },
 {
  "content": "。\n\n本案中"
 },
 {
  "content": "，房屋总价款"
 },
 {
  "content": "为100"
 },
 {
  "content": "万元，其百分之"
 },
 {
  "content": "二十为20"
 },
 {
  "content": "万元。双方约定"
 },
 {
  "content": "定金80万元"
 },
 {
  "content": "，已超出法定"
 },
 {
  "content": "上限。因此，"
 },
 {
  "content": "仅有20万元"
 },
 {
  "content": "适用定金罚则"
 },
 {
  "content": "，超出的6"
 },
 {
  "content": "0万元不产生"
 },
 {
  "content": "定金效力。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
