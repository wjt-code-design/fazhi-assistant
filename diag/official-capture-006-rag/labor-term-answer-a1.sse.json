 {
  "content": "合法"
 },
 {
  "content": "。\n\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第一款规定：“"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "。”三年"
 },
 {
  "content": "期劳动合同属于“"
 },
 {
  "content": "三年以上固定期限”"
 },
 {
  "content": "的"
 },
 {
  "content": "劳动合同"
 },
 {
  "content": "，约定"
 },
 {
  "content": "六个月"
 },
 {
  "content": "试用期正好符合"
 },
 {
  "content": "法定上限，未"
 },
 {
  "content": "超过法律规定"
 },
 {
  "content": "。\n\n同时，"
 },
 {
  "content": "该约定属于"
 },
 {
  "content": "第一次"
 },
 {
  "content": "约定试用期，也"
 },
 {
  "content": "符合《劳动合同法"
 },
 {
  "content": "》第十九条第二款“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”的要求。"
 },
 {
  "content": "\n\n因此，公司与"
 },
 {
  "content": "员工在"
 },
 {
  "content": "三年期劳动合同中"
 },
 {
  "content": "约定"
 },
 {
  "content": "六个月试用期，符合"
 },
 {
  "content": "法律规定。\n\n本答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
