 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "您骑电动车被"
 },
 {
  "content": "右转货车撞伤"
 },
 {
  "content": "，货车方以"
 },
 {
  "content": "您未戴头盔"
 },
 {
  "content": "为由拒绝赔偿。"
 },
 {
  "content": "本案争议焦点在于"
 },
 {
  "content": "：受害人"
 },
 {
  "content": "未戴头盔是否"
 },
 {
  "content": "导致侵权人完全"
 },
 {
  "content": "免除赔偿责任。\n\n"
 },
 {
  "content": "② 法律依据"
 },
 {
  "content": "\n《道路交通安全法"
 },
 {
  "content": "》第五十一条、《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "七十四条、《民法典"
 },
 {
  "content": "》第一千一百八"
 },
 {
  "content": "十六条、《民法典》第一千二百一十三条"
 },
 {
  "content": "、《道路交通安全法》"
 },
 {
  "content": "第七十四条。\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "货车方“不"
 },
 {
  "content": "赔”的理由不"
 },
 {
  "content": "成立。根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "七十四条，仅"
 },
 {
  "content": "当损害是因受害人"
 },
 {
  "content": "故意造成时，"
 },
 {
  "content": "行为人才不承担责任"
 },
 {
  "content": "。您未戴"
 },
 {
  "content": "头盔属于违反《"
 },
 {
  "content": "道路交通安全法》第五"
 },
 {
  "content": "十一条的过失行为"
 },
 {
  "content": "，并非故意造成"
 },
 {
  "content": "交通事故"
 },
 {
  "content": "，因此不能依据"
 },
 {
  "content": "该条"
 },
 {
  "content": "免除货车"
 },
 {
  "content": "方的赔偿责任。\n"
 },
 {
  "content": "第二，未戴"
 },
 {
  "content": "头盔存在过错，"
 },
 {
  "content": "可能减轻对方责任"
 },
 {
  "content": "，但不"
 },
 {
  "content": "导致全免"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百八"
 },
 {
  "content": "十六条体现的公平"
 },
 {
  "content": "及"
 },
 {
  "content": "过错责任"
 },
 {
  "content": "法"
 },
 {
  "content": "理，受害"
 },
 {
  "content": "人对损害的发生"
 },
 {
  "content": "也有"
 },
 {
  "content": "过错的，可以"
 },
 {
  "content": "减轻侵权人的责任"
 },
 {
  "content": "。未戴头盔"
 },
 {
  "content": "违反了安全规定"
 },
 {
  "content": "，该过错主要体现在"
 },
 {
  "content": "对自身损害（"
 },
 {
  "content": "尤其是头部伤害）"
 },
 {
  "content": "的扩大上。"
 },
 {
  "content": "在双方均有过错"
 },
 {
  "content": "的情况下，应按过错"
 },
 {
  "content": "比例分担损失"
 },
 {
  "content": "，而非一方完全不"
 },
 {
  "content": "赔。\n第三"
 },
 {
  "content": "，赔偿顺位"
 },
 {
  "content": "有法定"
 },
 {
  "content": "保障。根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条，应"
 },
 {
  "content": "先由货车交"
 },
 {
  "content": "强险在责任"
 },
 {
  "content": "限额内予以赔偿"
 },
 {
  "content": "；不足部分，"
 },
 {
  "content": "由商业险"
 },
 {
  "content": "或货车方赔偿"
 },
 {
  "content": "。交强险"
 },
 {
  "content": "赔付"
 },
 {
  "content": "通常不"
 },
 {
  "content": "因受害人一般"
 },
 {
  "content": "过失而免责，"
 },
 {
  "content": "商业险或侵权"
 },
 {
  "content": "人最终"
 },
 {
  "content": "承担"
 },
 {
  "content": "的部分"
 },
 {
  "content": "则会根据"
 },
 {
  "content": "双方过错程度"
 },
 {
  "content": "进行"
 },
 {
  "content": "划分。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：货车"
 },
 {
  "content": "方无权因"
 },
 {
  "content": "您未戴头盔"
 },
 {
  "content": "而拒绝全部赔偿"
 },
 {
  "content": "，您有权主张"
 },
 {
  "content": "医疗费、误"
 },
 {
  "content": "工费等合理"
 },
 {
  "content": "损失。\n风险"
 },
 {
  "content": "：存在法律不确定性"
 },
 {
  "content": "。未戴头盔"
 },
 {
  "content": "的过错可能导致您在"
 },
 {
  "content": "主张赔偿时被"
 },
 {
  "content": "减轻部分责任，"
 },
 {
  "content": "具体减轻比例需"
 },
 {
  "content": "结合未戴头盔"
 },
 {
  "content": "与损害后果（"
 },
 {
  "content": "如头部伤情"
 },
 {
  "content": "加重）之间的因果"
 },
 {
  "content": "关系由裁判机关"
 },
 {
  "content": "认定。建议您及时"
 },
 {
  "content": "报警获取"
 },
 {
  "content": "事故认定书，"
 },
 {
  "content": "并根据《道路交通安全法"
 },
 {
  "content": "》第七十四条通过"
 },
 {
  "content": "交"
 },
 {
  "content": "管部门调解或"
 },
 {
  "content": "向人民法院"
 },
 {
  "content": "起诉维权。本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
