[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世时留有"
 },
 {
  "content": "房产和信用卡欠款"
 },
 {
  "content": "，核心争议焦点"
 },
 {
  "content": "在于：子女作为"
 },
 {
  "content": "继承人，是否必须"
 },
 {
  "content": "用个人固有"
 },
 {
  "content": "财产来偿还父亲的"
 },
 {
  "content": "信用卡欠款。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百二十二条"
 },
 {
  "content": "，房产属于自然人"
 },
 {
  "content": "死亡时遗留的个人"
 },
 {
  "content": "合法财产，即"
 },
 {
  "content": "遗产。根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条，继承"
 },
 {
  "content": "人以所得遗产实际"
 },
 {
  "content": "价值为限清偿"
 },
 {
  "content": "被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务；超过遗产"
 },
 {
  "content": "实际价值部分，"
 },
 {
  "content": "继承人自愿偿还的不"
 },
 {
  "content": "在此限；继承人"
 },
 {
  "content": "放弃继承的，"
 },
 {
  "content": "对被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务可以不负清偿"
 },
 {
  "content": "责任。根据《"
 },
 {
  "content": "民事诉讼法》第二百四"
 },
 {
  "content": "十三条，作为被执行"
 },
 {
  "content": "人的公民死亡的，"
 },
 {
  "content": "以其遗产偿还债务"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，父亲的信用卡欠款"
 },
 {
  "content": "属于其个人债务"
 },
 {
  "content": "，子女没有"
 },
 {
  "content": "法定的代为偿还"
 },
 {
  "content": "义务。根据限定"
 },
 {
  "content": "继承原则，子女"
 },
 {
  "content": "若选择继承遗产"
 },
 {
  "content": "（房产），则"
 },
 {
  "content": "仅需在继承的"
 },
 {
  "content": "遗产价值范围内承担"
 },
 {
  "content": "债务清偿责任。"
 },
 {
  "content": "如果房产价值低于"
 },
 {
  "content": "信用卡欠款，超出"
 },
 {
  "content": "部分的债务，子女"
 },
 {
  "content": "无需用自己额外的"
 },
 {
  "content": "钱偿还。\n"
 },
 {
  "content": "其次，子女拥有"
 },
 {
  "content": "选择权。如果"
 },
 {
  "content": "子女放弃"
 },
 {
  "content": "继承父亲的房产，"
 },
 {
  "content": "则对父亲的信用卡"
 },
 {
  "content": "欠款可以不负清偿"
 },
 {
  "content": "责任。\n最后"
 },
 {
  "content": "，若子女继承了"
 },
 {
  "content": "房产，债权人有权"
 },
 {
  "content": "就该房产主张"
 },
 {
  "content": "权利，子女需"
 },
 {
  "content": "配合以该"
 },
 {
  "content": "房产变价款"
 },
 {
  "content": "优先受偿，"
 },
 {
  "content": "但变价款超出"
 },
 {
  "content": "债务的部分仍归"
 },
 {
  "content": "子女所有。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：子女"
 },
 {
  "content": "并非必须拿自己的"
 },
 {
  "content": "钱还父亲的信用卡"
 },
 {
  "content": "欠款，仅在继承"
 },
 {
  "content": "遗产价值范围内承担"
 },
 {
  "content": "清偿责任，或"
 },
 {
  "content": "选择放弃继承以免"
 },
 {
  "content": "除责任"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：如果子女继承了"
 },
 {
  "content": "房产，该房产"
 },
 {
  "content": "可能会被用于清偿"
 },
 {
  "content": "债务。此外，"
 },
 {
  "content": "若存在既有法定"
 },
 {
  "content": "继承又有遗嘱继承"
 },
 {
  "content": "的情况，根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十三条，超过"
 },
 {
  "content": "法定继承遗产实际"
 },
 {
  "content": "价值部分，由"
 },
 {
  "content": "遗嘱继承人和受"
 },
 {
  "content": "遗赠人按比例"
 },
 {
  "content": "以所得遗产清偿"
 },
 {
  "content": "，需厘"
 },
 {
  "content": "清继承方式"
 },
 {
  "content": "以确定清偿顺序"
 },
 {
  "content": "。\n\n本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
