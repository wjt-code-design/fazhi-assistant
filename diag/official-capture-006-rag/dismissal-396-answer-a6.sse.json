 {
  "content": "① 案情与"
 },
 {
  "content": "争议焦点\n员工"
 },
 {
  "content": "多次旷工，"
 },
 {
  "content": "公司依据经民主"
 },
 {
  "content": "程序制定且已"
 },
 {
  "content": "公示的规章制度解除"
 },
 {
  "content": "劳动合同，解除前"
 },
 {
  "content": "已通知工会并"
 },
 {
  "content": "留存证据。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "公司以此为由"
 },
 {
  "content": "解除劳动合同，是否需要"
 },
 {
  "content": "向员工支付经济"
 },
 {
  "content": "补偿或赔偿金"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第三十九条第（"
 },
 {
  "content": "二）项、"
 },
 {
  "content": "第四十三条、第四"
 },
 {
  "content": "十六条。\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n第一，关于"
 },
 {
  "content": "解除的实体合法性"
 },
 {
  "content": "。员工多次旷"
 },
 {
  "content": "工属于严重违反"
 },
 {
  "content": "规章制度的情形。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第三十九条第（"
 },
 {
  "content": "二）项，"
 },
 {
  "content": "劳动者严重违反用人"
 },
 {
  "content": "单位的规章制度的，"
 },
 {
  "content": "用人单位可以解除劳动合同"
 },
 {
  "content": "。本案中，"
 },
 {
  "content": "公司规章制度经民主"
 },
 {
  "content": "程序制定并已公示"
 },
 {
  "content": "，满足作为解除"
 },
 {
  "content": "依据"
 },
 {
  "content": "的前提条件。\n"
 },
 {
  "content": "第二，关于解除"
 },
 {
  "content": "的程序合法性。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第四十三条，用人单位"
 },
 {
  "content": "单方解除劳动合同"
 },
 {
  "content": "，应当事先将"
 },
 {
  "content": "理由通知工会。"
 },
 {
  "content": "本案中，公司"
 },
 {
  "content": "解除前已通知"
 },
 {
  "content": "工会并留存证据"
 },
 {
  "content": "，符合法定程序"
 },
 {
  "content": "要求。\n第三"
 },
 {
  "content": "，关于经济补偿"
 },
 {
  "content": "与赔偿金的支付"
 },
 {
  "content": "义务。根据《"
 },
 {
  "content": "劳动合同法》第四"
 },
 {
  "content": "十六条关于用人单位应当"
 },
 {
  "content": "支付经济补偿的"
 },
 {
  "content": "法定情形，其中"
 },
 {
  "content": "并不包含用人单位依据"
 },
 {
  "content": "第三十九条规定解除"
 },
 {
  "content": "劳动合同的情形。因此"
 },
 {
  "content": "，公司无需支付"
 },
 {
  "content": "经济补偿。同时"
 },
 {
  "content": "，由于公司的解除"
 },
 {
  "content": "理由和程序均"
 },
 {
  "content": "符合法律规定，不属于"
 },
 {
  "content": "违法解除，故"
 },
 {
  "content": "亦无需依据《"
 },
 {
  "content": "劳动合同法》第八"
 },
 {
  "content": "十七条支付违法解除"
 },
 {
  "content": "劳动合同的赔偿金"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：公司无需"
 },
 {
  "content": "支付经济补偿或"
 },
 {
  "content": "赔偿金。\n"
 },
 {
  "content": "风险提示：需"
 },
 {
  "content": "确保“多次旷"
 },
 {
  "content": "工”确实达到了"
 },
 {
  "content": "规章制度中明确规定的"
 },
 {
  "content": "“严重违反”"
 },
 {
  "content": "程度，且规章制度"
 },
 {
  "content": "的内容不得违反法律法规"
 },
 {
  "content": "的强制性规定。"
 },
 {
  "content": "若规章制度对“"
 },
 {
  "content": "严重违反"
 },
 {
  "content": "”界定不清或"
 },
 {
  "content": "解除依据"
 },
 {
  "content": "不足，仍存在"
 },
 {
  "content": "被认定为违法解除"
 },
 {
  "content": "的潜在风险。"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
