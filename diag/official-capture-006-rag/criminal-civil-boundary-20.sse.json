 {
  "content": "一、"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n\n"
 },
 {
  "content": "您描述的“卖家"
 },
 {
  "content": "收钱后失联"
 },
 {
  "content": "，聊天记录承诺发货"
 },
 {
  "content": "但实际无货"
 },
 {
  "content": "”的情形，核心"
 },
 {
  "content": "争议焦点在于该"
 },
 {
  "content": "行为究竟属于民事"
 },
 {
  "content": "合同违约或"
 },
 {
  "content": "欺诈，还是刑事"
 },
 {
  "content": "诈骗。这决定了"
 },
 {
  "content": "您应当选择向"
 },
 {
  "content": "公安机关报警，还是"
 },
 {
  "content": "直接向人民法院"
 },
 {
  "content": "提起民事诉讼。\n\n"
 },
 {
  "content": "二、法律依据"
 },
 {
  "content": "\n\n根据《民事诉讼"
 },
 {
  "content": "法》第六十六条"
 },
 {
  "content": "，证据包括当事人的"
 },
 {
  "content": "陈述、书证"
 },
 {
  "content": "、电子数据等"
 },
 {
  "content": "，且"
 },
 {
  "content": "证据必须查证"
 },
 {
  "content": "属实才能作为认定"
 },
 {
  "content": "事实的根据。"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第六十八条，"
 },
 {
  "content": "当事人对自己提出的主"
 },
 {
  "content": "张应当及时提供证据"
 },
 {
  "content": "。根据《民事诉讼"
 },
 {
  "content": "法》第一百零十三条"
 },
 {
  "content": "，可能因当事人"
 },
 {
  "content": "一方的行为或者其他原因"
 },
 {
  "content": "，使判决难以"
 },
 {
  "content": "执行的案件，根据"
 },
 {
  "content": "对方当事人的申请，"
 },
 {
  "content": "可以裁定对其财产"
 },
 {
  "content": "进行保全。\n\n"
 },
 {
  "content": "三、逐项"
 },
 {
  "content": "论证\n\n1."
 },
 {
  "content": " 关于报警（"
 },
 {
  "content": "刑事途径）：如果"
 },
 {
  "content": "卖家在收款"
 },
 {
  "content": "之初就根本没有货物"
 },
 {
  "content": "，且以非法"
 },
 {
  "content": "占有为目的，通过"
 },
 {
  "content": "虚构有货的事实"
 },
 {
  "content": "骗取您的钱财后"
 },
 {
  "content": "失联，其行为"
 },
 {
  "content": "涉嫌刑事诈骗。"
 },
 {
  "content": "此时，向公安机关"
 },
 {
  "content": "报警是"
 },
 {
  "content": "恰当的选择"
 },
 {
  "content": "。"
 },
 {
  "content": "\n2"
 },
 {
  "content": ". 关于起诉"
 },
 {
  "content": "（民事途径）："
 },
 {
  "content": "如果卖家只是因"
 },
 {
  "content": "客观原因无法供货"
 },
 {
  "content": "，属于一般的"
 },
 {
  "content": "合同违约或民事"
 },
 {
  "content": "欺诈，您可以通过"
 },
 {
  "content": "民事诉讼维权。您需要"
 },
 {
  "content": "依据《民事诉讼法"
 },
 {
  "content": "》第六十八条承担"
 },
 {
  "content": "举证责任，提交"
 },
 {
  "content": "聊天记录（证明承诺"
 },
 {
  "content": "发货）、转账凭证"
 },
 {
  "content": "（证明付款）"
 },
 {
  "content": "等证据。同时"
 },
 {
  "content": "，鉴于卖家已"
 },
 {
  "content": "失联，为防止其"
 },
 {
  "content": "转移财产导致判决"
 },
 {
  "content": "难以执行，您可以"
 },
 {
  "content": "依据《民事诉讼法"
 },
 {
  "content": "》第一百零十三条"
 },
 {
  "content": "向法院申请财产"
 },
 {
  "content": "保全，"
 },
 {
  "content": "查封"
 },
 {
  "content": "、"
 },
 {
  "content": "冻结其"
 },
 {
  "content": "相应"
 },
 {
  "content": "价值的"
 },
 {
  "content": "财产。\n\n四"
 },
 {
  "content": "、结论与风险"
 },
 {
  "content": "\n\n结论：鉴于"
 },
 {
  "content": "卖家“收钱"
 },
 {
  "content": "后失联”且"
 },
 {
  "content": "“根本没货"
 },
 {
  "content": "”，具有较大的非法"
 },
 {
  "content": "占有及虚构事实"
 },
 {
  "content": "的嫌疑，建议您"
 },
 {
  "content": "优先携带聊天记录"
 },
 {
  "content": "、转账凭证等"
 },
 {
  "content": "证据向公安机关报案"
 },
 {
  "content": "。若公安机关审查"
 },
 {
  "content": "后认为属于经济"
 },
 {
  "content": "纠纷不予立案，"
 },
 {
  "content": "您再持相关"
 },
 {
  "content": "证据向人民法院提起"
 },
 {
  "content": "民事诉讼。\n\n风险"
 },
 {
  "content": "提示：无论选择"
 },
 {
  "content": "哪种途径，证据"
 },
 {
  "content": "的收集和固定都"
 },
 {
  "content": "至关重要。电子数据"
 },
 {
  "content": "等证据"
 },
 {
  "content": "极易灭失，"
 },
 {
  "content": "建议您及时对聊天记录"
 },
 {
  "content": "、转账页面等进行"
 },
 {
  "content": "截图或公证保全"
 },
 {
  "content": "。"
 },
