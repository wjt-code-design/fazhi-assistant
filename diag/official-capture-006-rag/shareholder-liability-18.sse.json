[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n案情："
 },
 {
  "content": "公司拖欠供应商货款"
 },
 {
  "content": "，法定代表人要求股东"
 },
 {
  "content": "个人签署承诺"
 },
 {
  "content": "，供应商拟直接"
 },
 {
  "content": "起诉股东。\n"
 },
 {
  "content": "争议焦点：一是"
 },
 {
  "content": "供应商能否仅以"
 },
 {
  "content": "公司欠款为由直接"
 },
 {
  "content": "起诉股东要求"
 },
 {
  "content": "还款"
 },
 {
  "content": "；二是股东个人"
 },
 {
  "content": "签署的“承诺"
 },
 {
  "content": "”将产生何种"
 },
 {
  "content": "法律后果。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "：法人"
 },
 {
  "content": "人格否认及连带"
 },
 {
  "content": "责任。\n《"
 },
 {
  "content": "民法典》第五百五"
 },
 {
  "content": "十二条：债务加入"
 },
 {
  "content": "。\n《民法典"
 },
 {
  "content": "》第五百一十八条"
 },
 {
  "content": "：连带债务。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n关于焦点"
 },
 {
  "content": "一：公司"
 },
 {
  "content": "具有独立法人资格"
 },
 {
  "content": "，原则上"
 },
 {
  "content": "公司"
 },
 {
  "content": "债务由"
 },
 {
  "content": "公司自身财产承担"
 },
 {
  "content": "，供应商不能仅"
 },
 {
  "content": "因公司欠款直接"
 },
 {
  "content": "要求股东个人"
 },
 {
  "content": "偿还。但根据"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "，若股东滥用"
 },
 {
  "content": "公司法人独立地位"
 },
 {
  "content": "和股东有限责任逃避"
 },
 {
  "content": "债务，严重损害"
 },
 {
  "content": "公司债权人利益，"
 },
 {
  "content": "或"
 },
 {
  "content": "一人公司股东不能"
 },
 {
  "content": "证明公司财产独立"
 },
 {
  "content": "于股东自己财产"
 },
 {
  "content": "，股东应对公司"
 },
 {
  "content": "债务承担连带责任"
 },
 {
  "content": "。\n关于焦点"
 },
 {
  "content": "二：股东签署"
 },
 {
  "content": "“承诺”的行为"
 },
 {
  "content": "性质决定其法律"
 },
 {
  "content": "后果。若承诺"
 },
 {
  "content": "内容系股东向"
 },
 {
  "content": "供应商表示愿意加入"
 },
 {
  "content": "公司与供应商"
 },
 {
  "content": "的债务关系，"
 },
 {
  "content": "且供应商未在"
 },
 {
  "content": "合理期限内明确拒绝"
 },
 {
  "content": "，则构成“"
 },
 {
  "content": "债务加入”。根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "五十二条，供应商"
 },
 {
  "content": "可请求股东在其"
 },
 {
  "content": "愿意承担的债务范围内"
 },
 {
  "content": "承担连带债务。"
 },
 {
  "content": "依据《民法典》"
 },
 {
  "content": "第五百一"
 },
 {
  "content": "十八条，连带债务"
 },
 {
  "content": "的债权人可以"
 },
 {
  "content": "请求部分债务人履行"
 },
 {
  "content": "全部债务，故"
 },
 {
  "content": "供应商可直接起诉该"
 },
 {
  "content": "股东要求"
 },
 {
  "content": "还款。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：供应商能否"
 },
 {
  "content": "直接起诉股东，"
 },
 {
  "content": "取决于是否存在《"
 },
 {
  "content": "公司法》第二十三条规定的"
 },
 {
  "content": "法人人格否认情形"
 },
 {
  "content": "，或股东签署"
 },
 {
  "content": "的承诺是否构成"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "五十二条规定的债务"
 },
 {
  "content": "加入。\n风险"
 },
 {
  "content": "提示：股东签署"
 },
 {
  "content": "个人承诺存在极大"
 },
 {
  "content": "法律风险。若"
 },
 {
  "content": "承诺措辞不当"
 },
 {
  "content": "被认定为债务加入"
 },
 {
  "content": "，股东将面临"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "清偿责任的风险。"
 },
 {
  "content": "此外，若股东"
 },
 {
  "content": "与公司财产"
 },
 {
  "content": "混同，亦"
 },
 {
  "content": "可能触发《公司法"
 },
 {
  "content": "》第二十三条的连带"
 },
 {
  "content": "责任。股东应"
 },
 {
  "content": "审慎审查承诺文件"
 },
 {
  "content": "的具体措辞，"
 },
 {
  "content": "明确自身法律责任边界"
 },
 {
  "content": "。\n\n本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
