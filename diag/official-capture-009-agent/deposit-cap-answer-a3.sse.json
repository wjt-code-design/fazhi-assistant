  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n"
 },
 {
  "content": "本案中，房屋"
 },
 {
  "content": "买卖总价款为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，双方当事人在"
 },
 {
  "content": "合同中约定定金为"
 },
 {
  "content": "80万元。"
 },
 {
  "content": "核心争议焦点在于"
 },
 {
  "content": "，约定的定金数额"
 },
 {
  "content": "远超房屋"
 },
 {
  "content": "总价款时，"
 },
 {
  "content": "该定金条款的法律"
 },
 {
  "content": "效力如何认定，"
 },
 {
  "content": "以及超出法定"
 },
 {
  "content": "上限的部分应如何处理"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条规定，当事人"
 },
 {
  "content": "可以约定一方向"
 },
 {
  "content": "对方给付定金作为"
 },
 {
  "content": "债权的担保。"
 },
 {
  "content": "定"
 },
 {
  "content": "金的数额由当事人"
 },
 {
  "content": "约定；但是，"
 },
 {
  "content": "不得超过主合同标的"
 },
 {
  "content": "额的百分之二十，"
 },
 {
  "content": "超过部分不产生"
 },
 {
  "content": "定金的效力。"
 },
 {
  "content": "\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n本案房屋总价"
 },
 {
  "content": "款为10"
 },
 {
  "content": "0万元，依据"
 },
 {
  "content": "上述法律规定"
 },
 {
  "content": "，定金的法定"
 },
 {
  "content": "上限为10"
 },
 {
  "content": "0万元的百分之二十"
 },
 {
  "content": "，即20"
 },
 {
  "content": "万元。对于"
 },
 {
  "content": "双方约定的80"
 },
 {
  "content": "万元定金，应当"
 },
 {
  "content": "分为"
 },
 {
  "content": "两部分进行认定："
 },
 {
  "content": "\n第一，2"
 },
 {
  "content": "0万元以内的部分"
 },
 {
  "content": "。"
 },
 {
  "content": "该部分未超过"
 },
 {
  "content": "法定上限，属于"
 },
 {
  "content": "合法有效的定金，"
 },
 {
  "content": "产生定金担保"
 },
 {
  "content": "的效力，适用"
 },
 {
  "content": "定金罚则。"
 },
 {
  "content": "\n第二，超过"
 },
 {
  "content": "法定"
 },
 {
  "content": "上限的60"
 },
 {
  "content": "万元部分。因"
 },
 {
  "content": "违反法律"
 },
 {
  "content": "关于定金数额的"
 },
 {
  "content": "强制性规定，该"
 },
 {
  "content": "部分"
 },
 {
  "content": "不产生定金的"
 },
 {
  "content": "效力。虽然这"
 },
 {
  "content": "60万元不能"
 },
 {
  "content": "作为定金处理"
 },
 {
  "content": "，但属于"
 },
 {
  "content": "买受人"
 },
 {
  "content": "实际交付"
 },
 {
  "content": "的款项，在"
 },
 {
  "content": "合同未能"
 },
 {
  "content": "履行或解除时"
 },
 {
  "content": "，收受方应当"
 },
 {
  "content": "予以返还，但不"
 },
 {
  "content": "适用双倍返还的"
 },
 {
  "content": "定金罚则。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论是该"
 },
 {
  "content": "定金条款属于部分"
 },
 {
  "content": "有效、部分无效"
 },
 {
  "content": "。20万元"
 },
 {
  "content": "以内的部分产生定金"
 },
 {
  "content": "效力，超出2"
 },
 {
  "content": "0万元的60"
 },
 {
  "content": "万元部分不产生"
 },
 {
  "content": "定金效力。\n"
 },
 {
  "content": "风险在于"
 },
 {
  "content": "，若一方出现"
 },
 {
  "content": "违约，守约"
 },
 {
  "content": "方不能就8"
 },
 {
  "content": "0万元全额主张"
 },
 {
  "content": "适用定金罚则"
 },
 {
  "content": "（如双倍"
 },
 {
  "content": "返还或无权没收"
 },
 {
  "content": "），仅能就"
 },
 {
  "content": "20万元适用"
 },
 {
  "content": "定金罚则，"
 },
 {
  "content": "对于超"
 },
 {
  "content": "出的60万元"
 },
 {
  "content": "仅能要求返还"
 },
 {
  "content": "本金及相应的资金"
 },
 {
  "content": "占用利息，无法"
 },
 {
  "content": "获得定金罚则"
 },
 {
  "content": "的惩罚性赔偿"
 },
 {
  "content": "。\n\n本答复"
 },
 {
