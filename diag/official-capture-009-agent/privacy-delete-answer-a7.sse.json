 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n案情："
 },
 {
  "content": "用户在某App注销"
 },
 {
  "content": "账号后，平台"
 },
 {
  "content": "仍保留其手机"
 },
 {
  "content": "号和消费记录，"
 },
 {
  "content": "并用于营销推送"
 },
 {
  "content": "。\n争议焦点"
 },
 {
  "content": "：平台在用户"
 },
 {
  "content": "注销账号后继续"
 },
 {
  "content": "保留个人信息并用于"
 },
 {
  "content": "营销推送的行为，"
 },
 {
  "content": "违反了哪些关于个人信息"
 },
 {
  "content": "保护"
 },
 {
  "content": "、账号"
 },
 {
  "content": "注销及商业信息"
 },
 {
  "content": "推送的法律规定。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n《电子商务"
 },
 {
  "content": "法》第二十四条\n"
 },
 {
  "content": "《消费者权益保护法》"
 },
 {
  "content": "第二十九条\n《网络安全"
 },
 {
  "content": "法》第四十五条"
 },
 {
  "content": "\n《个人信息保护法"
 },
 {
  "content": "》第二十四条\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n第一，平台"
 },
 {
  "content": "违反了注销"
 },
 {
  "content": "账号后的信息删除"
 },
 {
  "content": "义务。根据《"
 },
 {
  "content": "电子商务法》第二十四条"
 },
 {
  "content": "，电子商务经营者收到"
 },
 {
  "content": "用户注销的申请的"
 },
 {
  "content": "，应当立即删除"
 },
 {
  "content": "该用户的信息；"
 },
 {
  "content": "依照法律、行政法规"
 },
 {
  "content": "的规定或者双方约定"
 },
 {
  "content": "保存的，依照"
 },
 {
  "content": "其规定。用户"
 },
 {
  "content": "注销账号后，"
 },
 {
  "content": "平台继续保留其"
 },
 {
  "content": "手机号和消费记录"
 },
 {
  "content": "，且无法律"
 },
 {
  "content": "、行政法规规定或"
 },
 {
  "content": "双方约定作为保留"
 },
 {
  "content": "依据，违反了立即"
 },
 {
  "content": "删除信息的法定义务"
 },
 {
  "content": "。\n\n"
 },
 {
  "content": "第二，平台违反了"
 },
 {
  "content": "未经同意禁止发送"
 },
 {
  "content": "商业性信息的义务"
 },
 {
  "content": "。根据《消费者权益"
 },
 {
  "content": "保护法》第二十九条，"
 },
 {
  "content": "经营者未经消费者同意"
 },
 {
  "content": "或者请求，或者"
 },
 {
  "content": "消费者明确表示拒绝"
 },
 {
  "content": "的，不得向其"
 },
 {
  "content": "发送商业性信息"
 },
 {
  "content": "。用户注销账号"
 },
 {
  "content": "并拒绝营销"
 },
 {
  "content": "推送"
 },
 {
  "content": "，平台仍利用"
 },
 {
  "content": "其手机号进行营销"
 },
 {
  "content": "，属于在"
 },
 {
  "content": "消费者明确拒绝"
 },
 {
  "content": "后仍发送商业"
 },
 {
  "content": "性信息的违法行为。"
 },
 {
  "content": "\n\n第三，平台"
 },
 {
  "content": "违反了自动化决策及"
 },
 {
  "content": "商业营销的合规"
 },
 {
  "content": "要求。根据《"
 },
 {
  "content": "个人信息保护法》第二十四条"
 },
 {
  "content": "，通过自动化决策"
 },
 {
  "content": "方式向个人进行"
 },
 {
  "content": "信息推送、商业"
 },
 {
  "content": "营销，应当同时"
 },
 {
  "content": "提供不针对其"
 },
 {
  "content": "个人特征的选项，"
 },
 {
  "content": "或者向个人提供"
 },
 {
  "content": "便捷的拒绝方式。"
 },
 {
  "content": "平台利用消费"
 },
 {
  "content": "记录进行营销推送"
 },
 {
  "content": "，若未提供"
 },
 {
  "content": "便捷的拒绝方式或"
 },
 {
  "content": "未保障"
 },
 {
  "content": "结果公平公正"
 },
 {
  "content": "，亦存在违规"
 },
 {
  "content": "风险。\n\n第四"
 },
 {
  "content": "，平台违反了"
 },
 {
  "content": "个人信息删除权"
 },
 {
  "content": "的规定。根据《"
 },
 {
  "content": "网络安全法》第四"
 },
 {
  "content": "十五条，个人发现"
 },
 {
  "content": "网络运营者违反"
 },
 {
  "content": "法律、行政法规的规定"
 },
 {
  "content": "或者双方的约定收集"
 },
 {
  "content": "、使用其个人"
 },
 {
  "content": "信息的，有权要求"
 },
 {
  "content": "网络运营者删除"
 },
 {
  "content": "其个人信息。用户"
 },
 {
  "content": "注销账号意味着双方"
 },
 {
  "content": "约定的个人信息处理关系"
 },
 {
  "content": "终止，平台继续使用"
 },
 {
  "content": "其信息"
 },
 {
  "content": "，用户有权要求"
 },
 {
  "content": "删除。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：该平台"
 },
 {
  "content": "在用户注销账号"
 },
 {
  "content": "后仍保留其"
 },
 {
  "content": "个人信息并用于营销"
 },
 {
  "content": "推送的行为，违反了"
 },
 {
  "content": "《电子商务法》"
 },
 {
  "content": "第二十四条的注销"
 },
 {
  "content": "删除义务、《消费者权益"
 },
 {
  "content": "保护法》第二十九条的"
 },
 {
  "content": "禁止未经同意推送"
 },
 {
  "content": "商业信息义务，"
 },
 {
  "content": "以及《网络安全法"
 },
 {
  "content": "》第四十五条和"
 },
 {
  "content": "《个人信息保护法》"
 },
 {
  "content": "第二十四条的相关规定。\n"
 },
 {
  "content": "风险提示：用户"
 },
 {
  "content": "有权要求平台立即"
 },
 {
  "content": "删除个人信息并停止"
 },
 {
  "content": "营销推送。若"
 },
 {
  "content": "平台拒绝，用户可以"
 },
 {
  "content": "向市场监督管理部门、"
 },
 {
  "content": "网信部门等投诉"
 },
 {
  "content": "举报，维护自身"
 },
 {
  "content": "合法权益。本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
