 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "：本案中，"
 },
 {
  "content": "员工多次旷工"
 },
 {
  "content": "，公司依据经"
 },
 {
  "content": "民主程序制定并"
 },
 {
  "content": "公示的规章制度解除"
 },
 {
  "content": "劳动合同，且解除"
 },
 {
  "content": "前已通知"
 },
 {
  "content": "工会并留存证据"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "，公司据此解除"
 },
 {
  "content": "劳动合同是否需要向"
 },
 {
  "content": "员工支付经济补偿"
 },
 {
  "content": "或赔偿金。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "：《劳动合同法》"
 },
 {
  "content": "第三十九条第（"
 },
 {
  "content": "二）项、"
 },
 {
  "content": "第四十三条、第四"
 },
 {
  "content": "十六条、第八十七条"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证：\n"
 },
 {
  "content": "第一，关于解除"
 },
 {
  "content": "的合法性。"
 },
 {
  "content": "员工多次旷工"
 },
 {
  "content": "，若该行为"
 },
 {
  "content": "属于严重违反用人单位"
 },
 {
  "content": "规章制度的情形，公司"
 },
 {
  "content": "可依据《劳动合同"
 },
 {
  "content": "法》第三十九条"
 },
 {
  "content": "第（二）"
 },
 {
  "content": "项的规定单方"
 },
 {
  "content": "解除劳动合同。\n"
 },
 {
  "content": "第二，关于经济"
 },
 {
  "content": "补偿。根据《"
 },
 {
  "content": "劳动合同法》第四"
 },
 {
  "content": "十六条的规定，用人单位"
 },
 {
  "content": "应当支付经济补偿"
 },
 {
  "content": "的情形并不包括依据"
 },
 {
  "content": "第三十九条解除劳动合同"
 },
 {
  "content": "的情形，因此公司"
 },
 {
  "content": "无需支付经济补偿"
 },
 {
  "content": "。\n第三，"
 },
 {
  "content": "关于赔偿金。"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第八十七条的规定"
 },
 {
  "content": "，支付赔偿金"
 },
 {
  "content": "的前提是“用人单位"
 },
 {
  "content": "违反本法规定解除"
 },
 {
  "content": "或者终止劳动合同”。"
 },
 {
  "content": "本案中"
 },
 {
  "content": "公司解除行为"
 },
 {
  "content": "符合法定条件"
 },
 {
  "content": "，不属于违法解除"
 },
 {
  "content": "，故无需支付"
 },
 {
  "content": "赔偿金。\n"
 },
 {
  "content": "第四，关于程序合规。公司解除"
 },
 {
  "content": "前已通知工会"
 },
 {
  "content": "并留存证据，"
 },
 {
  "content": "符合《劳动合同法"
 },
 {
  "content": "》第四十三条关于"
 },
 {
  "content": "用人单位"
 },
 {
  "content": "单方解除劳动合同"
 },
 {
  "content": "程序"
 },
 {
  "content": "的规定"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险：综上所述"
 },
 {
  "content": "，公司无需支付"
 },
 {
  "content": "经济补偿或赔偿"
 },
 {
  "content": "金。但需注意"
 },
 {
  "content": "，司法实践中对"
 },
 {
  "content": "“严重违反”"
 },
 {
  "content": "的认定存在裁量"
 },
 {
  "content": "空间，若规章制度"
 },
 {
  "content": "未明确"
 },
 {
  "content": "旷工多少次"
 },
 {
  "content": "构成“严重”，"
 },
 {
  "content": "或民主程序、"
 },
 {
  "content": "公示证据存在瑕疵"
 },
 {
  "content": "，公司仍可能"
 },
 {
  "content": "面临被认定为违法"
 },
 {
  "content": "解除并"
 },
 {
  "content": "需支付赔偿金"
 },
 {
  "content": "的风险。"
 },
