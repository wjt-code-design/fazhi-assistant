[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "前车的损失由"
 },
 {
  "content": "后车一方承担"
 },
 {
  "content": "赔偿责任，具体赔偿"
 },
 {
  "content": "顺位如下："
 },
 {
  "content": "\n\n1. "
 },
 {
  "content": "先由承保后"
 },
 {
  "content": "车机动车强制保险"
 },
 {
  "content": "（交强险"
 },
 {
  "content": "）的保险人在"
 },
 {
  "content": "责任限额范围内予以"
 },
 {
  "content": "赔偿；\n2"
 },
 {
  "content": ". 不足部分"
 },
 {
  "content": "，由承保后"
 },
 {
  "content": "车机动车"
 },
 {
  "content": "商业保险（三者"
 },
 {
  "content": "险）的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；\n"
 },
 {
  "content": "3. 仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由后车的"
 },
 {
  "content": "侵权人（驾驶人"
 },
 {
  "content": "/车主）予以"
 },
 {
  "content": "赔偿。\n\n【"
 },
 {
  "content": "法律依据】\n"
 },
 {
  "content": "根据《道路交通安全法"
 },
 {
  "content": "》第七十六条第一款"
 },
 {
  "content": "第（一）"
 },
 {
  "content": "项，机动车之间"
 },
 {
  "content": "发生交通事故的，"
 },
 {
  "content": "由有过错的一方"
 },
 {
  "content": "承担赔偿责任。本案"
 },
 {
  "content": "中交警"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任，故"
 },
 {
  "content": "后车作为过错"
 },
 {
  "content": "方应承担前"
 },
 {
  "content": "车的损失"
 },
 {
  "content": "。\n\n根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条，机动车"
 },
 {
  "content": "发生交通事故造成损害"
 },
 {
  "content": "，属于该机动车"
 },
 {
  "content": "一方责任的，先"
 },
 {
  "content": "由承保机动车强制"
 },
 {
  "content": "保险的保险人在"
 },
 {
  "content": "强制保险责任限额"
 },
 {
  "content": "范围内予以赔偿；"
 },
 {
  "content": "不足部分，由"
 },
 {
  "content": "承保机动车商业保险"
 },
 {
  "content": "的保险人按照保险"
 },
 {
  "content": "合同的约定予以赔偿"
 },
 {
  "content": "；仍然不足或者"
 },
 {
  "content": "没有投保机动车商业"
 },
 {
  "content": "保险的，由"
 },
 {
  "content": "侵权人赔偿。"
 },
