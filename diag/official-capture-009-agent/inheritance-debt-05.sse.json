[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世，留下"
 },
 {
  "content": "房产及信用卡欠款"
 },
 {
  "content": "。核心争议在于"
 },
 {
  "content": "：子女作为继承人"
 },
 {
  "content": "，是否必须用"
 },
 {
  "content": "个人固有财产偿还"
 },
 {
  "content": "父亲的信用卡欠款。"
 },
 {
  "content": "\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "二十二条，房产"
 },
 {
  "content": "属于自然人死亡时"
 },
 {
  "content": "遗留的个人合法财产"
 },
 {
  "content": "，属于遗产。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十一条"
 },
 {
  "content": "，继承人以所得"
 },
 {
  "content": "遗产实际价值为"
 },
 {
  "content": "限清偿被继承人"
 },
 {
  "content": "依法应当缴纳的"
 },
 {
  "content": "税款和债务；"
 },
 {
  "content": "超过遗产实际价值"
 },
 {
  "content": "部分，继承人自愿"
 },
 {
  "content": "偿还的不在此限"
 },
 {
  "content": "；继承人放弃继承"
 },
 {
  "content": "的，对被继承人"
 },
 {
  "content": "依法应当缴纳的"
 },
 {
  "content": "税款和债务可以"
 },
 {
  "content": "不负清偿责任。"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第二百四十三条，"
 },
 {
  "content": "作为被执行人的公民"
 },
 {
  "content": "死亡的，以其遗产"
 },
 {
  "content": "偿还债务。\n\n"
 },
 {
  "content": "③逐项论证\n首先，子女"
 },
 {
  "content": "没有必须"
 },
 {
  "content": "拿自己个人财产"
 },
 {
  "content": "还钱的"
 },
 {
  "content": "法定义务。法律"
 },
 {
  "content": "确立的是“限定"
 },
 {
  "content": "继承”原则，"
 },
 {
  "content": "即清偿债务仅"
 },
 {
  "content": "以遗产的实际价值"
 },
 {
  "content": "为限。若"
 },
 {
  "content": "房产变卖所得"
 },
 {
  "content": "足以覆盖信用卡欠款"
 },
 {
  "content": "，则用该"
 },
 {
  "content": "款项清偿即可"
 },
 {
  "content": "，子女无需额"
 },
 {
  "content": "外出钱"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "若房产价值低于"
 },
 {
  "content": "欠款数额"
 },
 {
  "content": "，超出遗产实际"
 },
 {
  "content": "价值的债务，"
 },
 {
  "content": "子女在法律上无"
 },
 {
  "content": "强制偿还义务，"
 },
 {
  "content": "除非其出于道德"
 },
 {
  "content": "或亲情"
 },
 {
  "content": "自愿偿还。\n"
 },
 {
  "content": "最后，子女享有"
 },
 {
  "content": "放弃继承的权利。"
 },
 {
  "content": "若子女不愿承担"
 },
 {
  "content": "债务风险，可以选择"
 },
 {
  "content": "放弃继承。一旦"
 },
 {
  "content": "放弃继承，则"
 },
 {
  "content": "对父亲的信用卡欠款"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：子女无需拿"
 },
 {
  "content": "自己的个人财产偿还"
 },
 {
  "content": "父亲的信用卡欠款，"
 },
 {
  "content": "仅需在继承的"
 },
 {
  "content": "房产价值范围内承担"
 },
 {
  "content": "清偿责任"
 },
 {
  "content": "，亦可"
 },
 {
  "content": "选择放弃继承以免"
 },
 {
  "content": "除责任。\n"
 },
 {
  "content": "风险提示：若"
 },
 {
  "content": "子女已经继承遗产"
 },
 {
  "content": "，则遗产将"
 },
 {
  "content": "首先用于清偿债务"
 },
 {
  "content": "，"
 },
 {
  "content": "继承人"
 },
 {
  "content": "可能无法获得"
 },
 {
  "content": "剩余"
 },
 {
  "content": "遗产；若子女"
 },
 {
  "content": "在继承遗产后"
 },
 {
  "content": "恶意转移财产逃避"
 },
 {
  "content": "债务，债权人可能"
 },
 {
  "content": "通过法律途径追"
 },
 {
  "content": "索；放弃继承"
 },
 {
  "content": "必须在遗产处理前"
 },
 {
  "content": "作出明确"
 },
 {
  "content": "意思"
 },
 {
  "content": "表示，一旦放弃"
 },
 {
  "content": "则丧失房"
 },
 {
  "content": "产权利"
 },
 {
  "content": "。本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
