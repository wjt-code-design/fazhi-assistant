 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n案情"
 },
 {
  "content": "：消费者办理健身房"
 },
 {
  "content": "会员卡，后"
 },
 {
  "content": "健身房关门停业，"
 },
 {
  "content": "无法继续提供服务，"
 },
 {
  "content": "合同写明“"
 },
 {
  "content": "概不退款”。"
 },
 {
  "content": "\n争议焦点："
 },
 {
  "content": "1.“概"
 },
 {
  "content": "不退款”条款"
 },
 {
  "content": "是否具有"
 },
 {
  "content": "法律效力？2"
 },
 {
  "content": ".健身房关门是否"
 },
 {
  "content": "构成违约，消费者"
 },
 {
  "content": "能否要求退款？"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第四百九十六条"
 },
 {
  "content": "、第四百九十七条"
 },
 {
  "content": "，《消费者权益保护法》"
 },
 {
  "content": "第二十六条，《民法典》"
 },
 {
  "content": "第五百六十三条、"
 },
 {
  "content": "第五百七十七条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "关于“概不"
 },
 {
  "content": "退款”条款的"
 },
 {
  "content": "效力。该条款"
 },
 {
  "content": "属于健身房为了重复"
 },
 {
  "content": "使用而预先拟定"
 },
 {
  "content": "、在订立合"
 },
 {
  "content": "同时未与消费者"
 },
 {
  "content": "协商的格式条款"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第四百九十七条"
 },
 {
  "content": "及《消费者权益保护法"
 },
 {
  "content": "》第二十六条，该"
 },
 {
  "content": "条款排除了消费者"
 },
 {
  "content": "在经营者无法提供服务"
 },
 {
  "content": "时的主要权利"
 },
 {
  "content": "，属于不合理地"
 },
 {
  "content": "免除经营者责任、"
 },
 {
  "content": "排除消费者主要权利"
 },
 {
  "content": "的情形，内容无效"
 },
 {
  "content": "。\n第二，"
 },
 {
  "content": "关于健身房的违约"
 },
 {
  "content": "责任。健身房关门"
 },
 {
  "content": "停业，导致消费者"
 },
 {
  "content": "无法享受约定的"
 },
 {
  "content": "服务，属于当事人"
 },
 {
  "content": "一方迟延履行"
 },
 {
  "content": "债务或者有其他违约"
 },
 {
  "content": "行为致使不能实现"
 },
 {
  "content": "合同目的的情形。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百六十三条，"
 },
 {
  "content": "消费者有权解除合同"
 },
 {
  "content": "。合同解除后"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "，健身房应当承担"
 },
 {
  "content": "赔偿损失等违约"
 },
 {
  "content": "责任，退还"
 },
 {
  "content": "消费者未消费的"
 },
 {
  "content": "剩余费用。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：消费者"
 },
 {
  "content": "有权要求健身房"
 },
 {
  "content": "退还剩余费用，“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款无效。\n"
 },
 {
  "content": "风险：健身房"
 },
 {
  "content": "关门往往伴随着"
 },
 {
  "content": "经营不善"
 },
 {
  "content": "甚至破产，可能存在"
 },
 {
  "content": "人去楼空、"
 },
 {
  "content": "无财产可供"
 },
 {
  "content": "执行的风险。建议"
 },
 {
  "content": "消费者保留好合同"
 },
 {
  "content": "、付款凭证、"
 },
 {
  "content": "健身房关门的相关证据"
 },
 {
  "content": "，通过向市场监管"
 },
 {
  "content": "部门投诉、请求"
 },
 {
  "content": "消费者协会调解或"
 },
 {
  "content": "向人民法院提起诉讼等方式"
 },
 {
  "content": "维权。"
 },
