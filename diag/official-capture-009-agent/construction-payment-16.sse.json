 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n\n装修公司存在"
 },
 {
  "content": "两个核心"
 },
 {
  "content": "行为"
 },
 {
  "content": "：一是拖延工期"
 },
 {
  "content": "两个月；二"
 },
 {
  "content": "是以材料涨价为由"
 },
 {
  "content": "单方要求加价"
 },
 {
  "content": "，否则拒绝继续"
 },
 {
  "content": "施工。争议焦点"
 },
 {
  "content": "在于：装修公司的"
 },
 {
  "content": "工期"
 },
 {
  "content": "拖延是否"
 },
 {
  "content": "构成违约，以及其"
 },
 {
  "content": "以"
 },
 {
  "content": "材料涨价为由单"
 },
 {
  "content": "方加价并"
 },
 {
  "content": "停工的行为是否具有"
 },
 {
  "content": "法律依据。\n\n"
 },
 {
  "content": "② 法律依据"
 },
 {
  "content": "\n\n根据《民法典"
 },
 {
  "content": "》第八百零一条"
 },
 {
  "content": "，因施工人的"
 },
 {
  "content": "原因致使建设工程质量"
 },
 {
  "content": "不符合约定的，发包"
 },
 {
  "content": "人有权请求施工"
 },
 {
  "content": "人在合理期限内无偿修理或者返工"
 },
 {
  "content": "、改建。"
 },
 {
  "content": "经过修理或者返"
 },
 {
  "content": "工、改建后"
 },
 {
  "content": "，造成逾期交付"
 },
 {
  "content": "的，施工人"
 },
 {
  "content": "应当承担违约责任"
 },
 {
  "content": "。\n\n根据《"
 },
 {
  "content": "民法典》第八百零"
 },
 {
  "content": "三条，发包人"
 },
 {
  "content": "未按照约定的时间和"
 },
 {
  "content": "要求提供原材料、"
 },
 {
  "content": "设备、场地、"
 },
 {
  "content": "资金、技术资料的"
 },
 {
  "content": "，承包人可以顺"
 },
 {
  "content": "延工程日期，"
 },
 {
  "content": "并有权请求赔偿"
 },
 {
  "content": "停工、窝工"
 },
 {
  "content": "等损失。\n\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第八百零五条"
 },
 {
  "content": "，因发包人"
 },
 {
  "content": "变更计划，提供的"
 },
 {
  "content": "资料不准确，"
 },
 {
  "content": "或者未按照期限"
 },
 {
  "content": "提供必需的勘察、"
 },
 {
  "content": "设计工作条件而造成"
 },
 {
  "content": "勘察、设计的返"
 },
 {
  "content": "工、停工或者"
 },
 {
  "content": "修改设计，发包"
 },
 {
  "content": "人应当按照勘察人"
 },
 {
  "content": "、设计人实际"
 },
 {
  "content": "消耗的工作量增"
 },
 {
  "content": "付费用。\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n\n1."
 },
 {
  "content": " 关于拖延工期"
 },
 {
  "content": "：装修公司作为"
 },
 {
  "content": "施工人，拖延"
 },
 {
  "content": "两个月未完工，"
 },
 {
  "content": "属于因施工人"
 },
 {
  "content": "自身"
 },
 {
  "content": "原因导致逾期交付"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第80"
 },
 {
  "content": "1条体现的法"
 },
 {
  "content": "理，因施工"
 },
 {
  "content": "人原因造成逾期"
 },
 {
  "content": "交付的，施工"
 },
 {
  "content": "人应当承担违约"
 },
 {
  "content": "责任"
 },
 {
  "content": "。"
 },
 {
  "content": "\n\n2. "
 },
 {
  "content": "关于加价停工："
 },
 {
  "content": "材料涨价通常属于"
 },
 {
  "content": "商业风险，不属于"
 },
 {
  "content": "法定的可"
 },
 {
  "content": "单方变更合同"
 },
 {
  "content": "价款的情形"
 },
 {
  "content": "。装修公司以此为由"
 },
 {
  "content": "要求加价并停工"
 },
 {
  "content": "，属于单方"
 },
 {
  "content": "变更合同主要条款"
 },
 {
  "content": "及拒绝履行合同"
 },
 {
  "content": "义务。根据《"
 },
 {
  "content": "民法典》第8"
 },
 {
  "content": "03条和第"
 },
 {
  "content": "805条"
 },
 {
  "content": "，因停工"
 },
 {
  "content": "、窝"
 },
 {
  "content": "工等增加"
 },
 {
  "content": "的费用，通常由"
 },
 {
  "content": "导致停工的一方承担责任"
 },
 {
  "content": "；若"
 },
 {
  "content": "因发包人原因"
 },
 {
  "content": "导致停工，发包"
 },
 {
  "content": "人才需增付"
 },
 {
  "content": "费用。"
 },
 {
  "content": "反之，因"
 },
 {
  "content": "承包人自身原因"
 },
 {
  "content": "（如材料涨价"
 },
 {
  "content": "商业风险）导致的"
 },
 {
  "content": "停工，承包人"
 },
 {
  "content": "不仅无权要求加价"
 },
 {
  "content": "，还应"
 },
 {
  "content": "承担由此造成的损失"
 },
 {
  "content": "及"
 },
 {
  "content": "工期延误"
 },
 {
  "content": "责任"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n\n"
 },
 {
  "content": "业主有权拒绝装修"
 },
 {
  "content": "公司的无理加价要求"
 },
 {
  "content": "，并要求其继续"
 },
 {
  "content": "履行合同、"
 },
 {
  "content": "承担工期延误"
 },
 {
  "content": "的违约责任。"
 },
 {
  "content": "\n\n"
 },
 {
  "content": "风险"
 },
 {
  "content": "提示：现有"
 },
 {
  "content": "资料"
 },
 {
  "content": "未对“逾期"
 },
 {
  "content": "竣工违约责任的具体"
 },
 {
  "content": "计算标准”及"
 },
 {
  "content": "“商业风险与"
 },
 {
  "content": "情势变更的界限"
 },
 {
  "content": "”"
 },
 {
  "content": "作出具体规定。"
 },
 {
  "content": "若协商"
 },
 {
  "content": "不成进入"
 },
 {
  "content": "诉讼，"
 },
 {
  "content": "工期"
 },
 {
  "content": "延误的损失"
 },
 {
  "content": "计算"
 },
 {
  "content": "及材料"
 },
 {
  "content": "涨价是否构成"
 },
 {
  "content": "情势变更（"
 },
 {
  "content": "需结合涨价"
 },
 {
  "content": "幅度等"
 },
 {
  "content": "具体案情认定"
 },
 {
  "content": "），需依赖"
 },
 {
  "content": "合同约定"
 },
 {
  "content": "及双方举证，"
 },
 {
  "content": "存在一定"
 },
 {
  "content": "法律不确定性。建议"
 },
 {
  "content": "业主妥善"
 },
 {
  "content": "保存合同、"
 },
 {
  "content": "付款"
 },
 {
  "content": "凭证、工期"
 },
 {
  "content": "延误及"
 },
 {
  "content": "对方"
 },
 {
  "content": "要求"
 },
 {
  "content": "加"
 },
