 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n房东因租客"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "，在未通知的情况下"
 },
 {
  "content": "直接换锁，"
 },
 {
  "content": "并拒绝退还押金"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "：房东单"
 },
 {
  "content": "方换锁的行为"
 },
 {
  "content": "是否合法；房东"
 },
 {
  "content": "以晚交两天"
 },
 {
  "content": "房租为由拒绝退还"
 },
 {
  "content": "押金是否有依据。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第七百二十二条："
 },
 {
  "content": "承租人无正当理由"
 },
 {
  "content": "未支付或者迟"
 },
 {
  "content": "延支付租金的"
 },
 {
  "content": "，出租人可以请求"
 },
 {
  "content": "承租人在合理期限内"
 },
 {
  "content": "支付；承租人逾期不"
 },
 {
  "content": "支付的，出租人可以"
 },
 {
  "content": "解除合同。\n"
 },
 {
  "content": "《电子商务法》"
 },
 {
  "content": "第二十一条：电子商务经营者"
 },
 {
  "content": "按照约定向消费者"
 },
 {
  "content": "收取押金的，"
 },
 {
  "content": "应当明示押金"
 },
 {
  "content": "退还的方式、程序"
 },
 {
  "content": "，不得对押金"
 },
 {
  "content": "退还设置不合理条件"
 },
 {
  "content": "。消费者申请退还"
 },
 {
  "content": "押金，符合押金"
 },
 {
  "content": "退还条件的，电子商务"
 },
 {
  "content": "经营者应当及时退还。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n关于换"
 },
 {
  "content": "锁行为：根据"
 },
 {
  "content": "《民法典》第七百"
 },
 {
  "content": "二十二条，即使"
 },
 {
  "content": "租客存在迟延"
 },
 {
  "content": "支付租金的情形，"
 },
 {
  "content": "出租人也仅"
 },
 {
  "content": "享有“先催"
 },
 {
  "content": "告、后解除"
 },
 {
  "content": "”的权利。房东"
 },
 {
  "content": "未进行催告"
 },
 {
  "content": "，也未给予租客"
 },
 {
  "content": "合理的期限"
 },
 {
  "content": "支付租金，直接"
 },
 {
  "content": "换锁的行为不符合"
 },
 {
  "content": "法定解除程序，"
 },
 {
  "content": "侵犯了承租人对"
 },
 {
  "content": "租赁物的合法占有"
 },
 {
  "content": "和使用权。\n"
 },
 {
  "content": "关于押金退还："
 },
 {
  "content": "根据《电子商务法"
 },
 {
  "content": "》第二十一条体现"
 },
 {
  "content": "的押金退还法"
 },
 {
  "content": "理，押金退还"
 },
 {
  "content": "不得设置不合理条件"
 },
 {
  "content": "。晚交两天"
 },
 {
  "content": "房租通常不构成"
 },
 {
  "content": "根本违约，房东"
 },
 {
  "content": "以此为由拒绝退还"
 },
 {
  "content": "押金，属于对"
 },
 {
  "content": "押金退还设置了不合理"
 },
 {
  "content": "条件，缺乏法律"
 },
 {
  "content": "与合同依据。"
 },
 {
  "content": "此外，房东违法"
 },
 {
  "content": "换锁导致合同"
 },
 {
  "content": "无法继续履行，"
 },
 {
  "content": "租客不存在严重"
 },
 {
  "content": "违约，房东应"
 },
 {
  "content": "退还押金。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n房东未通知"
 },
 {
  "content": "即换锁的行为"
 },
 {
  "content": "不合法，且"
 },
 {
  "content": "无权以"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "为由拒绝退还押金"
 },
 {
  "content": "。租客有权要求"
 },
 {
  "content": "房东恢复原状"
 },
 {
  "content": "（开锁）、"
 },
 {
  "content": "赔偿因换锁"
 },
 {
  "content": "造成的损失，并要求"
 },
 {
  "content": "房东退还押金。"
 },
 {
  "content": "若房东拒绝"
 },
 {
  "content": "，租客可通过诉讼"
 },
 {
  "content": "或向相关部门投诉"
 },
 {
  "content": "维权，但需注意"
 },
 {
  "content": "留存租赁"
 },
 {
  "content": "合同、租金支付"
 },
 {
  "content": "记录及换锁"
 },
 {
  "content": "证据。"
 },
