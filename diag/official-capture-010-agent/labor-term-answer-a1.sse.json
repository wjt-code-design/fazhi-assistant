 },
 {
  "content": "合法"
 },
 {
  "content": "。\n\n根据《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "第一款规定：“三年以上"
 },
 {
  "content": "固定期限和无固定"
 },
 {
  "content": "期限的劳动合同，"
 },
 {
  "content": "试用期不得超过六个月。”"
 },
 {
  "content": "您"
 },
 {
  "content": "描述"
 },
 {
  "content": "的情况中"
 },
 {
  "content": "，劳动合同"
 },
 {
  "content": "期限为三年，属于"
 },
 {
  "content": "“三年以上固定期限"
 },
 {
  "content": "劳动合同"
 },
 {
  "content": "”，法定"
 },
 {
  "content": "试用期上限为六个月"
 },
 {
  "content": "。公司"
 },
 {
  "content": "第一次"
 },
 {
  "content": "约定试用期"
 },
 {
  "content": "六个月，既"
 },
 {
  "content": "未超过法定上限"
 },
 {
  "content": "，也"
 },
 {
  "content": "符合“同一用人单位"
 },
 {
  "content": "与同一劳动者只能"
 },
 {
  "content": "约定一次试用期”"
 },
 {
  "content": "的规定"
 },
 {
  "content": "，因此该约定"
 },
 {
  "content": "合法。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
