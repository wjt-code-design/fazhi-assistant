 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n\n"
 },
 {
  "content": "本案为租赁"
 },
 {
  "content": "合同纠纷。争议焦点"
 },
 {
  "content": "在于：一是"
 },
 {
  "content": "房东因晚交"
 },
 {
  "content": "两天房租未通知"
 },
 {
  "content": "即换锁的行为"
 },
 {
  "content": "是否合法；二"
 },
 {
  "content": "是以晚"
 },
 {
  "content": "交房租为由拒绝"
 },
 {
  "content": "退还押金是否合法"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n\n根据《"
 },
 {
  "content": "民法典》第七百二十二"
 },
 {
  "content": "条；根据《"
 },
 {
  "content": "电子商务法》第二十一条"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n\n关于"
 },
 {
  "content": "换锁行为："
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第七百二十二条，"
 },
 {
  "content": "承租人迟"
 },
 {
  "content": "延支付租金的"
 },
 {
  "content": "，出租人需"
 },
 {
  "content": "先“请求在"
 },
 {
  "content": "合理期限内支付”，"
 },
 {
  "content": "仅在承租人"
 },
 {
  "content": "“逾期不支付的”"
 },
 {
  "content": "情况下，出租人才"
 },
 {
  "content": "可以解除合同。"
 },
 {
  "content": "房东未进行任何"
 },
 {
  "content": "催告通知，"
 },
 {
  "content": "直接换锁，"
 },
 {
  "content": "违反了法定程序"
 },
 {
  "content": "，属于"
 },
 {
  "content": "违法行为，且"
 },
 {
  "content": "侵犯了承租人对"
 },
 {
  "content": "租赁物的合法使用权"
 },
 {
  "content": "。\n\n关于押金"
 },
 {
  "content": "退还：根据《"
 },
 {
  "content": "电子商务法》第二十一条"
 },
 {
  "content": "，电子商务经营者按照"
 },
 {
  "content": "约定向消费者收取"
 },
 {
  "content": "押金的，应当"
 },
 {
  "content": "明示押金退还"
 },
 {
  "content": "的方式、程序，"
 },
 {
  "content": "不得对押金退还"
 },
 {
  "content": "设置不合理条件，"
 },
 {
  "content": "符合"
 },
 {
  "content": "退还"
 },
 {
  "content": "条件的应当及时退还。"
 },
 {
  "content": "虽然"
 },
 {
  "content": "该条主要针对"
 },
 {
  "content": "电子商务经营者，但其"
 },
 {
  "content": "体现的押金退还"
 },
 {
  "content": "法理在普通"
 },
 {
  "content": "租赁关系中同样"
 },
 {
  "content": "适用。晚"
 },
 {
  "content": "交两天房租通常"
 },
 {
  "content": "不构成根本违约"
 },
 {
  "content": "，房东以此为由"
 },
 {
  "content": "拒绝退还押金，"
 },
 {
  "content": "属于对押金退还"
 },
 {
  "content": "设置不合理条件。"
 },
 {
  "content": "此外，房东违法"
 },
 {
  "content": "换锁导致合同"
 },
 {
  "content": "无法继续履行，"
 },
 {
  "content": "构成根本"
 },
 {
  "content": "违约，更无权"
 },
 {
  "content": "扣留押金。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n\n房东未通知"
 },
 {
  "content": "即换锁及"
 },
 {
  "content": "拒退押金的行为"
 },
 {
  "content": "缺乏法律依据。"
 },
 {
  "content": "租客有权要求房东"
 },
 {
  "content": "退还押金，并可"
 },
 {
  "content": "主张因"
 },
 {
  "content": "换锁造成的财物"
 },
 {
  "content": "损失、无法入住"
 },
 {
  "content": "期间的租金损失等"
 },
 {
  "content": "。建议租客"
 },
 {
  "content": "先与房东协商"
 },
 {
  "content": "，协商不成可"
 },
 {
  "content": "收集租赁"
 },
 {
  "content": "合同、转账记录"
 },
 {
  "content": "、换锁证据"
 },
 {
  "content": "等向人民法院"
 },
 {
  "content": "提起诉讼。"
 },
