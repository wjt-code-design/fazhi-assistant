 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n\n本案的核心"
 },
 {
  "content": "争议在于：公司"
 },
 {
  "content": "作为独立法人欠"
 },
 {
  "content": "付"
 },
 {
  "content": "货款时，供应商"
 },
 {
  "content": "能否"
 },
 {
  "content": "越过"
 },
 {
  "content": "公司直接起诉"
 },
 {
  "content": "股东个人？"
 },
 {
  "content": "这"
 },
 {
  "content": "涉及"
 },
 {
  "content": "公司法人独立地位"
 },
 {
  "content": "与股东有限责任的"
 },
 {
  "content": "突破，以及股东"
 },
 {
  "content": "个人签署承诺的法律"
 },
 {
  "content": "性质认定"
 },
 {
  "content": "。\n\n②"
 },
 {
  "content": " 法律依据\n\n"
 },
 {
  "content": "根据"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "规定"
 },
 {
  "content": "：“公司股东滥用"
 },
 {
  "content": "公司法定"
 },
 {
  "content": "人"
 },
 {
  "content": "独立地位和股东"
 },
 {
  "content": "有限责任，逃避债务"
 },
 {
  "content": "，严重损害公司"
 },
 {
  "content": "债权人利益的，应当"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "责任。股东利用"
 },
 {
  "content": "其控制的两个以上"
 },
 {
  "content": "公司实施前款规定"
 },
 {
  "content": "行为的，各公司"
 },
 {
  "content": "应当对任一公司的债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "只有一个股东的公司，"
 },
 {
  "content": "股东不能证明公司"
 },
 {
  "content": "财产独立于股东"
 },
 {
  "content": "自己的财产的，"
 },
 {
  "content": "应当对公司债务承担"
 },
 {
  "content": "连带责任。”\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n\n1."
 },
 {
  "content": " 一般"
 },
 {
  "content": "原则：公司债务"
 },
 {
  "content": "由公司财产"
 },
 {
  "content": "承担，股东不承担"
 },
 {
  "content": "连带"
 },
 {
  "content": "责任"
 },
 {
  "content": "。"
 },
 {
  "content": "公司具有"
 },
 {
  "content": "独立的法人资格，能够"
 },
 {
  "content": "独立承担"
 },
 {
  "content": "民事责任。因此"
 },
 {
  "content": "，在"
 },
 {
  "content": "正常情况下，供应商只能"
 },
 {
  "content": "起诉公司要求"
 },
 {
  "content": "支付"
 },
 {
  "content": "货款，不能直接"
 },
 {
  "content": "起诉股东个人，"
 },
 {
  "content": "股东仅以"
 },
 {
  "content": "认"
 },
 {
  "content": "缴的出资额为"
 },
 {
  "content": "限对公司债务"
 },
 {
  "content": "负责"
 },
 {
  "content": "。\n\n2."
 },
 {
  "content": " 股东签署承诺"
 },
 {
  "content": "的法律后果：法人代表"
 },
 {
  "content": "让股东个人签"
 },
 {
  "content": "承诺"
 },
 {
  "content": "，需"
 },
 {
  "content": "看"
 },
 {
  "content": "承诺"
 },
 {
  "content": "的具体内容及"
 },
 {
  "content": "签署"
 },
 {
  "content": "行为的法律"
 },
 {
  "content": "定性"
 },
 {
  "content": "。如果股东签署"
 },
 {
  "content": "的承诺文件"
 },
 {
  "content": "明确表示"
 },
 {
  "content": "愿意与公司"
 },
 {
  "content": "共同承担"
 },
 {
  "content": "还款责任"
 },
 {
  "content": "（构成"
 },
 {
  "content": "债务加入），或者"
 },
 {
  "content": "承诺"
 },
 {
  "content": "为"
 },
 {
  "content": "公司的债务提供担保"
 },
 {
  "content": "（构成保证），"
 },
 {
  "content": "则供应商有权"
 },
 {
  "content": "依据该承诺直接"
 },
 {
  "content": "起诉该股东。"
 },
 {
  "content": "一旦股东签署，"
 },
 {
  "content": "即需依"
 },
 {
  "content": "约"
 },
 {
  "content": "承担相应的法律责任。"
 },
 {
  "content": "\n\n3. "
 },
 {
  "content": "股东滥用法人独立"
 },
 {
  "content": "地位："
 },
 {
  "content": "如果股东存在滥用"
 },
 {
  "content": "公司法人独立地位"
 },
 {
  "content": "和股东有限责任的行为"
 },
 {
  "content": "（"
 },
 {
  "content": "如随意"
 },
 {
  "content": "挪用"
 },
 {
  "content": "公司资金、财务"
 },
 {
  "content": "混"
 },
 {
  "content": "同等"
 },
 {
  "content": "），"
 },
 {
  "content": "以此逃避债务"
 },
 {
  "content": "，并"
 },
 {
  "content": "严重损害了供应商"
 },
 {
  "content": "利益的"
 },
 {
  "content": "，"
 },
 {
  "content": "根据"
 },
 {
  "content": "《公司法》第二十三条"
 },
 {
  "content": "之"
 },
 {
  "content": "规定，供应商"
 },
 {
  "content": "可以"
 },
 {
  "content": "“"
 },
 {
  "content": "刺"
 },
 {
  "content": "破公司面纱”，"
 },
 {
  "content": "直接要求该"
 },
 {
  "content": "股东对公司债务承担"
 },
 {
  "content": "连带责任。\n\n"
 },
 {
  "content": "4. 一人"
 },
 {
  "content": "有限责任"
 },
 {
  "content": "公司的特殊规则"
 },
 {
  "content": "：如果该公司"
 },
 {
  "content": "为"
 },
 {
  "content": "只有一个"
 },
 {
  "content": "股东的"
 },
 {
  "content": "“"
 },
 {
  "content": "一人公司"
 },
 {
  "content": "”，根据《公司法"
 },
 {
  "content": "》第二十三条第三款"
 },
 {
  "content": "之"
 },
 {
  "content": "规定，若"
 },
 {
  "content": "该股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己的财产，"
 },
 {
  "content": "应当"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "责任。此时，"
 },
 {
  "content": "举证"
 },
 {
  "content": "责任倒"
 },
 {
  "content": "置，供应商可直接"
 },
 {
  "content": "起诉股东。\n\n"
 },
 {
  "content": "④ 结论与"
 },
 {
  "content": "风险\n\n供应商能否"
 },
 {
  "content": "直接起诉股东，"
 },
 {
  "content": "需结合具体案情"
 },
 {
  "content": "判断：若"
 },
 {
  "content": "股东未"
 },
 {
  "content": "签署承诺"
 },
 {
  "content": "且"
 },
 {
  "content": "不存在滥用法人独立"
 },
 {
  "content": "地位等情形，"
 },
 {
  "content": "供应商通常不能直接"
 },
 {
  "content": "起诉股东；若"
 },
 {
  "content": "股东签署了构成"
 },
 {
  "content": "债务加入或担保"
 },
 {
  "content": "的承诺，或"
 },
 {
  "content": "存在滥用权利"
 },
 {
  "content": "逃避债务、一人"
 },
 {
  "content": "公司财产混同等"
 },
 {
  "content": "情形，供应商则"
 },
 {
  "content": "可以直接起诉股东。"
 },
 {
  "content": "\n\n重要"
 },
 {
  "content": "提示：股东在面对"
 },
 {
  "content": "法人代表"
 },
 {
  "content": "要求个人"
 },
 {
  "content": "签署承诺"
 },
 {
  "content": "时"
 },
 {
  "content": "需"
 },
 {
  "content": "极度"
 },
 {
  "content": "谨慎，一旦"
 },
 {
  "content": "签署可能"
 },
 {
  "content": "面临"
 },
 {
  "content": "以"
 },
 {
  "content": "个人"
 },
 {
  "content": "财产清偿"
 },
 {
  "content": "公司债务的重大"
 },
 {
  "content": "风险"
 },
 {
  "content": "。建议在"
 },
 {
  "content": "签署"
 },
 {
  "content": "前明确"
 },
 {
  "content": "承诺的法律"
 },
 {
  "content": "性质，必要时"
 },
 {
  "content": "咨询专业律师。"
 },
 {
  "content": "本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
