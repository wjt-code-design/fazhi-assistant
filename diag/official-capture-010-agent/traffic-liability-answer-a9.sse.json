 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "根据相关"
 },
 {
  "content": "法律规定，前车的"
 },
 {
  "content": "损失应由后车"
 },
 {
  "content": "方承担赔偿责任"
 },
 {
  "content": "，"
 },
 {
  "content": "具体赔偿顺序"
 },
 {
  "content": "如下"
 },
 {
  "content": "：\n\n一、"
 },
 {
  "content": " 赔偿责任"
 },
 {
  "content": "主体\n根据《"
 },
 {
  "content": "道路交通安全法》第七"
 },
 {
  "content": "十六条第一款第一项"
 },
 {
  "content": "规定，机动车之间"
 },
 {
  "content": "发生交通事故的，"
 },
 {
  "content": "由有过错的一方"
 },
 {
  "content": "承担赔偿责任。本案"
 },
 {
  "content": "中交警"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任，故"
 },
 {
  "content": "后车一方"
 },
 {
  "content": "为过错方，"
 },
 {
  "content": "应对"
 },
 {
  "content": "前车的损失承担"
 },
 {
  "content": "赔偿责任。\n\n二"
 },
 {
  "content": "、 赔偿顺序"
 },
 {
  "content": "与依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条规定，机动车"
 },
 {
  "content": "发生交通事故造成损害"
 },
 {
  "content": "，属于该机动车"
 },
 {
  "content": "一方责任的，按照"
 },
 {
  "content": "以下顺序赔偿"
 },
 {
  "content": "：\n1."
 },
 {
  "content": " 先由承保"
 },
 {
  "content": "后车机动车"
 },
 {
  "content": "强制保险的"
 },
 {
  "content": "保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿；\n"
 },
 {
  "content": "2. 不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "后车机动车"
 },
 {
  "content": "商业保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；\n"
 },
 {
  "content": "3. 仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由后"
 },
 {
  "content": "车的"
 },
 {
  "content": "侵权人（即"
 },
 {
  "content": "驾驶人/车主）"
 },
 {
  "content": "赔偿。\n\n综上"
 },
 {
  "content": "，前车的损失"
 },
 {
  "content": "由后车的交"
 },
 {
  "content": "强险保险公司"
 },
 {
  "content": "、"
 },
 {
  "content": "商业险保险公司依次"
 },
 {
  "content": "赔付"
 },
 {
  "content": "，不足"
 },
 {
  "content": "部分由后车"
 },
 {
  "content": "侵权人补"
 },
 {
  "content": "足。"
 },
