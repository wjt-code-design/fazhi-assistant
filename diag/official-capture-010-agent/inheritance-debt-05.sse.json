[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n父亲去世"
 },
 {
  "content": "，遗留房产及"
 },
 {
  "content": "信用卡欠款。核心"
 },
 {
  "content": "争议在于：子女"
 },
 {
  "content": "作为继承人，是否"
 },
 {
  "content": "必须以个人固有"
 },
 {
  "content": "财产偿还父亲的信用卡"
 },
 {
  "content": "欠款。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百二十二条，"
 },
 {
  "content": "遗产是自然人死亡"
 },
 {
  "content": "时遗留的个人合法"
 },
 {
  "content": "财产。\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十一条，"
 },
 {
  "content": "继承人以所得遗产"
 },
 {
  "content": "实际价值为限"
 },
 {
  "content": "清偿被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务。超过"
 },
 {
  "content": "遗产实际价值部分"
 },
 {
  "content": "，继承人自愿偿还"
 },
 {
  "content": "的不在此限。"
 },
 {
  "content": "继承人放弃继承的"
 },
 {
  "content": "，对被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务可以不负"
 },
 {
  "content": "清偿责任。\n"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第二百四十三条，"
 },
 {
  "content": "作为被执行人的公民"
 },
 {
  "content": "死亡的，以其遗产"
 },
 {
  "content": "偿还债务。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，父亲"
 },
 {
  "content": "遗留的房子属于其"
 },
 {
  "content": "死亡时遗留"
 },
 {
  "content": "的个人合法财产，"
 },
 {
  "content": "即遗产；信用卡"
 },
 {
  "content": "欠款属于其个人"
 },
 {
  "content": "债务。\n其次"
 },
 {
  "content": "，子女仅在"
 },
 {
  "content": "继承遗产的实际价值"
 },
 {
  "content": "范围内承担清偿责任"
 },
 {
  "content": "。即需用继承"
 },
 {
  "content": "的房产变价款"
 },
 {
  "content": "来偿还信用卡欠款"
 },
 {
  "content": "。若房产价值"
 },
 {
  "content": "足以覆盖欠款，"
 },
 {
  "content": "则在房产价值"
 },
 {
  "content": "范围内清偿；若房产价值低于欠款"
 },
 {
  "content": "，超出部分子女"
 },
 {
  "content": "无法律义务用自己"
 },
 {
  "content": "原有的钱偿还，"
 },
 {
  "content": "除非子女自愿偿还"
 },
 {
  "content": "。\n最后，"
 },
 {
  "content": "子女享有放弃"
 },
 {
  "content": "继承的选择权。"
 },
 {
  "content": "若子女明确放弃"
 },
 {
  "content": "继承该房产，"
 },
 {
  "content": "则对父亲的信用卡"
 },
 {
  "content": "欠款可以不负清偿"
 },
 {
  "content": "责任。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：子女并非"
 },
 {
  "content": "必须拿自己的钱"
 },
 {
  "content": "还，仅以"
 },
 {
  "content": "继承的遗产实际"
 },
 {
  "content": "价值为限承担"
 },
 {
  "content": "清偿责任。\n"
 },
 {
  "content": "重要："
 },
 {
  "content": "风险提示。若"
 },
 {
  "content": "子女实际占有或"
 },
 {
  "content": "管理遗产，需在"
 },
 {
  "content": "遗产价值范围内妥善"
 },
 {
  "content": "处理债务，避免"
 },
 {
  "content": "因恶意转移遗产"
 },
 {
  "content": "或造成遗产灭"
 },
 {
  "content": "失而对债务承担"
 },
 {
  "content": "额外责任。若"
 },
 {
  "content": "银行起诉，法院"
 },
 {
  "content": "将仅执行遗产"
 },
 {
  "content": "，不会直接"
 },
 {
  "content": "执行子女个人财产"
 },
 {
  "content": "。"
 },
