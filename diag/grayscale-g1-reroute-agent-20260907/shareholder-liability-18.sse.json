 {
  "content": "进行解答"
 },
 {
  "content": "：\n\n**"
 },
 {
  "content": "一、一般"
 },
 {
  "content": "原则："
 },
 {
  "content": "股东有限责任"
 },
 {
  "content": "**\n"
 },
 {
  "content": "根据《公司法》"
 },
 {
  "content": "的规定"
 },
 {
  "content": "，公司是企业"
 },
 {
  "content": "法人，有"
 },
 {
  "content": "独立的法人财产，"
 },
 {
  "content": "享有法人财产权"
 },
 {
  "content": "。公司以其全部"
 },
 {
  "content": "财产对公司的债务"
 },
 {
  "content": "承担责任。有限责任"
 },
 {
  "content": "公司的股东以其"
 },
 {
  "content": "认缴的出资"
 },
 {
  "content": "额为限"
 },
 {
  "content": "对公司承担责任"
 },
 {
  "content": "。因此"
 },
 {
  "content": "，在一般情况下，"
 },
 {
  "content": "公司欠"
 },
 {
  "content": "货款，"
 },
 {
  "content": "供应商"
 },
 {
  "content": "只能起诉公司，"
 },
 {
  "content": "不能直接起诉股东"
 },
 {
  "content": "，要求"
 },
 {
  "content": "股东个人"
 },
 {
  "content": "承担公司债务。"
 },
 {
  "content": "\n\n**二、"
 },
 {
  "content": "例外情形：股东"
 },
 {
  "content": "可能承担责任的"
 },
 {
  "content": "几种"
 },
 {
  "content": "情况**\n1."
 },
 {
  "content": " **股东滥用公司"
 },
 {
  "content": "法人独立地位和"
 },
 {
  "content": "有限责任"
 },
 {
  "content": "**  \n"
 },
 {
  "content": "   根据《公司法"
 },
 {
  "content": "》第二十三条规定，"
