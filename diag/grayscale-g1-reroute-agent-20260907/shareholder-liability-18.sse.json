 {
  "content": "个人担保或债务"
 },
 {
  "content": "加入，则供应商"
 },
 {
  "content": "可能直接起诉您"
 },
 {
  "content": "，要求您个人"
 },
 {
  "content": "承担债务"
 },
 {
  "content": "。因此，在"
 },
 {
  "content": "签署任何"
 },
 {
  "content": "文件"
 },
 {
  "content": "前，务必仔细阅读"
 },
 {
  "content": "并"
 },
 {
  "content": "理解"
 },
 {
  "content": "文件内容，必要时"
 },
 {
  "content": "咨询专业律师。"
 },
 {
  "content": "\n2. **"
 },
 {
  "content": "证据"
 },
 {
  "content": "收集**"
 },
 {
  "content": "：供应商如果"
 },
 {
  "content": "主张"
 },
 {
  "content": "股东滥用"
 },
 {
  "content": "公司"
 },
 {
  "content": "法人独立地位，"
 },
 {
  "content": "需要提供充分"
