 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n同事在群里"
 },
 {
  "content": "捏造并散布"
 },
 {
  "content": "你“骗钱"
 },
 {
  "content": "”的事实并转发"
 },
 {
  "content": "，导致你的"
 },
 {
  "content": "工作受到影响。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "该行为是否构成"
 },
 {
  "content": "民事名誉权"
 },
 {
  "content": "侵权；同事及"
 },
 {
  "content": "转发者是否承担"
 },
 {
  "content": "连带责任；该"
 },
 {
  "content": "行为是否触及刑事"
 },
 {
  "content": "诬告陷害或"
 },
 {
  "content": "行政违法；以及如何"
 },
 {
  "content": "通过调解或诉讼"
 },
 {
  "content": "进行维权。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十五条、"
 },
 {
  "content": "第一千一百六十八条"
 },
 {
  "content": "、第一千一百七"
 },
 {
  "content": "十一条；《刑法"
 },
 {
  "content": "》第二百四十三条；"
 },
 {
  "content": "《网络安全法》"
 },
 {
  "content": "第六十八条；《"
 },
 {
  "content": "人民调解法》第二十条"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，民事侵权维权"
 },
 {
  "content": "。同事捏造"
 },
 {
  "content": "你骗钱的事实"
 },
 {
  "content": "并在群里散布，"
 },
 {
  "content": "属于因"
 },
 {
  "content": "过错侵害你民事"
 },
 {
  "content": "权益的行为，根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十五条，"
 },
 {
  "content": "应当承担侵权责任"
 },
 {
  "content": "。对于转发者"
 },
 {
  "content": "，若其与同事"
 },
 {
  "content": "存在共同实施侵权"
 },
 {
  "content": "行为的意思联络，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十八条"
 },
 {
  "content": "，二人以上共同"
 },
 {
  "content": "实施侵权行为造成"
 },
 {
  "content": "他人损害的，"
 },
 {
  "content": "应当承担连带责任"
 },
 {
  "content": "；若转发者与"
 },
 {
  "content": "同事分别实施侵权"
 },
 {
  "content": "行为造成同一损害"
 },
 {
  "content": "，且每个人的转发"
 },
 {
  "content": "行为都足以造成"
 },
 {
  "content": "全部损害，根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百七十一条，"
 },
 {
  "content": "行为人也需承担"
 },
 {
  "content": "连带责任。你可"
 },
 {
  "content": "要求侵权人停止"
 },
 {
  "content": "侵害、恢复名誉"
 },
 {
  "content": "、消除影响、"
 },
 {
  "content": "赔礼道歉，"
 },
 {
  "content": "并可要求赔偿因"
 },
 {
  "content": "工作受影响造成的损失"
 },
 {
  "content": "。\n\n其次，"
 },
 {
  "content": "刑事与行政维权"
 },
 {
  "content": "。存在法律不确定性"
 },
 {
  "content": "。若同事捏"
 },
 {
  "content": "造你骗钱"
 },
 {
  "content": "的事实并向国家机关"
 },
 {
  "content": "告发，意图"
 },
 {
  "content": "使你受刑事追究"
 },
 {
  "content": "，情节严重的，可能"
 },
 {
  "content": "触犯《刑法"
 },
 {
  "content": "》第二百四十三条诬"
 },
 {
  "content": "告陷害罪。"
 },
 {
  "content": "若仅在群里散布"
 },
 {
  "content": "而未向国家机关"
 },
 {
  "content": "告发，则"
 },
 {
  "content": "较难构成"
 },
 {
  "content": "此罪。不过"
 },
 {
  "content": "，利用网络发布"
 },
 {
  "content": "涉及违法犯罪的"
 },
 {
  "content": "虚假信息，尚不"
 },
 {
  "content": "构成犯罪的，根据《"
 },
 {
  "content": "网络安全法》第六"
 },
 {
  "content": "十八条，可能面临"
 },
 {
  "content": "公安机关的行政拘留和"
 },
 {
  "content": "罚款。\n\n最后"
 },
 {
  "content": "，调解途径"
 },
 {
  "content": "。根据《人民调解"
 },
 {
  "content": "法》第二十条，"
 },
 {
  "content": "你可以向人民调解委员会"
 },
 {
  "content": "申请调解，在"
 },
 {
  "content": "征得当事人同意后，"
 },
 {
  "content": "可以邀请具有"
 },
 {
  "content": "专门知识、特定"
 },
 {
  "content": "经验的人员等参与"
 },
 {
  "content": "调解，以化解"
 },
 {
  "content": "纠纷。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "你可以通过民事起诉"
 },
 {
  "content": "要求同事及转发"
 },
 {
  "content": "者承担连带侵权"
 },
 {
  "content": "责任，或"
 },
 {
  "content": "向公安机关报案追究"
 },
 {
  "content": "其行政违法责任"
 },
 {
  "content": "，亦可申请人民调解"
 },
 {
  "content": "。风险在于："
 },
 {
  "content": "民事方面需你"
 },
 {
  "content": "举证证明对方"
 },
 {
  "content": "捏造事实、"
 },
 {
  "content": "存在损害后果及"
 },
 {
  "content": "因果关系；刑事"
 },
 {
  "content": "方面需证明对方"
 },
 {
  "content": "有向国家机关"
 },
 {
  "content": "告发以使你"
 },
 {
  "content": "受刑事追究的"
 },
 {
  "content": "意图，立案门槛"
 },
 {
  "content": "较高；行政违法"
 },
 {
  "content": "方面需公安机关根据"
 },
 {
  "content": "具体情节认定。"
 },
 {
  "content": "建议优先固定"
 },
 {
  "content": "群里聊天记录"
 },
 {
  "content": "等证据，视"
 },
 {
  "content": "情况选择维权路径"
 },
 {
  "content": "。"
 },
