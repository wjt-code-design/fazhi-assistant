 {
  "content": "① "
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案中，"
 },
 {
  "content": "房屋买卖总价款"
 },
 {
  "content": "为100"
 },
 {
  "content": "万元，双方约定"
 },
 {
  "content": "定金为80"
 },
 {
  "content": "万元。争议焦点"
 },
 {
  "content": "在于：该定金"
 },
 {
  "content": "条款是否全部有效"
 },
 {
  "content": "，以及超出法定"
 },
 {
  "content": "比例的部分如何处理。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条规定：“当事人"
 },
 {
  "content": "可以约定一方向"
 },
 {
  "content": "对方给付定金作为"
 },
 {
  "content": "债权的担保。"
 },
 {
  "content": "定金合同自实际"
 },
 {
  "content": "交付定金时成立"
 },
 {
  "content": "。定金的数额"
 },
 {
  "content": "由当事人约定；"
 },
 {
  "content": "但是，不得超过主"
 },
 {
  "content": "合同标的额的百分之"
 },
 {
  "content": "二十，超过部分"
 },
 {
  "content": "不产生定金的"
 },
 {
  "content": "效力。实际交付"
 },
 {
  "content": "的定金数额多于"
 },
 {
  "content": "或者少于约定数额"
 },
 {
  "content": "的，视为变更"
 },
 {
  "content": "约定的定金数额。”"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，计算定"
 },
 {
  "content": "金的法定上限。"
 },
 {
  "content": "本案主合同标的"
 },
 {
  "content": "额为100"
 },
 {
  "content": "万元，按照百分之"
 },
 {
  "content": "二十的最高比例"
 },
 {
  "content": "计算，定"
 },
 {
  "content": "金的法定上限为"
 },
 {
  "content": "20万元。"
 },
 {
  "content": "\n其次，分析"
 },
 {
  "content": "约定定金的效力"
 },
 {
  "content": "。双方约定的定金"
 },
 {
  "content": "为80万元"
 },
 {
  "content": "，明显超过了"
 },
 {
  "content": "20万元的法定"
 },
 {
  "content": "上限。根据上述"
 },
 {
  "content": "法律规定，20"
 },
 {
  "content": "万元以内的部分产生"
 },
 {
  "content": "定金效力，受"
 },
 {
  "content": "定金罚则约束"
 },
 {
  "content": "；而超出的"
 },
 {
  "content": "60万元部分"
 },
 {
  "content": "，不产生定"
 },
 {
  "content": "金的效力。\n"
 },
 {
  "content": "最后，关于"
 },
 {
  "content": "超出部分的性质。"
 },
 {
  "content": "虽然超出的6"
 },
 {
  "content": "0万元不产生"
 },
 {
  "content": "定金效力，但"
 },
 {
  "content": "已实际"
 },
 {
  "content": "交付的，通常"
 },
 {
  "content": "视为预付款。若"
 },
 {
  "content": "发生纠纷，收受"
 },
 {
  "content": "方应当"
 },
 {
  "content": "返还该6"
 },
 {
  "content": "0万元，且"
 },
 {
  "content": "不能适用“给付"
 },
 {
  "content": "定金一方违约"
 },
 {
  "content": "无权请求返还，"
 },
 {
  "content": "收受定金一方"
 },
 {
  "content": "违约需双倍返还"
 },
 {
  "content": "”的定金罚"
 },
 {
  "content": "则。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：该"
 },
 {
  "content": "定金条款部分有效"
 },
 {
  "content": "，即20"
 },
 {
  "content": "万元产生定金效力"
 },
 {
  "content": "，超出的6"
 },
 {
  "content": "0万元不产生"
 },
 {
  "content": "定金效力。\n"
 },
 {
  "content": "风险提示：若"
 },
 {
  "content": "买方违约，卖方"
 },
 {
  "content": "仅有权"
 },
 {
  "content": "没收20万元"
 },
 {
  "content": "定金，需返还"
 },
 {
  "content": "60万元；"
 },
 {
  "content": "若卖方违约，"
 },
 {
  "content": "仅需双倍返还4"
 },
 {
  "content": "0万元（2"
 },
 {
  "content": "0万元×2"
 },
 {
  "content": "），并返还6"
 },
 {
  "content": "0万元预付款，"
 },
 {
  "content": "而非双倍返还1"
 },
 {
  "content": "60万元。"
 },
 {
  "content": "建议在交易中"
 },
 {
  "content": "严格遵守定金"
 },
 {
  "content": "法定上限，避免"
 },
 {
  "content": "因条款"
 },
 {
  "content": "部分无效导致权益"
 },
 {
  "content": "预期落空。"
 },
