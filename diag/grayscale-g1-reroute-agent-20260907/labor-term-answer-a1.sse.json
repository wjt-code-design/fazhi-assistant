 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第一款规定：“"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "。”三年期劳动合同"
 },
 {
  "content": "属于“三年以上固定"
 },
 {
  "content": "期限劳动合同"
 },
 {
  "content": "”，"
 },
 {
  "content": "其法定"
 },
 {
  "content": "试用期上限即为"
 },
 {
  "content": "六个月。因此"
 },
 {
  "content": "，公司与"
 },
 {
  "content": "员工约定试用期六个月"
 },
 {
  "content": "，符合"
 },
 {
  "content": "法律规定，属于合法"
 },
 {
  "content": "约定"
 },
 {
  "content": "。\n\n需注意"
 },
 {
  "content": "：六个月已是"
 },
 {
  "content": "法定最"
 },
 {
  "content": "长期限，"
 },
 {
  "content": "若超过"
 },
 {
  "content": "六个月则构成"
 },
 {
  "content": "违法约定，"
 },
 {
  "content": "根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十三条，违法"
 },
 {
  "content": "约定的试用期已经"
 },
 {
  "content": "履行的，用人单位"
 },
 {
  "content": "需以劳动者试用期"
 },
 {
  "content": "满月工资为标准，"
 },
 {
  "content": "按已经履行的"
 },
 {
  "content": "超过法定试用期的"
 },
 {
  "content": "期间向劳动者支付"
 },
 {
  "content": "赔偿金。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
