 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世时遗留"
 },
 {
  "content": "有房子及"
 },
 {
  "content": "信用卡欠款，核心"
 },
 {
  "content": "争议在于子女是否"
 },
 {
  "content": "必须动用个人财产"
 },
 {
  "content": "来偿还父亲的信用卡"
 },
 {
  "content": "欠款。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "二十二条、第一千"
 },
 {
  "content": "一百六十一条；"
 },
 {
  "content": "《民事诉讼法》"
 },
 {
  "content": "第二百四十三条。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百二十二条，"
 },
 {
  "content": "父亲遗留的房子"
 },
 {
  "content": "属于其死亡时"
 },
 {
  "content": "遗留的个人合法财产"
 },
 {
  "content": "，依法构成遗产"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第二百四十三条，"
 },
 {
  "content": "作为被执行人的公民"
 },
 {
  "content": "死亡的，以其遗产"
 },
 {
  "content": "偿还债务。这意味着"
 },
 {
  "content": "父亲的信用卡欠款"
 },
 {
  "content": "属于其生前债务"
 },
 {
  "content": "，应当首先以"
 },
 {
  "content": "遗产（如"
 },
 {
  "content": "房子变"
 },
 {
  "content": "卖或"
 },
 {
  "content": "折价后的价款"
 },
 {
  "content": "）进行清偿，"
 },
 {
  "content": "而非直接要求子女"
 },
 {
  "content": "用个人财产偿还"
 },
 {
  "content": "。\n最后，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十一条"
 },
 {
  "content": "，我国实行限定"
 },
 {
  "content": "继承原则。继承"
 },
 {
  "content": "人以所得遗产实际"
 },
 {
  "content": "价值为限清偿"
 },
 {
  "content": "被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务。超过遗产"
 },
 {
  "content": "实际价值部分，"
 },
 {
  "content": "继承人自愿偿还的不"
 },
 {
  "content": "在此限。同时"
 },
 {
  "content": "，若"
 },
 {
  "content": "继承人放弃继承，"
 },
 {
  "content": "则"
 },
 {
  "content": "对被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务可以不负清偿"
 },
 {
  "content": "责任。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：子女并非"
 },
 {
  "content": "必须拿自己的钱"
 },
 {
  "content": "偿还父亲的信用卡欠款"
 },
 {
  "content": "。若子女选择"
 },
 {
  "content": "继承，仅"
 },
 {
  "content": "需在继承的遗产"
 },
 {
  "content": "（如"
 },
 {
  "content": "房子）实际价值"
 },
 {
  "content": "范围内承担清偿责任"
 },
 {
  "content": "；若子女选择"
 },
 {
  "content": "放弃继承，则"
 },
 {
  "content": "无需承担任何清偿"
 },
 {
  "content": "责任。\n风险"
 },
 {
  "content": "提示：若子女"
 },
 {
  "content": "继承了遗产，在"
 },
 {
  "content": "遗产实际价值不足以"
 },
 {
  "content": "清偿全部债务时"
 },
 {
  "content": "，超出部分"
 },
 {
  "content": "子女无法律强制"
 },
 {
  "content": "偿还义务，除非"
 },
 {
  "content": "自愿偿还。此外"
 },
 {
  "content": "，若子女实际"
 },
 {
  "content": "占有或"
 },
 {
  "content": "管理遗产却未"
 },
 {
  "content": "依法用于清偿债务"
 },
 {
  "content": "，可能"
 },
 {
  "content": "面临债权人主张权利"
 },
 {
  "content": "的风险。"
 },
