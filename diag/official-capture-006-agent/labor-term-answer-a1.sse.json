 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第一款规定：“"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "。”三年期劳动合同"
 },
 {
  "content": "属于“三年以上”"
 },
 {
  "content": "的情形，法定"
 },
 {
  "content": "试用期上限即为"
 },
 {
  "content": "六个月，公司"
 },
 {
  "content": "约定六个月未超过"
 },
 {
  "content": "该上限，因此"
 },
 {
  "content": "该约定合法"
 },
 {
  "content": "。\n\n同时"
 },
 {
  "content": "，该条"
 },
 {
  "content": "第二款"
 },
 {
  "content": "规定“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”，由于"
 },
 {
  "content": "是首次"
 },
 {
  "content": "约定，亦"
 },
 {
  "content": "符合该规定"
 },
 {
  "content": "。\n\n需注意"
 },
 {
  "content": "：试用期长度"
 },
 {
  "content": "合法不"
 },
 {
  "content": "意味着"
 },
 {
  "content": "公司"
 },
 {
  "content": "可随意解除合同"
 },
 {
  "content": "。根据《劳动合同"
 },
 {
  "content": "法》第二十一条，"
 },
 {
  "content": "在试用期中解除"
 },
 {
  "content": "合同"
 },
 {
  "content": "仍需符合"
 },
 {
  "content": "法定情形（如"
 },
 {
  "content": "第三十九条、"
 },
 {
  "content": "第四十条第一项"
 },
 {
  "content": "、第二项），"
 },
 {
  "content": "且"
 },
 {
  "content": "应向劳动者说明理由"
 },
 {
  "content": "，否则可能构成"
 },
 {
  "content": "违法解除。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
