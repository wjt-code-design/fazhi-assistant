[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n案情：消费者"
 },
 {
  "content": "办理健身房会员卡"
 },
 {
  "content": "后，健身房关门"
 },
 {
  "content": "停业，且双方"
 },
 {
  "content": "签订的合同中载"
 },
 {
  "content": "明“概不"
 },
 {
  "content": "退款”。\n争议"
 },
 {
  "content": "焦点：一是合同中"
 },
 {
  "content": "“概不退款"
 },
 {
  "content": "”条款的法律效力"
 },
 {
  "content": "如何认定"
 },
 {
  "content": "；二是健身房关门"
 },
 {
  "content": "是否构成根本违约"
 },
 {
  "content": "；三是消费者能否"
 },
 {
  "content": "突破该条款"
 },
 {
  "content": "主张退款。\n\n"
 },
 {
  "content": "②法律依据（"
 },
 {
  "content": "引条文）\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第四百九十六条关于"
 },
 {
  "content": "格式条款的定义，"
 },
 {
  "content": "以及第四百九十七条"
 },
 {
  "content": "关于格式条款无效"
 },
 {
  "content": "情形的规定；根据"
 },
 {
  "content": "《消费者权益保护法》"
 },
 {
  "content": "第二十六条关于经营者不得"
 },
 {
  "content": "利用格式条款排除"
 },
 {
  "content": "消费者权利的规定；"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百六十三条关于"
 },
 {
  "content": "合同法定解除的规定"
 },
 {
  "content": "，以及第五百七"
 },
 {
  "content": "十七条关于违约责任"
 },
 {
  "content": "的规定。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，关于“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款的效力。"
 },
 {
  "content": "该条款属于健身房"
 },
 {
  "content": "为了重复使用而"
 },
 {
  "content": "预先拟定、未"
 },
 {
  "content": "与消费者协商的"
 },
 {
  "content": "格式条款（根据"
 },
 {
  "content": "《民法典》第四百"
 },
 {
  "content": "九十六条）。该"
 },
 {
  "content": "条款排除了消费者"
 },
 {
  "content": "在经营者无法"
 },
 {
  "content": "提供服务时的退款权利"
 },
 {
  "content": "，单方面"
 },
 {
  "content": "免除了经营者的"
 },
 {
  "content": "退款责任，属于"
 },
 {
  "content": "不公平"
 },
 {
  "content": "、不合理的规定。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第四百九十七条第二"
 },
 {
  "content": "项及第三项"
 },
 {
  "content": "，以及《消费者权益"
 },
 {
  "content": "保护法》第二十六条，"
 },
 {
  "content": "该格式条款应"
 },
 {
  "content": "属无效。"
 },
 {
  "content": "\n其次，关于"
 },
 {
  "content": "健身房关门的法律定性"
 },
 {
  "content": "。健身房因关门"
 },
 {
  "content": "而无法继续"
 },
 {
  "content": "向消费者提供健身"
 },
 {
  "content": "服务，导致消费者"
 },
 {
  "content": "购买会员卡接受"
 },
 {
  "content": "服务的合同目的无法"
 },
 {
  "content": "实现。根据《"
 },
 {
  "content": "民法典》第五百六"
 },
 {
  "content": "十三条第四项，"
 },
 {
  "content": "当事人一方有其他违约"
 },
 {
  "content": "行为致使不能实现"
 },
 {
  "content": "合同目的，当事人"
 },
 {
  "content": "可以解除合同。"
 },
 {
  "content": "\n最后，关于"
 },
 {
  "content": "退款请求的合法性"
 },
 {
  "content": "。合同解除后"
 },
 {
  "content": "，健身房未履"
 },
 {
  "content": "行的服务部分对应的"
 },
 {
  "content": "费用应当退还。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百七十七条，"
 },
 {
  "content": "健身房不履行合同"
 },
 {
  "content": "义务应当承担违约"
 },
 {
  "content": "责任，消费者有权"
 },
 {
  "content": "要求退还剩余未"
 },
 {
  "content": "消费的款项，不受"
 },
 {
  "content": "“概不退款"
 },
 {
  "content": "”这一无效条款"
 },
 {
  "content": "的约束。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：虽然"
 },
 {
  "content": "合同写明“"
 },
 {
  "content": "概不退款”，"
 },
 {
  "content": "但该条款因属于"
 },
 {
  "content": "不公平的格式条款"
 },
 {
  "content": "而无效，消费者"
 },
 {
  "content": "仍有权要求健身房"
 },
 {
  "content": "退还剩余未消费"
 },
 {
  "content": "的费用。\n风险"
 },
 {
  "content": "：消费者需承担"
 },
 {
  "content": "举证责任，证明"
 },
 {
  "content": "已支付的金额、"
 },
 {
  "content": "剩余未消费的金额"
 },
 {
  "content": "，以及健身房关门"
 },
 {
  "content": "停业的事实。此外"
 },
 {
  "content": "，若健身房已经"
 },
 {
  "content": "注销或经营者跑路"
 },
 {
  "content": "、无财产可供"
 },
 {
  "content": "执行，消费者即使"
 },
 {
  "content": "胜诉也可能面临"
 },
 {
  "content": "退款执行难"
 },
 {
  "content": "的风险。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
