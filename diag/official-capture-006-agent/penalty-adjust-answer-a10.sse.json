 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案中，"
 },
 {
  "content": "卖方逾期交货3"
 },
 {
  "content": "0天，构成"
 },
 {
  "content": "履行合同义务不符合"
 },
 {
  "content": "约定的违约行为。"
 },
 {
  "content": "双方争议"
 },
 {
  "content": "焦点在于：合同"
 },
 {
  "content": "约定的违约金数额远超"
 },
 {
  "content": "买方实际损失，"
 },
 {
  "content": "买方是否有权请求"
 },
 {
  "content": "法院对该违约金"
 },
 {
  "content": "予以适当减少。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第五百八十五条"
 },
 {
  "content": "第二款：“约定的违约金"
 },
 {
  "content": "过分高于造成的损失的"
 },
 {
  "content": "，人民法院或者仲裁"
 },
 {
  "content": "机构可以根据当事人的请求"
 },
 {
  "content": "予以适当减少。”"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "：“当事人一方不"
 },
 {
  "content": "履行合同义务或者"
 },
 {
  "content": "履行合同义务不符合"
 },
 {
  "content": "约定的，应当承担"
 },
 {
  "content": "继续履行、采取"
 },
 {
  "content": "补救措施或者赔偿"
 },
 {
  "content": "损失等违约责任"
 },
 {
  "content": "。”\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，卖方逾期交货"
 },
 {
  "content": "30天，"
 },
 {
  "content": "属于典型的违约行为"
 },
 {
  "content": "，买方有权要求"
 },
 {
  "content": "其承担违约责任"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "关于违约金的司法"
 },
 {
  "content": "调整，法律明确"
 },
 {
  "content": "规定了"
 },
 {
  "content": "当事人的请求权。"
 },
 {
  "content": "当合同约定的违约金"
 },
 {
  "content": "“过分高于”"
 },
 {
  "content": "造成的实际损失时"
 },
 {
  "content": "，当事人可以向人民法院"
 },
 {
  "content": "或者仲裁机构请求"
 },
 {
  "content": "予以适当减少。"
 },
 {
  "content": "本案中违约金高出"
 },
 {
  "content": "实际损失数倍"
 },
 {
  "content": "，通常可被认定为"
 },
 {
  "content": "“过分高于”。"
 },
 {
  "content": "\n重要：法院"
 },
 {
  "content": "调整违约金遵循"
 },
 {
  "content": "“不告不理"
 },
 {
  "content": "”原则，即"
 },
 {
  "content": "必须基于"
 },
 {
  "content": "当事人的主动"
 },
 {
  "content": "请求。买方若"
 },
 {
  "content": "认为违约金过高，"
 },
 {
  "content": "必须在诉讼或"
 },
 {
  "content": "仲裁中明确提出减少"
 },
 {
  "content": "违约金的申请。"
 },
 {
  "content": "同时，买方需"
 },
 {
  "content": "承担相应的举证责任"
 },
 {
  "content": "，提供证据证明自身的实际损失具体"
 },
 {
  "content": "数额，否则法院"
 },
 {
  "content": "可能难以认定违约金"
 },
 {
  "content": "过高。\n\n④结论与风险\n"
 },
 {
  "content": "结论：买方可以"
 },
 {
  "content": "请求法院适当减少"
 },
 {
  "content": "违约金。\n风险"
 },
 {
  "content": "提示：买方需"
 },
 {
  "content": "承担证明实际损失"
 },
 {
  "content": "数额的举证责任"
 },
 {
  "content": "。此外，法院"
 },
 {
  "content": "在调整违约金时"
 },
 {
  "content": "，会综合考量"
 },
 {
  "content": "合同的履行情况、"
 },
 {
  "content": "当事人的过错程度以及"
 },
 {
  "content": "预期利益等因素，"
 },
 {
  "content": "并非一律将"
 },
 {
  "content": "违约金裁减至"
 },
 {
  "content": "与实际损失完全"
 },
 {
  "content": "一致的水平，最终"
 },
 {
  "content": "减少的幅度存在"
 },
 {
  "content": "不确定性。本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
