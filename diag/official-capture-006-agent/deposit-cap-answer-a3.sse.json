 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案中，房屋"
 },
 {
  "content": "买卖双方"
 },
 {
  "content": "约定的购房定金为"
 },
 {
  "content": "80万元，"
 },
 {
  "content": "而房屋总价款"
 },
 {
  "content": "为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "。争议焦点"
 },
 {
  "content": "在于：当约定的"
 },
 {
  "content": "定金数额超过"
 },
 {
  "content": "主合同标的额"
 },
 {
  "content": "法定比例时，"
 },
 {
  "content": "该定金条款的"
 },
 {
  "content": "效力如何认定。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条规定：“当事人"
 },
 {
  "content": "可以约定一方向"
 },
 {
  "content": "对方给付定金作为"
 },
 {
  "content": "债权的担保。"
 },
 {
  "content": "定金合同自实际"
 },
 {
  "content": "交付定金时成立"
 },
 {
  "content": "。定金的数额"
 },
 {
  "content": "由当事人约定；"
 },
 {
  "content": "但是，不得超过主"
 },
 {
  "content": "合同标的额的百分之"
 },
 {
  "content": "二十，超过部分"
 },
 {
  "content": "不产生定金的"
 },
 {
  "content": "效力。实际交付"
 },
 {
  "content": "的定金数额多于"
 },
 {
  "content": "或者少于约定数额"
 },
 {
  "content": "的，视为变更"
 },
 {
  "content": "约定的定金数额。”"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，计算法定定金"
 },
 {
  "content": "上限。涉案"
 },
 {
  "content": "房屋总价款为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，依据上述规定"
 },
 {
  "content": "，定金数额"
 },
 {
  "content": "不得超过主合同标的"
 },
 {
  "content": "额的百分之二十，"
 },
 {
  "content": "即最高"
 },
 {
  "content": "不得超过2"
 },
 {
  "content": "0万元。\n"
 },
 {
  "content": "其次，分析超出"
 },
 {
  "content": "部分的效力。双方"
 },
 {
  "content": "约定的定金为8"
 },
 {
  "content": "0万元，超出了"
 },
 {
  "content": "法定上限60"
 },
 {
  "content": "万元。依据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条，20"
 },
 {
  "content": "万元以内的部分产生"
 },
 {
  "content": "定金效力；超出"
 },
 {
  "content": "法定上限的6"
 },
 {
  "content": "0万元部分，"
 },
 {
  "content": "不产生定金的"
 },
 {
  "content": "效力。这意味着该"
 },
 {
  "content": "60万元不能"
 },
 {
  "content": "适用定金罚则"
 },
 {
  "content": "，其性质"
 },
 {
  "content": "通常可能被"
 },
 {
  "content": "认定为购房"
 },
 {
  "content": "预付款"
 },
 {
  "content": "等"
 },
 {
  "content": "，需"
 },
 {
  "content": "根据"
 },
 {
  "content": "具体履行"
 },
 {
  "content": "情况确定，但不"
 },
 {
  "content": "具备定"
 },
 {
  "content": "金的法定"
 },
 {
  "content": "担保约束"
 },
 {
  "content": "力。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：该"
 },
 {
  "content": "定金条款并非"
 },
 {
  "content": "全部无效，而是"
 },
 {
  "content": "部分有效、"
 },
 {
  "content": "部分无定金"
 },
 {
  "content": "效力。即2"
 },
 {
  "content": "0万元部分产生"
 },
 {
  "content": "定金效力，6"
 },
 {
  "content": "0万元部分不"
 },
 {
  "content": "产生定金效力。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "若收受定金一方"
 },
 {
  "content": "违约，其双倍"
 },
 {
  "content": "返还定金的罚"
 },
 {
  "content": "则仅针对"
 },
 {
  "content": "20万元部分"
 },
 {
  "content": "（即双倍返还"
 },
 {
  "content": "40万元），"
 },
 {
  "content": "对于超出的6"
 },
 {
  "content": "0万元，守"
 },
 {
  "content": "约方仅"
 },
 {
  "content": "能主张返还该"
 },
 {
  "content": "6"
 },
 {
  "content": "0万元本金及"
 },
 {
  "content": "相应的资金占用损失"
 },
 {
  "content": "等，而无法"
 },
 {
  "content": "主张该6"
 },
 {
  "content": "0万元的双倍"
 },
 {
  "content": "返还。若给付"
 },
 {
  "content": "定金一方违约，"
 },
 {
  "content": "其无权请求返还"
 },
 {
  "content": "的定金也仅限于"
 },
 {
  "content": "20万元部分"
 },
 {
  "content": "，超出的6"
 },
 {
  "content": "0万元收受方"
 },
 {
  "content": "应予以返还。"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
