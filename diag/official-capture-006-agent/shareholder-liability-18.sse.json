[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n用户咨询的是"
 },
 {
  "content": "公司拖欠货款时"
 },
 {
  "content": "，法定代表人让个人"
 },
 {
  "content": "签署承诺，供应商"
 },
 {
  "content": "能否直接起诉股东"
 },
 {
  "content": "的问题。本案争议"
 },
 {
  "content": "焦点在于：公司"
 },
 {
  "content": "债务能否及何时"
 },
 {
  "content": "由股东个人承担"
 },
 {
  "content": "，以及个人"
 },
 {
  "content": "签署承诺的法律性质"
 },
 {
  "content": "与后果。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《公司法》"
 },
 {
  "content": "第二十三条规定，公司"
 },
 {
  "content": "股东滥用公司法人"
 },
 {
  "content": "独立地位和股东"
 },
 {
  "content": "有限责任，逃避债务"
 },
 {
  "content": "，严重损害公司"
 },
 {
  "content": "债权人利益的，应当"
 },
 {
  "content": "对公司债务承担连带"
 },
 {
  "content": "责任。只有一个股东"
 },
 {
  "content": "的公司，股东不能"
 },
 {
  "content": "证明公司财产独立"
 },
 {
  "content": "于股东自己的财产"
 },
 {
  "content": "的，应当对公司"
 },
 {
  "content": "债务承担连带责任"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "民法典》第五百五"
 },
 {
  "content": "十二条规定，第三"
 },
 {
  "content": "人与债务人约定加入"
 },
 {
  "content": "债务并通知债权人"
 },
 {
  "content": "，或者第三人向"
 },
 {
  "content": "债权人表示愿意加入"
 },
 {
  "content": "债务，债权人未"
 },
 {
  "content": "在合理期限内明确"
 },
 {
  "content": "拒绝的，债权人"
 },
 {
  "content": "可以请求第三人在"
 },
 {
  "content": "其愿意承担的债务"
 },
 {
  "content": "范围内和债务人承担"
 },
 {
  "content": "连带债务。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n第一，一般"
 },
 {
  "content": "原则下，供应商"
 },
 {
  "content": "不能直接起诉股东"
 },
 {
  "content": "。公司具有独立法人资格"
 },
 {
  "content": "，以其全部财产"
 },
 {
  "content": "对公司的债务承担责任"
 },
 {
  "content": "。股东仅以其"
 },
 {
  "content": "认缴的出资"
 },
 {
  "content": "额为限对公司承担责任"
 },
 {
  "content": "，公司债务"
 },
 {
  "content": "与股东个人财产"
 },
 {
  "content": "相互独立。\n"
 },
 {
  "content": "第二，法定例外"
 },
 {
  "content": "情形下，供应商"
 },
 {
  "content": "可以起诉股东。"
 },
 {
  "content": "如果存在股东滥用"
 },
 {
  "content": "公司法人独立地位"
 },
 {
  "content": "和股东有限责任逃避"
 },
 {
  "content": "债务，严重损害"
 },
 {
  "content": "债权人利益的情形，"
 },
 {
  "content": "或者一人公司股东"
 },
 {
  "content": "无法证明个人"
 },
 {
  "content": "财产与公司财产独立"
 },
 {
  "content": "，根据《公司法"
 },
 {
  "content": "》第二十三条，股东"
 },
 {
  "content": "需承担"
 },
 {
  "content": "连带责任。\n"
 },
 {
  "content": "第三，个人签署"
 },
 {
  "content": "“承诺”的风险"
 },
 {
  "content": "。如果法定代表人让你"
 },
 {
  "content": "签署的承诺书中"
 },
 {
  "content": "包含了愿意与公司"
 },
 {
  "content": "共同承担还款责任"
 },
 {
  "content": "的意思表示，且"
 },
 {
  "content": "供应商接受，这可能"
 },
 {
  "content": "构成《民法典》"
 },
 {
  "content": "第五百五十二条规定的"
 },
 {
  "content": "“债务加入”。"
 },
 {
  "content": "一旦构成债务加入"
 },
 {
  "content": "，供应商有权直接"
 },
 {
  "content": "起诉签署承诺"
 },
 {
  "content": "的个人（若"
 },
 {
  "content": "你是股东，则可"
 },
 {
  "content": "起诉你），"
 },
 {
  "content": "要求你在承诺"
 },
 {
  "content": "范围内承担连带债务"
 },
 {
  "content": "。若仅是表示"
 },
 {
  "content": "督促"
 },
 {
  "content": "公司还款"
 },
 {
  "content": "，则"
 },
 {
  "content": "不"
 },
 {
  "content": "产生"
 },
 {
  "content": "个人"
 },
 {
  "content": "还款"
 },
 {
  "content": "义务"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：供应商能否直接"
 },
 {
  "content": "起诉股东，取决于"
 },
 {
  "content": "是否存在股东滥用权利"
 },
 {
  "content": "、财产混同"
 },
 {
  "content": "的法定情形，"
 },
 {
  "content": "或者股东是否在承诺"
 },
 {
  "content": "中作出了债务加入"
 },
 {
  "content": "的意思表示。\n"
 },
 {
  "content": "风险提示：个人"
 },
 {
  "content": "签署此类“"
 },
 {
  "content": "承诺”存在极大的"
 },
 {
  "content": "法律风险，极易"
 },
 {
  "content": "被认定为债务加入"
 },
 {
  "content": "或保证担保，"
 },
 {
  "content": "从而导致个人需对"
 },
 {
  "content": "公司的巨额债务承担"
 },
 {
  "content": "连带清偿责任。"
 },
 {
  "content": "建议在签署前"
 },
 {
  "content": "明确承诺的法律性质"
 },
 {
  "content": "，避免作出"
 },
 {
  "content": "模糊的兜"
 },
 {
  "content": "底承诺"
 },
 {
  "content": "。"
 },
