 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，用人单位与劳动者"
 },
 {
  "content": "签订了三年期劳动合同"
 },
 {
  "content": "，约定六个月试用期"
 },
 {
  "content": "后又延长两个月。"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "用人单位延长试用期的"
 },
 {
  "content": "行为是否合法，"
 },
 {
  "content": "以及超过法定上限"
 },
 {
  "content": "的试用期应如何处理"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条，三年以上固定"
 },
 {
  "content": "期限和无固定期限"
 },
 {
  "content": "的劳动合同，试用期"
 },
 {
  "content": "不得超过六个月；同一"
 },
 {
  "content": "用人单位与同一劳动者"
 },
 {
  "content": "只能约定一次试用期"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "劳动合同法》第八"
 },
 {
  "content": "十三条，用人单位违反"
 },
 {
  "content": "本法规定与劳动者"
 },
 {
  "content": "约定试用期的，"
 },
 {
  "content": "由劳动行政部门责令改正"
 },
 {
  "content": "；违法约定的试用期"
 },
 {
  "content": "已经履行的，"
 },
 {
  "content": "由用人单位以劳动者"
 },
 {
  "content": "试用期满月工资为标准"
 },
 {
  "content": "，按已经履"
 },
 {
  "content": "行的超过法定试用"
 },
 {
  "content": "期的期间向劳动者"
 },
 {
  "content": "支付赔偿金。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n第一"
 },
 {
  "content": "，试用期长度超过"
 },
 {
  "content": "法定上限。三年"
 },
 {
  "content": "期劳动合同的试用期"
 },
 {
  "content": "最长为六个月，"
 },
 {
  "content": "本案中实际履行"
 },
 {
  "content": "了八个月，"
 },
 {
  "content": "超出了法定最高限"
 },
 {
  "content": "。\n第二，"
 },
 {
  "content": "延长试用期违反强制性"
 },
 {
  "content": "规定。法律明确规定"
 },
 {
  "content": "“同一用人单位与"
 },
 {
  "content": "同一劳动者只能约定"
 },
 {
  "content": "一次试用期”，用人单位"
 },
 {
  "content": "单方延长试用期"
 },
 {
  "content": "，实质上属于"
 },
 {
  "content": "再次约定或变更"
 },
 {
  "content": "试用期，违反了“"
 },
 {
  "content": "一次约定"
 },
 {
  "content": "”的强制性规定"
 },
 {
  "content": "，该延长行为"
 },
 {
  "content": "无效。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：公司"
 },
 {
  "content": "约定六个月试用期"
 },
 {
  "content": "后又延长两个月的"
 },
 {
  "content": "行为不合法。"
 },
 {
  "content": "\n风险与"
 },
 {
  "content": "维权：对于违法"
 },
 {
  "content": "履行的超过法定"
 },
 {
  "content": "试用期的期间（"
 },
 {
  "content": "即超长的"
 },
 {
  "content": "两个月），如果已经"
 },
 {
  "content": "实际履行，劳动者"
 },
 {
  "content": "有权要求用人单位支付"
 },
 {
  "content": "赔偿金。赔偿"
 },
 {
  "content": "金的标准为"
 },
 {
  "content": "试用期满月工资，"
 },
 {
  "content": "按超期的"
 },
 {
  "content": "两个月计算。劳动者"
 },
 {
  "content": "可向劳动行政部门"
 },
 {
  "content": "投诉或申请劳动"
 },
 {
  "content": "维权。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
