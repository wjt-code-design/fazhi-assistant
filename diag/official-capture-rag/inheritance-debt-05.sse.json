[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世后留有房产"
 },
 {
  "content": "和信用卡欠款，"
 },
 {
  "content": "核心争议在于子女"
 },
 {
  "content": "作为继承人，是否"
 },
 {
  "content": "必须以个人自有"
 },
 {
  "content": "财产偿还父亲的信用卡"
 },
 {
  "content": "欠款"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "二十二条，遗产"
 },
 {
  "content": "是自然人死亡时"
 },
 {
  "content": "遗留的个人合法财产"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条，继承人以"
 },
 {
  "content": "所得遗产实际价值"
 },
 {
  "content": "为限清偿被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "；超过遗产实际"
 },
 {
  "content": "价值部分，继承人"
 },
 {
  "content": "自愿偿还的不在此"
 },
 {
  "content": "限；继承人放弃"
 },
 {
  "content": "继承的，对被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。根据《民事诉讼"
 },
 {
  "content": "法》第二百四十三条"
 },
 {
  "content": "，作为被执行人的"
 },
 {
  "content": "公民死亡的，以其"
 },
 {
  "content": "遗产偿还债务。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "子女无需用个人"
 },
 {
  "content": "自有财产偿还超出"
 },
 {
  "content": "遗产价值的债务。"
 },
 {
  "content": "依据限定继承原则"
 },
 {
  "content": "，子女仅在继承"
 },
 {
  "content": "的遗产（如"
 },
 {
  "content": "房子）实际价值"
 },
 {
  "content": "范围内承担信用卡欠"
 },
 {
  "content": "款的清偿责任。"
 },
 {
  "content": "若房子变卖"
 },
 {
  "content": "后所得价款"
 },
 {
  "content": "不足以覆盖信用卡欠款"
 },
 {
  "content": "，子女无义务"
 },
 {
  "content": "用个人工资"
 },
 {
  "content": "等自有"
 },
 {
  "content": "财产补足差额"
 },
 {
  "content": "，除非其"
 },
 {
  "content": "自愿偿还。\n"
 },
 {
  "content": "其次，子女享有"
 },
 {
  "content": "放弃继承的权利"
 },
 {
  "content": "。如果子女选择"
 },
 {
  "content": "放弃继承父亲的房产"
 },
 {
  "content": "和遗产，则"
 },
 {
  "content": "对父亲的信用卡欠款"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。\n再次，"
 },
 {
  "content": "关于房产的处理。"
 },
 {
  "content": "该房产属于父亲的"
 },
 {
  "content": "遗产，应首先"
 },
 {
  "content": "用于清偿信用卡欠款"
 },
 {
  "content": "。若该"
 },
 {
  "content": "房产上设有"
 },
 {
  "content": "抵押权，根据"
 },
 {
  "content": "《民法典》第三百"
 },
 {
  "content": "九十四条，抵押"
 },
 {
  "content": "权人对该房产"
 },
 {
  "content": "享有优先受偿"
 },
 {
  "content": "权，清偿"
 },
 {
  "content": "抵押"
 },
 {
  "content": "权后的"
 },
 {
  "content": "剩余部分才用于"
 },
 {
  "content": "清偿信用卡欠款。"
 },
 {
  "content": "\n最后，若"
 },
 {
  "content": "存在多名"
 },
 {
  "content": "继承人，根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十三条，由"
 },
 {
  "content": "法定继承人负责"
 },
 {
  "content": "清偿债务"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：子女不需要拿"
 },
 {
  "content": "自己的钱偿还父亲的"
 },
 {
  "content": "信用卡欠款，仅在"
 },
 {
  "content": "继承遗产价值范围内"
 },
 {
  "content": "承担清偿责任，"
 },
 {
  "content": "或选择放弃继承"
 },
 {
  "content": "以免除"
 },
 {
  "content": "责任。\n风险"
 },
 {
  "content": "提示：若子女"
 },
 {
  "content": "继承了遗产，却"
 },
 {
  "content": "未在遗产实际"
 },
 {
  "content": "价值范围内清偿债务"
 },
 {
  "content": "，债权人有权向"
 },
 {
  "content": "法院起诉，要求"
 },
 {
  "content": "子女在继承"
 },
 {
  "content": "遗产范围内承担责任；"
 },
 {
  "content": "若子女私自转移"
 },
 {
  "content": "遗产，可能面临"
 },
 {
  "content": "债权人行使"
 },
 {
  "content": "撤销权的风险。"
 },
 {
  "content": "此外，放弃继承"
 },
 {
  "content": "需以书面形式明确"
 },
 {
  "content": "表示，否则视为"
 },
 {
  "content": "接受继承。"
 },
