 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，承租人晚交"
 },
 {
  "content": "两天房租，出租"
 },
 {
  "content": "人未通知即"
 },
 {
  "content": "更换门锁"
 },
 {
  "content": "并拒绝退还押金"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "：出租人是否有"
 },
 {
  "content": "权因晚交"
 },
 {
  "content": "两天租金解除合同"
 },
 {
  "content": "并换锁；"
 },
 {
  "content": "出租人擅自换"
 },
 {
  "content": "锁行为的合法性及"
 },
 {
  "content": "责任；押金应"
 },
 {
  "content": "否退还。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第七百二十二条，"
 },
 {
  "content": "承租人无正当理由"
 },
 {
  "content": "未支付或者迟"
 },
 {
  "content": "延支付租金的"
 },
 {
  "content": "，出租人可以请求"
 },
 {
  "content": "承租人在合理期限内"
 },
 {
  "content": "支付；承租人逾期不"
 },
 {
  "content": "支付的，出租人可以"
 },
 {
  "content": "解除合同。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，关于"
 },
 {
  "content": "出租人能否因"
 },
 {
  "content": "晚交两天租金"
 },
 {
  "content": "解除合同并换"
 },
 {
  "content": "锁。根据上述"
 },
 {
  "content": "法律规定，即使承租人"
 },
 {
  "content": "存在迟延支付"
 },
 {
  "content": "租金的情形，出租"
 },
 {
  "content": "人也必须履行“"
 },
 {
  "content": "催告”程序"
 },
 {
  "content": "，并给予承租人"
 },
 {
  "content": "合理的支付"
 },
 {
  "content": "期限。只有在承租人"
 },
 {
  "content": "逾期仍不支付"
 },
 {
  "content": "的情况下，出租人才"
 },
 {
  "content": "享有合同解除权"
 },
 {
  "content": "。晚交两天"
 },
 {
  "content": "房租通常不构成"
 },
 {
  "content": "根本违约，且"
 },
 {
  "content": "出租人未履行"
 },
 {
  "content": "催告程序，"
 },
 {
  "content": "直接换锁不符合"
 },
 {
  "content": "法定解除程序，"
 },
 {
  "content": "该行为侵犯了"
 },
 {
  "content": "承租人对租赁物的"
 },
 {
  "content": "合法使用权。\n\n"
 },
 {
  "content": "其次，关于出租"
 },
 {
  "content": "人擅自换锁"
 },
 {
  "content": "的法律性质"
 },
 {
  "content": "。无论承租人"
 },
 {
  "content": "是否存在违约行为，"
 },
 {
  "content": "出租人都不能通过"
 },
 {
  "content": "私自换锁的方式"
 },
 {
  "content": "收回房屋或"
 },
 {
  "content": "迫使承租人搬"
 },
 {
  "content": "离。擅自换"
 },
 {
  "content": "锁可能导致承租人无法"
 },
 {
  "content": "使用租赁物甚至"
 },
 {
  "content": "造成财物损失，"
 },
 {
  "content": "出租人需对此"
 },
 {
  "content": "承担侵权赔偿责任"
 },
 {
  "content": "。\n\n最后，"
 },
 {
  "content": "关于押金退还问题"
 },
 {
  "content": "。晚交两天"
 },
 {
  "content": "房租属于轻微违约"
 },
 {
  "content": "，通常不足以"
 },
 {
  "content": "构成全额扣除押"
 },
 {
  "content": "金的法定或"
 },
 {
  "content": "约定理由"
 },
 {
  "content": "。若出租人"
 },
 {
  "content": "主张以押金抵扣"
 },
 {
  "content": "损失，需证明"
 },
 {
  "content": "实际损失的存在"
 },
 {
  "content": "及具体金额，否则应当"
 },
 {
  "content": "退还押金。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：出租"
 },
 {
  "content": "人擅自换锁"
 },
 {
  "content": "的行为缺乏法律依据"
 },
 {
  "content": "，承租人有权要求"
 },
 {
  "content": "出租人恢复原"
 },
 {
  "content": "状（开锁"
 },
 {
  "content": "）、赔偿因无法"
 },
 {
  "content": "使用房屋造成的损失"
 },
 {
  "content": "，并要求退还押金"
 },
 {
  "content": "。\n\n风险提示"
 },
 {
  "content": "：实务中，"
 },
 {
  "content": "若租赁"
 },
 {
  "content": "合同中对逾期"
 },
 {
  "content": "交租"
 },
 {
  "content": "有特别严苛"
 },
 {
  "content": "的"
 },
 {
  "content": "约定，"
 },
 {
  "content": "该条款可能因"
 },
 {
  "content": "排除承租人权利、"
 },
 {
  "content": "加重承租人"
 },
 {
  "content": "责任而被认定无效"
 },
 {
  "content": "，但也需"
 },
 {
  "content": "结合具体案情判断"
 },
 {
  "content": "。建议承租人先"
 },
 {
  "content": "与出租人协商"
 },
 {
  "content": "，协商不成可"
 },
 {
  "content": "报警留存"
 },
 {
  "content": "证据，并通过诉讼"
 },
 {
  "content": "途径维权"
 },
 {
  "content": "。本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
