[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n您骑"
 },
 {
  "content": "电动车被右转货车"
 },
 {
  "content": "撞伤，货车"
 },
 {
  "content": "方以您未"
 },
 {
  "content": "戴头盔为由拒绝"
 },
 {
  "content": "赔偿。本案争议"
 },
 {
  "content": "焦点在于：受害人"
 },
 {
  "content": "未戴头盔是否"
 },
 {
  "content": "构成加害人"
 },
 {
  "content": "免除或减轻"
 },
 {
  "content": "赔偿责任的理由。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第五十一条规定"
 },
 {
  "content": "摩托车驾驶人及乘坐"
 },
 {
  "content": "人员应当按规定戴"
 },
 {
  "content": "安全头盔；《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "七十四条规定损害"
 },
 {
  "content": "是因受害人故意造成的"
 },
 {
  "content": "，行为人不承担责任"
 },
 {
  "content": "；《民法典》"
 },
 {
  "content": "第一千二百一十三条"
 },
 {
  "content": "规定了机动车交通事故"
 },
 {
  "content": "的赔偿顺位"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n第一"
 },
 {
  "content": "，货车方“"
 },
 {
  "content": "不赔”的主"
 },
 {
  "content": "张缺乏法律依据"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百七"
 },
 {
  "content": "十四条，仅在受害人"
 },
 {
  "content": "故意造成损害时"
 },
 {
  "content": "，行为人才不"
 },
 {
  "content": "承担责任。您未"
 },
 {
  "content": "戴头盔属于"
 },
 {
  "content": "对自身安全未尽"
 },
 {
  "content": "到合理"
 },
 {
  "content": "注意义务，并非"
 },
 {
  "content": "故意造成交通事故，"
 },
 {
  "content": "因此不构成法"
 },
 {
  "content": "定的免责事由"
 },
 {
  "content": "。\n第二，"
 },
 {
  "content": "未戴头盔可能"
 },
 {
  "content": "涉及“与有过"
 },
 {
  "content": "失”。虽然提供的"
 },
 {
  "content": "条文中未直接"
 },
 {
  "content": "规定与有过失"
 },
 {
  "content": "条款，但依据"
 },
 {
  "content": "侵权责任的一般"
 },
 {
  "content": "法理，受害"
 },
 {
  "content": "人对损害的发生或"
 },
 {
  "content": "扩大有过错的，"
 },
 {
  "content": "可以减轻侵权人的"
 },
 {
  "content": "责任，而不能完全"
 },
 {
  "content": "免除。"
 },
 {
  "content": "且未戴头盔"
 },
 {
  "content": "通常仅对头部"
 },
 {
  "content": "损害的扩大具有"
 },
 {
  "content": "影响，不能以此"
 },
 {
  "content": "否定货车方转弯"
 },
 {
  "content": "未"
 },
 {
  "content": "让直行"
 },
 {
  "content": "等引发事故的"
 },
 {
  "content": "过错。\n第三"
 },
 {
  "content": "，关于赔偿顺"
 },
 {
  "content": "位，根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条，货车"
 },
 {
  "content": "作为"
 },
 {
  "content": "机动车通常"
 },
 {
  "content": "投保了"
 },
 {
  "content": "交强险，"
 },
 {
  "content": "应先由承保"
 },
 {
  "content": "机动车"
 },
 {
  "content": "强制保险的保险"
 },
 {
  "content": "人在强制保险责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "，不足部分再由"
 },
 {
  "content": "商业险"
 },
 {
  "content": "或侵权人承担"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n存在"
 },
 {
  "content": "法律不确定性："
 },
 {
  "content": "在司法实践中，"
 },
 {
  "content": "未戴头盔可能会"
 },
 {
  "content": "对赔偿责任比例"
 },
 {
  "content": "产生一定影响。"
 },
 {
  "content": "若交警认定对方"
 },
 {
  "content": "全责，您"
 },
 {
  "content": "未戴头盔可能"
 },
 {
  "content": "仅导致头部伤害"
 },
 {
  "content": "部分的赔偿被适当"
 },
 {
  "content": "减轻，而非完全不"
 },
 {
  "content": "赔。建议您及时"
 },
 {
  "content": "报警获取事故"
 },
 {
  "content": "责任认定书，"
 },
 {
  "content": "若对方及"
 },
 {
  "content": "保险公司"
 },
 {
  "content": "拒赔，可"
 },
 {
  "content": "依据《道路交通安全法"
 },
 {
  "content": "》第七十四条请求"
 },
 {
  "content": "交"
 },
 {
  "content": "管部门调解，"
 },
 {
  "content": "或向人民法院"
 },
 {
  "content": "提起民事诉讼。本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
