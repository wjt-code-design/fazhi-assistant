 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "用户与装修公司之间"
 },
 {
  "content": "成立装饰装修合同关系"
 },
 {
  "content": "。装修公司拖延工期"
 },
 {
  "content": "两个月，并以材料"
 },
 {
  "content": "涨价为由要求加价"
 },
 {
  "content": "，否则拒绝继续"
 },
 {
  "content": "施工。争议焦点"
 },
 {
  "content": "为：1."
 },
 {
  "content": " 装修公司拖延工期"
 },
 {
  "content": "及停工是否"
 },
 {
  "content": "构成违约？2"
 },
 {
  "content": ". 材料涨价"
 },
 {
  "content": "能否成为加价或"
 },
 {
  "content": "停工的合法理由"
 },
 {
  "content": "？\n\n②法律"
 },
 {
  "content": "依据\n主要依据"
 },
 {
  "content": "《民法典》第十八章"
 },
 {
  "content": "建设工程合同的相关规定。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "关于拖延工期与"
 },
 {
  "content": "停工。根据《"
 },
 {
  "content": "民法典》第8"
 },
 {
  "content": "03条，"
 },
 {
  "content": "发包人未按"
 },
 {
  "content": "约提供原材料、"
 },
 {
  "content": "设备、场地、"
 },
 {
  "content": "资金、技术资料的"
 },
 {
  "content": "，承包人才可以"
 },
 {
  "content": "顺延工程日期"
 },
 {
  "content": "并索赔停工窝"
 },
 {
  "content": "工损失；根据"
 },
 {
  "content": "《民法典》第"
 },
 {
  "content": "805条"
 },
 {
  "content": "，因发包人"
 },
 {
  "content": "变更计划等导致"
 },
 {
  "content": "停工的，发包"
 },
 {
  "content": "人需按实际"
 },
 {
  "content": "工作量增付费用"
 },
 {
  "content": "。上述条文反向"
 },
 {
  "content": "说明，停工及"
 },
 {
  "content": "费用增加需"
 },
 {
  "content": "基于发包"
 },
 {
  "content": "人原因。本案"
 },
 {
  "content": "中，材料涨价"
 },
 {
  "content": "属于施工人应"
 },
 {
  "content": "自行承担的商业风险"
 },
 {
  "content": "，不属于法定可"
 },
 {
  "content": "顺延工期或"
 },
 {
  "content": "增付费用的情形"
 },
 {
  "content": "。施工人以此"
 },
 {
  "content": "为由停工，"
 },
 {
  "content": "缺乏法律依据，"
 },
 {
  "content": "构成违约。根据"
 },
 {
  "content": "《民法典》第"
 },
 {
  "content": "801条"
 },
 {
  "content": "，因施工人"
 },
 {
  "content": "原因造成逾期交付"
 },
 {
  "content": "的，施工人"
 },
 {
  "content": "应当承担违约责任"
 },
 {
  "content": "。\n\n"
 },
 {
  "content": "其次，关于加价"
 },
 {
  "content": "要求。合同双方"
 },
 {
  "content": "应遵循全面履行"
 },
 {
  "content": "原则，材料涨价"
 },
 {
  "content": "通常"
 },
 {
  "content": "不属于法定的情势"
 },
 {
  "content": "变更情形，施工"
 },
 {
  "content": "人不得单"
 },
 {
  "content": "方要求加价。"
 },
 {
  "content": "其以停工"
 },
 {
  "content": "相要挟，"
 },
 {
  "content": "属于单方变更"
 },
 {
  "content": "合同核心条款，"
 },
 {
  "content": "于法无据"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n装修"
 },
 {
  "content": "公司的加价要求无"
 },
 {
  "content": "法律依据，其"
 },
 {
  "content": "停工行为构成违约"
 },
 {
  "content": "。建议用户书面"
 },
 {
  "content": "催告其继续"
 },
 {
  "content": "施工，若仍"
 },
 {
  "content": "拒绝，可主张"
 },
 {
  "content": "逾期违约责任；"
 },
 {
  "content": "若合同目的"
 },
 {
  "content": "无法实现，可"
 },
 {
  "content": "依法解除合同并"
 },
 {
  "content": "主张赔偿。需注意"
 },
 {
  "content": "，若合同明确"
 },
 {
  "content": "约定了材料价格"
 },
 {
  "content": "波动调价条款"
 },
 {
  "content": "，则需按"
 },
 {
  "content": "约定处理；若"
 },
 {
  "content": "装修涉及建筑主体"
 },
 {
  "content": "和承重结构变动"
 },
 {
  "content": "，还需符合《"
 },
 {
  "content": "建筑法》第"
 },
 {
  "content": "49条关于"
 },
 {
  "content": "设计方案的强制性规定"
 },
 {
  "content": "，否则可能面临"
 },
 {
  "content": "安全隐患及行政处罚。"
 },
