[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世，留下"
 },
 {
  "content": "遗产（房子）"
 },
 {
  "content": "和债务（信用卡"
 },
 {
  "content": "欠款）。核心争议"
 },
 {
  "content": "焦点为：子女"
 },
 {
  "content": "是否必须用个人"
 },
 {
  "content": "自有财产偿还"
 },
 {
  "content": "父亲的信用卡欠款。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条，继承"
 },
 {
  "content": "人以所得遗产实际"
 },
 {
  "content": "价值为限清偿"
 },
 {
  "content": "被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务。超过遗产"
 },
 {
  "content": "实际价值部分，"
 },
 {
  "content": "继承人自愿偿还的不"
 },
 {
  "content": "在此限。继承人"
 },
 {
  "content": "放弃继承的，"
 },
 {
  "content": "对被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务可以不负清偿"
 },
 {
  "content": "责任。\n根据"
 },
 {
  "content": "《民事诉讼法》"
 },
 {
  "content": "第二百四十三条，作为"
 },
 {
  "content": "被执行人的公民死亡的"
 },
 {
  "content": "，以其遗产偿还"
 },
 {
  "content": "债务。\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百二十二条，"
 },
 {
  "content": "遗产是自然人死亡"
 },
 {
  "content": "时遗留的个人合法"
 },
 {
  "content": "财产。\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n第一，限定"
 },
 {
  "content": "继承原则。子女"
 },
 {
  "content": "作为继承人，仅在"
 },
 {
  "content": "继承遗产"
 },
 {
  "content": "的实际价值范围内承担"
 },
 {
  "content": "清偿责任。若"
 },
 {
  "content": "父亲留下的房子"
 },
 {
  "content": "等遗产"
 },
 {
  "content": "价值低于信用卡欠款"
 },
 {
  "content": "，超出部分的"
 },
 {
  "content": "债务，子女在法律"
 },
 {
  "content": "上没有必须"
 },
 {
  "content": "用个人财产偿还"
 },
 {
  "content": "的义务。\n第二"
 },
 {
  "content": "，放弃继承的法律"
 },
 {
  "content": "后果。若子女"
 },
 {
  "content": "选择放弃继承父亲的"
 },
 {
  "content": "遗产，则对"
 },
 {
  "content": "父亲的信用卡欠款依法"
 },
 {
  "content": "不负清偿责任。"
 },
 {
  "content": "\n第三，债务"
 },
 {
  "content": "清偿顺位。"
 },
 {
  "content": "父亲的信用卡欠款"
 },
 {
  "content": "属于其个人债务"
 },
 {
  "content": "，应首先"
 },
 {
  "content": "以父亲的"
 },
 {
  "content": "遗产（如房子"
 },
 {
  "content": "）进行清偿。"
 },
 {
  "content": "若遗产足以"
 },
 {
  "content": "覆盖债务，清偿"
 },
 {
  "content": "后剩余部分由"
 },
 {
  "content": "子女继承；若"
 },
 {
  "content": "不足以覆盖，子女"
 },
 {
  "content": "无需倒"
 },
 {
  "content": "贴个人财产。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：子女不需要拿"
 },
 {
  "content": "自己的个人钱"
 },
 {
  "content": "去偿还父亲的信用卡"
 },
 {
  "content": "欠款，仅需以"
 },
 {
  "content": "继承的"
 },
 {
  "content": "遗产价值为限"
 },
 {
  "content": "进行清偿，或者"
 },
 {
  "content": "直接选择放弃继承"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：若子女实际"
 },
 {
  "content": "管理或占"
 },
 {
  "content": "有了遗产，却"
 },
 {
  "content": "未在遗产范围内"
 },
 {
  "content": "积极清偿债务，"
 },
 {
  "content": "债权人可能通过诉讼"
 },
 {
  "content": "要求子女在继承"
 },
 {
  "content": "遗产范围内承担责任。"
 },
 {
  "content": "此外，若子女"
 },
 {
  "content": "自愿代为偿还超出"
 },
 {
  "content": "遗产价值"
 },
 {
  "content": "的部分，法律予以"
 },
 {
  "content": "允许，但此"
 },
 {
  "content": "非法定义务。"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
