[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "您于20"
 },
 {
  "content": "21年为朋友的"
 },
 {
  "content": "借款提供担保，"
 },
 {
  "content": "现债权人要求您"
 },
 {
  "content": "承担保证责任，"
 },
 {
  "content": "但合同中"
 },
 {
  "content": "未约定保证期间"
 },
 {
  "content": "。本案争议焦点"
 },
 {
  "content": "在于：您的"
 },
 {
  "content": "保证方式如何认定"
 },
 {
  "content": "、保证期间如何"
 },
 {
  "content": "计算，以及您"
 },
 {
  "content": "是否还需承担保证"
 },
 {
  "content": "责任。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第六百"
 },
 {
  "content": "八十六条，当事"
 },
 {
  "content": "人在保证合同中对"
 },
 {
  "content": "保证方式没有约定"
 },
 {
  "content": "或者约定不明确的"
 },
 {
  "content": "，按照一般保证"
 },
 {
  "content": "承担保证责任。"
 },
 {
  "content": "\n根据《民法典》第六百九十二条"
 },
 {
  "content": "，没有约定或者"
 },
 {
  "content": "约定不明确保证"
 },
 {
  "content": "期间的，保证期间"
 },
 {
  "content": "为主债务履行期限"
 },
 {
  "content": "届满之日起六个月。"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第六百九十三条"
 },
 {
  "content": "，一般保证的"
 },
 {
  "content": "债权人未在保证期间"
 },
 {
  "content": "对债务人提起诉讼或者"
 },
 {
  "content": "申请仲裁的，"
 },
 {
  "content": "保证人不再承担"
 },
 {
  "content": "保证责任。\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第六百八十七条，"
 },
 {
  "content": "一般保证的保证"
 },
 {
  "content": "人在主合同纠纷未经"
 },
 {
  "content": "审判或者仲裁，"
 },
 {
  "content": "并就债务人财产依法"
 },
 {
  "content": "强制执行仍不能履行"
 },
 {
  "content": "债务前，有权"
 },
 {
  "content": "拒绝向债权人承担"
 },
 {
  "content": "保证责任。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，由于"
 },
 {
  "content": "合同未写明"
 },
 {
  "content": "保证方式，依法"
 },
 {
  "content": "应推定您"
 },
 {
  "content": "承担的是一般保证责任"
 },
 {
  "content": "，而非连带责任"
 },
 {
  "content": "保证。\n其次"
 },
 {
  "content": "，合同未约定"
 },
 {
  "content": "保证期间，保证"
 },
 {
  "content": "期间应为主"
 },
 {
  "content": "债务履行期限届满"
 },
 {
  "content": "之日起六个月。即"
 },
 {
  "content": "从约定的还款日"
 },
 {
  "content": "次日起算6"
 },
 {
  "content": "个月。\n再次"
 },
 {
  "content": "，由于您"
 },
 {
  "content": "是一般保证人，"
 },
 {
  "content": "债权人必须在上述6"
 },
 {
  "content": "个月保证期间内"
 },
 {
  "content": "对债务人（您"
 },
 {
  "content": "朋友）提起诉讼或者"
 },
 {
  "content": "申请仲裁。如果"
 },
 {
  "content": "债权人未在该期间"
 },
 {
  "content": "内起诉或申请"
 },
 {
  "content": "仲裁，您的保证"
 },
 {
  "content": "责任消灭，无需"
 },
 {
  "content": "再还款"
 },
 {
  "content": "。\n最后，"
 },
 {
  "content": "即使债权人在保证"
 },
 {
  "content": "期间内起诉了"
 },
 {
  "content": "，您作为一般"
 },
 {
  "content": "保证人仍享有"
 },
 {
  "content": "先诉抗辩"
 },
 {
  "content": "权，可以要求"
 },
 {
  "content": "债权人先就您"
 },
 {
  "content": "朋友的财产"
 },
 {
  "content": "依法强制执行，您"
 },
 {
  "content": "仅在朋友财产"
 },
 {
  "content": "不足以清偿的"
 },
 {
  "content": "范围内承担责任。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：如果"
 },
 {
  "content": "借款约定的"
 },
 {
  "content": "还款期限届满至今"
 },
 {
  "content": "（自"
 },
 {
  "content": "2021"
 },
 {
  "content": "年起算"
 },
 {
  "content": "）已经超过六个月，"
 },
 {
  "content": "且债权人从未"
 },
 {
  "content": "向债务人"
 },
 {
  "content": "提起诉讼或申请仲裁"
 },
 {
  "content": "，您的保证责任"
 },
 {
  "content": "已经免除，可以"
 },
 {
  "content": "拒绝还款。\n"
 },
 {
  "content": "风险提示：需"
 },
 {
  "content": "核实主债务的具体"
 },
 {
  "content": "履行期限。如果"
 },
 {
  "content": "当时未约定还款"
 },
 {
  "content": "期限或约定"
 },
 {
  "content": "不明，保证期间"
 },
 {
  "content": "自债权人请求债务人"
 },
 {
  "content": "履行债务的宽"
 },
 {
  "content": "限期届满之日起计算"
 },
 {
  "content": "，此时保证期间"
 },
 {
  "content": "可能尚未届满。"
 },
 {
  "content": "此外，如果债权"
 },
 {
  "content": "人在保证期间内"
 },
 {
  "content": "已对债务人提起诉讼"
 },
 {
  "content": "，您的保证责任"
 },
 {
  "content": "不能免除，但"
 },
 {
  "content": "可主张先诉"
 },
 {
  "content": "抗辩权。"
 },
 {
  "content": "建议核对"
 },
 {
  "content": "借条上的"
 },
 {
  "content": "还款日期及债权人"
 },
 {
  "content": "是否曾起诉"
 },
 {
  "content": "。"
 },
