 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "公司与劳动者签订三年"
 },
 {
  "content": "期劳动合同，先"
 },
 {
  "content": "约定六个月试用期，"
 },
 {
  "content": "后又延长两个月，"
 },
 {
  "content": "总试用期达"
 },
 {
  "content": "八个月。争议"
 },
 {
  "content": "焦点在于：公司"
 },
 {
  "content": "延长试用"
 },
 {
  "content": "期的行为是否合法"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条，"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "；同一用人单位与"
 },
 {
  "content": "同一劳动者只能约定"
 },
 {
  "content": "一次试用期。\n"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第八十三条，"
 },
 {
  "content": "用人单位违反本法规定"
 },
 {
  "content": "与劳动者约定试用"
 },
 {
  "content": "期的，由劳动"
 },
 {
  "content": "行政部门责令改正；违法"
 },
 {
  "content": "约定的试用期已经履"
 },
 {
  "content": "行的，由用人单位"
 },
 {
  "content": "以劳动者试用期满月"
 },
 {
  "content": "工资为标准，按"
 },
 {
  "content": "已经履行的超过"
 },
 {
  "content": "法定试用期的期间"
 },
 {
  "content": "向劳动者支付赔偿"
 },
 {
  "content": "金。\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n第一，试用期"
 },
 {
  "content": "总时长"
 },
 {
  "content": "超过法定上限。"
 },
 {
  "content": "三年"
 },
 {
  "content": "期劳动合同的法定"
 },
 {
  "content": "最长试用"
 },
 {
  "content": "期为六个月，公司将"
 },
 {
  "content": "试用期"
 },
 {
  "content": "延长至八个月，"
 },
 {
  "content": "超出了两个"
 },
 {
  "content": "月的法定上限，"
 },
 {
  "content": "违反了"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条关于试用期长度的"
 },
 {
  "content": "强制性"
 },
 {
  "content": "规定。\n第二"
 },
 {
  "content": "，延长"
 },
 {
  "content": "试用期违反"
 },
 {
  "content": "“一次"
 },
 {
  "content": "试用期"
 },
 {
  "content": "”禁止"
 },
 {
  "content": "性规定。《劳动合同"
 },
 {
  "content": "法》第十九条明确"
 },
 {
  "content": "限定"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期。公司对"
 },
 {
  "content": "试用期进行"
 },
 {
  "content": "延长"
 },
 {
  "content": "，实质上属于"
 },
 {
  "content": "二次"
 },
 {
  "content": "约定试用期，该"
 },
 {
  "content": "行为直接违反了法律的"
 },
 {
  "content": "禁止性规定。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：公司延长试用"
 },
 {
  "content": "期的行为不合法"
 },
 {
  "content": "。\n法律风险"
 },
 {
  "content": "：根据《劳动合同"
 },
 {
  "content": "法》第八十三条"
 },
 {
  "content": "，对于"
 },
 {
  "content": "违法履"
 },
 {
  "content": "行的试用期"
 },
 {
  "content": "（即超"
 },
 {
  "content": "出的两个月），劳动者"
 },
 {
  "content": "有权要求公司支付"
 },
 {
  "content": "赔偿金。赔偿"
 },
 {
  "content": "金"
 },
 {
  "content": "的标准"
 },
 {
  "content": "为"
 },
 {
  "content": "试用期"
 },
 {
  "content": "满月工资，计算"
 },
 {
  "content": "期间"
 },
 {
  "content": "为已经"
 },
 {
  "content": "履行的超过法定"
 },
 {
  "content": "试用期的期间（"
 },
 {
  "content": "即两个月）。此外"
 },
 {
  "content": "，劳动行政部门可"
 },
 {
  "content": "责令公司改正"
 },
 {
  "content": "违法行为。\n\n本"
 },
 {
