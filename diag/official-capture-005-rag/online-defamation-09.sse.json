 {
  "content": "，导致您的工作"
 },
 {
  "content": "受影响。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "该"
 },
 {
  "content": "言论"
 },
 {
  "content": "是否构成名誉侵权"
 },
 {
  "content": "；转发者是否"
 },
 {
  "content": "承担连带责任；"
 },
 {
  "content": "捏造骗"
 },
 {
  "content": "钱事实是否涉嫌"
 },
 {
  "content": "刑事犯罪。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十五条"
 },
 {
  "content": "，行为人因"
 },
 {
  "content": "过错侵害他人民"
 },
 {
  "content": "事权益造成损害"
 },
 {
  "content": "的，应当承担"
 },
 {
  "content": "侵权责任。\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十八条"
 },
 {
  "content": "，二人以上共同"
 },
 {
  "content": "实施侵权行为，"
 },
 {
  "content": "造成他人损害的"
 },
 {
  "content": "，应当承担连带"
 },
 {
  "content": "责任。\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百七十一条，"
 },
 {
  "content": "二人以上分别实施"
 },
 {
  "content": "侵权行为造成同一"
 },
 {
  "content": "损害，每个人的侵权"
 },
 {
  "content": "行为都足以造成"
 },
 {
  "content": "全部损害的，"
 },
 {
  "content": "行为人承担连带"
 },
 {
  "content": "责任。\n根据"
 },
 {
  "content": "《刑法》第二百四"
 },
 {
  "content": "十三条，捏造"
 },
 {
  "content": "事实诬告陷害"
 },
 {
  "content": "他人，意图使"
 },
 {
  "content": "他人受刑事追究"
 },
 {
  "content": "，情节严重的，处"
 },
 {
  "content": "三年以下有期徒刑、"
 },
 {
  "content": "拘役或者管制"
 },
 {
  "content": "；造成严重后果的"
 },
 {
  "content": "，处三年以上十年"
 },
 {
  "content": "以下有期徒刑。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，同事"
 },
 {
  "content": "捏造“骗"
 },
 {
  "content": "钱”事实并在"
 },
 {
  "content": "群内散布，"
 },
 {
  "content": "主观上"
 },
 {
  "content": "存在过错，客观"
 },
 {
  "content": "上损害了您的"
 },
 {
  "content": "名誉并影响了工作"
 },
 {
  "content": "，依据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十五条，已"
 },
 {
  "content": "构成名誉权侵权"
 },
 {
  "content": "，您可要求其"
 },
 {
  "content": "停止侵害、恢复"
 },
 {
  "content": "名誉、赔礼"
 },
 {
  "content": "道歉及赔偿损失"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "关于转发者的"
 },
 {
  "content": "责任，若转发"
 },
 {
  "content": "者与同事存在共同"
 },
 {
  "content": "故意，依据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十八条，需"
 },
 {
  "content": "承担连带责任；"
 },
 {
  "content": "若转发者分别"
 },
 {
  "content": "实施侵权行为且"
 },
 {
  "content": "各自行为足以造成"
 },
 {
  "content": "全部损害，依据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百七十一条，"
 },
 {
  "content": "亦需承担连带"
 },
 {
  "content": "责任。\n最后"
 },
 {
  "content": "，捏造“"
 },
 {
  "content": "骗钱”属于"
 },
 {
  "content": "虚构犯罪事实。"
 },
 {
  "content": "若同事不仅"
 },
 {
  "content": "散布，还"
 },
 {
  "content": "向公安机关告"
 },
 {
  "content": "发，意图使"
 },
 {
  "content": "您受刑事追究"
 },
 {
  "content": "且情节严重，"
 },
 {
  "content": "则可能触犯"
 },
 {
  "content": "《刑法》第二百四"
 },
 {
  "content": "十三条的诬告"
 },
 {
  "content": "陷害罪。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n您可采取民事"
 },
 {
  "content": "起诉要求赔偿"
 },
 {
  "content": "，或向公安机关"
 },
 {
  "content": "报案追究其"
