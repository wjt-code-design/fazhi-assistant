[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "用户骑电动车被"
 },
 {
  "content": "右转货车撞伤"
 },
 {
  "content": "，货车方以"
 },
 {
  "content": "用户未戴头盔"
 },
 {
  "content": "为由拒绝赔偿。"
 },
 {
  "content": "本案争议焦点在于"
 },
 {
  "content": "：受害人"
 },
 {
  "content": "未戴头盔是否"
 },
 {
  "content": "构成法定的免责"
 },
 {
  "content": "或减责"
 },
 {
  "content": "事由，从而"
 },
 {
  "content": "免除货车的"
 },
 {
  "content": "赔偿责任。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "七十四条：损害"
 },
 {
  "content": "是因受害人故意造成的"
 },
 {
  "content": "，行为人不承担责任"
 },
 {
  "content": "。\n《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条：机动车发生"
 },
 {
  "content": "交通事故造成损害，"
 },
 {
  "content": "属于该机动车一方"
 },
 {
  "content": "责任的，先由"
 },
 {
  "content": "承保机动车强制保险"
 },
 {
  "content": "的保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿；不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "仍然不足或者没有"
 },
 {
  "content": "投保机动车商业保险"
 },
 {
  "content": "的，由侵权"
 },
 {
  "content": "人赔偿。\n"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第五十一条：机动车"
 },
 {
  "content": "行驶时，驾驶人"
 },
 {
  "content": "、乘坐人员应当"
 },
 {
  "content": "按规定使用安全带，"
 },
 {
  "content": "摩托车驾驶人及乘坐"
 },
 {
  "content": "人员应当按规定戴"
 },
 {
  "content": "安全头盔。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n第一，未"
 },
 {
  "content": "戴头盔不构成"
 },
 {
  "content": "“受害人故意”，"
 },
 {
  "content": "不能免除赔偿责任。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百七十四条"
 },
 {
  "content": "，行为人免责"
 },
 {
  "content": "的前提是损害由"
 },
 {
  "content": "受害人“故意”"
 },
 {
  "content": "造成。未戴"
 },
 {
  "content": "头盔属于违反交通"
 },
 {
  "content": "管理规定的行为，"
 },
 {
  "content": "并非故意造成交通事故"
 },
 {
  "content": "或故意自伤"
 },
 {
  "content": "，因此货车方"
 },
 {
  "content": "不能以此为由主张"
 },
 {
  "content": "完全免责。\n第二，未戴"
 },
 {
  "content": "头盔与事故发生通常"
 },
 {
  "content": "无因果关系，"
 },
 {
  "content": "仅可能影响损害"
 },
 {
  "content": "扩大的责任"
 },
 {
  "content": "分担。右转货车"
 },
 {
  "content": "依法应当让"
 },
 {
  "content": "行"
 },
 {
  "content": "直行车辆，事故"
 },
 {
  "content": "责任"
 },
 {
  "content": "通常在于"
 },
 {
  "content": "货车一方。未"
 },
 {
  "content": "戴头盔一般不会"
 },
 {
  "content": "导致事故发生，但"
 },
 {
  "content": "如果是因未戴"
 },
 {
  "content": "头盔导致头部损伤"
 },
 {
  "content": "加重，司法实践中"
 },
 {
  "content": "可能依据过失相"
 },
 {
  "content": "抵原则，适当"
 },
 {
  "content": "减轻侵权人对“"
 },
 {
  "content": "扩大损害”部分的"
 },
 {
  "content": "赔偿责任，但这与"
 },
 {
  "content": "“完全不赔”"
 },
 {
  "content": "是两回事。"
 },
 {
  "content": "\n第三，国家法律"
 },
 {
  "content": "未强制要求电动车"
 },
 {
  "content": "驾驶人员佩戴头盔"
 },
 {
  "content": "。根据《道路交通安全"
 },
 {
  "content": "法》第五十一条"
 },
 {
  "content": "，仅规定摩托车"
 },
 {
  "content": "驾驶人及乘坐人员"
 },
 {
  "content": "应当戴安全头盔"
 },
 {
  "content": "，并未规定"
 },
 {
  "content": "电动车驾驶人员必须"
 },
 {
  "content": "佩戴（"
 },
 {
  "content": "是否强制"
 },
 {
  "content": "需看地方性"
 },
 {
  "content": "规定，但题目"
 },
 {
  "content": "未提供）。\n第四"
 },
 {
  "content": "，赔偿顺位"
 },
 {
  "content": "有明确规定"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条，只要属于"
 },
 {
  "content": "货车一方责任，"
 },
 {
  "content": "应先由交"
 },
 {
  "content": "强险在限额"
 },
 {
  "content": "内赔付，不足"
 },
 {
  "content": "部分由商业险"
 },
 {
  "content": "或货车方赔偿"
 },
 {
  "content": "，不存在“不"
 },
 {
  "content": "赔”的法律空间"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：货车方以"
 },
 {
  "content": "没戴头盔为由"
 },
 {
  "content": "拒绝赔偿没有法律"
 },
 {
  "content": "依据，用户有权"
 },
 {
  "content": "主张赔偿。\n"
 },
 {
  "content": "风险提示：虽然"
 },
 {
  "content": "未戴头盔不能"
 },
 {
  "content": "成为拒"
 },
 {
  "content": "赔理由，但如果"
 },
 {
  "content": "因未戴头盔"
 },
 {
  "content": "导致伤"
 },
 {
  "content": "情加重，法院"
 },
 {
  "content": "在划分具体"
 },
 {
  "content": "赔偿金额时，"
 },
 {
  "content": "可能会认定用户对"
 },
 {
  "content": "损害扩大存在一定"
 },
 {
  "content": "过错，从而适当"
 },
 {
  "content": "减轻侵权人对加重"
 },
 {
  "content": "部分的赔偿责任。建议"
 },
 {
  "content": "用户及时报警获取"
 },
 {
  "content": "事故认定书，"
 },
 {
  "content": "若协商不成，"
 },
 {
  "content": "可请求交"
 },
 {
  "content": "管部门调解或"
 },
 {
  "content": "向人民法院提起民事诉讼"
 },
 {
  "content": "。"
 },
