  "content": "①案情与争议"
 },
 {
  "content": "焦点\n业主与"
 },
 {
  "content": "装修公司签订装修合同"
 },
 {
  "content": "后，装修公司拖延"
 },
 {
  "content": "工期两个月，并以"
 },
 {
  "content": "材料涨价为由单"
 },
 {
  "content": "方要求加价，"
 },
 {
  "content": "否则拒绝继续施工"
 },
 {
  "content": "。本案争议焦点"
 },
 {
  "content": "为：1."
 },
 {
  "content": " 工期延误"
 },
 {
  "content": "的违约责任认定"
 },
 {
  "content": "；2. "
 },
 {
  "content": "装修公司单方要求"
 },
 {
  "content": "加价并停工"
 },
 {
  "content": "的行为是否"
 },
 {
  "content": "合法。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第八百"
 },
 {
  "content": "零一条规定，"
 },
 {
  "content": "因施工人的原因"
 },
 {
  "content": "致使建设工程质量不符合"
 },
 {
  "content": "约定的，发包人"
 },
 {
  "content": "有权请求施工人在"
 },
 {
  "content": "合理期限内无偿修理"
 },
 {
  "content": "或者返工、"
 },
 {
  "content": "改建；经过修理"
 },
 {
  "content": "或者返工、"
 },
 {
  "content": "改建后，造成"
 },
 {
  "content": "逾期交付的，"
 },
 {
  "content": "施工人应当承担"
 },
 {
  "content": "违约责任。根据"
 },
 {
  "content": "《民法典》第八百"
 },
 {
  "content": "零五条规定，"
 },
 {
  "content": "因发包人变更"
 },
 {
  "content": "计划，提供的资料"
 },
 {
  "content": "不准确，或者"
 },
 {
  "content": "未按照期限提供"
 },
 {
  "content": "必需的勘察、设计"
 },
 {
  "content": "工作条件而造成勘察"
 },
 {
  "content": "、设计的返工"
 },
 {
  "content": "、停工或者修改"
 },
 {
  "content": "设计，发包人"
 },
 {
  "content": "应当按照勘察人、"
 },
 {
  "content": "设计人实际消耗"
 },
 {
  "content": "的工作量增付"
 },
 {
  "content": "费用。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，关于工期"
 },
 {
  "content": "延误。装修公司作为"
 },
 {
  "content": "施工人，若"
 },
 {
  "content": "因其自身原因导致"
 },
 {
  "content": "工期拖延两个月，"
 },
 {
  "content": "属于违约行为。"
 },
 {
  "content": "参照"
 },
 {
  "content": "《民法典》第八百"
 },
 {
  "content": "零一条的逻辑，"
 },
 {
  "content": "因施工人原因"
 },
 {
  "content": "造成逾期交付的"
 },
 {
  "content": "，施工人应当"
 },
 {
  "content": "承担违约责任，"
 },
 {
  "content": "业主有权要求其"
 },
 {
  "content": "赔偿因此"
 },
 {
  "content": "造成的"
 },
 {
  "content": "停工"
 },
 {
  "content": "、"
 },
 {
  "content": "窝工等损失"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "关于单方加价"
 },
 {
  "content": "与停工。材料"
 },
 {
  "content": "涨价通常属于商业"
 },
 {
  "content": "风险，并"
 },
 {
  "content": "非法定的合同变更"
 },
 {
  "content": "或增付"
 },
 {
  "content": "费用事"
 },
 {
  "content": "由。根据《"
 },
 {
  "content": "民法典》第八百零"
 },
 {
  "content": "五条的规定，"
 },
 {
  "content": "只有在因"
 },
 {
  "content": "发包人变更计划"
 },
 {
  "content": "、提供资料不"
 },
 {
  "content": "准确等发包人"
 },
 {
  "content": "原因导致停工、"
 },
 {
  "content": "返工时，"
 },
 {
  "content": "发包人才负有"
 },
 {
  "content": "增付费用的义务"
 },
 {
  "content": "。装修公司仅以"
 },
 {
  "content": "材料涨价为由要求"
 },
 {
  "content": "加价，缺乏法律"
 },
 {
  "content": "依据。"
 },
 {
  "content": "其以停工相"
 },
 {
  "content": "威胁，属于滥用"
 },
 {
  "content": "权利，构成"
 },
 {
  "content": "违约。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：装修公司"
 },
 {
  "content": "拖延工期并单"
 },
 {
  "content": "方要求加价否则"
 },
 {
  "content": "停工的行为构成违约"
 },
 {
  "content": "，业主有权拒绝"
 },
 {
  "content": "加价，并要求其"
 },
 {
  "content": "继续履行合同并"
 },
 {
  "content": "承担逾期交付"
 },
 {
  "content": "的违约责任。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "若双方"
 },
 {
  "content": "签订"
 },
 {
  "content": "的合同中明确约"
 },
 {
  "content": "定了材料价格波动"
 },
 {
  "content": "可调整价款的"
 },
 {
  "content": "条款"
 },
 {
  "content": "，则装修公司的"
 },
 {
  "content": "加价主张可能"
 },
 {
  "content": "具有"
 },
 {
  "content": "合同"
 },
 {
  "content": "依据，需结合"
 },
 {
  "content": "具体合同条款判定"
 },
 {
  "content": "。此外，若"
 },
 {
  "content": "装修公司的停工行为"
 },
 {
  "content": "导致合同目的不能"
 },
 {
  "content": "实现，业主可"
 },
 {
  "content": "依法主张解除合同"
 },
 {
  "content": "并要求赔偿，但"
 },
 {
  "content": "需注意固定对方"
 },
 {
  "content": "违约的证据"
 },
 {
  "content": "。"
