[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案为两"
 },
 {
  "content": "机动车追尾事故"
 },
 {
  "content": "，交警已"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任。争议"
 },
 {
  "content": "焦点在于前车"
 },
 {
  "content": "损失的赔偿义务主体"
 },
 {
  "content": "及具体"
 },
 {
  "content": "赔偿顺位。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《道路交通安全"
 },
 {
  "content": "法》第七十六条"
 },
 {
  "content": "第一款第（一"
 },
 {
  "content": "）项，机动车"
 },
 {
  "content": "之间发生交通事故的"
 },
 {
  "content": "，由有过错"
 },
 {
  "content": "的一方承担赔偿责任；"
 },
 {
  "content": "双方都有过错的"
 },
 {
  "content": "，按照各自过错"
 },
 {
  "content": "的比例分担责任。"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条，机动车发生"
 },
 {
  "content": "交通事故造成损害，"
 },
 {
  "content": "属于该机动车一方"
 },
 {
  "content": "责任的，先由"
 },
 {
  "content": "承保机动车强制保险"
 },
 {
  "content": "的保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿；不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "仍然不足或者没有"
 },
 {
  "content": "投保机动车商业保险"
 },
 {
  "content": "的，由侵权"
 },
 {
  "content": "人赔偿。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，关于"
 },
 {
  "content": "责任主体。本案"
 },
 {
  "content": "中后车被"
 },
 {
  "content": "认定负全部"
 },
 {
  "content": "责任，即后"
 },
 {
  "content": "车一方对"
 },
 {
  "content": "事故的发生"
 },
 {
  "content": "存在全部"
 },
 {
  "content": "过错。"
 },
 {
  "content": "依据《道路交通安全法"
 },
 {
  "content": "》第七十六条，"
 },
 {
  "content": "应由有过错的后"
 },
 {
  "content": "车一方承担前"
 },
 {
  "content": "车的"
 },
 {
  "content": "损失赔偿责任。\n"
 },
 {
  "content": "其次，关于赔偿"
 },
 {
  "content": "顺位。依据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十三条，"
 },
 {
  "content": "赔偿需按"
 },
 {
  "content": "法定顺"
 },
 {
  "content": "位进行：第一"
 },
 {
  "content": "顺位是由"
 },
 {
  "content": "后车承保交"
 },
 {
  "content": "强险的保险公司"
 },
 {
  "content": "，在交强"
 },
 {
  "content": "险责任限额范围内"
 },
 {
  "content": "对前车损失"
 },
 {
  "content": "予以"
 },
 {
  "content": "赔偿；第二顺"
 },
 {
  "content": "位是如果前"
 },
 {
  "content": "车损失超过"
 },
 {
  "content": "交强险限额"
 },
 {
  "content": "，则由后车"
 },
 {
  "content": "承保商业险的"
 },
 {
  "content": "保险公司按照保险合同约定"
 },
 {
  "content": "予以赔偿；第三"
 },
 {
  "content": "顺位是如果"
 },
 {
  "content": "损失仍不足，"
 },
 {
  "content": "或者后车根本没有"
 },
 {
  "content": "投保商业险，"
 },
 {
  "content": "则由后车车主"
 },
 {
  "content": "或驾驶员（侵权"
 },
 {
  "content": "人）自行承担"
 },
 {
  "content": "剩余部分的赔偿"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：前车的损失"
 },
 {
  "content": "，先"
 },
 {
  "content": "由后车的交"
 },
 {
  "content": "强险在限额"
 },
 {
  "content": "内赔付，不足"
 },
 {
  "content": "部分由后车的"
 },
 {
  "content": "商业险赔付，"
 },
 {
  "content": "仍不足或没有"
 },
 {
  "content": "商业险的，"
 },
 {
  "content": "由后车车主"
 },
 {
  "content": "或驾驶员（侵权"
 },
 {
  "content": "人）赔偿。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "若后车未"
 },
 {
  "content": "投保商业三者险"
 },
 {
  "content": "或保额不足"
 },
 {
  "content": "，且侵权人"
 },
 {
  "content": "个人经济能力有限"
 },
 {
  "content": "，前车可能"
 },
 {
  "content": "面临无法全额"
 },
 {
  "content": "获赔的执行难"
 },
 {
  "content": "风险。此外，"
 },
 {
  "content": "理赔过程中需"
 },
 {
  "content": "及时固定"
 },
 {
  "content": "损失证据，避免"
 },
 {
  "content": "因证据缺失"
 },
 {
  "content": "导致理赔受阻。"
 },
 {
  "content": "\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
