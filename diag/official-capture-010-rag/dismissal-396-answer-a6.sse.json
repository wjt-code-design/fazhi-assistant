 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，员工存在多次"
 },
 {
  "content": "旷工的事实，"
 },
 {
  "content": "公司依据经"
 },
 {
  "content": "民主程序制定并已"
 },
 {
  "content": "公示的规章制度解除"
 },
 {
  "content": "劳动合同，且履行"
 },
 {
  "content": "了通知工会的"
 },
 {
  "content": "程序。核心"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "用人单位依据劳动者严重"
 },
 {
  "content": "违反规章制度解除劳动合同"
 },
 {
  "content": "，是否需要支付经济"
 },
 {
  "content": "补偿或赔偿金"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n主要"
 },
 {
  "content": "依据《劳动合同法"
 },
 {
  "content": "》第三十九条、"
 },
 {
  "content": "第四十三条、第四"
 },
 {
  "content": "十六条及第八十七条"
 },
 {
  "content": "。\n\n③ "
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，关于解除"
 },
 {
  "content": "的合法性。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第三十九条第（"
 },
 {
  "content": "二）项，"
 },
 {
  "content": "劳动者严重违反用人"
 },
 {
  "content": "单位的规章制度的，"
 },
 {
  "content": "用人单位可以解除劳动合同"
 },
 {
  "content": "。员工多次旷"
 },
 {
  "content": "工，若该"
 },
 {
  "content": "行为符合公司依法"
 },
 {
  "content": "制定的规章制度中关于"
 },
 {
  "content": "“严重违反”"
 },
 {
  "content": "的界定，公司"
 },
 {
  "content": "据此解除"
 },
 {
  "content": "属于合法解除"
 },
 {
  "content": "。\n第二，"
 },
 {
  "content": "关于解除程序。"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第四十三条，"
 },
 {
  "content": "用人单位单方解除"
 },
 {
  "content": "劳动合同，应当事先"
 },
 {
  "content": "将理由通知工会"
 },
 {
  "content": "。公司已通知工会"
 },
 {
  "content": "并留存证据，"
 },
 {
  "content": "程序合法。"
 },
 {
  "content": "\n第三，关于"
 },
 {
  "content": "经济补偿。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第四十六条，用人单位"
 },
 {
  "content": "应当支付经济补偿"
 },
 {
  "content": "的情形包括"
 },
 {
  "content": "劳动者被迫解除、"
 },
 {
  "content": "协商一致"
 },
 {
  "content": "解除、无过失"
 },
 {
  "content": "性解除及裁员"
 },
 {
  "content": "等，但不包含"
 },
 {
  "content": "依据第三十九条过失"
 },
 {
  "content": "性解除的情形。"
 },
 {
  "content": "因此，公司无需"
 },
 {
  "content": "支付经济补偿。"
 },
 {
  "content": "\n第四，关于"
 },
 {
  "content": "赔偿金。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十七条，用人单位"
 },
 {
  "content": "违反本法规定解除"
 },
 {
  "content": "或者终止劳动合同的"
 },
 {
  "content": "，应当支付赔偿"
 },
 {
  "content": "金。本案解除"
 },
 {
  "content": "事实清楚"
 },
 {
  "content": "、依据充分"
 },
 {
  "content": "、程序合法，"
 },
 {
  "content": "不构成违法解除"
 },
 {
  "content": "，故无需支付"
 },
 {
  "content": "赔偿金。\n\n"
 },
 {
  "content": "④ 结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "公司无需支付经济"
 },
 {
  "content": "补偿或赔偿金"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：虽然本案"
 },
 {
  "content": "解除程序完备"
 },
 {
  "content": "，但在司法实践中"
 },
 {
  "content": "，仲裁或法院"
 },
 {
  "content": "仍会对规章制度的"
 },
 {
  "content": "合法性、旷"
 },
 {
  "content": "工事实的严重"
 },
 {
  "content": "程度进行实质"
 },
 {
  "content": "审查。若规章制度"
 },
 {
  "content": "中未明确旷"
 },
 {
  "content": "工多少次属于“"
 },
 {
  "content": "严重违反”，或者"
 },
 {
  "content": "旷工天数"
 },
 {
  "content": "计算存在争议"
 },
 {
  "content": "，仍可能"
 },
 {
  "content": "面临被认定为违法"
 },
 {
  "content": "解除的风险。建议"
 },
 {
  "content": "公司完善规章制度，"
 },
 {
  "content": "明确“严重违反"
 },
 {
  "content": "”的具体标准。"
 },
