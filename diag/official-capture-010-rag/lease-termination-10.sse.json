[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "房东因租客晚"
 },
 {
  "content": "交两天房租，"
 },
 {
  "content": "在未通知的情况下更换"
 },
 {
  "content": "门锁，并拒绝"
 },
 {
  "content": "退还押金。本案"
 },
 {
  "content": "争议焦点为："
 },
 {
  "content": "房东未通知即"
 },
 {
  "content": "换锁的行为是否"
 },
 {
  "content": "合法；房东以"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "为由拒绝退还押金"
 },
 {
  "content": "是否具有法律依据"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第七百二十二"
 },
 {
  "content": "条，承租人无"
 },
 {
  "content": "正当理由未支付或者迟延支付"
 },
 {
  "content": "租金的，出租"
 },
 {
  "content": "人可以请求承租人在"
 },
 {
  "content": "合理期限内支付；"
 },
 {
  "content": "承租人逾期不支付的，"
 },
 {
  "content": "出租人可以解除合同"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n关于"
 },
 {
  "content": "换锁行为的合法性"
 },
 {
  "content": "：晚交两天"
 },
 {
  "content": "房租属于迟延"
 },
 {
  "content": "支付租金。依据"
 },
 {
  "content": "上述法律规定，出租"
 },
 {
  "content": "人解除合同有"
 },
 {
  "content": "法定前置程序，"
 },
 {
  "content": "即必须先请求承租"
 },
 {
  "content": "人在“合理期限内"
 },
 {
  "content": "”进行催"
 },
 {
  "content": "告，只有在承租人"
 },
 {
  "content": "逾期仍不支付"
 },
 {
  "content": "的情况下，出租人才"
 },
 {
  "content": "有权解除合同。"
 },
 {
  "content": "房东未履行"
 },
 {
  "content": "催告程序直接"
 },
 {
  "content": "换锁，不符合"
 },
 {
  "content": "法定解除程序，"
 },
 {
  "content": "该行为"
 },
 {
  "content": "存在被认定为违法"
 },
 {
  "content": "阻碍承租人使用租赁"
 },
 {
  "content": "物的风险。\n"
 },
 {
  "content": "关于押金退还："
 },
 {
  "content": "您提供的《"
 },
 {
  "content": "电子商务法》第二十一条"
 },
 {
  "content": "及第七十八条主要针对"
 },
 {
  "content": "电子商务经营者的押金"
 },
 {
  "content": "退还，不直接"
 },
 {
  "content": "适用于传统房屋租赁。"
 },
 {
  "content": "但在传统租赁中"
 },
 {
  "content": "，押金通常用于"
 },
 {
  "content": "担保房屋损坏或"
 },
 {
  "content": "欠租等。"
 },
 {
  "content": "房东仅因晚"
 },
 {
  "content": "交两天租金且"
 },
 {
  "content": "未造成其他"
 },
 {
  "content": "损失的情况下直接"
 },
 {
  "content": "没收押金，缺乏"
 },
 {
  "content": "充分的法律依据。"
 },
 {
  "content": "若租客不存在"
 },
 {
  "content": "其他违约行为，"
 },
 {
  "content": "房东扣留押金可能"
 },
 {
  "content": "构成不当得利。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "房东未通知即"
 },
 {
  "content": "换锁的行为不符合"
 },
 {
  "content": "法定程序，拒绝"
 },
 {
  "content": "退还押金缺乏充分"
 },
 {
  "content": "依据。\n风险"
 },
 {
  "content": "提示：房东擅自"
 },
 {
  "content": "换锁可能面临"
 },
 {
  "content": "非法阻碍他人"
 },
 {
  "content": "使用租赁物或"
 },
 {
  "content": "违约的法律风险，"
 },
 {
  "content": "需承担相应责任"
 },
 {
  "content": "；租客应"
 },
 {
  "content": "保留租金"
 },
 {
  "content": "支付记录、换"
 },
 {
  "content": "锁证据等，"
 },
 {
  "content": "通过协商或诉讼"
 },
 {
  "content": "要求房东"
 },
 {
  "content": "退还押金并赔偿"
 },
 {
  "content": "因换"
 },
 {
  "content": "锁造成的损失。"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
