[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n本案"
 },
 {
  "content": "中，公司拖欠"
 },
 {
  "content": "供应商货款，法定代表人"
 },
 {
  "content": "要求股东个人签署"
 },
 {
  "content": "承诺。争议"
 },
 {
  "content": "焦点在于：供应商"
 },
 {
  "content": "能否越过公司，"
 },
 {
  "content": "直接起诉股东个人"
 },
 {
  "content": "要求其承担付款"
 },
 {
  "content": "责任。\n\n②"
 },
 {
  "content": "法律依据\n主要"
 },
 {
  "content": "依据《公司法》"
 },
 {
  "content": "第二十三条关于法人人格"
 },
 {
  "content": "独立及否认的规定"
 },
 {
  "content": "，以及《民法典"
 },
 {
  "content": "》第五百零九"
 },
 {
  "content": "条、第五百七"
 },
 {
  "content": "十七条关于合同履行"
 },
 {
  "content": "及违约责任的规定"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n一"
 },
 {
  "content": "、原则上，供应商"
 },
 {
  "content": "不能直接起诉股东"
 },
 {
  "content": "。根据《公司法"
 },
 {
  "content": "》第二十三条，公司"
 },
 {
  "content": "是企业法人，有"
 },
 {
  "content": "独立的法人财产，"
 },
 {
  "content": "公司以其全部财产"
 },
 {
  "content": "对公司的债务承担责任"
 },
 {
  "content": "。股东仅以"
 },
 {
  "content": "出资额为限对公司"
 },
 {
  "content": "承担责任，公司债务"
 },
 {
  "content": "与股东个人财产"
 },
 {
  "content": "相互独立。因此"
 },
 {
  "content": "，供应商通常只能"
 },
 {
  "content": "向公司主张货款"
 },
 {
  "content": "。\n\n二"
 },
 {
  "content": "、例外"
 },
 {
  "content": "情形下，供应商"
 },
 {
  "content": "可以直接起诉股东。"
 },
 {
  "content": "\n1. "
 },
 {
  "content": "股东滥用法人独立"
 },
 {
  "content": "地位。根据《"
 },
 {
  "content": "公司法》第二十三条，"
 },
 {
  "content": "公司股东滥用公司"
 },
 {
  "content": "法人独立地位和"
 },
 {
  "content": "股东有限责任，逃避"
 },
 {
  "content": "债务，严重损害"
 },
 {
  "content": "公司债权人利益的，"
 },
 {
  "content": "应当对公司债务承担"
 },
 {
  "content": "连带责任。此外"
 },
 {
  "content": "，只有一个股东的公司"
 },
 {
  "content": "，股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己的财产的"
 },
 {
  "content": "，应当对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "若存在此类"
 },
 {
  "content": "情形，供应商可"
 },
 {
  "content": "诉请"
 },
 {
  "content": "股东承担连带责任"
 },
 {
  "content": "。\n2."
 },
 {
  "content": " 股东签署承诺"
 },
 {
  "content": "构成债务加入或"
 },
 {
  "content": "保证。法定代表人要求"
 },
 {
  "content": "股东签署承诺，"
 },
 {
  "content": "若该承诺明确"
 },
 {
  "content": "表示股东自愿为公司"
 },
 {
  "content": "债务承担连带清偿"
 },
 {
  "content": "责任（构成"
 },
 {
  "content": "债务加入或保证"
 },
 {
  "content": "），则该"
 },
 {
  "content": "承诺在股东与"
 },
 {
  "content": "供应商之间成立合同"
 },
 {
  "content": "关系。根据《"
 },
 {
  "content": "民法典》第五百零"
 },
 {
  "content": "九条及第五百"
 },
 {
  "content": "七十七条，供应商"
 },
 {
  "content": "可依据该承诺"
 },
 {
  "content": "直接起诉股东，"
 },
 {
  "content": "要求其依约"
 },
 {
  "content": "承担付款"
 },
 {
  "content": "责任。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：供应商原则上"
 },
 {
  "content": "不能直接起诉股东"
 },
 {
  "content": "，但若存在股东"
 },
 {
  "content": "滥用法人独立地位"
 },
 {
  "content": "逃避债务的情形，"
 },
 {
  "content": "或股东签署的"
 },
 {
  "content": "承诺构成债务加入"
 },
 {
  "content": "/保证，则"
 },
 {
  "content": "供应商可以直接起诉股东"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：股东在签署"
 },
 {
  "content": "承诺前务必审查"
 },
 {
  "content": "承诺内容，一旦"
 },
 {
  "content": "签署含有"
 },
 {
  "content": "债务加入"
 },
 {
  "content": "或保证意思的"
 },
 {
  "content": "承诺，将面临"
 },
 {
  "content": "以个人财产清偿"
 },
 {
  "content": "公司债务的重大风险"
 },
 {
  "content": "。"
 },
