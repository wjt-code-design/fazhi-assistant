 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n您骑"
 },
 {
  "content": "电动车被右转货车"
 },
 {
  "content": "撞伤，货车"
 },
 {
  "content": "方以您未"
 },
 {
  "content": "戴头盔为由拒绝"
 },
 {
  "content": "赔偿。本案"
 },
 {
  "content": "争议"
 },
 {
  "content": "焦点在于：未"
 },
 {
  "content": "戴头盔是否构成"
 },
 {
  "content": "货车方免除"
 },
 {
  "content": "或"
 },
 {
  "content": "减轻"
 },
 {
  "content": "赔偿"
 },
 {
  "content": "责任的法定事由"
 },
 {
  "content": "，以及赔偿顺"
 },
 {
  "content": "位如何确定。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n《道路交通安全"
 },
 {
  "content": "法》第五十一条"
 },
 {
  "content": "、《民法典》第一千"
 },
 {
  "content": "一百七十四条、《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条、《民法典"
 },
 {
  "content": "》第一千一百八"
 },
 {
  "content": "十二条、《道路交通安全法"
 },
 {
  "content": "》第七十四条。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，货车方“"
 },
 {
  "content": "没戴头盔就不赔”的理由不能"
 },
 {
  "content": "完全成立。根据"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第五十一条，电动车"
 },
 {
  "content": "骑乘人员应当"
 },
 {
  "content": "按规定戴安全头盔"
 },
 {
  "content": "，您未戴"
 },
 {
  "content": "头盔确实违反了"
 },
 {
  "content": "道路通行规定。"
 },
 {
  "content": "但是，根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "七十四条，只有"
 },
 {
  "content": "损害是因受害人“"
 },
 {
  "content": "故意”造成的，"
 },
 {
  "content": "行为人才不承担责任"
 },
 {
  "content": "。您未戴"
 },
 {
  "content": "头盔属于违规行为"
 },
 {
  "content": "，并非“故意"
 },
 {
  "content": "”造成交通事故或"
 },
 {
  "content": "故意"
 },
 {
  "content": "造成"
 },
 {
  "content": "自身伤害，因此"
 },
 {
  "content": "货车方不能据此"
 },
 {
  "content": "完全免除赔偿责任。"
 },
 {
  "content": "\n\n其次，关于"
 },
 {
  "content": "赔偿顺位。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千二百一十三条"
 },
 {
  "content": "，机动车发生交通事故"
 },
 {
  "content": "造成损害，属于"
 },
 {
  "content": "该机动车一方责任的"
 },
 {
  "content": "，先由承保机动车强制保险的"
 },
 {
  "content": "保险人在强制保险"
 },
 {
  "content": "责任限额范围内予以"
 },
 {
  "content": "赔偿；不足部分"
 },
 {
  "content": "，由承保机动车"
 },
 {
  "content": "商业保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由侵权人"
 },
 {
  "content": "赔偿。未"
 },
 {
  "content": "戴头盔并非交"
 },
 {
  "content": "强险或商业"
 },
 {
  "content": "险的法定免责"
 },
 {
  "content": "事由，保险公司"
 },
 {
  "content": "仍需在责任"
 },
 {
  "content": "限额内先行赔付"
 },
 {
  "content": "。\n\n再次，"
 },
 {
  "content": "关于责任划分与损失扩"
 },
 {
  "content": "大的问题。转弯"
 },
 {
  "content": "的机动车应当让"
 },
 {
  "content": "直行的车辆先行"
 },
 {
  "content": "，右转货车撞击"
 },
 {
  "content": "直行电动车，货车"
 },
 {
  "content": "方通常负主要"
 },
 {
  "content": "或全部事故责任"
 },
 {
  "content": "。但需要注意的是，"
 },
 {
  "content": "未戴头盔虽"
 },
 {
  "content": "不导致"
 },
 {
  "content": "全案免责，"
 },
 {
  "content": "却与头部受伤的"
 },
 {
  "content": "损害后果存在关联"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百八"
 },
 {
  "content": "十二条，侵害他人"
 },
 {
  "content": "人身权益造成财产"
 },
 {
  "content": "损失的，按照被"
 },
 {
  "content": "侵权人因此受到的"
 },
 {
  "content": "损失赔偿。在"
 },
 {
  "content": "司法实践中，对于"
 },
 {
  "content": "因未戴头盔"
 },
 {
  "content": "而扩大的头部"
 },
 {
  "content": "伤害损失"
 },
 {
  "content": "，法院可能"
 },
 {
  "content": "认定您对"
 },
 {
  "content": "自身"
 },
 {
  "content": "损害的扩大存在"
 },
 {
  "content": "一定过错，从而"
 },
 {
  "content": "酌情减轻货车方"
 },
 {
  "content": "对该部分损失的赔偿责任"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：对方以"
 },
 {
  "content": "未戴头盔为由"
 },
 {
  "content": "完全拒"
 },
 {
  "content": "赔缺乏法律依据"
 },
 {
  "content": "，您有权主张"
 },
 {
  "content": "赔偿。"
 },
 {
  "content": "\n风险：未"
 },
 {
  "content": "戴头盔可能影响"
 },
 {
  "content": "头部伤害部分的"
 },
 {
  "content": "赔偿比例，法院"
 },
 {
  "content": "可能据此"
 },
 {
  "content": "减轻货车方对"
 },
 {
  "content": "头部伤害扩大部分的"
 },
 {
  "content": "赔偿责任。此外"
 },
 {
  "content": "，如果"
 },
 {
  "content": "对方拒绝协商"
 },
 {
  "content": "，您需要"
 },
 {
  "content": "承担"
 },
 {
  "content": "相应的"
 },
 {
  "content": "举证责任（"
 },
 {
  "content": "如事故"
 },
 {
  "content": "认定书"
 },
 {
  "content": "、医疗记录"
 },
 {
  "content": "等）。若协商"
 },
 {
  "content": "无"
 },
 {
  "content": "果，您可以"
 },
 {
  "content": "根据《道路交通安全法"
 },
 {
  "content": "》第七十四条向"
 },
 {
  "content": "人民法院提起民事诉讼。"
 },
 {
  "content": "\n\n本答复"
 },
