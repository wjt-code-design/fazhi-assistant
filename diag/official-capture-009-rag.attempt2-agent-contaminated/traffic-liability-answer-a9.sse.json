[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "前车的损失由后"
 },
 {
  "content": "车一方进行赔偿"
 },
 {
  "content": "，具体赔偿顺"
 },
 {
  "content": "位如下：\n\n"
 },
 {
  "content": "1. 先"
 },
 {
  "content": "由后车投保"
 },
 {
  "content": "的保险"
 },
 {
  "content": "公司在机动车强制保险"
 },
 {
  "content": "（交强险"
 },
 {
  "content": "）责任限额范围内"
 },
 {
  "content": "予以赔偿；\n"
 },
 {
  "content": "2. 不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "后"
 },
 {
  "content": "车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "\n3. "
 },
 {
  "content": "仍然不足或者后"
 },
 {
  "content": "车没有投保机动车"
 },
 {
  "content": "商业保险的，"
 },
 {
  "content": "由后车的侵权"
 },
 {
  "content": "人（驾驶人"
 },
 {
  "content": "/车主）予以"
 },
 {
  "content": "赔偿。\n\n【"
 },
 {
  "content": "法律依据】\n"
 },
 {
  "content": "根据《道路交通安全法"
 },
 {
  "content": "》第七十六条第一款"
 },
 {
  "content": "第一项规定，"
 },
 {
  "content": "机动车之间发生交通事故"
 },
 {
  "content": "的，由有过"
 },
 {
  "content": "错的一方承担赔偿责任"
 },
 {
  "content": "。本案中交警"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全责，故"
 },
 {
  "content": "应由后车承担"
 },
 {
  "content": "赔偿责任"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条规定，"
 },
 {
  "content": "机动车发生交通事故造成"
 },
 {
  "content": "损害，属于该"
 },
 {
  "content": "机动车一方责任的，"
 },
 {
  "content": "先由承保"
 },
 {
  "content": "机动车强制保险的"
 },
 {
  "content": "保险人在强制保险"
 },
 {
  "content": "责任限额范围内予以"
 },
 {
  "content": "赔偿；不足部分"
 },
 {
  "content": "，由承保机动车"
 },
 {
  "content": "商业保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由侵权人"
 },
 {
  "content": "赔偿。"
 },
