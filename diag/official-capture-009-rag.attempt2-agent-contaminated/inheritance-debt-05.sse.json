[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "父亲去世时遗留"
 },
 {
  "content": "有房产和信用卡"
 },
 {
  "content": "欠款，核心"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "子女作为继承人，"
 },
 {
  "content": "是否必须使用"
 },
 {
  "content": "个人固有财产来"
 },
 {
  "content": "偿还父亲的信用卡债务"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百六十一条，"
 },
 {
  "content": "继承人以所得遗产"
 },
 {
  "content": "实际价值为限"
 },
 {
  "content": "清偿被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务。超过"
 },
 {
  "content": "遗产实际价值部分"
 },
 {
  "content": "，继承人自愿偿还"
 },
 {
  "content": "的不在此限。"
 },
 {
  "content": "继承人放弃继承的"
 },
 {
  "content": "，对被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务可以不负"
 },
 {
  "content": "清偿责任。\n"
 },
 {
  "content": "根据《民事诉讼法"
 },
 {
  "content": "》第二百四十三条，"
 },
 {
  "content": "作为被执行人的公民"
 },
 {
  "content": "死亡的，以其遗产"
 },
 {
  "content": "偿还债务。\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "我国法律确立"
 },
 {
  "content": "的是限定继承原则"
 },
 {
  "content": "。子女仅在继承"
 },
 {
  "content": "遗产（即父亲"
 },
 {
  "content": "留下的房子"
 },
 {
  "content": "）的实际价值范围内"
 },
 {
  "content": "承担清偿"
 },
 {
  "content": "信用卡欠款的责任。"
 },
 {
  "content": "如果房子的价值足以"
 },
 {
  "content": "覆盖信用卡欠款，"
 },
 {
  "content": "则通过变卖"
 },
 {
  "content": "房产清偿即可"
 },
 {
  "content": "；如果信用卡欠款"
 },
 {
  "content": "超过房子的价值，"
 },
 {
  "content": "超出部分子女无需"
 },
 {
  "content": "用自己原有的"
 },
 {
  "content": "个人财产偿还。"
 },
 {
  "content": "\n第二，子女"
 },
 {
  "content": "享有放弃继承的权利"
 },
 {
  "content": "。若父亲的"
 },
 {
  "content": "债务远超遗产价值"
 },
 {
  "content": "，子女可以选择放弃"
 },
 {
  "content": "继承该房产。"
 },
 {
  "content": "一旦依法"
 },
 {
  "content": "放弃继承，则"
 },
 {
  "content": "对父亲的信用卡欠款"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。\n第三，"
 },
 {
  "content": "债务清偿以遗产"
 },
 {
  "content": "为限。父亲的"
 },
 {
  "content": "信用卡债务属于其"
 },
 {
  "content": "个人债务，应"
 },
 {
  "content": "以其遗产（房子"
 },
 {
  "content": "）为限"
 },
 {
  "content": "进行清偿，执行"
 },
 {
  "content": "程序中亦"
 },
 {
  "content": "只能针对"
 },
 {
  "content": "遗产采取措施，不能"
 },
 {
  "content": "直接强制执行子女的个人"
 },
 {
  "content": "财产用于偿还超出"
 },
 {
  "content": "遗产价值的债务。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：子女不需要拿"
 },
 {
  "content": "自己的个人财产偿还"
 },
 {
  "content": "超出父亲遗产价值"
 },
 {
  "content": "部分的信用卡欠款。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "首先，如果"
 },
 {
  "content": "子女自愿代为偿还"
 },
 {
  "content": "超出遗产价值部分的"
 },
 {
  "content": "债务，法律予以"
 },
 {
  "content": "允许；其次，"
 },
 {
  "content": "若房产上设有"
 },
 {
  "content": "抵押权（如"
 },
 {
  "content": "银行按揭未"
 },
 {
  "content": "还清），抵押"
 },
 {
  "content": "权人有权依据"
 },
 {
  "content": "《民法典》第三百"
 },
 {
  "content": "九十四条、第四百"
 },
 {
  "content": "一十条对该房屋"
 },
 {
  "content": "主张优先受偿"
 },
 {
  "content": "，剩余价值"
 },
 {
  "content": "才用于清偿信用卡"
 },
 {
  "content": "债务；最后，"
 },
 {
  "content": "子女在继承"
 },
 {
  "content": "遗产后、清偿"
 },
 {
  "content": "债务前，不得擅自"
 },
 {
  "content": "恶意转移或"
 },
 {
  "content": "隐匿遗产，否则"
 },
 {
  "content": "可能面临债权人主张"
 },
 {
  "content": "权利的风险。"
 },
