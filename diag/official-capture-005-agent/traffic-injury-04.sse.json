[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n您"
 },
 {
  "content": "骑电动车被右转"
 },
 {
  "content": "货车撞伤，"
 },
 {
  "content": "货车方以您"
 },
 {
  "content": "未戴头盔为由"
 },
 {
  "content": "拒绝赔偿。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "未戴头盔是否"
 },
 {
  "content": "构成货车方免责"
 },
 {
  "content": "或减责的"
 },
 {
  "content": "法定事由，"
 },
 {
  "content": "以及赔偿责任应如何"
 },
 {
  "content": "承担。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "道路交通安全法》第五"
 },
 {
  "content": "十一条、《民法典》"
 },
 {
  "content": "第一千一百七十四条"
 },
 {
  "content": "、第一千二百零"
 },
 {
  "content": "八条、第一千"
 },
 {
  "content": "二百一十三条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n第一，"
 },
 {
  "content": "关于未戴头盔"
 },
 {
  "content": "的法律定性"
 },
 {
  "content": "。根据《道路交通安全"
 },
 {
  "content": "法》第五十一条"
 },
 {
  "content": "，仅规定“"
 },
 {
  "content": "摩托车驾驶人及乘坐"
 },
 {
  "content": "人员应当按规定戴"
 },
 {
  "content": "安全头盔”，并未"
 },
 {
  "content": "规定非"
 },
 {
  "content": "机动车（电动车）"
 },
 {
  "content": "骑乘人员必须"
 },
 {
  "content": "戴头盔。因此"
 },
 {
  "content": "，您未戴"
 },
 {
  "content": "头盔通常不构成"
 },
 {
  "content": "违法行为。\n第二"
 },
 {
  "content": "，关于货车方"
 },
 {
  "content": "能否免责。根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "一百七十四条，"
 },
 {
  "content": "只有损害是因受害人"
 },
 {
  "content": "故意造成的，行为"
 },
 {
  "content": "人才不承担责任。"
 },
 {
  "content": "未戴头盔显然"
 },
 {
  "content": "不属于“受害人故意"
 },
 {
  "content": "”，且未戴"
 },
 {
  "content": "头盔与交通事故的发生"
 },
 {
  "content": "无因果关系，"
 },
 {
  "content": "货车方以此为由"
 },
 {
  "content": "完全拒赔缺乏"
 },
 {
  "content": "法律依据。\n"
 },
 {
  "content": "第三，关于赔偿责任"
 },
 {
  "content": "顺位。根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十三条，"
 },
 {
  "content": "机动车发生交通事故造成"
 },
 {
  "content": "损害，属于该"
 },
 {
  "content": "机动车一方责任的，"
 },
 {
  "content": "先由承保机动车"
 },
 {
  "content": "强制保险的保险"
 },
 {
  "content": "人在强制保险责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "；不足部分由"
 },
 {
  "content": "商业保险或侵权"
 },
 {
  "content": "人赔偿。货车"
 },
 {
  "content": "方无权单方"
 },
 {
  "content": "决定“不赔"
 },
 {
  "content": "”。\n第四，"
 },
 {
  "content": "关于未戴头盔"
 },
 {
  "content": "对赔偿金额的影响"
 },
 {
  "content": "。虽然未戴"
 },
 {
  "content": "头盔不能免除货车"
 },
 {
  "content": "方的赔偿责任，但在"
 },
 {
  "content": "司法实践中，若"
 },
 {
  "content": "未戴头盔导致"
 },
 {
  "content": "损害后果（"
 },
 {
  "content": "如头部损伤）"
 },
 {
  "content": "加重，法院可能"
 },
 {
  "content": "认定您对损害结果的"
 },
 {
  "content": "扩大存在一定过错"
 },
 {
  "content": "，从而减轻侵权"
 },
 {
  "content": "人对加重部分的赔偿责任"
 },
 {
  "content": "。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：货车方"
 },
 {
  "content": "以您未戴"
 },
 {
  "content": "头盔为由完全拒"
 },
 {
  "content": "赔不合法，"
 },
 {
  "content": "您有权主张赔偿"
 },
 {
  "content": "。\n风险："
 },
 {
  "content": "未戴头盔可能"
 },
 {
  "content": "影响最终的赔偿数额"
 },
 {
  "content": "，法院可能据此"
 },
 {
  "content": "减轻侵权"
 },
 {
  "content": "人对因未"
 },
 {
  "content": "戴头盔而加重"
 },
 {
  "content": "部分的损害赔偿"
 },
 {
  "content": "责任。建议您及时"
 },
 {
  "content": "报警定责，"
 },
 {
  "content": "先向货车"
 },
 {
  "content": "方的交强险"
 },
 {
  "content": "保险公司主张理赔"
 },
 {
  "content": "，协商不成可"
 },
 {
  "content": "依据《道路交通安全法"
 },
 {
  "content": "》第七十四条向"
 },
 {
  "content": "法院提起诉讼。"
 },
