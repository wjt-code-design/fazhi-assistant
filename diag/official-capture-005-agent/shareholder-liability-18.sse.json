[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案中"
 },
 {
  "content": "，公司拖欠货款"
 },
 {
  "content": "，法定代表人要求"
 },
 {
  "content": "股东个人签署承诺"
 },
 {
  "content": "。争议"
 },
 {
  "content": "焦点在于：供应商"
 },
 {
  "content": "能否突破公司法人"
 },
 {
  "content": "独立地位，直接"
 },
 {
  "content": "起诉股东要求其"
 },
 {
  "content": "承担付款责任。"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n《公司法》"
 },
 {
  "content": "第二十三条：公司股东"
 },
 {
  "content": "滥用公司法人独立"
 },
 {
  "content": "地位和股东有限责任"
 },
 {
  "content": "，逃避债务，"
 },
 {
  "content": "严重损害公司债权人"
 },
 {
  "content": "利益的，应当对公司"
 },
 {
  "content": "债务承担连带责任"
 },
 {
  "content": "。只有一个股东的公司"
 },
 {
  "content": "，股东不能证明"
 },
 {
  "content": "公司财产独立于"
 },
 {
  "content": "股东自己的财产的"
 },
 {
  "content": "，应当对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第五百五十二条："
 },
 {
  "content": "第三人与债务人约定"
 },
 {
  "content": "加入债务并通知"
 },
 {
  "content": "债权人，或者第三人"
 },
 {
  "content": "向债权人表示愿意"
 },
 {
  "content": "加入债务，债权人"
 },
 {
  "content": "未在合理期限内"
 },
 {
  "content": "明确拒绝的，"
 },
 {
  "content": "债权人可以请求第三"
 },
 {
  "content": "人在其愿意承担的"
 },
 {
  "content": "债务范围内和债务人"
 },
 {
  "content": "承担连带债务。"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第五百一十八条："
 },
 {
  "content": "债务人为二人以上"
 },
 {
  "content": "，债权人可以请求"
 },
 {
  "content": "部分或者全部债务人"
 },
 {
  "content": "履行全部债务的"
 },
 {
  "content": "，为连带债务"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，原则上"
 },
 {
  "content": "公司具有独立法人资格，"
 },
 {
  "content": "公司欠货款应由"
 },
 {
  "content": "公司财产偿还"
 },
 {
  "content": "，股东通常不"
 },
 {
  "content": "直接对外承担"
 },
 {
  "content": "公司债务。\n"
 },
 {
  "content": "其次，关于股东"
 },
 {
  "content": "签署的“承诺"
 },
 {
  "content": "”，需视其"
 },
 {
  "content": "具体内容而定。如果"
 },
 {
  "content": "该承诺明确表示"
 },
 {
  "content": "股东愿意与公司"
 },
 {
  "content": "共同承担还款责任"
 },
 {
  "content": "，构成“"
 },
 {
  "content": "债务加入”（并"
 },
 {
  "content": "存的债务承担），"
 },
 {
  "content": "且供应商接受"
 },
 {
  "content": "或未明确拒绝"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第五百五十二条"
 },
 {
  "content": "，供应商有权直接"
 },
 {
  "content": "起诉该股东，"
 },
 {
  "content": "要求其与公司"
 },
 {
  "content": "承担连带债务。"
 },
 {
  "content": "如果承诺仅构成一般保证，则"
 },
 {
  "content": "股东享有"
 },
 {
  "content": "先诉抗辩"
 },
 {
  "content": "权，不能直接"
 },
 {
  "content": "要求股东承担责任"
 },
 {
  "content": "（除非构成连带"
 },
 {
  "content": "责任保证）。\n"
 },
 {
  "content": "最后，如果股东"
 },
 {
  "content": "存在滥用公司法人"
 },
 {
  "content": "独立地位逃避债务"
 },
 {
  "content": "（如公司财产"
 },
 {
  "content": "与股东个人财产"
 },
 {
  "content": "混同等）的情形"
 },
 {
  "content": "，根据《公司法"
 },
 {
  "content": "》第二十三条，供应商"
 },
 {
  "content": "可以主张否认"
 },
 {
  "content": "公司法人人格，"
 },
 {
  "content": "直接要求股东对公司"
 },
 {
  "content": "债务承担连带责任"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n供应商"
 },
 {
  "content": "能否直接起诉股东"
 },
 {
  "content": "，取决于股东签署"
 },
 {
  "content": "的“承诺”"
 },
 {
  "content": "是否构成债务加入"
 },
 {
  "content": "或连带责任保证"
 },
 {
  "content": "，以及是否存在股东"
 },
 {
  "content": "滥用法人独立地位"
 },
 {
  "content": "逃避债务的情形。"
 },
 {
  "content": "重要："
 },
 {
  "content": "股东在签署此类"
 },
 {
  "content": "文件时需极度"
 },
 {
  "content": "谨慎，一旦签署"
 },
 {
  "content": "含有“愿意共同"
 },
 {
  "content": "偿还”“"
 },
 {
  "content": "承担连带责任”"
 },
 {
  "content": "等字样的承诺"
 },
 {
  "content": "，极有可能"
 },
 {
  "content": "面临被直接"
 },
 {
  "content": "起诉并承担还款"
 },
 {
  "content": "责任的法律风险。"
 },
