 {
  "content": "① "
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案属于装修"
 },
 {
  "content": "合同纠纷。"
 },
 {
  "content": "装修公司拖延工期两个月"
 },
 {
  "content": "，并以材料涨价"
 },
 {
  "content": "为由要求加价，"
 },
 {
  "content": "否则停工。争议"
 },
 {
  "content": "焦点在于：装修公司"
 },
 {
  "content": "拖延工期是否构成"
 },
 {
  "content": "违约？其以"
 },
 {
  "content": "材料涨价为由要求加价并停工的行为"
 },
 {
  "content": "是否合法？\n\n"
 },
 {
  "content": "② 法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第八百零一条"
 },
 {
  "content": "规定，因施工"
 },
 {
  "content": "人的原因致使建设工程"
 },
 {
  "content": "质量不符合约定的，"
 },
 {
  "content": "发包人有权请求"
 },
 {
  "content": "施工人在合理期限内"
 },
 {
  "content": "无偿修理或者返"
 },
 {
  "content": "工、改建。"
 },
 {
  "content": "经过修理或者返"
 },
 {
  "content": "工、改建后"
 },
 {
  "content": "，造成逾期交付"
 },
 {
  "content": "的，施工人"
 },
 {
  "content": "应当承担违约责任"
 },
 {
  "content": "。\n\n③ "
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "关于拖延工期："
 },
 {
  "content": "装修公司作为施工"
 },
 {
  "content": "人，因自身"
 },
 {
  "content": "原因导致工程逾期"
 },
 {
  "content": "交付两个月，已"
 },
 {
  "content": "构成违约，依法"
 },
 {
  "content": "应当承担逾期交付"
 },
 {
  "content": "的违约责任。"
 },
 {
  "content": "\n关于材料涨价"
 },
 {
  "content": "与加价停工"
 },
 {
  "content": "：材料价格波动"
 },
 {
  "content": "通常属于商业风险"
 },
 {
  "content": "，并非"
 },
 {
  "content": "不可抗力或法定的"
 },
 {
  "content": "合同变更事由"
 },
 {
  "content": "。装修公司单方面"
 },
 {
  "content": "以材料涨价为由"
 },
 {
  "content": "要求加价，实质"
 },
 {
  "content": "是单方变更"
 },
 {
  "content": "合同价格条款"
 },
 {
  "content": "；在未果的情况下"
 },
 {
  "content": "停工，属于"
 },
 {
  "content": "以明"
 },
 {
  "content": "示方式表明"
 },
 {
  "content": "不履行合同主要义务，构成违约"
 },
 {
  "content": "。业主有权拒绝"
 },
 {
  "content": "装修公司的加价要求"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：装修公司无权"
 },
 {
  "content": "以材料涨价为由"
 },
 {
  "content": "单方加价，"
 },
 {
  "content": "其拖延工期和"
 },
 {
  "content": "停工行为"
 },
 {
  "content": "构成违约。业主"
 },
 {
  "content": "有权要求其继续"
 },
 {
  "content": "按原合同施工"
 },
 {
  "content": "，并主张"
 },
 {
  "content": "逾期交付的违约"
 },
 {
  "content": "责任；若装修公司"
 },
 {
  "content": "坚持停工导致"
 },
 {
  "content": "合同目的无法实现"
 },
 {
  "content": "，业主可主张"
 },
 {
  "content": "解除合同并要求赔偿"
 },
 {
  "content": "损失。\n风险"
 },
 {
  "content": "提示：业主需注意"
 },
 {
  "content": "固定和收集"
 },
 {
  "content": "证据，如装修"
 },
 {
  "content": "合同、付款凭证"
 },
 {
  "content": "、工期约定"
 },
 {
  "content": "、装修公司要求"
 },
 {
  "content": "加价及停工的"
 },
 {
  "content": "沟通记录等。"
 },
 {
  "content": "若双方"
 },
 {
  "content": "对违约"
 },
 {
  "content": "责任或损失"
 },
 {
  "content": "赔偿无法"
 },
 {
  "content": "协商一致，可通过"
 },
 {
  "content": "诉讼途径解决。"
 },
 {
  "content": "由于现有条文未"
 },
 {
  "content": "对逾期违约"
 },
 {
  "content": "责任的计算"
 },
 {
  "content": "标准作出具体规定"
 },
 {
  "content": "，具体赔偿金额"
 },
 {
  "content": "需结合合同约定及"
 },
 {
  "content": "实际损失认定"
 },
 {
