 {
  "content": "结论"
 },
 {
  "content": "与风险："
 },
 {
  "content": "您可以主张双倍返还"
 },
 {
  "content": "定金，但需注意"
 },
 {
  "content": "定金数额不得超过房屋"
 },
 {
  "content": "总价的20"
 },
 {
  "content": "%，超过部分"
 },
 {
  "content": "不产生定金效力"
 },
 {
  "content": "。若房屋涨价"
 },
 {
  "content": "带来的实际损失"
 },
 {
  "content": "（如差价"
 },
 {
  "content": "）超过定金"
 },
 {
  "content": "数额，还可"
 },
 {
  "content": "主张额外赔偿。"
 },
 {
  "content": "\n\n案情与争议"
 },
 {
  "content": "焦点：本案中"
 },
 {
  "content": "，买卖双方签订了"
 },
 {
  "content": "认购书并交付"
 },
 {
  "content": "了定金，卖方"
 },
 {
  "content": "因房价上涨拒绝"
 },
 {
  "content": "出售，属于"
 },
 {
  "content": "收受定金的一方不"
 },
 {
  "content": "履行合同义务，"
 },
 {
  "content": "导致合同目的无法"
 },
 {
  "content": "实现。争议焦点"
 },
 {
  "content": "在于买方能否适用"
 },
 {
  "content": "定金罚则要求"
 },
 {
  "content": "双倍返还。\n\n"
 },
 {
  "content": "法律依据与逐"
 },
 {
  "content": "项论证：\n\n"
 },
 {
  "content": "第一，卖方构成"
 },
 {
  "content": "根本违约，应"
 },
 {
  "content": "适用定金罚则"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百八十七条"
 },
 {
  "content": "规定，收受定金"
 },
 {
  "content": "的一方不履行债务"
 },
 {
  "content": "或者履行债务不符合"
 },
 {
  "content": "约定，致使不能"
 },
 {
  "content": "实现合同目的的，"
 },
 {
  "content": "应当双倍返还定金"
 },
 {
  "content": "。卖方因涨价"
 },
 {
  "content": "拒绝卖房，"
 },
 {
  "content": "属于不履行合同"
 },
 {
  "content": "义务，买方有权"
 },
 {
  "content": "要求其双倍返还"
 },
 {
  "content": "定金。\n\n第二"
 },
 {
  "content": "，定金数额受"
 },
 {
  "content": "法律上限限制。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百八十六条规定"
 },
 {
  "content": "，定金的数额"
 },
 {
  "content": "由"
 },
 {
  "content": "当事人约定，但"
 },
 {
  "content": "不得超过主合同标的"
 },
 {
  "content": "额的20%"
 },
 {
  "content": "，超过部分不"
 },
 {
  "content": "产生定金的效力"
 },
 {
  "content": "。因此，若"
 },
 {
  "content": "10万元定金"
 },
 {
  "content": "超过了房屋总价的"
 },
 {
  "content": "20%，"
 },
 {
  "content": "则双倍返还的"
 },
 {
  "content": "基数仅为房屋总"
 },
 {
  "content": "价的20%"
 },
 {
  "content": "，超出部分仅"
 },
 {
  "content": "能作为原"
 },
 {
  "content": "款返还"
 },
 {
  "content": "。例如，房屋"
 },
 {
  "content": "总价300"
 },
 {
  "content": "万元，20"
 },
 {
  "content": "%上限为6"
 },
 {
  "content": "0万元，1"
 },
 {
  "content": "0万元未超"
 },
 {
  "content": "上限，可按1"
 },
 {
  "content": "0万元双倍返还"
 },
 {
  "content": "；若房屋总价"
 },
 {
  "content": "40万元，"
 },
 {
  "content": "20%上限"
 },
 {
  "content": "为8万元，"
 },
 {
  "content": "则仅能按"
 },
 {
  "content": "8万元双倍返还"
 },
 {
  "content": "，超出的2"
 },
 {
  "content": "万元按原款"
 },
 {
  "content": "返还。\n\n第三"
 },
 {
  "content": "，定金与违约金"
 },
 {
  "content": "的选择适用。根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "八十八条规定，"
 },
 {
  "content": "当事人既约定违约金"
 },
 {
  "content": "又约定定金的"
 },
 {
  "content": "，一方违约时"
 },
 {
  "content": "，对方可以选择适用"
 },
 {
  "content": "违约金或者定金条款"
 },
 {
  "content": "。您主张“"
 },
 {
  "content": "要双倍”即是"
 },
 {
  "content": "选择适用定金条款"
 },
 {
  "content": "。\n\n第四，"
 },
 {
  "content": "定金不足以弥补损失"
 },
 {
  "content": "时可主张额外赔偿"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百八十八条"
 },
 {
  "content": "第二款规定，定金"
 },
 {
  "content": "不足以弥补一方违约"
 },
 {
  "content": "造成的损失的，对方"
 },
 {
  "content": "可以请求赔偿超过"
 },
 {
  "content": "定金数额的损失"
 },
 {
  "content": "。若房屋涨价"
 },
 {
  "content": "导致您另行购房"
 },
 {
  "content": "的差价损失超过"
 },
 {
  "content": "双倍定金金额，"
 },
 {
  "content": "您有权就超出"
 },
 {
  "content": "部分要求卖方"
 },
 {
  "content": "赔偿。\n\n结论"
 },
 {
  "content": "与风险：卖方"
 },
 {
  "content": "因涨价拒绝卖"
 },
 {
  "content": "房，您有权"
 },
 {
  "content": "依据《民法典》"
 },
 {
  "content": "主张双倍返还定金。但需注意定金"
 },
 {
  "content": "20%的"
 },
 {
  "content": "法定上限，以及"
 },
 {
  "content": "收集认购"
 },
 {
  "content": "书、定金转账"
 },
 {
  "content": "凭证、卖方明确"
 },
 {
  "content": "表示不卖房的"
 },
 {
  "content": "聊天记录或"
 },
 {
  "content": "录音等证据。"
 },
 {
  "content": "若实际损失较大"
 },
 {
  "content": "，可另行主张"
 },
 {
  "content": "差价赔偿。"
 },
