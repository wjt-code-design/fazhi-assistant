 },
 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "您向"
 },
 {
  "content": "健身房预付"
 },
 {
  "content": "费用办理"
 },
 {
  "content": "会员卡，"
 },
 {
  "content": "双方成立"
 },
 {
  "content": "服务合同关系。"
 },
 {
  "content": "现"
 },
 {
  "content": "健身房关门无法"
 },
 {
  "content": "继续"
 },
 {
  "content": "提供服务，合同写"
 },
 {
  "content": "明“概不"
 },
 {
  "content": "退款”。"
 },
 {
  "content": "本案"
 },
 {
  "content": "争议"
 },
 {
  "content": "焦点在于：该"
 },
 {
  "content": "“概不退款"
 },
 {
  "content": "”条款是否具有"
 },
 {
  "content": "法律效力，以及"
 },
 {
  "content": "您是否有权要求"
 },
 {
  "content": "退还"
 },
 {
  "content": "剩余费用。\n\n"
 },
 {
  "content": "② 法律依据"
 },
 {
  "content": "\n《"
 },
 {
  "content": "民法典》第四百九"
 },
 {
  "content": "十六条关于"
 },
 {
  "content": "格式条款定义"
 },
 {
  "content": "及"
 },
 {
  "content": "提示"
 },
 {
  "content": "说明义务的规定；"
 },
 {
  "content": "《"
 },
 {
  "content": "民法典》第四百九"
 },
 {
  "content": "十七条关于格式条款"
 },
 {
  "content": "无效情形"
 },
 {
  "content": "的规定；《民法典"
 },
 {
  "content": "》第五百六十三条"
 },
 {
  "content": "关于法定"
 },
 {
  "content": "解除合同的规定；"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "七十七条关于违约"
 },
 {
  "content": "责任的规定；《"
 },
 {
  "content": "消费者权益保护法》第二十六条"
 },
 {
  "content": "关于经营者不得以"
 },
 {
  "content": "格式条款排除或"
 },
 {
  "content": "限制消费者权利的规定"
 },
 {
  "content": "。\n\n③ "
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款属于格式条款"
 },
 {
  "content": "。根据"
 },
 {
  "content": "《"
 },
 {
  "content": "民法典》第四百九"
 },
 {
  "content": "十六条，该条款"
 },
 {
  "content": "由健身房预先拟定"
 },
 {
  "content": "、"
 },
 {
  "content": "重复"
 },
 {
  "content": "使用，"
 },
 {
  "content": "且在与"
 },
 {
  "content": "您订立合同时未"
 },
 {
  "content": "进行"
 },
 {
  "content": "协商，符合"
 },
 {
  "content": "格式条款的特征"
 },
 {
  "content": "。\n第二，“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款依法"
 },
 {
  "content": "无效。根据《"
 },
 {
  "content": "民法典"
 },
 {
  "content": "》第四百九十七条"
 },
 {
  "content": "及"
 },
 {
  "content": "《消费者权益保护法》"
 },
 {
  "content": "第二十六条，该"
 },
 {
  "content": "条款"
 },
 {
  "content": "排"
 },
 {
  "content": "除了您要求"
 },
 {
  "content": "退还"
 },
 {
  "content": "预付款"
 },
 {
  "content": "的主要权利，不合理"
 },
 {
  "content": "地免除了经营者"
 },
 {
  "content": "退款"
 },
 {
  "content": "的责任"
 },
 {
  "content": "，属于对"
 },
 {
  "content": "消费者不公平、不合理"
 },
 {
  "content": "的规定，该"
 },
 {
  "content": "条款内容无效。"
 },
 {
  "content": "健身房"
 },
 {
  "content": "不能以此"
 },
 {
  "content": "为由拒绝退款。"
 },
 {
  "content": "\n第三，健身房"
 },
 {
  "content": "关门构成根本违约"
 },
 {
  "content": "，您有权解除"
 },
 {
  "content": "合同。根据《"
 },
 {
  "content": "民法典》第五百六"
 },
 {
  "content": "十三条，当事人一方"
 },
 {
  "content": "有其他"
 },
 {
  "content": "违约行为致使不能"
 },
 {
  "content": "实现合同目的"
 },
 {
  "content": "，当事人"
 },
 {
  "content": "可以解除合同。"
 },
 {
  "content": "健身房关门导致其"
 },
 {
  "content": "无法继续"
 },
 {
  "content": "为您提供"
 },
 {
  "content": "服务，合同目的"
 },
 {
  "content": "已"
 },
 {
  "content": "无法实现。"
 },
 {
  "content": "\n第四，您"
 },
 {
  "content": "有权要求退还"
 },
 {
  "content": "剩余费用。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百七十七条，"
 },
 {
  "content": "当事人"
 },
 {
  "content": "一方不履行合同"
 },
 {
  "content": "义务或者"
 },
 {
  "content": "履行合同义务不符合"
 },
 {
  "content": "约定的，应当承担"
 },
 {
  "content": "赔偿损失等违约"
 },
 {
  "content": "责任。合同解除"
 },
 {
  "content": "后，健身房"
 },
 {
  "content": "应当退还您"
 },
 {
  "content": "尚未消费的预付款"
 },
 {
  "content": "项"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：您可以"
 },
 {
  "content": "要求健身房"
 },
 {
  "content": "退还剩余费用，“概不退款”"
 },
 {
  "content": "条款不能成为其"
 },
 {
  "content": "拒"
 },
 {
  "content": "退"
 },
 {
  "content": "理由"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：健身房"
 },
 {
  "content": "关门往往"
 },
 {
  "content": "伴随"
 },
 {
  "content": "经营"
 },
 {
  "content": "不善"
 },
 {
  "content": "甚至"
 },
 {
  "content": "破产跑路"
 },
 {
  "content": "，您"
 },
 {
  "content": "虽"
 },
 {
  "content": "享有"
 },
 {
  "content": "胜诉权，"
 },
 {
  "content": "但可能"
 },
 {
  "content": "面临执行"
 },
 {
  "content": "不能"
 },
 {
  "content": "、无财产可供"
 },
 {
  "content": "退还的实际"
 },
 {
  "content": "风险。建议您"
 },
 {
  "content": "及时收集办"
 },
 {
  "content": "卡合同、付款"
 },
 {
  "content": "凭证、健身房"
 },
 {
  "content": "关门公告"
 },
 {
  "content": "等证据，向"
 },
 {
  "content": "市场监督管理部门投诉举报"
 },
 {
  "content": "，或向人民法院"
 },
 {
  "content": "提起诉讼以"
 },
 {
  "content": "维护自身权益。"
 },
