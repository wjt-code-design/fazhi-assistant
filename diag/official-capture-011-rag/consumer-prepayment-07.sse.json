 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n你办卡"
 },
 {
  "content": "后健身房关门，"
 },
 {
  "content": "合同中虽有概"
 },
 {
  "content": "不退款的约定"
 },
 {
  "content": "，但该条款能否"
 },
 {
  "content": "阻却"
 },
 {
  "content": "你的退款权利是"
 },
 {
  "content": "本案的核心争议焦点"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据（引条文"
 },
 {
  "content": "）\n《民法典"
 },
 {
  "content": "》第四百九十七条"
 },
 {
  "content": "、《消费者权益保护法》"
 },
 {
  "content": "第二十六条、《民法典》"
 },
 {
  "content": "第五百六十三条、《"
 },
 {
  "content": "民法典》第五百七"
 },
 {
  "content": "十七条。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，概不"
 },
 {
  "content": "退款条款无效"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第四百九十七条"
 },
 {
  "content": "规定，提供格式"
 },
 {
  "content": "条款一方排除对方"
 },
 {
  "content": "主要权利的，该"
 },
 {
  "content": "格式条款无效。"
 },
 {
  "content": "同时，《消费者权益保护法"
 },
 {
  "content": "》第二十六条明确"
 },
 {
  "content": "，经营者不得以格式"
 },
 {
  "content": "条款等方式作出排除"
 },
 {
  "content": "或限制消费者权利"
 },
 {
  "content": "、减轻或免除"
 },
 {
  "content": "经营者责任的规定"
 },
 {
  "content": "，否则该"
 },
 {
  "content": "内容无效。概"
 },
 {
  "content": "不退款条款免"
 },
 {
  "content": "除了健身房无法"
 },
 {
  "content": "经营时的退款责任"
 },
 {
  "content": "，排除了消费者"
 },
 {
  "content": "在合同"
 },
 {
  "content": "目的无法实现时的"
 },
 {
  "content": "解除权与求"
 },
 {
  "content": "偿权，属于"
 },
 {
  "content": "无效条款，自"
 },
 {
  "content": "始没有法律"
 },
 {
  "content": "约束力。\n\n"
 },
 {
  "content": "第二，健身房关门"
 },
 {
  "content": "构成根本违约。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百六十三条规定"
 },
 {
  "content": "，当事人一方有其他"
 },
 {
  "content": "违约行为致使不能"
 },
 {
  "content": "实现合同目的的，"
 },
 {
  "content": "当事人可以解除合同"
 },
 {
  "content": "。健身房关门导致"
 },
 {
  "content": "其无法继续"
 },
 {
  "content": "提供"
 },
 {
  "content": "健身服务，合同"
 },
 {
  "content": "目的已无法实现"
 },
 {
  "content": "，你有权解除"
 },
 {
  "content": "合同。\n\n第三"
 },
 {
  "content": "，违约方"
 },
 {
  "content": "应承担退款责任"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "规定，当事人一方"
 },
 {
  "content": "不履行合同义务"
 },
 {
  "content": "的，应当承担"
 },
 {
  "content": "赔偿损失等违约"
 },
 {
  "content": "责任。合同解除"
 },
 {
  "content": "后，健身房应当"
 },
 {
  "content": "退还你未"
 },
 {
  "content": "消费的预付款"
 },
 {
  "content": "项。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：你有权"
 },
 {
  "content": "要求健身房退还剩余费用，概不"
 },
 {
  "content": "退款条款不能成为"
 },
 {
  "content": "拒退"
 },
 {
  "content": "理由。\n风险提示：健身房关门"
 },
 {
  "content": "往往伴随经营者失联"
 },
 {
  "content": "或资产转移，"
 },
 {
  "content": "存在赢了官司拿"
 },
 {
  "content": "不到钱的"
 },
 {
  "content": "执行风险。建议"
 },
 {
  "content": "保留合同、付款"
 },
 {
  "content": "凭证等"
 },
 {
  "content": "证据，及时向"
 },
 {
  "content": "市场监管部门投诉举报"
 },
 {
  "content": "，若存在"
 },
 {
  "content": "办卡"
 },
 {
  "content": "后恶意关"
 },
 {
  "content": "门的诈骗嫌疑，"
 },
 {
  "content": "可向公安机关报案。"
 },
 {
  "content": "\n\n本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
