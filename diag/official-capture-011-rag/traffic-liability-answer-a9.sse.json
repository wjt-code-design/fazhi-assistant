 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n本案为"
 },
 {
  "content": "两辆机动车追"
 },
 {
  "content": "尾事故，交警"
 },
 {
  "content": "已认定后车"
 },
 {
  "content": "负全部责任。"
 },
 {
  "content": "争议焦点在于前"
 },
 {
  "content": "车的损失应由谁"
 },
 {
  "content": "承担赔偿责任"
 },
 {
  "content": "以及具体的赔偿顺"
 },
 {
  "content": "位。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第七十六条第一款第"
 },
 {
  "content": "（一）项"
 },
 {
  "content": "规定，机动车之间"
 },
 {
  "content": "发生交通事故的，"
 },
 {
  "content": "由有过错的一方"
 },
 {
  "content": "承担赔偿责任；双方"
 },
 {
  "content": "都有过错的，按照各自过错的比例"
 },
 {
  "content": "分担责任。\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千二百一十三条"
 },
 {
  "content": "规定，机动车发生"
 },
 {
  "content": "交通事故造成损害，"
 },
 {
  "content": "属于该机动车一方"
 },
 {
  "content": "责任的，先由"
 },
 {
  "content": "承保机动车强制保险"
 },
 {
  "content": "的保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿；不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "仍然不足或者没有"
 },
 {
  "content": "投保机动车商业保险"
 },
 {
  "content": "的，由侵权"
 },
 {
  "content": "人赔偿。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，交警"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任，表明"
 },
 {
  "content": "后车对事故"
 },
 {
  "content": "的发生存在过错，"
 },
 {
  "content": "依据《道路交通安全法"
 },
 {
  "content": "》第七十六条，"
 },
 {
  "content": "后车作为过错"
 },
 {
  "content": "方应对前车的"
 },
 {
  "content": "损失承担赔偿责任"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "具体的赔偿顺位"
 },
 {
  "content": "应依据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条确定：\n"
 },
 {
  "content": "第一步，由后"
 },
 {
  "content": "车（全责"
 },
 {
  "content": "方）所投保"
 },
 {
  "content": "的机动车交通事故"
 },
 {
  "content": "责任强制保险（"
 },
 {
  "content": "交强险）"
 },
 {
  "content": "的保险人，在"
 },
 {
  "content": "交强险"
 },
 {
  "content": "责任限额范围内对"
 },
 {
  "content": "前车的损失予以"
 },
 {
  "content": "赔偿。\n第二步"
 },
 {
  "content": "，交强险"
 },
 {
  "content": "赔偿不足的部分"
 },
 {
  "content": "，由后车"
 },
 {
  "content": "投保的机动车商业"
 },
 {
  "content": "保险的保险人按照"
 },
 {
  "content": "保险合同的约定予以"
 },
 {
  "content": "赔偿。\n第三步"
 },
 {
  "content": "，如果商业险"
 },
 {
  "content": "赔偿后仍有不足"
 },
 {
  "content": "，或者后车"
 },
 {
  "content": "根本没有投保机动车商业"
 },
 {
  "content": "保险，则由侵权"
 },
 {
  "content": "人（即后"
 },
 {
  "content": "车车主或驾驶员"
 },
 {
  "content": "）对剩余"
 },
 {
  "content": "损失进行赔偿。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "前车的损失由"
 },
 {
  "content": "后车一方"
 },
 {
  "content": "承担，具体由"
 },
 {
  "content": "后车的交强"
 },
 {
  "content": "险保险公司、商业"
 },
 {
  "content": "险保险公司及后"
 },
 {
  "content": "车侵权人按"
 },
 {
  "content": "法定顺位依次"
 },
 {
  "content": "赔偿。\n风险"
 },
 {
  "content": "提示：若后"
 },
 {
  "content": "车未投保商业"
 },
 {
  "content": "三者险或保"
 },
 {
  "content": "额不足，超出"
 },
 {
  "content": "交强险部分的"
 },
 {
  "content": "损失需由后"
 },
 {
  "content": "车车主或驾驶员"
 },
 {
  "content": "个人承担，可能存在"
 },
 {
  "content": "因责任人个人偿"
 },
 {
  "content": "付能力不足而导致"
 },
 {
  "content": "前车难以获得"
 },
 {
  "content": "足额赔偿的风险。"
 },
