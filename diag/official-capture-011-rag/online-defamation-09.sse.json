 {
  "content": "法》第二十条（"
 },
 {
  "content": "调解程序）。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n第一，民事"
 },
 {
  "content": "侵权层面。同事"
 },
 {
  "content": "在群里捏造"
 },
 {
  "content": "并散布用户"
 },
 {
  "content": "“骗钱”"
 },
 {
  "content": "的事实，属于因"
 },
 {
  "content": "过错侵害他人民"
 },
 {
  "content": "事权益的行为，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十五条"
 },
 {
  "content": "，应当承担侵权"
 },
 {
  "content": "责任。若其他"
 },
 {
  "content": "同事在转发时"
 },
 {
  "content": "存在过错"
 },
 {
  "content": "，属于共同"
 },
 {
  "content": "实施侵权行为，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十八条"
 },
 {
  "content": "，行为人应当"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "用户有权要求侵权"
 },
 {
  "content": "人停止侵害、"
 },
 {
  "content": "恢复名誉、消除"
 },
 {
  "content": "影响、赔礼"
 },
 {
  "content": "道歉，并可要求"
 },
 {
  "content": "赔偿因此造成的财产损失"
 },
 {
  "content": "及精神损害。"
 },
 {
  "content": "\n\n"
 },
 {
  "content": "第二，刑事犯罪"
 },
 {
  "content": "层面。如果"
 },
 {
  "content": "同事捏造用户"
 },
 {
  "content": "“骗钱”"
 },
 {
  "content": "的事实，并向司法机关"
 },
 {
  "content": "或有关单位"
 },
 {
  "content": "告发，意图"
 },
 {
  "content": "使用户受到刑事"
 },
 {
  "content": "追究，情节严重的，"
 },
 {
  "content": "根据《刑法》"
 },
 {
  "content": "第二百四十三条，可能"
 },
 {
  "content": "构成诬告陷害"
 },
 {
  "content": "罪。需注意，"
