[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n您与"
 },
 {
  "content": "公司的劳动合同期限为"
 },
 {
  "content": "三年，公司最初"
 },
 {
  "content": "约定了六个月"
 },
 {
  "content": "试用期，后又延长"
 },
 {
  "content": "两个月。争议焦点"
 },
 {
  "content": "在于：公司延长"
 },
 {
  "content": "试用期的行为是否"
 },
 {
  "content": "合法，以及违法"
 },
 {
  "content": "延长试用期"
 },
 {
  "content": "需承担何种法律责任"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n《劳动合同"
 },
 {
  "content": "法》第十九条\n"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十三条\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，公司最初"
 },
 {
  "content": "约定六个月试用期是"
 },
 {
  "content": "合法的。根据《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "，三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月。三年期"
 },
 {
  "content": "合同约定六个月试用期符合"
 },
 {
  "content": "法定上限。\n\n"
 },
 {
  "content": "其次，公司延长"
 },
 {
  "content": "两个月试用期的行为"
 },
 {
  "content": "不合法。理由"
 },
 {
  "content": "有二：一是违反了"
 },
 {
  "content": "试用期次数限制，"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第十九条，同一"
 },
 {
  "content": "用人单位与同一劳动者"
 },
 {
  "content": "只能约定一次试用期"
 },
 {
  "content": "，延长试用期实质"
 },
 {
  "content": "上属于再次约定"
 },
 {
  "content": "试用期；二是延长"
 },
 {
  "content": "后总试用期为"
 },
 {
  "content": "八个月，超过了"
 },
 {
  "content": "法定六个月"
 },
 {
  "content": "的最长期限。"
 },
 {
  "content": "\n\n最后，关于"
 },
 {
  "content": "违法延长试用"
 },
 {
  "content": "期的法律后果，"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第八十三条，"
 },
 {
  "content": "用人单位违反本法规定"
 },
 {
  "content": "与劳动者约定试用"
 },
 {
  "content": "期的，违法"
 },
 {
  "content": "约定的试用期已经履"
 },
 {
  "content": "行的，由用人单位"
 },
 {
  "content": "以劳动者试用期满月"
 },
 {
  "content": "工资为标准，按"
 },
 {
  "content": "已经履行的超过"
 },
 {
  "content": "法定试用期的期间"
 },
 {
  "content": "向劳动者支付赔偿"
 },
 {
  "content": "金。本案中"
 },
 {
  "content": "，超过法定试用"
 },
 {
  "content": "期的期间为两个月"
 },
 {
  "content": "（八个月减"
 },
 {
  "content": "六个月），公司需"
 },
 {
  "content": "按试用期满月工资"
 },
 {
  "content": "标准向您"
 },
 {
  "content": "支付两个"
 },
 {
  "content": "月的赔偿金。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "公司延长两个月试用"
 },
 {
  "content": "期的行为不合法"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：您可以要求公司"
 },
 {
  "content": "支付违法履行"
 },
 {
  "content": "试用期的赔偿金"
 },
 {
  "content": "。若公司拒绝"
 },
 {
  "content": "，您可以向劳动"
 },
 {
  "content": "行政部门投诉或申请"
 },
 {
  "content": "劳动仲裁。需注意"
 },
 {
  "content": "收集劳动合同"
 },
 {
  "content": "、试用期延长通知"
 },
 {
  "content": "、工资发放"
 },
 {
  "content": "记录等证据，"
 },
 {
  "content": "以证明试用期实际"
 },
 {
  "content": "履行情况及"
 },
 {
  "content": "工资标准"
 },
 {
  "content": "。本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
