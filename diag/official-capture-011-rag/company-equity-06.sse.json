 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "案情：合伙人口"
 },
 {
  "content": "头承诺给予当事人"
 },
 {
  "content": "10%的"
 },
 {
  "content": "“股权”（实为"
 },
 {
  "content": "合伙企业财产份额），"
 },
 {
  "content": "当事人实际参与经营"
 },
 {
  "content": "或劳动两年，"
 },
 {
  "content": "但未签订任何书面"
 },
 {
  "content": "协议。争议焦点"
 },
 {
  "content": "：口头承诺是否"
 },
 {
  "content": "具有法律效力？"
 },
 {
  "content": "未签订书面协议"
 },
 {
  "content": "的情况下，能否要求"
 },
 {
  "content": "确认合伙人身份或"
 },
 {
  "content": "财产份额？\n\n"
 },
 {
  "content": "②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "合伙企业法》第十九条"
 },
 {
  "content": "，合伙协议经"
 },
 {
  "content": "全体合伙人签名、"
 },
 {
  "content": "盖章后生效。"
 },
 {
  "content": "根据《合伙企业法"
 },
 {
  "content": "》第四十三条，"
 },
 {
  "content": "新合伙人入伙"
 },
 {
  "content": "，除合伙协议"
 },
 {
  "content": "另有约定外，"
 },
 {
  "content": "应当经全体合伙人"
 },
 {
  "content": "一致同意，并"
 },
 {
  "content": "依法订立书面入"
 },
 {
  "content": "伙协议。根据"
 },
 {
  "content": "《合伙企业法》"
 },
 {
  "content": "第二十二条，合伙人向"
 },
 {
  "content": "合伙人以外的人转让"
 },
 {
  "content": "其在合伙企业中的全部"
 },
 {
  "content": "或者部分财产份额"
 },
 {
  "content": "时，须经其他"
 },
 {
  "content": "合伙人一致同意。"
 },
 {
  "content": "\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，关于合伙协议的"
 },
 {
  "content": "生效要件。依据"
 },
 {
  "content": "《合伙企业法》"
 },
 {
  "content": "第十九条和第四十三条"
 },
 {
  "content": "，合伙协议及"
 },
 {
  "content": "入伙协议原则上"
 },
 {
  "content": "要求书面形式"
 },
 {
  "content": "并经签名"
 },
 {
  "content": "、盖章生效。"
 },
 {
  "content": "口头承诺因缺乏"
 },
 {
  "content": "法定形式"
 },
 {
  "content": "要件，难以直接"
 },
 {
  "content": "认定为合法有效的合伙"
 },
 {
  "content": "协议。\n其次"
 },
 {
  "content": "，关于财产份额"
 },
 {
  "content": "转让或入伙"
 },
 {
  "content": "的程序。依据《"
 },
 {
  "content": "合伙企业法》第二十二条"
 },
 {
  "content": "和第四十三条，"
 },
 {
  "content": "无论是受让财产"
 },
 {
  "content": "份额还是入伙"
 },
 {
  "content": "，均需经"
 },
 {
  "content": "其他合伙人“"
 },
 {
  "content": "一致同意”。若"
 },
 {
  "content": "仅有部分"
 },
 {
  "content": "合伙人口头承诺"
 },
 {
  "content": "，而无法证明其他"
 },
 {
  "content": "合伙人一致同意，"
 },
 {
  "content": "该承诺无法产生"
 },
 {
  "content": "法律上的入伙"
 },
 {
  "content": "或转让效力"
 },
 {
  "content": "。\n再次，"
 },
 {
  "content": "关于“干了两年"
 },
 {
  "content": "”的法律性质。"
 },
 {
  "content": "当事人实际参与经营"
 },
 {
  "content": "或劳动两年，"
 },
 {
  "content": "若未签协议"
 },
 {
  "content": "，该行为可能被"
 },
 {
  "content": "认定为提供劳务或"
 },
 {
  "content": "雇佣关系，而非"
 },
 {
  "content": "履行合伙人义务"
 },
 {
  "content": "。法律并未"
 },
 {
  "content": "规定单纯"
 },
 {
  "content": "的实际劳动"
 },
 {
  "content": "投入可自动转化为"
 },
 {
  "content": "合伙人身份。\n"
 },
 {
  "content": "最后，关于争议"
 },
 {
  "content": "解决与举证。"
 },
 {
  "content": "依据《合伙企业法"
 },
 {
  "content": "》第一百零三条，"
 },
 {
  "content": "合伙人履行合伙协议"
 },
 {
  "content": "发生争议可以向法院"
 },
 {
  "content": "起诉。但当事人"
 },
 {
  "content": "需承担举证责任"
 },
 {
  "content": "，证明口头承诺"
 },
 {
  "content": "的存在以及全体合伙人"
 },
 {
  "content": "一致同意的事实。"
 },
 {
  "content": "\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：仅凭口头"
 },
 {
  "content": "承诺且未签"
 },
 {
  "content": "书面协议，要求"
 },
 {
  "content": "确认合伙人身份或"
 },
 {
  "content": "财产份额存在极大"
 },
 {
  "content": "法律风险，难以"
 },
 {
  "content": "得到法院"
 },
 {
  "content": "支持。\n风险"
 },
 {
  "content": "提示：1."
 },
 {
  "content": " 举证困难："
 },
 {
  "content": "口头承诺若无其他"
 },
 {
  "content": "证据佐"
 },
 {
  "content": "证，极易被"
 },
 {
  "content": "对方否认；2"
 },
 {
  "content": ". 身份认定"
 },
 {
  "content": "风险：实际参与"
 },
 {
  "content": "经营可能被认定为劳务"
 },
 {
  "content": "关系，仅能"
 },
 {
  "content": "主张劳动报酬而非"
 },
 {
  "content": "合伙人权益；3"
 },
 {
  "content": ". 程序瑕疵"
 },
 {
  "content": "：缺乏全体合伙人"
 },
 {
  "content": "一致同意的证据"
 },
 {
  "content": "，入伙或"
 },
 {
  "content": "转让行为无效。"
 },
 {
  "content": "建议当事人尽可能"
 },
 {
  "content": "收集辅助证据，"
 },
 {
  "content": "如分红记录、"
 },
 {
  "content": "其他合伙人认可其"
 },
 {
  "content": "合伙人身份的录音录像"
 },
 {
  "content": "、参与合伙事务"
 },
 {
  "content": "决策的记录等，"
 },
 {
  "content": "以补强口头"
 },
 {
  "content": "承诺的证明力"
 },
 {
  "content": "。"
 },
