 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n父亲"
 },
 {
  "content": "去世时遗留有"
 },
 {
  "content": "房产及"
 },
 {
  "content": "信用卡欠款。"
 },
 {
  "content": "本案争议"
 },
 {
  "content": "焦点在于：子女"
 },
 {
  "content": "作为继承人，是否"
 },
 {
  "content": "必须以个人"
 },
 {
  "content": "自有财产清偿"
 },
 {
  "content": "被继承人生前"
 },
 {
  "content": "债务。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "二十二条：遗产"
 },
 {
  "content": "是自然人死亡时"
 },
 {
  "content": "遗留的个人合法财产"
 },
 {
  "content": "。\n《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条：继承人以"
 },
 {
  "content": "所得遗产实际价值"
 },
 {
  "content": "为限清偿被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "。超过遗产实际"
 },
 {
  "content": "价值部分，继承人"
 },
 {
  "content": "自愿偿还的不在此"
 },
 {
  "content": "限。继承人放弃"
 },
 {
  "content": "继承的，对被"
 },
 {
  "content": "继承人依法应当缴纳"
 },
 {
  "content": "的税款和债务"
 },
 {
  "content": "可以不负清偿责任"
 },
 {
  "content": "。\n《民事诉讼"
 },
 {
  "content": "法》第二百四十三条"
 },
 {
  "content": "：作为被执行人的"
 },
 {
  "content": "公民死亡的，以其"
 },
 {
  "content": "遗产偿还债务。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百二十二条"
 },
 {
  "content": "，父亲遗留的"
 },
 {
  "content": "房产属于其遗产"
 },
 {
  "content": "，信用卡欠款属于"
 },
 {
  "content": "其生前债务。"
 },
 {
  "content": "根据"
 },
 {
  "content": "《民事诉讼法》"
 },
 {
  "content": "第二百四十三条，该"
 },
 {
  "content": "债务应先以"
 },
 {
  "content": "遗产偿还。\n"
 },
 {
  "content": "其次，根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条确立的"
 },
 {
  "content": "限定继承原则，"
 },
 {
  "content": "子女若选择继承"
 },
 {
  "content": "遗产，则仅"
 },
 {
  "content": "需在继承遗产的实际"
 },
 {
  "content": "价值范围内清偿债务"
 },
 {
  "content": "。也就是说"
 },
 {
  "content": "，子女是否需要拿"
 },
 {
  "content": "自己的钱还款，"
 },
 {
  "content": "取决于信用卡欠款是否"
 },
 {
  "content": "超过房产的价值"
 },
 {
  "content": "。若欠款"
 },
 {
  "content": "未超过房产价值"
 },
 {
  "content": "，则通过处置"
 },
 {
  "content": "房产即可清偿，"
 },
 {
  "content": "无需动用个人财产"
 },
 {
  "content": "；若欠款超过"
 },
 {
  "content": "房产价值，超出"
 },
 {
  "content": "部分子女无需用"
 },
 {
  "content": "个人财产偿还，"
 },
 {
  "content": "除非其自愿偿还"
 },
 {
  "content": "。\n最后，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百六十一条"
 },
 {
  "content": "第二款，若子女"
 },
 {
  "content": "选择放弃继承，"
 },
 {
  "content": "则对父亲的信用卡"
 },
 {
  "content": "欠款可以不负清偿"
 },
 {
  "content": "责任。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：子女并非"
 },
 {
  "content": "必须拿自己的钱"
 },
 {
  "content": "偿还父亲的信用卡欠款"
 },
 {
  "content": "，仅在继承遗产"
 },
 {
  "content": "价值范围内承担清偿"
 },
 {
  "content": "责任。\n风险"
 },
 {
  "content": "提示：若子女"
 },
 {
  "content": "选择继承房产，"
 },
 {
  "content": "需在遗产"
 },
 {
  "content": "范围内"
 },
 {
  "content": "配合"
 },
 {
  "content": "清偿"
 },
 {
  "content": "债务；若私自"
 },
 {
  "content": "转移遗产规避"
 },
 {
  "content": "债务"
 },
 {
  "content": "，可能面临"
 },
 {
  "content": "债权人"
 },
 {
  "content": "追"
 },
 {
  "content": "索。"
 },
 {
  "content": "此外，如果信用卡"
 },
 {
  "content": "欠款属于"
 },
 {
  "content": "夫妻共同债务，"
 },
 {
  "content": "则需先析出"
 },
 {
  "content": "配偶的财产份额"
 },
 {
  "content": "进行清偿。放弃"
 },
 {
  "content": "继承需符合法定"
 },
 {
  "content": "程序，否则可能"
 },
 {
  "content": "仍需"
 },
 {
  "content": "承担管理遗产"
 },
 {
  "content": "及协助清偿的义务"
 },
 {
  "content": "。本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
