 {
  "content": "① 案情与"
 },
 {
  "content": "争议焦点\n房东"
 },
 {
  "content": "因租客晚交"
 },
 {
  "content": "两天房租，未"
 },
 {
  "content": "通知即更换门锁"
 },
 {
  "content": "且拒绝退还押金"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "：1. "
 },
 {
  "content": "房东单方换"
 },
 {
  "content": "锁行为是否具有"
 },
 {
  "content": "法律依据；2"
 },
 {
  "content": ". 房东拒绝"
 },
 {
  "content": "退还押金是否有法律"
 },
 {
  "content": "依据。\n\n②"
 },
 {
  "content": " 法律依据\n"
 },
 {
  "content": "《民法典》第七百"
 },
 {
  "content": "二十二条：承租人"
 },
 {
  "content": "无正当理由未"
 },
 {
  "content": "支付或者迟延"
 },
 {
  "content": "支付租金的，"
 },
 {
  "content": "出租人可以请求承租"
 },
 {
  "content": "人在合理期限内支付"
 },
 {
  "content": "；承租人逾期不支付的"
 },
 {
  "content": "，出租人可以解除"
 },
 {
  "content": "合同。\n《"
 },
 {
  "content": "民法典》第七百三十"
 },
 {
  "content": "条：当事人对"
 },
 {
  "content": "租赁期限没有约定"
 },
 {
  "content": "或者约定不明确"
 },
 {
  "content": "，依据本法第五百"
 },
 {
  "content": "一十条的规定仍"
 },
 {
  "content": "不能确定的，视为"
 },
 {
  "content": "不定期租赁；当事人"
 },
 {
  "content": "可以随时解除合同，"
 },
 {
  "content": "但是应当在合理期限"
 },
 {
  "content": "之前通知对方。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n关于"
 },
 {
  "content": "房东单方换"
 },
 {
  "content": "锁行为：\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第七百二十二条，"
 },
 {
  "content": "承租人迟延支付"
 },
 {
  "content": "租金（晚交"
 },
 {
  "content": "两天），出租人"
 },
 {
  "content": "仅享有“请求"
 },
 {
  "content": "承租人在合理期限内"
 },
 {
  "content": "支付”的权利。"
 },
 {
  "content": "只有在承租人“逾期不"
 },
 {
  "content": "支付”的情况下，"
 },
 {
  "content": "出租人才享有“"
 },
 {
  "content": "解除合同”的权利"
 },
 {
  "content": "。晚交两天"
 },
 {
  "content": "房租并不直接产生"
 },
 {
  "content": "合同解除权，"
 },
 {
  "content": "房东未先履行"
 },
 {
  "content": "催告程序且"
 },
 {
  "content": "未给予合理期限，直接换锁"
 },
 {
  "content": "剥夺了租客对"
 },
 {
  "content": "租赁物的使用权，"
 },
 {
  "content": "缺乏法律依据。"
 },
 {
  "content": "\n此外，若"
 },
 {
  "content": "该租赁属于不定期"
 },
 {
  "content": "租赁，根据《"
 },
 {
  "content": "民法典》第七百三十"
 },
 {
  "content": "条，当事人可以随时"
 },
 {
  "content": "解除合同，但"
 },
 {
  "content": "前提是“应当在合理"
 },
 {
  "content": "期限之前通知对方"
 },
 {
  "content": "”。房东未通知"
 },
 {
  "content": "即换锁，"
 },
 {
  "content": "亦违反了法定的"
 },
 {
  "content": "通知义务。\n"
 },
 {
  "content": "关于押金退还："
 },
 {
  "content": "\n由于房东解除"
 },
 {
  "content": "合同（通过"
 },
 {
  "content": "换锁行为推"
 },
 {
  "content": "定）不符合《"
 },
 {
  "content": "民法典》第七百二十二"
 },
 {
  "content": "条及第七百三十"
 },
 {
  "content": "条的规定，房东"
 },
 {
  "content": "认定租客违约的理由"
 },
 {
  "content": "可能不成立。"
 },
 {
  "content": "因此，房东以"
 },
 {
  "content": "租客违约为由"
 },
 {
  "content": "拒绝退还押金，"
 },
 {
  "content": "亦可能缺乏合法"
 },
 {
  "content": "依据。但关于"
 },
 {
  "content": "押金退还的具体规则"
 },
 {
  "content": "及不合理押"
 },
 {
  "content": "金的界定，现有"
 },
 {
  "content": "资料未涵盖，"
 },
 {
  "content": "需结合《民法典"
 },
 {
  "content": "》合同编通则"
 },
 {
  "content": "及租赁合同章节"
 },
 {
  "content": "的其他条款进一步判断"
 },
 {
  "content": "。\n\n④ "
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：房东因"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "且未通知即"
 },
 {
  "content": "换锁的行为，"
 },
 {
  "content": "存在缺乏法律依据"
 },
 {
  "content": "的风险，可能构成"
 },
 {
  "content": "对租客租赁物"
 },
 {
  "content": "使用权的侵害。"
 },
 {
  "content": "房东以此为由拒绝"
 },
 {
  "content": "退还押金，亦"
 },
 {
  "content": "可能缺乏合法依据"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：租客有权要求"
 },
 {
  "content": "房东恢复原状"
 },
 {
  "content": "（换回"
 },
 {
  "content": "锁）或主张"
 },
 {
  "content": "因无法使用租赁"
 },
 {
  "content": "物造成的损失。"
 },
 {
  "content": "对于押金问题，"
 },
 {
  "content": "建议双方协商处理"
 },
 {
  "content": "，若协商不成"
 },
 {
  "content": "，需结合《"
 },
 {
  "content": "民法典》合同编"
 },
 {
  "content": "通则及租赁合同"
 },
 {
  "content": "章节的其他相关规定进一步"
 },
 {
  "content": "主张权利。本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
