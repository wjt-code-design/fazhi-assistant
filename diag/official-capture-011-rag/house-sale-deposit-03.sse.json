 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n买方与"
 },
 {
  "content": "卖方就二手房签订"
 },
 {
  "content": "认购书并支付"
 },
 {
  "content": "10万元定金"
 },
 {
  "content": "，卖方因房价"
 },
 {
  "content": "上涨拒绝出售。"
 },
 {
  "content": "争议焦点在于卖方"
 },
 {
  "content": "是否构成根本违约"
 },
 {
  "content": "，买方是否有权"
 },
 {
  "content": "要求双倍返还定金"
 },
 {
  "content": "，以及10"
 },
 {
  "content": "万元定金是否受"
 },
 {
  "content": "法定上限限制。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n《民法典"
 },
 {
  "content": "》第五百八十七条"
 },
 {
  "content": "（定金罚则"
 },
 {
  "content": "）\n《民法典"
 },
 {
  "content": "》第五百八十六条"
 },
 {
  "content": "（定金限额）"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第五百八十八条（"
 },
 {
  "content": "定金与赔偿损失"
 },
 {
  "content": "）\n《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "（违约责任）"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，卖方因涨价"
 },
 {
  "content": "拒绝卖房，"
 },
 {
  "content": "属于不履行合同"
 },
 {
  "content": "义务，构成违约"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "，当事人一方不"
 },
 {
  "content": "履行合同义务的"
 },
 {
  "content": "，应当承担违约"
 },
 {
  "content": "责任。\n其次"
 },
 {
  "content": "，卖方作为收受"
 },
 {
  "content": "定金的一方，拒绝"
 },
 {
  "content": "履行债务导致合同"
 },
 {
  "content": "目的无法实现，"
 },
 {
  "content": "触发了定金罚"
 },
 {
  "content": "则。根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十七条，收受定金"
 },
 {
  "content": "的一方不履行债务"
 },
 {
  "content": "致使不能实现合同"
 },
 {
  "content": "目的的，应当双倍"
 },
 {
  "content": "返还定金。\n"
 },
 {
  "content": "再次，定金的"
 },
 {
  "content": "数额受法律限制"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百八十六条"
 },
 {
  "content": "，定金的数额"
 },
 {
  "content": "不得超过主合同标的"
 },
 {
  "content": "额的20%"
 },
 {
  "content": "，超过部分不"
 },
 {
  "content": "产生定金的效力"
 },
 {
  "content": "。若10"
 },
 {
  "content": "万元定金超过房屋"
 },
 {
  "content": "总价的20"
 },
 {
  "content": "%，则仅"
 },
 {
  "content": "20%以内的"
 },
 {
  "content": "部分适用双倍罚"
 },
 {
  "content": "则，超出部分"
 },
 {
  "content": "仅能要求原"
 },
 {
  "content": "额返还。\n"
 },
 {
  "content": "最后，若房价"
 },
 {
  "content": "上涨导致买"
 },
 {
  "content": "方的实际损失超过"
 },
 {
  "content": "双倍定金数额，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百八十八条，"
 },
 {
  "content": "定金不足以弥补一方"
 },
 {
  "content": "违约造成的损失的，"
 },
 {
  "content": "对方可以请求赔偿"
 },
 {
  "content": "超过定金数额的"
 },
 {
  "content": "损失。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：买方"
 },
 {
  "content": "有权要求卖方双倍"
 },
 {
  "content": "返还定金（在"
 },
 {
  "content": "法定20%"
 },
 {
  "content": "上限内），并"
 },
 {
  "content": "可能主张超出部分的"
 },
 {
  "content": "实际损失赔偿。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "需核实认购书中"
 },
 {
  "content": "明确写明的是"
 },
 {
  "content": "“定金”而非"
 },
 {
  "content": "“订金”；"
 },
 {
  "content": "需计算房屋总价"
 },
 {
  "content": "以确认10"
 },
 {
  "content": "万元是否超过2"
 },
 {
  "content": "0%的法定"
 },
 {
  "content": "上限；主张超出"
 },
 {
  "content": "定金数额的损失"
 },
 {
  "content": "需由买方承担"
 },
 {
  "content": "举证责任，证明"
 },
 {
  "content": "实际损失的具体"
 },
 {
  "content": "金额。本答复"
 },
 {
