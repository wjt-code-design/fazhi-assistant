[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案中，承租人"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "，出租人未"
 },
 {
  "content": "作通知即擅自"
 },
 {
  "content": "换锁并拒绝"
 },
 {
  "content": "退还押金。争议"
 },
 {
  "content": "焦点在于：出租"
 },
 {
  "content": "人是否有权因"
 },
 {
  "content": "晚交两天房租"
 },
 {
  "content": "而单方换"
 },
 {
  "content": "锁及没收押金"
 },
 {
  "content": "。\n\n② "
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第七百"
 },
 {
  "content": "二十二条，承租人"
 },
 {
  "content": "无正当理由未"
 },
 {
  "content": "支付或者迟延"
 },
 {
  "content": "支付租金的，"
 },
 {
  "content": "出租人可以请求承租"
 },
 {
  "content": "人在合理期限内支付"
 },
 {
  "content": "；承租人逾期不支付的"
 },
 {
  "content": "，出租人可以解除"
 },
 {
  "content": "合同。\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n首先，关于"
 },
 {
  "content": "晚交房租的法律"
 },
 {
  "content": "后果。晚交"
 },
 {
  "content": "两天租金属于轻微"
 },
 {
  "content": "迟延，并不"
 },
 {
  "content": "直接产生合同解除"
 },
 {
  "content": "的法律后果。依据"
 },
 {
  "content": "前述条文"
 },
 {
  "content": "，出租人若"
 },
 {
  "content": "因迟"
 },
 {
  "content": "延支付租金主张"
 },
 {
  "content": "权利，必须先"
 },
 {
  "content": "履行催告义务"
 },
 {
  "content": "，给予承租人"
 },
 {
  "content": "合理的支付期限。"
 },
 {
  "content": "只有在承租人逾期"
 },
 {
  "content": "仍不支付的情况下"
 },
 {
  "content": "，出租人才享有"
 },
 {
  "content": "法定的合同"
 },
 {
  "content": "解除权。\n"
 },
 {
  "content": "其次，关于擅自"
 },
 {
  "content": "换锁行为的合法性"
 },
 {
  "content": "。出租人未"
 },
 {
  "content": "进行催告，"
 },
 {
  "content": "也未在"
 },
 {
  "content": "解除合同前"
 },
 {
  "content": "通知承租人，直接"
 },
 {
  "content": "采取换锁行为"
 },
 {
  "content": "，导致承租人无法"
 },
 {
  "content": "正常使用租赁物，"
 },
 {
  "content": "该行为缺乏法律"
 },
 {
  "content": "依据，构成对"
 },
 {
  "content": "承租人合法占有和使用"
 },
 {
  "content": "租赁物的"
 },
 {
  "content": "侵犯，属于违法"
 },
 {
  "content": "的私力救济"
 },
 {
  "content": "。\n最后，"
 },
 {
  "content": "关于押金退还问题"
 },
 {
  "content": "。由于出租人"
 },
 {
  "content": "违法换锁导致"
 },
 {
  "content": "租赁合同无法继续"
 },
 {
  "content": "履行，其本身"
 },
 {
  "content": "构成违约，"
 },
 {
  "content": "无权以"
 },
 {
  "content": "承租人晚交两天"
 },
 {
  "content": "房租为由没收押金"
 },
 {
  "content": "。押金应当退还"
 },
 {
  "content": "，若因"
 },
 {
  "content": "换锁造成承租人"
 },
 {
  "content": "其他财物"
 },
 {
  "content": "损失，承租人亦可"
 },
 {
  "content": "主张赔偿。\n\n"
 },
 {
  "content": "④ 结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "房东擅自换锁"
 },
 {
  "content": "及没收押金的行为"
 },
 {
  "content": "缺乏法律依据，"
 },
 {
  "content": "承租人有权要求退还"
 },
 {
  "content": "押金，并可要求"
 },
 {
  "content": "房东承担因"
 },
 {
  "content": "换锁造成的损失"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：实务中，"
 },
 {
  "content": "需结合租赁"
 },
 {
  "content": "合同的具体约定"
 },
 {
  "content": "判断是否存在关于"
 },
 {
  "content": "迟延支付租金"
 },
 {
  "content": "的特殊条款"
 },
 {
  "content": "，但即便"
 },
 {
  "content": "有约定，也"
 },
 {
  "content": "需符合法律关于"
 },
 {
  "content": "合同解除的程序"
 },
 {
  "content": "性规定，出租"
 },
 {
  "content": "人直接换锁"
 },
 {
  "content": "仍存在较大法律"
 },
 {
  "content": "风险。建议承租人"
 },
 {
  "content": "通过协商或"
 },
 {
  "content": "诉讼途径维权"
 },
 {
  "content": "。"
 },
