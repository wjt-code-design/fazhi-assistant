[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案中，卖方"
 },
 {
  "content": "逾期交货30"
 },
 {
  "content": "天，构成违约"
 },
 {
  "content": "。合同约定的违约金"
 },
 {
  "content": "远高于买方的实际"
 },
 {
  "content": "损失。争议焦点"
 },
 {
  "content": "在于：当合同"
 },
 {
  "content": "约定的违约金过分高于"
 },
 {
  "content": "实际损失时，"
 },
 {
  "content": "买方是否有权请求"
 },
 {
  "content": "法院予以适当减少"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十五条第二款，约定的"
 },
 {
  "content": "违约金过分高于造成的"
 },
 {
  "content": "损失的，人民法院或者"
 },
 {
  "content": "仲裁机构可以根据当事人的"
 },
 {
  "content": "请求予以适当减少"
 },
 {
  "content": "。同时，根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "八十四条，损失"
 },
 {
  "content": "赔偿额应当相当于"
 },
 {
  "content": "因违约所造成的损失"
 },
 {
  "content": "，确立了违约损害赔偿"
 },
 {
  "content": "的填平原则"
 },
 {
  "content": "。\n\n③逐"
 },
 {
  "content": "项论证\n首先"
 },
 {
  "content": "，卖方逾期交货"
 },
 {
  "content": "30天，"
 },
 {
  "content": "属于履行合同义务"
 },
 {
  "content": "不符合约定的违约行为"
 },
 {
  "content": "，应当承担违约"
 },
 {
  "content": "责任。\n其次"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第五百八十五条"
 },
 {
  "content": "，当事人虽可"
 },
 {
  "content": "自由约定违约金，"
 },
 {
  "content": "但违约金制度以"
 },
 {
  "content": "补偿性为主、"
 },
 {
  "content": "惩罚性为辅。"
 },
 {
  "content": "若约定的违约金过分"
 },
 {
  "content": "高于实际损失，"
 },
 {
  "content": "则违背了违约"
 },
 {
  "content": "金的补偿性原则"
 },
 {
  "content": "，守约方"
 },
 {
  "content": "据此获取"
 },
 {
  "content": "不当利益，有"
 },
 {
  "content": "违公平原则。"
 },
 {
  "content": "\n最后，买方"
 },
 {
  "content": "作为守约方"
 },
 {
  "content": "，若认为约定的"
 },
 {
  "content": "违约金过高，有权"
 },
 {
  "content": "依据《民法典》"
 },
 {
  "content": "第五百八十五条向"
 },
 {
  "content": "人民法院或者仲裁机构"
 },
 {
  "content": "提出减少违约金的"
 },
 {
  "content": "请求。法院在"
 },
 {
  "content": "裁量时，通常会"
 },
 {
  "content": "以实际损失为基础"
 },
 {
  "content": "，兼顾合同的履行"
 },
 {
  "content": "情况、当事人的过错"
 },
 {
  "content": "程度以及预期利益"
 },
 {
  "content": "等综合因素，"
 },
 {
  "content": "根据公平原则和"
 },
 {
  "content": "诚信原则予以衡量"
 },
 {
  "content": "并作出"
 },
 {
  "content": "裁判。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：买方可以"
 },
 {
  "content": "请求法院适当减少"
 },
 {
  "content": "违约金。\n风险"
 },
 {
  "content": "提示：第一，"
 },
 {
  "content": "买方需承担举证"
 },
 {
  "content": "责任，证明约定的违约金“过分高于"
 },
 {
  "content": "”造成的实际损失"
 },
 {
  "content": "，若举证"
 },
 {
  "content": "不足，其请求"
 },
 {
  "content": "可能无法得到支持"
 },
 {
  "content": "。第二，法院"
 },
 {
  "content": "减少违约金是基于当事人的"
 },
 {
  "content": "请求，遵循“"
 },
 {
  "content": "不告不理”"
 },
 {
  "content": "原则，若买方"
 },
 {
  "content": "未主动提出，"
 },
 {
  "content": "法院一般不会主动"
 },
 {
  "content": "干预。第三，"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百八十五条第三"
 },
 {
  "content": "款，若该"
 },
 {
  "content": "违约金是针对迟延"
 },
 {
  "content": "履行约定的，卖方"
 },
 {
  "content": "支付违约金后，"
 },
 {
  "content": "买方仍可"
 },
 {
  "content": "要求卖方继续履行"
 },
 {
  "content": "交货义务。"
 },
