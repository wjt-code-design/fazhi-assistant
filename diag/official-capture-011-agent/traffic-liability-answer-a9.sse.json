 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案为两机动车"
 },
 {
  "content": "追尾事故，"
 },
 {
  "content": "交警认定后车"
 },
 {
  "content": "负全部责任。"
 },
 {
  "content": "核心争议焦点"
 },
 {
  "content": "在于前车的损失"
 },
 {
  "content": "应由谁"
 },
 {
  "content": "承担赔偿责任，以及"
 },
 {
  "content": "赔偿义务"
 },
 {
  "content": "主体之间的"
 },
 {
  "content": "顺"
 },
 {
  "content": "位如何。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "1.《道路交通安全"
 },
 {
  "content": "法》第七十六条"
 },
 {
  "content": "第一款第一项："
 },
 {
  "content": "机动车之间发生交通事故"
 },
 {
  "content": "的，由有过"
 },
 {
  "content": "错的一方承担赔偿责任"
 },
 {
  "content": "；双方都有过错"
 },
 {
  "content": "的，按照各自"
 },
 {
  "content": "过错的比例分担责任"
 },
 {
  "content": "。\n2."
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十三条："
 },
 {
  "content": "机动车发生交通事故造成"
 },
 {
  "content": "损害，属于该"
 },
 {
  "content": "机动车一方责任的，"
 },
 {
  "content": "先由承保机动车"
 },
 {
  "content": "强制保险的保险"
 },
 {
  "content": "人在强制保险责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "；不足部分，"
 },
 {
  "content": "由承保机动车商业"
 },
 {
  "content": "保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由侵权人"
 },
 {
  "content": "赔偿。\n3"
 },
 {
  "content": ".《民法典》"
 },
 {
  "content": "第一千一百六十五条"
 },
 {
  "content": "：行为人因"
 },
 {
  "content": "过错侵害他人民"
 },
 {
  "content": "事权益造成损害"
 },
 {
  "content": "的，应当承担"
 },
 {
  "content": "侵权责任。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n1.责任"
 },
 {
  "content": "主体认定：交警"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任，表明"
 },
 {
  "content": "后车驾驶"
 },
 {
  "content": "人对事故的发生存在"
 },
 {
  "content": "过错。根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十五条的过错"
 },
 {
  "content": "责任原则，以及"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第七十六条第一款第一"
 },
 {
  "content": "项关于机动车之间"
 },
 {
  "content": "交通事故由过错"
 },
 {
  "content": "方担"
 },
 {
  "content": "责的规定，后"
 },
 {
  "content": "车一方"
 },
 {
  "content": "作为侵权"
 },
 {
  "content": "人，"
 },
 {
  "content": "依法"
 },
 {
  "content": "应对前车的损失"
 },
 {
  "content": "承担赔偿责任。\n"
 },
 {
  "content": "2.赔偿顺"
 },
 {
  "content": "位确定"
 },
 {
  "content": "：根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十三条，"
 },
 {
  "content": "前车"
 },
 {
  "content": "损失的赔偿需遵循"
 },
 {
  "content": "“交强险"
 },
 {
  "content": "先行、商业险"
 },
 {
  "content": "补充、侵权人"
 },
 {
  "content": "兜底”的"
 },
 {
  "content": "法定顺位。"
 },
 {
  "content": "首先由后车"
 },
 {
  "content": "承保交"
 },
 {
  "content": "强险的保险"
 },
 {
  "content": "公司在责任限额内"
 },
 {
  "content": "赔付"
 },
 {
  "content": "；不足部分，"
 },
 {
  "content": "由后车承保"
 },
 {
  "content": "商业险的保险公司"
 },
 {
  "content": "按合同约定赔付"
 },
 {
  "content": "；若仍"
 },
 {
  "content": "不足或未"
 },
 {
  "content": "投保商业险，"
 },
 {
  "content": "则由后车侵权"
 },
 {
  "content": "人自行赔付"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：前车的损失"
 },
 {
  "content": "由后车"
 },
 {
  "content": "方的交强险"
 },
 {
  "content": "保险公司、商业险"
 },
 {
  "content": "保险公司及后车"
 },
 {
  "content": "侵权人按法定"
 },
 {
  "content": "顺位依次"
 },
 {
  "content": "进行赔偿。\n"
 },
 {
  "content": "风险提示：若"
 },
 {
  "content": "后车未投保"
 },
 {
  "content": "交强险、"
 },
 {
  "content": "商业险保额"
 },
 {
  "content": "不足，或存在"
 },
 {
  "content": "醉酒"
 },
 {
  "content": "驾驶等保险公司"
 },
 {
  "content": "免责情形，前"
 },
 {
  "content": "车"
 },
 {
  "content": "损失将直接由"
 },
 {
  "content": "侵权人个人承担"
 },
 {
  "content": "，此时可能面临"
 },
 {
  "content": "侵权人无力"
 },
 {
  "content": "赔偿"
 },
 {
  "content": "导致执行不能"
 },
 {
  "content": "的风险。"
 },
