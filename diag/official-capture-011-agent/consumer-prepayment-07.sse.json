[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n本案为消费者"
 },
 {
  "content": "与健身房之间的"
 },
 {
  "content": "服务合同纠纷。消费者"
 },
 {
  "content": "办"
 },
 {
  "content": "卡后健身房关门"
 },
 {
  "content": "停业"
 },
 {
  "content": "，且合同中"
 },
 {
  "content": "载明"
 },
 {
  "content": "“概不退款"
 },
 {
  "content": "”。争议焦点在于"
 },
 {
  "content": "：该“概"
 },
 {
  "content": "不退款”条款"
 },
 {
  "content": "是否具有法律效力"
 },
 {
  "content": "？消费者在健身房"
 },
 {
  "content": "违约"
 },
 {
  "content": "关门的情况下，是否有"
 },
 {
  "content": "权要求退还剩余"
 },
 {
  "content": "费用。\n\n②"
 },
 {
  "content": " 法律依据\n"
 },
 {
  "content": "《民法典》第四百"
 },
 {
  "content": "九十六条关于格式"
 },
 {
  "content": "条款定义及提示"
 },
 {
  "content": "说明义务的规定；"
 },
 {
  "content": "《民法典》第四百"
 },
 {
  "content": "九十七条关于格式"
 },
 {
  "content": "条款无效情形"
 },
 {
  "content": "的规定；《消费者权益"
 },
 {
  "content": "保护法》第二十六条关于"
 },
 {
  "content": "经营者不得利用格式"
 },
 {
  "content": "条款排除或"
 },
 {
  "content": "限制消费者权利的规定"
 },
 {
  "content": "；《民法典》"
 },
 {
  "content": "第五百六十三条关于"
 },
 {
  "content": "合同法定解除的规定"
 },
 {
  "content": "；《民法典》"
 },
 {
  "content": "第五百七十七条关于"
 },
 {
  "content": "违约责任的规定。"
 },
 {
  "content": "\n\n③ 逐"
 },
 {
  "content": "项论证\n第一"
 },
 {
  "content": "，关于“概"
 },
 {
  "content": "不退款”条款"
 },
 {
  "content": "的效力。该"
 },
 {
  "content": "条款由健身房预先"
 },
 {
  "content": "拟定且"
 },
 {
  "content": "未与消费者协商"
 },
 {
  "content": "，属于格式条款"
 },
 {
  "content": "。健身房关门导致"
 },
 {
  "content": "其无法提供后续"
 },
 {
  "content": "服务，此时若"
 },
 {
  "content": "仍适用“概"
 },
 {
  "content": "不退款”，属于"
 },
 {
  "content": "提供格式条款一方"
 },
 {
  "content": "不合理地免除自身"
 },
 {
  "content": "责任、排除消费者"
 },
 {
  "content": "主要权利的情形。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第四百九十七条及"
 },
 {
  "content": "《消费者权益保护法》"
 },
 {
  "content": "第二十六条，该条款"
 },
 {
  "content": "内容无效，对"
 },
 {
  "content": "消费者不具有法律约束"
 },
 {
  "content": "力。\n第二"
 },
 {
  "content": "，关于健身房关"
 },
 {
  "content": "门的性质。健身房"
 },
 {
  "content": "关门停业，无法"
 },
 {
  "content": "继续为消费者提供"
 },
 {
  "content": "健身服务，构成"
 },
 {
  "content": "根本违约，导致"
 },
 {
  "content": "合同目的无法实现"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百六十三条"
 },
 {
  "content": "，消费者有权解除"
 },
 {
  "content": "双方之间的服务合同"
 },
 {
  "content": "。\n第三，"
 },
 {
  "content": "关于退款请求权"
 },
 {
  "content": "。合同解除后"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第五百七十七条"
 },
 {
  "content": "，消费者有权要求"
 },
 {
  "content": "健身房承担赔偿损失"
 },
 {
  "content": "等违约责任。"
 },
 {
  "content": "因健身房已无法"
 },
 {
  "content": "继续履行服务，"
 },
 {
  "content": "消费者有权要求其"
 },
 {
  "content": "退还卡内尚未"
 },
 {
  "content": "消费的剩余费用。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：消费者有权要求"
 },
 {
  "content": "健身房退还剩余费用"
 },
 {
  "content": "，合同中的“"
 },
 {
  "content": "概不退款”"
 },
 {
  "content": "条款无效。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "虽然法律上消费者的"
 },
 {
  "content": "退款主张成立，"
 },
 {
  "content": "但实际执行中存在"
 },
 {
  "content": "风险。若健身房"
 },
 {
  "content": "已经关门且经营者"
 },
 {
  "content": "失联或进入破产"
 },
 {
  "content": "程序，消费者可能"
 },
 {
  "content": "面临无财产可供"
 },
 {
  "content": "执行的情况，导致"
 },
 {
  "content": "退款难以实际追回"
 },
 {
  "content": "。建议消费者及时"
 },
 {
  "content": "通过向"
 },
 {
  "content": "消费者协会"
 },
 {
  "content": "投诉、向市场监管"
 },
 {
  "content": "部门举报或向"
 },
 {
  "content": "法院提起诉讼等方式维权"
 },
 {
  "content": "，并注意保留"
 },
 {
  "content": "合同、付款凭证"
 },
 {
  "content": "等证据。"
 },
