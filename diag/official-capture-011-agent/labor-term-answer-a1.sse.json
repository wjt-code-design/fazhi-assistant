  "msg": "正在思考…"
 },
 {
  "content": "该试用期约定合法"
 },
 {
  "content": "。\n\n根据《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "第一款规定：“劳动合同"
 },
 {
  "content": "期限三个月以上不满"
 },
 {
  "content": "一年的，试用期不得超过"
 },
 {
  "content": "一个月；劳动合同期限"
 },
 {
  "content": "一年以上不满三年的，"
 },
 {
  "content": "试用期不得超过二个月"
 },
 {
  "content": "；三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月。”本案中"
 },
 {
  "content": "，公司与员工签订"
 },
 {
  "content": "的是三年期劳动合同"
 },
 {
  "content": "，属于“三年以上"
 },
 {
  "content": "固定期限劳动合同”，"
 },
 {
  "content": "约定的试用期"
 },
 {
  "content": "六个月未超过法"
 },
 {
  "content": "定的六个月上限。"
 },
 {
  "content": "\n\n同时，根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第二款规定：“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期。”本案属于"
 },
 {
  "content": "第一次约定试用期，"
 },
 {
  "content": "未违反该禁止"
 },
 {
  "content": "性规定。\n\n"
 },
 {
  "content": "因此，该试用期"
 },
 {
  "content": "约定符合法律规定。"
 },
 {
  "content": "\n\n风险提示："
 },
 {
  "content": "虽然该约定合法"
 },
 {
  "content": "，但六个月已是"
 },
 {
  "content": "法定最长期限"
 },
 {
  "content": "。用人单位在试用期"
 },
 {
  "content": "解除劳动合同"
 },
 {
  "content": "受到严格限制，"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第二十一条规定，"
 },
 {
  "content": "在试用期中，"
 },
 {
  "content": "除劳动者有本法"
 },
 {
  "content": "第三十九条和第四"
 },
 {
  "content": "十条第一项、"
 },
 {
  "content": "第二项规定的情形"
 },
 {
  "content": "外，用人单位不得"
 },
 {
  "content": "解除劳动合同，且"
 },
 {
  "content": "解除时需向"
 },
 {
  "content": "劳动者说明理由。"
 },
 {
  "content": "\n\n本答复仅供参考"
 },
 {
  "content": "，不构成正式"
 },
 {
  "content": "法律意见。"
 },
