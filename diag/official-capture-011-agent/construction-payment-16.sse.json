 },
 {
  "content": "① 案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "装修公司拖延工期两个月"
 },
 {
  "content": "，并以材料涨价"
 },
 {
  "content": "为由要求加价，"
 },
 {
  "content": "否则拒绝继续"
 },
 {
  "content": "施工。争议焦点"
 },
 {
  "content": "在于：1."
 },
 {
  "content": " 装修公司拖延工期"
 },
 {
  "content": "是否具有合法依据"
 },
 {
  "content": "；2. "
 },
 {
  "content": "材料涨价能否成为"
 },
 {
  "content": "装修公司单方加价"
 },
 {
  "content": "或停工的合法"
 },
 {
  "content": "理由。\n\n②"
 },
 {
  "content": " 法律依据\n"
 },
 {
  "content": "《民法典》第八百"
 },
 {
  "content": "零三条：发包"
 },
 {
  "content": "人未按照约定的"
 },
 {
  "content": "时间和要求提供原材料"
 },
 {
  "content": "、设备、场地"
 },
 {
  "content": "、资金、技术"
 },
 {
  "content": "资料的，承包人可以"
 },
 {
  "content": "顺延工程日期"
 },
 {
  "content": "，并有权请求"
 },
 {
  "content": "赔偿停工、窝"
 },
 {
  "content": "工等损失。"
 },
 {
  "content": "\n《民法典》"
 },
 {
  "content": "第八百零一条："
 },
 {
  "content": "因施工人的原因"
 },
 {
  "content": "致使建设工程质量不符合"
 },
 {
  "content": "约定的，发包人"
 },
 {
  "content": "有权请求施工人在"
 },
 {
  "content": "合理期限内无偿修理"
 },
 {
  "content": "或者返工、"
 },
 {
  "content": "改建。经过修理"
 },
 {
  "content": "或者返工、"
 },
 {
  "content": "改建后，造成"
 },
 {
  "content": "逾期交付的，"
 },
 {
  "content": "施工人应当承担"
 },
 {
  "content": "违约责任。\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n关于工期"
 },
 {
  "content": "拖延：根据《"
 },
 {
  "content": "民法典》第八百零"
 },
 {
  "content": "三条的规定，承包"
 },
 {
  "content": "人顺延工程"
 },
 {
  "content": "日期的法定事"
 },
 {
  "content": "由是发包"
 },
 {
  "content": "人未按约"
 },
 {
  "content": "提供原材料、设备"
 },
 {
  "content": "、场地、资金"
 },
 {
  "content": "、技术资料等"
 },
 {
  "content": "。本案中，"
 },
 {
  "content": "材料涨价属于商业"
 },
 {
  "content": "风险，并非发包"
 },
 {
  "content": "人未按约"
 },
 {
  "content": "提供材料所致"
 },
 {
  "content": "，不具备顺延"
 },
 {
  "content": "工期的法定条件"
 },
 {
  "content": "。因此，装修公司"
 },
 {
  "content": "拖延两个月的行为"
 },
 {
  "content": "缺乏"
 },
 {
  "content": "法律依据，构成"
 },
 {
  "content": "违约"
 },
 {
  "content": "。\n关于加价"
 },
 {
  "content": "停工：装修公司以"
 },
 {
  "content": "材料涨价为由要求"
 },
 {
  "content": "加价，否则停工"
 },
 {
  "content": "，实质上是单"
 },
 {
  "content": "方要求变更合同"
 },
 {
  "content": "价款，并可能"
 },
 {
  "content": "构成预期违约。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第八百零一条关于"
 },
 {
  "content": "施工人按"
 },
 {
  "content": "约施工、无偿"
 },
 {
  "content": "返修的规定精神"
 },
 {
  "content": "，施工人应当"
 },
 {
  "content": "全面履行合同义务"
 },
 {
  "content": "。材料涨价属于"
 },
 {
  "content": "正常的商业风险，"
 },
 {
  "content": "不能成为单方"
 },
 {
  "content": "加价或停工的"
 },
 {
  "content": "合法理由。若"
 },
 {
  "content": "其擅自停工，"
 },
 {
  "content": "属于违约行为。"
 },
 {
  "content": "\n\n④ 结论"
 },
 {
  "content": "与风险\n装修"
 },
 {
  "content": "公司的行为构成违约"
 },
 {
  "content": "，业主有权要求"
 },
 {
  "content": "其继续履行并"
 },
 {
  "content": "承担违约责任。"
 },
 {
  "content": "关于拖延工期的"
 },
 {
  "content": "具体违约责任计算"
 },
 {
  "content": "及"
 },
 {
  "content": "合同解除条件，"
 },
 {
  "content": "通常需结合《"
 },
 {
  "content": "民法典》合同编"
 },
 {
  "content": "的相关规定"
 },
 {
  "content": "进一步确定。业主"
 },
 {
  "content": "应注意保存对方要求"
 },
 {
  "content": "加价、停工的证据"
 },
 {
  "content": "，必要时通过"
 },
 {
  "content": "诉讼维权。"
 },
