 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n用户在某"
 },
 {
  "content": "App注销账号后"
 },
 {
  "content": "，平台仍保留"
 },
 {
  "content": "其手机号及消费"
 },
 {
  "content": "记录用于营销推送"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "平台是否违反了用户"
 },
 {
  "content": "注销后的个人信息删除"
 },
 {
  "content": "义务，以及违反了"
 },
 {
  "content": "禁止未经同意发送"
 },
 {
  "content": "商业信息"
 },
 {
  "content": "的规定。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "电子商务法》第二十四条"
 },
 {
  "content": "、《消费者权益保护法》"
 },
 {
  "content": "第二十九条、《消费者权益保护法"
 },
 {
  "content": "》第五十条、《"
 },
 {
  "content": "网络安全法》第四"
 },
 {
  "content": "十五条。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，平台"
 },
 {
  "content": "违反了注销后的个人信息"
 },
 {
  "content": "删除义务。根据"
 },
 {
  "content": "《电子商务法》"
 },
 {
  "content": "第二十四条规定，用户"
 },
 {
  "content": "注销的，电子商务"
 },
 {
  "content": "经营者应当立即删除"
 },
 {
  "content": "该用户的信息；"
 },
 {
  "content": "依照法律、行政法规"
 },
 {
  "content": "的规定或者双方约定"
 },
 {
  "content": "保存的，依照"
 },
 {
  "content": "其规定。平台"
 },
 {
  "content": "在用户注销后"
 },
 {
  "content": "仍保留手机号与"
 },
 {
  "content": "消费记录，且"
 },
 {
  "content": "无法定或约定"
 },
 {
  "content": "理由，违反"
 },
 {
  "content": "了该条规定"
 },
 {
  "content": "。同时，根据"
 },
 {
  "content": "《网络安全法》"
 },
 {
  "content": "第四十五条，个人"
 },
 {
  "content": "发现网络运营者"
 },
 {
  "content": "违反法律、行政法规"
 },
 {
  "content": "的规定或者双方的约定"
 },
 {
  "content": "收集、使用其"
 },
 {
  "content": "个人信息的，有权"
 },
 {
  "content": "要求网络运营者"
 },
 {
  "content": "删除其个人信息。"
 },
 {
  "content": "\n第二，平台"
 },
 {
  "content": "违反了禁止未经同意"
 },
 {
  "content": "发送商业信息的规定"
 },
 {
  "content": "。根据《消费者权益"
 },
 {
  "content": "保护法》第二十九条规定"
 },
 {
  "content": "，经营者未经消费者"
 },
 {
  "content": "同意或者请求，"
 },
 {
  "content": "或者消费者明确表示"
 },
 {
  "content": "拒绝的，不得"
 },
 {
  "content": "向其发送商业性"
 },
 {
  "content": "信息。账号注销"
 },
 {
  "content": "通常意味着用户对"
 },
 {
  "content": "营销推送"
 },
 {
  "content": "的撤回或"
 },
 {
  "content": "明确拒绝"
 },
 {
  "content": "，平台继续推送"
 },
 {
  "content": "违反了"
 },
 {
  "content": "此规定。\n"
 },
 {
  "content": "第三，平台需"
 },
 {
  "content": "承担相应侵权"
 },
 {
  "content": "责任。根据《"
 },
 {
  "content": "消费者权益保护法》第五"
 },
 {
  "content": "十条规定，经营者"
 },
 {
  "content": "侵害消费者个人信息依法"
 },
 {
  "content": "得到保护的权利的"
 },
 {
  "content": "，应当停止侵害"
 },
 {
  "content": "、恢复"
 },
 {
  "content": "名誉、消除影响"
 },
 {
  "content": "、赔礼道歉"
 },
 {
  "content": "，并赔偿损失"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：平台在用户"
 },
 {
  "content": "注销账号后保留"
 },
 {
  "content": "其信息并用于"
 },
 {
  "content": "营销推送的行为，"
 },
 {
  "content": "违反了个人信息删除义务"
 },
 {
  "content": "及禁止未经同意"
 },
 {
  "content": "推送商业信息的规定"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：用户有权要求"
 },
 {
  "content": "平台立即删除"
 },
 {
  "content": "个人信息并停止营销"
 },
 {
  "content": "推送。若因"
 },
 {
  "content": "信息泄露或骚扰"
 },
 {
  "content": "造成实际损失，"
 },
 {
  "content": "可主张赔偿。"
 },
 {
  "content": "若平台侵害众"
 },
 {
  "content": "多个人的权益，"
 },
 {
  "content": "根据《个人信息保护法"
 },
 {
  "content": "》第七十条，"
 },
 {
  "content": "人民检察院、"
 },
 {
  "content": "法律规定的消费者组织等可依法提起"
 },
 {
  "content": "公益诉讼。建议"
 },
 {
  "content": "用户先行向平台"
 },
 {
  "content": "主张权利，或"
 },
 {
  "content": "向市场监督管理部门、"
 },
 {
  "content": "网信部门投诉举报"
 },
 {
  "content": "。"
 },
