[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "合法。"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第十九条第一款规定"
 },
 {
  "content": "，三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月。三年期"
 },
 {
  "content": "劳动合同属于“三年以上"
 },
 {
  "content": "固定期限劳动合同"
 },
 {
  "content": "”，约定试用期六个月"
 },
 {
  "content": "刚好达到法定上限"
 },
 {
  "content": "，未超过法律"
 },
 {
  "content": "允许的范围，因此"
 },
 {
  "content": "该约定合法。"
 },
 {
  "content": "\n\n此外，根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第四款，"
 },
 {
  "content": "试用期包含在劳动合同"
 },
 {
  "content": "期限内；同时，"
 },
 {
  "content": "因为是首次约定，"
 },
 {
  "content": "不违反第十九条第二款"
 },
 {
  "content": "“同一用人单位与"
 },
 {
  "content": "同一劳动者只能约定"
 },
 {
  "content": "一次试用期”的规定"
 },
 {
  "content": "。\n\n提示："
 },
 {
  "content": "虽然约定六个月试用期"
 },
 {
  "content": "合法，但根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第二十一条，在试用期"
 },
 {
  "content": "中，用人单位"
 },
 {
  "content": "除非有证据"
 },
 {
  "content": "证明劳动者存在《"
 },
 {
  "content": "劳动合同法》第三"
 },
 {
  "content": "十九条或第四十条"
 },
 {
  "content": "第一项、第二"
 },
 {
  "content": "项规定的情形，"
 },
 {
  "content": "否则不得解除劳动合同"
 },
 {
  "content": "，且解除"
 },
 {
  "content": "时需向劳动者"
 },
 {
  "content": "说明理由。若"
 },
 {
  "content": "随意以“试用期"
 },
 {
  "content": "不合格”解除"
 },
 {
  "content": "，可能构成违法"
 },
 {
  "content": "解除。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
