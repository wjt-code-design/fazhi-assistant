[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n公司以“绩效"
 },
 {
  "content": "不合格”为由当天"
 },
 {
  "content": "辞退员工，未"
 },
 {
  "content": "提前通知且未提供"
 },
 {
  "content": "任何绩效评估"
 },
 {
  "content": "或调岗培训"
 },
 {
  "content": "材料。争议焦点"
 },
 {
  "content": "在于：该辞退"
 },
 {
  "content": "行为是否合法，"
 },
 {
  "content": "劳动者应如何维权"
 },
 {
  "content": "。\n\n②"
 },
 {
  "content": "法律依据\n主要"
 },
 {
  "content": "涉及《劳动合同法"
 },
 {
  "content": "》第三十九条、"
 },
 {
  "content": "第四十条、第四"
 },
 {
  "content": "十六条、第四十八条"
 },
 {
  "content": "、第八十七条。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "需区分"
 },
 {
  "content": "员工是否"
 },
 {
  "content": "处于试用期。若"
 },
 {
  "content": "员工在试用"
 },
 {
  "content": "期间被证明不符合"
 },
 {
  "content": "录用条件（绩效"
 },
 {
  "content": "不合格可视为不符合"
 },
 {
  "content": "录用条件的一种"
 },
 {
  "content": "），用人单位"
 },
 {
  "content": "可依据《劳动合同"
 },
 {
  "content": "法》第三十九条"
 },
 {
  "content": "第一项解除劳动合同"
 },
 {
  "content": "，无需提前通知"
 },
 {
  "content": "及支付经济补偿"
 },
 {
  "content": "。但公司需"
 },
 {
  "content": "承担“被证明"
 },
 {
  "content": "”的举证责任"
 },
 {
  "content": "，未提供任何材料"
 },
 {
  "content": "将承担"
 },
 {
  "content": "举证不能的后果"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "若员工已过试用期"
 },
 {
  "content": "，或公司无法"
 },
 {
  "content": "证明试用期不符合录用"
 },
 {
  "content": "条件，“绩效不合格"
 },
 {
  "content": "”通常被"
 },
 {
  "content": "认定为“不能胜任"
 },
 {
  "content": "工作”。根据《"
 },
 {
  "content": "劳动合同法》第四"
 },
 {
  "content": "十条第二项，"
 },
 {
  "content": "劳动者不能胜任工作"
 },
 {
  "content": "，需经过培训"
 },
 {
  "content": "或者调整工作岗位，"
 },
 {
  "content": "仍不能胜任工作的"
 },
 {
  "content": "，用人单位才可以解除"
 },
 {
  "content": "，且需提前"
 },
 {
  "content": "三十日通知或"
 },
 {
  "content": "额外支付一个月工资"
 },
 {
  "content": "（代通知金"
 },
 {
  "content": "），并依据第四"
 },
 {
  "content": "十六条第三项支付"
 },
 {
  "content": "经济补偿。公司"
 },
 {
  "content": "当天辞退且未"
 },
 {
  "content": "给材料，严重"
 },
 {
  "content": "违反法定程序。"
 },
 {
  "content": "\n最后，公司"
 },
 {
  "content": "未能提供任何绩效"
 },
 {
  "content": "不合格及培训"
 },
 {
  "content": "、调岗的材料"
 },
 {
  "content": "，其辞退行为"
 },
 {
  "content": "缺乏事实与"
 },
 {
  "content": "程序依据，构成"
 },
 {
  "content": "违法解除劳动合同。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n公司的辞退"
 },
 {
  "content": "行为存在极高的违法"
 },
 {
  "content": "解除风险。根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第四十八条，劳动者"
 },
 {
  "content": "可以要求继续履行"
 },
 {
  "content": "劳动合同，或者不"
 },
 {
  "content": "要求继续履行而"
 },
 {
  "content": "要求公司依照第八"
 },
 {
  "content": "十七条支付赔偿金"
 },
 {
  "content": "（经济补偿标准的"
 },
 {
  "content": "二倍）。风险"
 },
 {
  "content": "提示：劳动者应"
 },
 {
  "content": "保留被辞退的证据"
 },
 {
  "content": "（如辞退通知"
 },
 {
  "content": "、沟通记录等"
 },
 {
  "content": "），并在法定时效"
 },
 {
  "content": "内申请劳动仲裁"
 },
 {
  "content": "，以维护自身"
 },
 {
  "content": "合法权益。本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
