 },
 {
  "content": "”或“在公司"
 },
 {
  "content": "不付款"
 },
 {
  "content": "时由本人承担"
 },
 {
  "content": "”，构成"
 },
 {
  "content": "保证合同关系"
 },
 {
  "content": "，供应商可依据"
 },
 {
  "content": "该"
 },
 {
  "content": "承诺"
 },
 {
  "content": "直接起诉"
 },
 {
  "content": "股东要求"
 },
 {
  "content": "承担保证"
 },
 {
  "content": "责任。  \n-"
 },
 {
  "content": " 若承诺表示"
 },
 {
  "content": "“本人愿意与公司"
 },
 {
  "content": "共同承担债务”"
 },
 {
  "content": "或“本人"
 },
 {
  "content": "加入公司债务”，"
 },
 {
  "content": "构成债务加入，"
 },
 {
  "content": "根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "五十二条，供应商"
 },
 {
  "content": "可直接"
 },
 {
  "content": "起诉股东要求"
 },
 {
  "content": "其在"
 },
 {
  "content": "承诺"
 },
 {
  "content": "范围内承担连带债务"
 },
 {
  "content": "。  \n- "
 },
 {
  "content": "若承诺"
 },
 {
  "content": "仅表示“督促"
 },
 {
  "content": "公司付款"
 },
 {
  "content": "”等"
 },
 {
  "content": "模糊"
 },
 {
  "content": "表述，未"
 },
 {
  "content": "明确"
 },
 {
  "content": "承担"
 },
 {
  "content": "债务的意思"
 },
 {
  "content": "，则不"
 },
 {
  "content": "构成保证或债务"
 },
 {
  "content": "加入，供应商不能"
 },
 {
