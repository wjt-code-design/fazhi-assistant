 },
 {
  "content": "最长期限。"
 },
 {
  "content": "\n其次，法律"
 },
 {
  "content": "明确规定“同一用人单位"
 },
 {
  "content": "与同一劳动者只能"
 },
 {
  "content": "约定一次试用期”，"
 },
 {
  "content": "公司对试用期"
