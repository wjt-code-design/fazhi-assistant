  "content": "，现卖方因"
 },
 {
  "content": "房价上涨拒绝"
 },
 {
  "content": "出售。争议焦点"
 },
 {
  "content": "在于卖方单方"
 },
 {
  "content": "涨价不卖是否"
 },
 {
  "content": "构成根本违约，"
 },
 {
  "content": "以及您是否有权"
 },
 {
  "content": "要求双倍返还定金"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n《民法典"
 },
 {
  "content": "》第五百八十六条"
 },
 {
  "content": "：定金合同自"
 },
 {
  "content": "实际交付定金时"
 },
 {
  "content": "成立。定金的"
 },
 {
  "content": "数额由当事人约定"
 },
 {
  "content": "，但不得超过主"
 },
 {
  "content": "合同标的额的百分之"
 },
 {
  "content": "二十，超过部分"
 },
 {
  "content": "不产生定金的"
 },
 {
  "content": "效力。\n《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十七条：收受定金"
 },
 {
  "content": "的一方不履行债务"
 },
 {
  "content": "或者履行债务不符合约定，致使不能"
 },
 {
  "content": "实现合同目的的，"
 },
 {
  "content": "应当双倍返还定金"
 },
 {
  "content": "。\n《民法典"
 },
 {
  "content": "》第五百六十三条"
 },
 {
  "content": "：当事人一方有其他"
 },
 {
  "content": "违约行为致使不能"
 },
 {
  "content": "实现合同目的，"
 },
 {
  "content": "当事人可以解除合同"
 },
 {
  "content": "。\n《民法典"
 },
 {
  "content": "》第五百八十八条"
 },
 {
  "content": "：定金不足以弥补"
 },
 {
  "content": "一方违约造成的损失的"
 },
 {
  "content": "，对方可以请求"
 },
 {
  "content": "赔偿超过定金数额"
 },
 {
  "content": "的损失。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n第一，关于"
 },
 {
  "content": "定金效力。根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "八十六条，您"
 },
 {
  "content": "已交付10"
 },
 {
  "content": "万元，定金合同"
 },
 {
  "content": "成立。但该"
 },
 {
  "content": "10万元若"
 },
 {
  "content": "超过房屋总价款的"
 },
 {
  "content": "百分之二十，超过"
 },
 {
  "content": "部分不适用定金"
 },
 {
  "content": "罚则，仅"
 },
 {
  "content": "能要求原额"
 },
 {
  "content": "返还。\n第二"
 },
 {
  "content": "，关于违约"
 },
 {
  "content": "认定。卖方因"
 },
 {
  "content": "涨价拒绝"
 },
 {
  "content": "卖房，属于"
 },
 {
  "content": "以自己的行为表明不履行主要债务，"
 },
 {
  "content": "构成根本违约。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百六十三条，"
 },
 {
  "content": "该行为导致合同"
 },
 {
  "content": "目的无法实现，"
 },
 {
  "content": "您有权解除认购"
 },
 {
  "content": "书。\n第三"
 },
 {
  "content": "，关于双倍返还"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百八十七条"
 },
 {
  "content": "，卖方作为收受"
 },
 {
  "content": "定金的一方不履行"
 },
 {
  "content": "债务致使不能"
 },
 {
  "content": "实现合同目的，"
 },
 {
  "content": "应当双倍返还定金"
 },
 {
  "content": "。您有权主张"
 },
 {
  "content": "该权利。若"
 },
 {
  "content": "房屋实际差价损失"
 },
 {
  "content": "超过定金"
 },
 {
  "content": "金额"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第五百八十八条"
 },
 {
  "content": "，您还可主张"
 },
 {
  "content": "赔偿超过定金数额"
 },
 {
  "content": "的损失。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：卖方"
 },
 {
  "content": "涨价不卖构成"
 },
 {
  "content": "违约，您有权"
 },
 {
  "content": "要求其双倍返还"
 },
 {
  "content": "定金（以房屋"
 },
 {
  "content": "总价的百分之二十"
 },
 {
  "content": "为上限）。\n"
 },
 {
  "content": "风险提示：1"
 },
 {
  "content": ". 需核实"
 },
 {
  "content": "认购书中明确载"
 },
 {
  "content": "明款项性质"
 },
 {
  "content": "为“定金”，"
 },
 {
  "content": "若写为“"
 },
 {
  "content": "订金”“"
 },
 {
  "content": "认购金”且"
 },
 {
  "content": "未约定定金"
 },
 {
  "content": "罚则，可能"
 },
 {
  "content": "无法适用双倍返还"
 },
 {
  "content": "规则；2."
 },
 {
  "content": " 需核实1"
 },
 {
  "content": "0万元是否超过房屋总价的百分之"
 },
 {
  "content": "二十，超出部分"
 },
 {
  "content": "仅能要求原"
 },
 {
  "content": "额返还；3"
 },
 {
