 {
  "content": "根据"
 },
 {
  "content": "您的描述，对您"
 },
 {
  "content": "的问题分析如下："
 },
 {
  "content": "\n\n①案情与"
 },
 {
  "content": "争议焦点\n您"
 },
 {
  "content": "与二手房卖方签订了"
 },
 {
  "content": "认购书并支付"
 },
 {
  "content": "10万元定金"
 },
