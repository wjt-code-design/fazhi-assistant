[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "前车的"
 },
 {
  "content": "损失由后车"
 },
 {
  "content": "（全责方"
 },
 {
  "content": "）及其保险公司承担"
 },
 {
  "content": "赔偿责任。具体"
 },
 {
  "content": "赔偿顺序如下："
 },
 {
  "content": "\n\n1. "
 },
 {
  "content": "先由承保后"
 },
 {
  "content": "车机动车强制保险"
 },
 {
  "content": "的保险人在责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "；\n2."
 },
 {
  "content": " 不足部分，"
 },
 {
  "content": "由承保后车"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "\n3. "
 },
 {
  "content": "仍然不足或者后"
 },
 {
  "content": "车没有投保机动车"
 },
 {
  "content": "商业保险的，"
 },
 {
  "content": "由后车（"
 },
 {
  "content": "侵权人）自行"
 },
 {
  "content": "赔偿。\n\n法律"
 },
 {
  "content": "依据：\n根据"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第七十六条第一款第一"
 },
 {
  "content": "项，机动车之间"
 },
 {
  "content": "发生交通事故的，"
 },
 {
  "content": "由有过错的一方"
 },
 {
  "content": "承担赔偿责任。本案"
 },
 {
  "content": "后车被认定"
 },
 {
  "content": "负全部"
 },
 {
  "content": "责任，故应"
 },
 {
  "content": "由其承担前车"
 },
 {
  "content": "损失的赔偿责任。\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千二百一十三条"
 },
 {
  "content": "，机动车发生交通事故"
 },
 {
  "content": "造成损害，属于"
 },
 {
  "content": "该机动车一方责任的"
 },
 {
  "content": "，先由承保"
 },
 {
  "content": "机动车强制保险的"
 },
 {
  "content": "保险人在强制保险"
 },
 {
  "content": "责任限额范围内予以"
 },
 {
  "content": "赔偿；不足部分"
 },
 {
  "content": "，由承保机动车"
 },
 {
  "content": "商业保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由侵权人"
 },
 {
  "content": "赔偿。"
 },
