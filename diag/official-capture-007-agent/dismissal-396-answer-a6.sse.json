 },
 {
  "content": "十九条第二项，"
 },
 {
  "content": "劳动者严重违反用人"
 },
 {
  "content": "单位的规章制度的，"
 },
 {
  "content": "用人单位可以解除劳动合同"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "劳动合同法》第四"
 },
 {
  "content": "十三条，用人单位单"
 },
 {
  "content": "方解除劳动合同，"
 },
 {
  "content": "应当事先将理由"
 },
 {
  "content": "通知工会。\n"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第四十六条，"
 },
 {
  "content": "用人单位应当支付经济"
 },
 {
  "content": "补偿的情形"
 },
 {
  "content": "中，不包含依据"
 },
 {
  "content": "第三十九条解除劳动合同"
 },
 {
  "content": "的情形。\n根据"
 },
 {
  "content": "《劳动合同法》第八十七条，用人单位"
 },
 {
  "content": "违反本法规定解除"
 },
 {
  "content": "或者终止劳动合同的"
 },
 {
  "content": "，应当支付赔偿"
 },
 {
  "content": "金。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，关于解除"
 },
 {
  "content": "的实体合法性。"
 },
 {
  "content": "员工多次旷工"
 },
 {
  "content": "属于严重违反规章制度"
 },
 {
  "content": "的情形，依据《"
 },
 {
  "content": "劳动合同法》第三"
 },
 {
  "content": "十九条第二项，"
 },
 {
  "content": "用人单位有权单方"
 },
 {
  "content": "解除劳动合同。题"
 },
 {
  "content": "干中规章制度经"
 },
 {
  "content": "民主程序制定且"
 },
 {
  "content": "已公示，解除"
 },
 {
  "content": "的实体依据充分"
 },
 {
  "content": "。\n第二，"
 },
 {
  "content": "关于解除的程序合法性"
 },
 {
  "content": "。依据《劳动合同"
 },
 {
  "content": "法》第四十三条"
 },
 {
  "content": "，用人单位单方"
 },
 {
  "content": "解除劳动合同需事先"
 },
 {
  "content": "通知工会。题"
 },
 {
  "content": "干中公司已通知"
 },
 {
  "content": "工会并留存证据"
 },
 {
  "content": "，符合法定程序"
 },
 {
  "content": "要求。\n第三"
 },
 {
  "content": "，关于经济补偿"
 },
 {
  "content": "与赔偿金。"
 },
 {
  "content": "依据《劳动合同法"
 },
 {
  "content": "》第四十六条关于"
 },
 {
  "content": "经济补偿的法定"
 },
 {
  "content": "情形，其中并不"
 },
 {
  "content": "包含用人单位依据第三"
 },
 {
  "content": "十九条解除合同的情形"
 },
 {
  "content": "，因此无需支付"
 },
 {
  "content": "经济补偿。同时"
 },
 {
  "content": "，因解除行为"
 },
 {
  "content": "实体与程序均"
 },
 {
  "content": "合法，不属于违法"
 },
 {
  "content": "解除，故也不"
 },
 {
  "content": "符合《劳动合同法"
 },
 {
  "content": "》第八十七条规定的"
 },
 {
  "content": "支付赔偿金的情形"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "：在所述"
 },
 {
  "content": "情形下，用人单位"
 },
 {
  "content": "无需支付经济补偿"
 },
 {
  "content": "或赔偿金。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "若公司无法充分"
 },
 {
  "content": "证明劳动者“多次"
 },
 {
  "content": "旷工”的事实"
 },
 {
  "content": "，或规章制度中"
 },
 {
  "content": "未明确界定“"
 },
 {
  "content": "多次旷工”"
 },
 {
  "content": "属于严重违反规章制度"
 },
 {
  "content": "，则可能被认定为"
 },
 {
  "content": "违法解除，面临"
 },
 {
  "content": "支付赔偿金的风险"
 },
 {
