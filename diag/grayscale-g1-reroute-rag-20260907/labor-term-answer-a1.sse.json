 {
  "content": "合法"
 },
 {
  "content": "。\n\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条第一款规定：“"
 },
 {
  "content": "三年以上固定期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "。”三年期劳动合同"
 },
 {
  "content": "属于“三年以上固定"
 },
 {
  "content": "期限劳动合同"
 },
 {
  "content": "”，约定"
 },
 {
  "content": "六个月试用期正好"
 },
 {
  "content": "在法定上限之内"
 },
 {
  "content": "，未超出"
 },
 {
  "content": "法律规定"
 },
 {
  "content": "。\n\n同时，"
 },
 {
  "content": "这是"
 },
 {
  "content": "第一次约定试用期，"
 },
 {
  "content": "符合《劳动合同法"
 },
 {
  "content": "》第十九条第二款“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”的规定"
 },
 {
  "content": "。\n\n因此，"
 },
 {
  "content": "该试用期"
 },
 {
  "content": "约定合法有效"
 },
 {
  "content": "。\n\n本答复"
 },
 {
  "content": "仅供参考，不构成"
 },
 {
  "content": "正式法律意见。"
 },
