 {
  "content": "严重违反用人单位的"
 },
 {
  "content": "规章制度的，用人单位"
 },
 {
  "content": "可以解除劳动合同。"
 },
 {
  "content": "\n《劳动合同法"
 },
 {
  "content": "》第四十三条："
 },
 {
  "content": "用人单位单方解除"
 },
 {
  "content": "劳动合同，应当事先"
 },
 {
  "content": "将理由通知工会"
 },
 {
  "content": "。\n《劳动合同"
 },
 {
  "content": "法》第四十六条"
 },
 {
  "content": "：列举了用人单位"
 },
 {
  "content": "应当向劳动者支付经济"
 },
 {
  "content": "补偿的情形。\n"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十七条：用人单位"
 },
 {
  "content": "违反本法规定解除"
 },
 {
  "content": "或者终止劳动合同的"
 },
 {
  "content": "，应当依照本法"
 },
 {
  "content": "第四十七条规定的经济"
 },
 {
  "content": "补偿标准的二倍"
 },
 {
  "content": "向劳动者支付赔偿"
 },
 {
  "content": "金。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "关于解除的"
 },
 {
  "content": "合法性：员工多次"
 },
 {
  "content": "旷工属于严重"
 },
 {
  "content": "违反规章制度的情形。"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第三十九条第"
 },
 {
  "content": "（二）项"
 },
 {
  "content": "，用人单位可以据此"
 },
 {
  "content": "单方解除劳动合同"
 },
 {
  "content": "，且该情形"
 },
 {
  "content": "不属于《劳动合同法"
 },
 {
  "content": "》第四十六条规定的"
 },
 {
  "content": "应当支付经济补偿"
 },
 {
  "content": "的"
 },
 {
  "content": "法定情形"
 },
 {
  "content": "。\n关于程序的"
 },
 {
  "content": "合法性：公司规章制度"
 },
 {
  "content": "经民主程序制定"
 },
 {
  "content": "并已公示，且"
 },
 {
  "content": "解除前已通知"
 },
 {
  "content": "工会并留存证据"
 },
 {
  "content": "，符合《劳动合同"
 },
 {
  "content": "法》第四十三条"
 },
 {
  "content": "的程序性要求，"
 },
 {
  "content": "解除程序合法。"
 },
 {
  "content": "\n关于赔偿金的"
 },
 {
  "content": "适用："
 },
 {
  "content": "赔偿金规定于"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十七条，适用于"
 },
 {
  "content": "违法解除劳动合同的情形"
 },
 {
  "content": "。本案中"
 },
 {
  "content": "，用人单位的解除"
 },
 {
  "content": "理由和"
 },
 {
  "content": "程序均符合法律规定"
 },
 {
  "content": "，属于合法解除"
 },
 {
  "content": "，故不适用违法"
 },
 {
  "content": "解除的赔偿金"
 },
 {
  "content": "规定。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：用人单位依据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第三十九条第（"
 },
 {
  "content": "二）项解除"
 },
 {
  "content": "劳动合同，无需支付"
 },
 {
  "content": "经济补偿，也"
 },
 {
  "content": "无需支付赔偿金"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：虽然本案"
 },
 {
  "content": "表面符合合法"
 },
 {
  "content": "解除的条件，但在"
 },
 {
  "content": "司法实践中，仍"
 },
 {
  "content": "存在因规章制度"
 },
 {
  "content": "中关于"
 },
 {
  "content": "“严重违反”"
 },
 {
  "content": "的具体界定不清"
 },
 {
  "content": "，或者旷"
 },
 {
  "content": "工事实的证据"
 },
 {
  "content": "不足，导致被"
 },
 {
  "content": "认定为违法解除的风险"
 },
 {
  "content": "。一旦被认定为"
 },
 {
  "content": "违法解除，根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第八十七条，用人单位"
 },
 {
  "content": "需支付赔偿金"
 },
 {
  "content": "。此外，未"
 },
 {
  "content": "依法通知工会的"
 },
 {
  "content": "程序瑕疵也可能导致"
 },
 {
  "content": "解除违法，本案"
 },
 {
  "content": "中已通知工会"
 },
 {
  "content": "并留存证据，"
 },
 {
  "content": "可规避该程序"
 },
 {
  "content": "风险。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
