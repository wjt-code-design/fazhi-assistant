 },
 {
  "content": "规章制度经民主程序"
 },
 {
  "content": "制定并已公示，"
 },
 {
  "content": "解除前已通知"
 },
 {
  "content": "工会并留存证据"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "：用人单位以此"
 },
 {
  "content": "为由解除劳动合同，"
 },
