 {
  "content": "①"
 },
 {
  "content": "案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案涉及某有限责任公司"
 },
 {
  "content": "注册资本认缴1"
 },
 {
  "content": "00万元尚未"
 },
 {
  "content": "实缴，对外"
 },
 {
  "content": "负债500"
 },
 {
  "content": "万元且"
 },
 {
  "content": "无力偿还。争议"
 },
 {
  "content": "焦点在于：股东"
 },
 {
  "content": "是否需对超出"
 },
 {
  "content": "认缴额的4"
 },
 {
  "content": "00万元债务"
 },
 {
  "content": "承担"
 },
 {
  "content": "个人责任。\n\n"
 },
 {
  "content": "②法律"
 },
 {
  "content": "依据\n《公司法"
 },
 {
  "content": "》第四条、第五"
 },
 {
  "content": "十四条、第二十三条。"
 },
 {
  "content": "\n\n③逐"
 },
 {
  "content": "项论证\n第一"
 },
 {
  "content": "，股东原则上承担"
 },
 {
  "content": "有限责任。根据《"
 },
 {
  "content": "公司法》第四条，"
 },
 {
  "content": "有限责任公司的股东以其"
 },
 {
  "content": "认缴的出资"
 },
 {
  "content": "额为限对公司承担责任"
 },
 {
  "content": "。因此"
 },
 {
  "content": "，在未发生法定"
 },
 {
  "content": "例外情形时"
 },
 {
  "content": "，股东的责任上限"
 },
 {
  "content": "即"
 },
 {
  "content": "为其认缴的"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，对超出认"
 },
 {
  "content": "缴额的40"
 },
 {
  "content": "0万元债务无需"
 },
 {
  "content": "以个人财产承担责任"
 },
 {
  "content": "。\n\n第二，"
 },
 {
  "content": "出资义务加速到期"
 },
 {
  "content": "。根据《公司法"
 },
 {
  "content": "》第五十四条，"
 },
 {
  "content": "公司不能清偿到期"
 },
 {
  "content": "债务的，已"
 },
 {
  "content": "到期债权的债权人"
 },
 {
  "content": "有权要求已认"
 },
 {
  "content": "缴出资但未届"
 },
 {
  "content": "出资期限的股东"
 },
 {
  "content": "提前缴纳出资。"
 },
 {
  "content": "本案中，债权人"
 },
 {
  "content": "可要求股东提前"
 },
 {
  "content": "缴纳100"
 },
 {
  "content": "万元用于清偿债务"
 },
 {
  "content": "，但这仍属于"
 },
 {
  "content": "股东履行"
 },
 {
  "content": "其"
 },
 {
  "content": "认缴出资义务"
 },
 {
  "content": "的"
 },
 {
  "content": "范畴，并非对"
 },
 {
  "content": "超出认缴额"
 },
 {
  "content": "债务的额外承担"
 },
 {
  "content": "。\n\n第三，"
 },
 {
  "content": "例外情形下的连带"
 },
 {
  "content": "责任。根据《"
 },
 {
  "content": "公司法》第二十三条，"
 },
 {
  "content": "若股东滥用公司"
 },
 {
  "content": "法人独立地位和"
 },
 {
  "content": "股东有限责任，逃避"
 },
 {
  "content": "债务，严重损害"
 },
 {
  "content": "公司债权人利益的，"
 },
 {
  "content": "应当对公司债务承担"
 },
 {
  "content": "连带责任。此外"
 },
 {
  "content": "，若该公司"
 },
 {
  "content": "为一人有限责任公司，"
 },
 {
  "content": "股东不能证明公司"
 },
 {
  "content": "财产独立于股东"
 },
 {
  "content": "自己财产的，"
 },
 {
  "content": "也需对公司债务"
 },
 {
  "content": "承担连带责任。"
 },
 {
  "content": "在此例外"
 },
 {
  "content": "情形下，股东"
 },
 {
  "content": "可能需对全部"
 },
 {
  "content": "500万元"
 },
 {
  "content": "债务（含超出"
 },
 {
  "content": "认缴额部分"
 },
 {
  "content": "）承担连带责任"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n原则上"
 },
 {
  "content": "，股东无需对"
 },
 {
  "content": "超出认缴额的"
 },
 {
  "content": "债务负责，仅在"
 },
 {
  "content": "存在滥用"
 },
 {
  "content": "法人独立地位逃避"
 },
 {
  "content": "债务等法定例外"
 },
 {
  "content": "情形时，才"
 },
 {
  "content": "可能突破有限责任。"
 },
 {
  "content": "同时，债权人"
 },
 {
  "content": "有权要求股东将"
 },
 {
  "content": "未实缴的"
 },
 {
  "content": "100万元"
 },
 {
  "content": "出资加速到期用于"
 },
 {
  "content": "偿债。具体责任"
 },
 {
  "content": "需结合是否存在滥用"
 },
 {
  "content": "行为等案情确定"
 },
 {
  "content": "。本答复仅供参考"
 },
 {
  "content": "。"
