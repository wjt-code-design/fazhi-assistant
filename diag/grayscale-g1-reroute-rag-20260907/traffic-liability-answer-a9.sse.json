 {
  "content": "「"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点」\n本案"
 },
 {
  "content": "为两辆"
 },
 {
  "content": "机动车追"
 },
 {
  "content": "尾事故，交警"
 },
 {
  "content": "已"
 },
 {
  "content": "认定后车负"
 },
 {
  "content": "全部责任。争议"
 },
 {
  "content": "焦点在于前车"
 },
 {
  "content": "损失的赔偿主体及"
 },
 {
  "content": "赔偿顺位如何"
 },
 {
  "content": "确定。\n\n「"
 },
 {
  "content": "②法律依据」"
 },
 {
  "content": "\n根据《道路交通安全"
 },
 {
  "content": "法》第七十六条"
 },
 {
  "content": "第一款第（一"
 },
 {
  "content": "）项，机动车"
 },
 {
  "content": "之间发生交通事故的"
 },
 {
  "content": "，由有过错"
 },
 {
  "content": "的一方承担赔偿责任。"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十三条，机动车发生"
 },
 {
  "content": "交通事故造成损害，"
 },
 {
  "content": "属于该机动车一方"
 },
 {
  "content": "责任的，先由"
 },
 {
  "content": "承保机动车强制保险"
 },
 {
  "content": "的保险人在强制"
 },
 {
  "content": "保险责任限额范围内"
 },
 {
  "content": "予以赔偿；不足"
 },
 {
  "content": "部分，由承保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "保险人按照保险合同的"
 },
 {
  "content": "约定予以赔偿；"
 },
 {
  "content": "仍然不足或者没有"
 },
 {
  "content": "投保机动车商业保险"
 },
 {
  "content": "的，由侵权"
 },
 {
  "content": "人赔偿。\n\n"
 },
 {
  "content": "「③逐项"
 },
 {
  "content": "论证」\n1"
 },
 {
  "content": ". 责任主体"
 },
 {
  "content": "认定：后车"
 },
 {
  "content": "被交警认定为"
 },
 {
  "content": "全责，即"
 },
 {
  "content": "后车一方对"
 },
 {
  "content": "事故"
 },
 {
  "content": "的发生存在过错，"
 },
 {
  "content": "是本次事故的"
 },
 {
  "content": "侵权人，应当对"
 },
 {
  "content": "前车的损失承担"
 },
 {
  "content": "赔偿责任。\n2"
 },
 {
  "content": ". 赔偿顺"
 },
 {
  "content": "位确定"
 },
 {
  "content": "：前车的"
 },
 {
  "content": "损失需按照法定"
 },
 {
  "content": "顺"
 },
 {
  "content": "位获得"
 },
 {
  "content": "赔偿。首先，"
 },
 {
  "content": "由后车承保"
 },
 {
  "content": "机动车"
 },
 {
  "content": "强制保险（"
 },
 {
  "content": "交强险）"
 },
 {
  "content": "的保险公司在交"
 },
 {
  "content": "强险"
 },
 {
  "content": "责任限额范围内予以"
 },
 {
  "content": "赔偿；其次，"
 },
 {
  "content": "交强险赔偿"
 },
 {
  "content": "不足的部分，由"
 },
 {
  "content": "后车承保机动车"
 },
 {
  "content": "商业保险（主要是"
 },
 {
  "content": "商业三者险）"
 },
 {
  "content": "的保险人按照保险"
 },
 {
  "content": "合同的约定予以赔偿"
 },
 {
  "content": "；最后，如果"
 },
 {
  "content": "商业保险赔偿后"
 },
 {
  "content": "仍有"
 },
 {
  "content": "不足，或者后"
 },
 {
  "content": "车根本没有"
 },
 {
  "content": "投保机动车"
 },
 {
  "content": "商业保险，"
 },
 {
  "content": "则由后车（"
 },
 {
  "content": "侵权人）自行"
 },
 {
  "content": "承担剩余部分的赔偿责任"
 },
 {
  "content": "。\n\n「④"
 },
 {
  "content": "结论与风险」"
 },
 {
  "content": "\n结论：前"
 },
 {
  "content": "车的损失由后"
 },
 {
  "content": "车的交"
 },
 {
  "content": "强险保险公司、"
 },
 {
  "content": "商业险保险公司及"
 },
 {
  "content": "后车侵权人"
 },
 {
  "content": "按法定"
 },
 {
  "content": "顺位进行"
 },
 {
  "content": "赔偿。\n风险"
 },
 {
  "content": "提示：若后"
 },
 {
  "content": "车未投保交"
 },
 {
  "content": "强险或"
 },
 {
  "content": "商业险，或者"
 },
 {
  "content": "保额不足以"
 },
 {
  "content": "覆盖前车全部"
 },
 {
  "content": "损失，前车的"
 },
 {
  "content": "损失将"
 },
 {
  "content": "需直接"
 },
 {
  "content": "向后"
 },
 {
  "content": "车车主或驾驶员"
 },
 {
  "content": "个人"
 },
 {
  "content": "追偿。此时"
 },
 {
  "content": "可能面临侵权"
 },
 {
  "content": "人无力"
 },
 {
  "content": "赔偿"
 },
 {
  "content": "或"
 },
 {
  "content": "逃避"
 },
 {
  "content": "债务"
 },
 {
  "content": "的执行"
 },
 {
  "content": "风险，需"
 },
 {
  "content": "结合具体"
 },
 {
  "content": "案情考虑"
 },
 {
  "content": "采取"
 },
 {
  "content": "财产保全等措施"
 },
 {
  "content": "。"
 },
