 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n用户与装修公司"
 },
 {
  "content": "之间"
 },
 {
  "content": "存在装修合同关系"
 },
 {
  "content": "，装修公司拖延工期"
 },
 {
  "content": "两个月，并以材料"
 },
 {
  "content": "涨价为由要求加价"
 },
 {
  "content": "，否则拒绝继续"
 },
 {
  "content": "施工。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "装修公司能否以材料"
 },
 {
  "content": "涨价为由单方"
 },
 {
  "content": "要求加价并停工"
 },
 {
  "content": "，以及"
 },
 {
  "content": "业主应如何维权"
 },
 {
  "content": "。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第八百"
 },
 {
  "content": "零一条，因"
 },
 {
  "content": "施工人的原因致使"
 },
 {
  "content": "建设工程质量不符合约定的"
 },
 {
  "content": "，发包人有权"
 },
 {
  "content": "请求施工人在合理"
 },
 {
  "content": "期限内无偿修理或者"
 },
 {
  "content": "返工、改建"
 },
 {
  "content": "。经过修理或者"
 },
 {
  "content": "返工、改建"
 },
 {
  "content": "后，造成逾期"
 },
 {
  "content": "交付的，施工"
 },
 {
  "content": "人应当承担违约"
 },
 {
  "content": "责任。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，关于加价"
 },
 {
  "content": "问题。材料涨价"
 },
 {
  "content": "通常属于正常的商业"
 },
 {
  "content": "风险，装修公司作为"
 },
 {
  "content": "专业市场主体"
 },
 {
  "content": "，在签订合"
 },
 {
  "content": "同时应当"
 },
 {
  "content": "已预见到市场"
 },
 {
  "content": "波"
 },
 {
  "content": "动的可能性"
 },
 {
  "content": "，无权"
 },
 {
  "content": "单方要求加价"
 },
 {
  "content": "。除非材料价格"
 },
 {
  "content": "出现异常巨大"
 },
 {
  "content": "涨幅，超出订立"
 },
 {
  "content": "合同时可预"
 },
 {
  "content": "见的范围，可能"
 },
 {
  "content": "构成情势变更，"
 },
 {
  "content": "但需由"
 },
 {
  "content": "法院或仲裁机构"
 },
 {
  "content": "认定，装修公司无权"
 },
 {
  "content": "自行以此"
 },
 {
  "content": "为由"
 },
 {
  "content": "变更"
 },
 {
  "content": "合同价款"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "关于停工与拖延"
 },
 {
  "content": "工期。装修公司以"
 },
 {
  "content": "不加价就停工"
 },
 {
  "content": "相"
 },
 {
  "content": "要"
 },
 {
  "content": "挟，属于"
 },
 {
  "content": "明确"
 },
 {
  "content": "表示不履行合同"
 },
 {
  "content": "主要义务，构成"
 },
 {
  "content": "违约。根据《"
 },
 {
  "content": "民法典》第八百零"
 },
 {
  "content": "一条，因施工"
 },
 {
  "content": "人原因造成逾期"
 },
 {
  "content": "交付的，施工"
 },
 {
  "content": "人应当承担违约"
 },
 {
  "content": "责任。材料涨价"
 },
 {
  "content": "不属于不可抗力，"
 },
 {
  "content": "不能作为拖延"
 },
 {
  "content": "工期的免责事"
 },
 {
  "content": "由。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：装修公司无权"
 },
 {
  "content": "单方加价，"
 },
 {
  "content": "其停工行为"
 },
 {
  "content": "构成违约，业主"
 },
 {
  "content": "有权要求其继续"
 },
 {
  "content": "履行合同并承担"
 },
 {
  "content": "逾期交付的违约"
 },
 {
  "content": "责任。若合同"
 },
 {
  "content": "约定了业主的单"
 },
 {
  "content": "方解除权，"
 },
 {
  "content": "业主也可主张解除"
 },
 {
  "content": "合同并要求赔偿损失"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：如果双方无法"
 },
 {
  "content": "协商，业主需"
 },
 {
  "content": "通过诉讼或仲裁"
 },
 {
  "content": "解决，维权周期"
 },
 {
  "content": "可能较长。此外"
 },
 {
  "content": "，若材料价格"
 },
 {
  "content": "确实发生极端"
 },
 {
  "content": "异常波动，是否"
 },
 {
  "content": "构成情势变更存在"
 },
 {
  "content": "法律不确定性，需"
 },
 {
  "content": "结合具体涨幅、"
 },
 {
  "content": "合同约定等因素综合认定"
 },
 {
  "content": "。"
