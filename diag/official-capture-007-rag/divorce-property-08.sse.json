 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n婚后父母转账"
 },
 {
  "content": "30万用于"
 },
 {
  "content": "购买房产，离婚"
 },
 {
  "content": "时配偶要求分割"
 },
 {
  "content": "一半。本案争议"
 },
 {
  "content": "焦点在于：婚后"
 },
 {
  "content": "父母为子女出资"
 },
 {
  "content": "购房的款项及"
 },
 {
  "content": "对应房产性质，"
 },
 {
  "content": "属于夫妻共同财产"
 },
 {
  "content": "还是一方个人财产"
 },
 {
  "content": "。\n\n二、"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "零六十三条第"
 },
 {
  "content": "（三）项"
 },
 {
  "content": "，遗嘱或者赠与"
 },
 {
  "content": "合同中确定只归"
 },
 {
  "content": "一方的财产为夫妻"
 },
 {
  "content": "一方的个人财产。"
 },
 {
  "content": "\n\n三、逐"
 },
 {
  "content": "项论证\n1"
 },
 {
  "content": ". 若父母"
 },
 {
  "content": "出资时明确表示"
 },
 {
  "content": "该30万"
 },
 {
  "content": "仅赠与子女个人"
 },
 {
  "content": "：例如通过签订"
 },
 {
  "content": "赠与合同、办理"
 },
 {
  "content": "公证或在转账时"
 },
 {
  "content": "明确备注“仅"
 },
 {
  "content": "赠与子女个人”"
 },
 {
  "content": "等，能够证明"
 },
 {
  "content": "属于“赠与"
 },
 {
  "content": "合同中确定只归"
 },
 {
  "content": "一方的财产”，则"
 },
 {
  "content": "该30万"
 },
 {
  "content": "及所购房产"
 },
 {
  "content": "中对应的"
 },
 {
  "content": "份额属于子女的个人"
 },
 {
  "content": "财产，离婚时"
 },
 {
  "content": "配偶无权要求分割"
 },
 {
  "content": "。\n2."
 },
 {
  "content": " 若父母出资"
 },
 {
  "content": "时未明确表示"
 },
 {
  "content": "只归一方："
 },
 {
  "content": "由于该出资行为"
 },
 {
  "content": "发生在婚姻关系"
 },
 {
  "content": "存续期间，若"
 },
 {
  "content": "无法提供证据证明"
 },
 {
  "content": "父母当时"
 },
 {
  "content": "明确表示只赠与"
 },
 {
  "content": "子女一方，该"
 },
 {
  "content": "30万出资"
 },
 {
  "content": "及对应的房产份额"
 },
 {
  "content": "存在被认定为夫妻"
 },
 {
  "content": "共同财产的风险。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千零八十七条"
 },
 {
  "content": "，离婚时夫妻"
 },
 {
  "content": "的共同财产由双方"
 },
 {
  "content": "协议处理，协议"
 },
 {
  "content": "不成的由法院"
 },
 {
  "content": "根据"
 },
 {
  "content": "财产具体情况"
 },
 {
  "content": "判决，配偶此时"
 },
 {
  "content": "有权要求分割。"
 },
 {
  "content": "\n\n四、结论"
 },
 {
  "content": "与风险\n结论"
 },
 {
  "content": "取决于是否有证据"
 },
 {
  "content": "证明父母有“"
 },
 {
  "content": "只归一方”"
 },
 {
  "content": "的赠与意思表示"
 },
 {
  "content": "。主要风险在于"
 },
 {
  "content": "举证，"
 },
 {
  "content": "若仅有转账流水"
 },
 {
  "content": "而无明确赠与一方的"
 },
 {
  "content": "意思表示，该"
 },
 {
  "content": "出资极易被推"
 },
 {
  "content": "定为对夫妻双方的"
 },
 {
  "content": "赠与，从而面临"
 },
 {
