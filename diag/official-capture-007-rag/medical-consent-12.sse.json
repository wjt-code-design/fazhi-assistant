[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，患者术前未被"
 },
 {
  "content": "告知手术风险，"
 },
 {
  "content": "术后出现后遗症，"
 },
 {
  "content": "医院以患者已"
 },
 {
  "content": "签字为由拒绝赔偿"
 },
 {
  "content": "。争议焦点在于"
 },
 {
  "content": "：患者签字能否"
 },
 {
  "content": "免除医院未尽风险"
 },
 {
  "content": "告知义务的责任？"
 },
 {
  "content": "医院是否应对"
 },
 {
  "content": "后遗症承担赔偿责任？"
 },
 {
  "content": "\n\n②法律依据"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千二百一"
 },
 {
  "content": "十九条，需要实施"
 },
 {
  "content": "手术的，医务人员应当及时"
 },
 {
  "content": "向患者具体说明"
 },
 {
  "content": "医疗风险、替代"
 },
 {
  "content": "医疗方案等情况，"
 },
 {
  "content": "并取得其明确同意"
 },
 {
  "content": "；未尽到前款"
 },
 {
  "content": "义务，造成患者"
 },
 {
  "content": "损害的，医疗机构"
 },
 {
  "content": "应当承担赔偿责任。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千二百二十四条"
 },
 {
  "content": "，医疗机构不承担赔偿责任"
 },
 {
  "content": "的情形限于患者不"
 },
 {
  "content": "配合、紧急情况"
 },
 {
  "content": "已尽合理义务"
 },
 {
  "content": "及限于当时医疗"
 },
 {
  "content": "水平难以诊疗三种"
 },
 {
  "content": "，不包括“患者"
 },
 {
  "content": "已签字”。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n第一，签字"
 },
 {
  "content": "不等于有效同意。"
 },
 {
  "content": "法律规定的知情同意"
 },
 {
  "content": "不仅需要形式"
 },
 {
  "content": "上的签字，更"
 },
 {
  "content": "要求医务人员"
 },
 {
  "content": "“具体说明医疗"
 },
 {
  "content": "风险”。若术前"
 },
 {
  "content": "未作实质性风险"
 },
 {
  "content": "告知，患者在不知情"
 },
 {
  "content": "下签字"
 },
 {
  "content": "，不符合“明确"
 },
 {
  "content": "同意”的实质"
 },
 {
  "content": "要件，该签字"
 },
 {
  "content": "不能阻却医院"
 },
 {
  "content": "未尽告知义务的"
 },
 {
  "content": "违法性。\n"
 },
 {
  "content": "第二，医院“"
 },
 {
  "content": "签字免责”的抗"
 },
 {
  "content": "辩不成立。"
 },
 {
  "content": "法定免责事"
 },
 {
  "content": "由并未包含患者"
 },
 {
  "content": "已签字的情形。"
 },
 {
  "content": "医务人员"
 },
 {
  "content": "未尽到说明义务"
 },
 {
  "content": "，造成患者损害"
 },
 {
  "content": "的，医疗机构应当"
 },
 {
  "content": "承担赔偿责任。\n"
 },
 {
  "content": "第三，因果"
 },
 {
  "content": "关系是关键。医院"
 },
 {
  "content": "承担赔偿责任的前提是"
 },
 {
  "content": "“未尽到说明"
 },
 {
  "content": "义务”与“"
 },
 {
  "content": "患者损害”之间"
 },
 {
  "content": "存在因果关系。"
 },
 {
  "content": "需进一步审查后"
 },
 {
  "content": "遗症的产生是否"
 },
 {
  "content": "与医疗行为（"
 },
 {
  "content": "包括因未告知"
 },
 {
  "content": "风险导致患者丧失"
 },
 {
  "content": "选择替代方案的机会"
 },
 {
  "content": "等）有关。"
 },
 {
  "content": "\n\n④结论与"
 },
 {
  "content": "风险\n结论："
 },
 {
  "content": "医院以“签字"
 },
 {
  "content": "了就没责任”"
 },
 {
  "content": "为由拒绝赔偿缺乏"
 },
 {
  "content": "法律依据，若"
 },
 {
  "content": "其术前"
 },
 {
  "content": "确实未履行"
 },
 {
  "content": "风险告知义务且"
 },
 {
  "content": "该行为与损害"
 },
 {
  "content": "后果存在因果关系"
 },
 {
  "content": "，医院需承担"
 },
 {
  "content": "赔偿责任。风险："
 },
 {
  "content": "实践中需结合病历"
 },
 {
  "content": "资料等证据审查"
 },
 {
  "content": "医院是否存在伪造、"
 },
 {
  "content": "篡改病历的情形，"
 },
 {
  "content": "以及后遗症与医疗"
 },
 {
  "content": "过错之间的因果关系"
 },
 {
  "content": "比例，最终确定"
 },
 {
  "content": "赔偿范围。"
 },
