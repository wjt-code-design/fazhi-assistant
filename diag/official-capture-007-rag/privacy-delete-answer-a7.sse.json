[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n用户在某App"
 },
 {
  "content": "注销账号后，"
 },
 {
  "content": "平台仍保留其"
 },
 {
  "content": "手机号和消费记录"
 },
 {
  "content": "用于营销推送。"
 },
 {
  "content": "本案的争议焦点"
 },
 {
  "content": "在于：用户注销"
 },
 {
  "content": "账号后，平台"
 },
 {
  "content": "是否有权继续保留"
 },
 {
  "content": "其个人信息；平台"
 },
 {
  "content": "在用户"
 },
 {
  "content": "注销后继续推送"
 },
 {
  "content": "营销信息是否合法"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "电子商务法》第二十四条"
 },
 {
  "content": "，电子商务经营者收到"
 },
 {
  "content": "用户注销申请的"
 },
 {
  "content": "，应当立即删除"
 },
 {
  "content": "该用户的信息；"
 },
 {
  "content": "依照法律、行政法规"
 },
 {
  "content": "的规定或者双方约定"
 },
 {
  "content": "保存的，依照"
 },
 {
  "content": "其规定。\n根据《消费者权益保护法"
 },
 {
  "content": "》第二十九条，经营者"
 },
 {
  "content": "及其工作人员对收集的"
 },
 {
  "content": "消费者个人信息必须严格"
 },
 {
  "content": "保密，不得泄露"
 },
 {
  "content": "、出售或者非法"
 },
 {
  "content": "向他人提供。"
 },
 {
  "content": "经营者未经消费者同意"
 },
 {
  "content": "或者请求，或者"
 },
 {
  "content": "消费者明确表示拒绝"
 },
 {
  "content": "的，不得向其"
 },
 {
  "content": "发送商业性信息"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "网络安全法》第四"
 },
 {
  "content": "十五条，个人发现"
 },
 {
  "content": "网络运营者违反"
 },
 {
  "content": "法律、行政法规的规定"
 },
 {
  "content": "或者双方的约定收集"
 },
 {
  "content": "、使用其个人"
 },
 {
  "content": "信息的，有权要求"
 },
 {
  "content": "网络运营者删除"
 },
 {
  "content": "其个人信息。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，关于"
 },
 {
  "content": "注销后保留信息"
 },
 {
  "content": "的行为。根据《"
 },
 {
  "content": "电子商务法》第二十四条"
 },
 {
  "content": "，用户注销账号"
 },
 {
  "content": "后，平台原则上"
 },
 {
  "content": "应当立即删除其"
 },
 {
  "content": "个人信息。除非法律"
 },
 {
  "content": "、行政法规另有规定"
 },
 {
  "content": "（如交易"
 },
 {
  "content": "信息保存义务）"
 },
 {
  "content": "或双方另有约定"
 },
 {
  "content": "，否则平台保留"
 },
 {
  "content": "手机号和消费记录"
 },
 {
  "content": "缺乏合法性基础"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "关于注销后营销"
 },
 {
  "content": "推送的行为。用户"
 },
 {
  "content": "注销账号的行为，"
 },
 {
  "content": "可视为对"
 },
 {
  "content": "个人信息处理的"
 },
 {
  "content": "撤回同意或明确"
 },
 {
  "content": "拒绝。根据《"
 },
 {
  "content": "消费者权益保护法》第二十九条"
 },
 {
  "content": "，经营者未经消费者"
 },
 {
  "content": "同意或者请求，"
 },
 {
  "content": "或者消费者明确表示"
 },
 {
  "content": "拒绝的，不得"
 },
 {
  "content": "向其发送商业性"
 },
 {
  "content": "信息。平台继续"
 },
 {
  "content": "利用保留的信息"
 },
 {
  "content": "进行营销推送，"
 },
 {
  "content": "违反了该禁止"
 },
 {
  "content": "性规定。\n"
 },
 {
  "content": "最后，关于用户的"
 },
 {
  "content": "救济权利。根据"
 },
 {
  "content": "《网络安全法》"
 },
 {
  "content": "第四十五条，用户"
 },
 {
  "content": "有权要求平台删除"
 },
 {
  "content": "其个人信息，平台"
 },
 {
  "content": "应当采取措施予以删除"
 },
 {
  "content": "。\n\n④结论"
 },
 {
  "content": "与风险\n平台"
 },
 {
  "content": "在用户注销账号"
 },
 {
  "content": "后仍保留其"
 },
 {
  "content": "手机号和消费记录"
 },
 {
  "content": "用于营销推送，"
 },
 {
  "content": "涉嫌违反《电子商务"
 },
 {
  "content": "法》第二十四条的"
 },
 {
  "content": "删除义务以及《"
 },
 {
  "content": "消费者权益保护法》第二十九条"
 },
 {
  "content": "关于禁止未经"
 },
 {
  "content": "同意发送商业性"
 },
 {
  "content": "信息的规定。用户"
 },
 {
  "content": "有权要求平台删除"
 },
 {
  "content": "信息并停止推送"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：平台可能以"
 },
 {
  "content": "“依照法律、"
 },
 {
  "content": "行政法规的规定或者双方"
 },
 {
  "content": "约定保存”为由"
 },
 {
  "content": "进行抗辩，"
 },
 {
  "content": "例如主张消费记录"
 },
 {
  "content": "属于法律要求"
 },
 {
  "content": "保存的交易信息，"
 },
 {
  "content": "或者用户协议中"
 },
 {
  "content": "约定了注销"
 },
 {
  "content": "后仍保留部分"
 },
 {
  "content": "信息。用户需"
 },
 {
  "content": "核实平台隐私"
 },
 {
  "content": "政策或用户协议"
 },
 {
  "content": "中的相关条款。若"
 },
 {
  "content": "协商无果"
 },
 {
  "content": "，可向市场监督管理部门"
 },
 {
  "content": "或网信"
 },
 {
  "content": "部门投诉，亦可"
 },
 {
  "content": "依法提起诉讼。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
