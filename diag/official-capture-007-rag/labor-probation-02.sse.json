 {
  "content": "① 案情与"
 },
 {
  "content": "争议焦点\n劳动合同"
 },
 {
  "content": "期限为三年，公司"
 },
 {
  "content": "最初约定6个月"
 },
 {
  "content": "试用期，后又延长"
 },
 {
  "content": "2个月。本案"
 },
 {
  "content": "争议焦点在于："
 },
 {
  "content": "公司延长试用期的"
 },
 {
  "content": "行为是否合法。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "，三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月；同一用人单位"
 },
 {
  "content": "与同一劳动者只能"
 },
 {
  "content": "约定一次试用期。"
 },
 {
  "content": "\n根据《劳动合同"
 },
 {
  "content": "法》第八十三条"
 },
 {
  "content": "，用人单位违反本法"
 },
 {
  "content": "规定与劳动者约定"
 },
 {
  "content": "试用期的，由"
 },
 {
  "content": "劳动行政部门责令改正；"
 },
 {
  "content": "违法约定的试用期已经"
 },
 {
  "content": "履行的，由"
 },
 {
  "content": "用人单位以劳动者试用期"
 },
 {
  "content": "满月工资为标准，"
 },
 {
  "content": "按已经履行的"
 },
 {
  "content": "超过法定试用期的"
 },
 {
  "content": "期间向劳动者支付"
 },
 {
  "content": "赔偿金。\n\n"
 },
 {
  "content": "③ 逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "三年期劳动合同的"
 },
 {
  "content": "法定最长试用期为"
 },
 {
  "content": "6个月。公司"
 },
 {
  "content": "最初约定6个月"
 },
 {
  "content": "试用期本身符合法律规定，但随后延长"
 },
 {
  "content": "2个月至8"
 },
 {
  "content": "个月，明显超过了"
 },
 {
  "content": "法定"
 },
 {
  "content": "上限。\n其次"
 },
 {
  "content": "，法律明确规定“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”。公司延长"
 },
 {
  "content": "试用期的行为，"
 },
 {
  "content": "实质上是试图通过"
 },
 {
  "content": "变更合同的方式"
 },
 {
  "content": "变相再次"
 },
 {
  "content": "约定或延长试用期"
 },
 {
  "content": "，违反了法律的禁止"
 },
 {
  "content": "性规定。\n"
 },
 {
  "content": "最后，根据《"
 },
 {
  "content": "劳动合同法》第二十九条"
 },
 {
  "content": "，用人单位与劳动者"
 },
 {
  "content": "应当按照劳动合同的约定"
 },
 {
  "content": "全面履行义务，"
 },
 {
  "content": "变更合同需协商"
 },
 {
  "content": "一致且不得违反"
 },
 {
  "content": "法律强制性规定。"
 },
 {
  "content": "本案中延长试用"
 },
 {
  "content": "期的变更因违反"
 },
 {
  "content": "法律强制性规定而"
 },
 {
  "content": "无效。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：公司"
 },
 {
  "content": "延长试用期的行为"
 },
 {
  "content": "不合法。\n"
 },
 {
  "content": "风险与维权"
 },
 {
  "content": "：对于已经履"
 },
 {
  "content": "行的超过法定试用"
 },
 {
  "content": "期的2个月，"
 },
 {
  "content": "劳动者有权要求公司"
 },
 {
  "content": "支付赔偿金。"
 },
 {
  "content": "赔偿金标准以"
 },
 {
  "content": "试用期满月工资为"
 },
 {
  "content": "基数，按超"
 },
 {
  "content": "期履行的2"
 },
 {
  "content": "个月期间计算。"
 },
 {
  "content": "劳动者可向劳动行政部门"
 },
 {
  "content": "投诉，或依法"
 },
 {
  "content": "申请劳动仲裁以"
 },
 {
