[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案为两"
 },
 {
  "content": "机动车追尾事故"
 },
 {
  "content": "，交警部门"
 },
 {
  "content": "已认定后车"
 },
 {
  "content": "负全部责任。"
 },
 {
  "content": "核心争议焦点在于"
 },
 {
  "content": "：前车的"
 },
 {
  "content": "车辆"
 },
 {
  "content": "损失应由谁承担"
 },
 {
  "content": "，以及具体的赔偿"
 },
 {
  "content": "顺序与责任主体"
 },
 {
  "content": "如何界定。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《道路交通安全法"
 },
 {
  "content": "》第七十六条第一款"
 },
 {
  "content": "第一项规定：“"
 },
 {
  "content": "机动车之间发生交通事故"
 },
 {
  "content": "的，由有过"
 },
 {
  "content": "错的一方承担赔偿责任"
 },
 {
  "content": "；双方都有过错"
 },
 {
  "content": "的，按照各自"
 },
 {
  "content": "过错的比例分担责任"
 },
 {
  "content": "。”\n根据《"
 },
 {
  "content": "民法典》第一千二百"
 },
 {
  "content": "一十三条规定：“"
 },
 {
  "content": "机动车发生交通事故造成"
 },
 {
  "content": "损害，属于该"
 },
 {
  "content": "机动车一方责任的，"
 },
 {
  "content": "先由承保机动车"
 },
 {
  "content": "强制保险的保险"
 },
 {
  "content": "人在强制保险责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "；不足部分，"
 },
 {
  "content": "由承保机动车商业"
 },
 {
  "content": "保险的保险人按照"
 },
 {
  "content": "保险合同的约定予以"
 },
 {
  "content": "赔偿；仍然不足"
 },
 {
  "content": "或者没有投保机动车"
 },
 {
  "content": "商业保险的，"
 },
 {
  "content": "由侵权人赔偿"
 },
 {
  "content": "。”\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十五条规定，"
 },
 {
  "content": "行为人因过错"
 },
 {
  "content": "侵害他人民事"
 },
 {
  "content": "权益造成损害的"
 },
 {
  "content": "，应当承担侵权"
 },
 {
  "content": "责任。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "第一，责任主体"
 },
 {
  "content": "认定。后车被认定全责"
 },
 {
  "content": "，即存在过错"
 },
 {
  "content": "，应当作为侵权"
 },
 {
  "content": "人对前车的损失"
 },
 {
  "content": "承担民事"
 },
 {
  "content": "赔偿责任。\n第二"
 },
 {
  "content": "，交强险"
 },
 {
  "content": "优先赔偿。由于"
 },
 {
  "content": "事故属于后"
 },
 {
  "content": "车一方责任，"
 },
 {
  "content": "前车的损失首先"
 },
 {
  "content": "由后车投保"
 },
 {
  "content": "的机动车交通事故"
 },
 {
  "content": "责任强制保险（"
 },
 {
  "content": "交强险）"
 },
 {
  "content": "在责任限额范围内"
 },
 {
  "content": "予以赔偿。\n"
 },
 {
  "content": "第三，商业险"
 },
 {
  "content": "补充赔偿。如果"
 },
 {
  "content": "前车损失超出"
 },
 {
  "content": "交强险的"
 },
 {
  "content": "赔偿限额，不足"
 },
 {
  "content": "部分由后车"
 },
 {
  "content": "投保的机动车商业"
 },
 {
  "content": "保险（如第三者"
 },
 {
  "content": "责任险）按照"
 },
 {
  "content": "保险合同的约定予以"
 },
 {
  "content": "赔偿。\n第四"
 },
 {
  "content": "，侵权人自行"
 },
 {
  "content": "赔偿。如果前"
 },
 {
  "content": "车损失仍存在"
 },
 {
  "content": "不足，或者后车根本没有投保机动车"
 },
 {
  "content": "商业保险，则由"
 },
 {
  "content": "侵权人（即"
 },
 {
  "content": "后车车主或"
 },
 {
  "content": "驾驶人）自行承担"
 },
 {
  "content": "剩余部分的赔偿"
 },
 {
  "content": "。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：前车的"
 },
 {
  "content": "损失由后车"
 },
 {
  "content": "方负责赔偿，"
 },
 {
  "content": "具体赔偿顺序为"
 },
 {
  "content": "后车的交强"
 },
 {
  "content": "险、商业险"
 },
 {
  "content": "、侵权人个人"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：若后车"
 },
 {
  "content": "存在未投保交"
 },
 {
  "content": "强险、未"
 },
 {
  "content": "投保商业险或"
 },
 {
  "content": "商业险"
 },
 {
  "content": "保额严重不足"
 },
 {
  "content": "的情形，前车的"
 },
 {
  "content": "赔偿款项将"
 },
 {
  "content": "直接依赖于后车"
 },
 {
  "content": "车主或驾驶"
 },
 {
  "content": "人的个人清偿能力"
 },
 {
  "content": "。一旦侵权"
 },
 {
  "content": "人缺乏支付能力"
 },
 {
  "content": "，前车权利"
 },
 {
  "content": "人可能面临执行"
 },
 {
  "content": "难的风险，导致"
 },
 {
  "content": "实际获"
 },
 {
  "content": "赔周期拉长"
 },
 {
  "content": "或无法全额获"
 },
 {
  "content": "赔。"
 },
