  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "合法。"
 },
 {
  "content": "\n\n根据《劳动合同"
 },
 {
  "content": "法》第十九条第一款"
 },
 {
  "content": "规定：“劳动合同"
 },
 {
  "content": "期限三个月以上不满"
 },
 {
  "content": "一年的，试用期不得超过"
 },
 {
  "content": "一个月；劳动合同期限"
 },
 {
  "content": "一年以上不满三年的，"
 },
 {
  "content": "试用期不得超过二个月"
 },
 {
  "content": "；三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月。”\n\n本案"
 },
 {
  "content": "中，公司与员工"
 },
 {
  "content": "签订的劳动合同期限为三年"
 },
 {
  "content": "，属于“三年以上"
 },
 {
  "content": "固定期限劳动合同”，"
 },
 {
  "content": "其"
 },
 {
  "content": "法定试用期上限即为"
 },
 {
  "content": "六个月。公司"
 },
 {
  "content": "第一次约定试用期"
 },
 {
  "content": "六个月，未超过"
 },
 {
  "content": "法定上限，且"
 },
 {
  "content": "符合《劳动合同法"
 },
 {
  "content": "》第十九条第二款“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”的规定（"
 },
 {
  "content": "系首次约定），"
 },
 {
  "content": "因此该试用期约定"
 },
 {
  "content": "合法。\n\n本"
 },
 {
  "content": "答复仅供参考，不"
 },
 {
  "content": "构成正式法律意见"
 },
 {
  "content": "。"
 },
