 },
 {
  "content": "第十九条第一款规定：“"
 },
 {
  "content": "劳动合同"
 },
 {
  "content": "期限三个月以上不满"
 },
 {
  "content": "一年的，试用期不得超过"
 },
 {
  "content": "一个月；劳动合同期限"
 },
 {
  "content": "一年以上不满三年的，"
 },
 {
  "content": "试用期不得超过二个月"
 },
 {
  "content": "；三年以上固定期限"
 },
 {
  "content": "和无固定期限的"
 },
 {
  "content": "劳动合同，试用期不得超过"
 },
 {
  "content": "六个月。”\n\n本案"
 },
 {
  "content": "中，公司与员工"
 },
 {
  "content": "签订的"
 },
 {
  "content": "劳动合同"
 },
 {
  "content": "期限为"
 },
 {
  "content": "三年，属于“"
 },
 {
  "content": "三年以上固定期限劳动合同"
 },
 {
  "content": "”，其"
 },
 {
  "content": "法定试用期上限即为"
 },
 {
  "content": "六个月。公司"
 },
 {
  "content": "第一次"
 },
 {
  "content": "约定试用期"
 },
 {
  "content": "六个月，既"
 },
 {
  "content": "未超过法定"
 },
 {
  "content": "上限，也不"
 },
 {
  "content": "违反《劳动合同法"
 },
 {
  "content": "》第十九条第二款“"
 },
 {
  "content": "同一用人单位与同一"
 },
 {
  "content": "劳动者只能约定一次"
 },
 {
  "content": "试用期”的规定，"
 },
 {
  "content": "因此该约定合法"
 },
 {
  "content": "有效"
 },
