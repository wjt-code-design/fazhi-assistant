 {
  "content": "①案情与"
 },
 {
  "content": "争议焦点\n本案"
 },
 {
  "content": "中，卖方逾期"
 },
 {
  "content": "交货30天"
 },
 {
  "content": "，构成违约。"
 },
 {
  "content": "合同约定的违约金数额"
 },
 {
  "content": "远高于买方的实际"
 },
 {
  "content": "损失。核心争议"
 },
 {
  "content": "焦点在于：当"
 },
 {
  "content": "约定的违约金过分高于"
 },
 {
  "content": "实际损失时，"
 },
 {
  "content": "买方是否有权请求"
 },
 {
  "content": "法院予以适当减少"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n主要依据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "八十五条关于违约金"
 },
 {
  "content": "调整的规定，以及"
 },
 {
  "content": "第五百七十七条、"
 },
 {
  "content": "第五百八十四条关于"
 },
 {
  "content": "违约责任及损失"
 },
 {
  "content": "赔偿范围的规定。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "卖方逾期交货属于"
 },
 {
  "content": "违约行为。根据"
 },
 {
  "content": "《民法典》第五百"
 },
 {
  "content": "七十七条，当事人"
 },
 {
  "content": "一方不履行合同"
 },
 {
  "content": "义务或者履行合同"
 },
 {
  "content": "义务不符合约定的，"
 },
 {
  "content": "应当承担赔偿损失"
 },
 {
  "content": "等违约责任。"
 },
 {
  "content": "\n其次，违约金"
 },
 {
  "content": "过高可依法请求"
 },
 {
  "content": "调减"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第五百八十五条"
 },
 {
  "content": "，约定的违约金过分"
 },
 {
  "content": "高于造成的损失的，"
 },
 {
  "content": "人民法院或者仲裁机构"
 },
 {
  "content": "可以根据当事人的请求予以"
 },
 {
  "content": "适当减少。本案"
 },
 {
  "content": "中违约金高出实际"
 },
 {
  "content": "损失数倍，"
 },
 {
  "content": "符合法律规定的“"
 },
 {
  "content": "过分高于”情形"
 },
 {
  "content": "，买方依法享有"
 },
 {
  "content": "请求减少的权利。"
 },
 {
  "content": "\n最后，违约金"
 },
 {
  "content": "调整需以实际"
 },
 {
  "content": "损失为参照。"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第五百八十四条，"
 },
 {
  "content": "损失赔偿额应当"
 },
 {
  "content": "相当于因违约所造成的"
 },
 {
  "content": "损失，包括合同"
 },
 {
  "content": "履行后可以获得的利益"
 },
 {
  "content": "。法院在裁量"
 },
 {
  "content": "是否减少及"
 },
 {
  "content": "减少幅度时，"
 },
 {
  "content": "通常以实际损失"
 },
 {
  "content": "为基础，兼顾合同"
 },
 {
  "content": "履行情况、当事人"
 },
 {
  "content": "过错程度等因素综合"
 },
 {
  "content": "衡量。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：买方可以"
 },
 {
  "content": "请求法院适当减少"
 },
 {
  "content": "违约金。\n风险"
 },
 {
  "content": "提示：买方需"
 },
 {
  "content": "对“违约金过分"
 },
 {
  "content": "高于实际损失”"
 },
 {
  "content": "承担举证责任，"
 },
 {
  "content": "即需提供"
 },
 {
  "content": "证据证明自身的"
 },
 {
  "content": "实际损失具体数额"
 },
 {
  "content": "。此外，法院"
 },
 {
  "content": "在调整时具有"
 },
 {
  "content": "自由裁量权，"
 },
 {
  "content": "并非必然将违约金"
 },
 {
  "content": "降至与实际损失"
 },
 {
  "content": "完全一致的水平，"
 },
 {
  "content": "而是“适当减少"
 },
 {
  "content": "”，因此最终判决"
 },
 {
  "content": "结果存在一定不确定性"
 },
 {
  "content": "。"
 },
