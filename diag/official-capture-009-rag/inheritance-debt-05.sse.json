[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n父亲去世后"
 },
 {
  "content": "留有房产及"
 },
 {
  "content": "信用卡欠款，核心"
 },
 {
  "content": "争议在于子女作为"
 },
 {
  "content": "继承人，是否必须"
 },
 {
  "content": "以个人固有财产"
 },
 {
  "content": "偿还父亲生前的"
 },
 {
  "content": "信用卡欠款。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第一千一百二十二条"
 },
 {
  "content": "关于遗产定义"
 },
 {
  "content": "的规定；根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条关于限定"
 },
 {
  "content": "继承及放弃继承"
 },
 {
  "content": "的规定；根据《"
 },
 {
  "content": "民事诉讼法》第二百四"
 },
 {
  "content": "十三条关于被执行人死亡"
 },
 {
  "content": "后以遗产偿还债务"
 },
 {
  "content": "的规定。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，子女没有"
 },
 {
  "content": "必须拿个人财产"
 },
 {
  "content": "替父亲还"
 },
 {
  "content": "债的法定义务"
 },
 {
  "content": "。根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条，我国实行"
 },
 {
  "content": "限定继承原则，"
 },
 {
  "content": "继承人以所得遗产"
 },
 {
  "content": "实际价值为限"
 },
 {
  "content": "清偿被继承人依法"
 },
 {
  "content": "应当缴纳的税款"
 },
 {
  "content": "和债务。超过"
 },
 {
  "content": "遗产实际价值部分"
 },
 {
  "content": "，继承人自愿偿还"
 },
 {
  "content": "的不在此限。"
 },
 {
  "content": "\n其次，关于"
 },
 {
  "content": "本案中的房子和"
 },
 {
  "content": "信用卡欠款，父亲的"
 },
 {
  "content": "房子属于其死亡"
 },
 {
  "content": "时遗留的个人合法"
 },
 {
  "content": "财产即遗产，"
 },
 {
  "content": "应当先用该遗产"
 },
 {
  "content": "清偿信用卡欠款。"
 },
 {
  "content": "若房产变价款"
 },
 {
  "content": "足以覆盖"
 },
 {
  "content": "欠款，清偿后"
 },
 {
  "content": "剩余部分由子女"
 },
 {
  "content": "继承；若房产"
 },
 {
  "content": "变价款不足以覆盖"
 },
 {
  "content": "欠款，子女仅需"
 },
 {
  "content": "以房产价值"
 },
 {
  "content": "为限偿还，"
 },
 {
  "content": "超出部分除非子女"
 },
 {
  "content": "自愿，否则无需"
 },
 {
  "content": "用自己额外的"
 },
 {
  "content": "钱偿还。\n"
 },
 {
  "content": "最后，若子女"
 },
 {
  "content": "明确表示放弃继承"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第一千一百六"
 },
 {
  "content": "十一条第二款，子女"
 },
 {
  "content": "对被继承人的税款"
 },
 {
  "content": "和债务可以不负"
 },
 {
  "content": "清偿责任。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：子女"
 },
 {
  "content": "并非必须拿自己的"
 },
 {
  "content": "钱偿还父亲的信用卡"
 },
 {
  "content": "欠款，仅需在"
 },
 {
  "content": "继承遗产的实际价值"
 },
 {
  "content": "范围内承担清偿责任"
 },
 {
  "content": "。\n风险提示"
 },
 {
  "content": "：若房产上"
 },
 {
  "content": "设有抵押权等"
 },
 {
  "content": "优先受偿权"
 },
 {
  "content": "，根据《民法典"
 },
 {
  "content": "》第三百九十四条"
 },
 {
  "content": "，抵押权人"
 },
 {
  "content": "有权就该财产优先"
 },
 {
  "content": "受偿，这"
 },
 {
  "content": "可能导致遗产实际价值"
 },
 {
  "content": "减少。此外，"
 },
 {
  "content": "若子女已实际"
 },
 {
  "content": "管理或"
 },
 {
  "content": "占有遗产，可能"
 },
 {
  "content": "需在遗产管理范围内"
 },
 {
  "content": "配合债权人实现债权"
 },
 {
  "content": "，建议妥善"
 },
 {
  "content": "处理遗产分割与"
 },
 {
  "content": "债务清偿事宜。"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
