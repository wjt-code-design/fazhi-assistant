[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①案情"
 },
 {
  "content": "与争议焦点\n"
 },
 {
  "content": "本案为两车"
 },
 {
  "content": "追尾事故，"
 },
 {
  "content": "交警认定后车"
 },
 {
  "content": "负全部责任。"
 },
 {
  "content": "争议焦点在于前"
 },
 {
  "content": "车损失的赔偿义务"
 },
 {
  "content": "主体及具体赔偿"
 },
 {
  "content": "顺序。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《道路交通安全法》"
 },
 {
  "content": "第七十六条第一款第"
 },
 {
  "content": "（一）项"
 },
 {
  "content": "：机动车之间发生"
 },
 {
  "content": "交通事故的，由"
 },
 {
  "content": "有过错的一方承担"
 },
 {
  "content": "赔偿责任；双方都有"
 },
 {
  "content": "过错的，按照"
 },
 {
  "content": "各自过错的比例分担"
 },
 {
  "content": "责任。\n根据"
 },
 {
  "content": "《民法典》第一千"
 },
 {
  "content": "二百一十三条："
 },
 {
  "content": "机动车发生交通事故造成"
 },
 {
  "content": "损害，属于该"
 },
 {
  "content": "机动车一方责任的，"
 },
 {
  "content": "先由承保机动车"
 },
 {
  "content": "强制保险的保险"
 },
 {
  "content": "人在强制保险责任"
 },
 {
  "content": "限额范围内予以赔偿"
 },
 {
  "content": "；不足部分，"
 },
 {
  "content": "由承保机动车商业"
 },
 {
  "content": "保险的保险人"
 },
 {
  "content": "按照保险合同的约定"
 },
 {
  "content": "予以赔偿；仍然"
 },
 {
  "content": "不足或者没有投保"
 },
 {
  "content": "机动车商业保险的"
 },
 {
  "content": "，由侵权人"
 },
 {
  "content": "赔偿。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，后车"
 },
 {
  "content": "被认定负全部"
 },
 {
  "content": "责任，表明"
 },
 {
  "content": "后车一方对"
 },
 {
  "content": "事故的发生存在过错"
 },
 {
  "content": "，是侵权人"
 },
 {
  "content": "，应当对前车的"
 },
 {
  "content": "损失承担赔偿责任。"
 },
 {
  "content": "\n其次，赔偿"
 },
 {
  "content": "需按照法定顺"
 },
 {
  "content": "位进行：第一"
 },
 {
  "content": "顺位是"
 },
 {
  "content": "后车的交强"
 },
 {
  "content": "险，由承保"
 },
 {
  "content": "交强险的"
 },
 {
  "content": "保险公司在责任限额"
 },
 {
  "content": "范围内优先赔付前"
 },
 {
  "content": "车的损失；第二"
 },
 {
  "content": "顺位是后"
 },
 {
  "content": "车的商业险（"
 },
 {
  "content": "如商业第三者责任"
 },
 {
  "content": "险），交强"
 },
 {
  "content": "险赔付不足的部分"
 },
 {
  "content": "，由商业险"
 },
 {
  "content": "保险公司按保险"
 },
 {
  "content": "合同约定进行赔付；"
 },
 {
  "content": "第三顺位是"
 },
 {
  "content": "侵权人本人，"
 },
 {
  "content": "如果交强险"
 },
 {
  "content": "和商业险赔付后"
 },
 {
  "content": "仍有不足"
 },
 {
  "content": "，或者后车"
 },
 {
  "content": "根本没有投保商业险"
 },
 {
  "content": "，则由后车"
 },
 {
  "content": "车主或驾驶员（"
 },
 {
  "content": "侵权人）自行"
 },
 {
  "content": "承担剩余部分的"
 },
 {
  "content": "赔偿。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：前车的"
 },
 {
  "content": "损失由后车"
 },
 {
  "content": "方的交强险"
 },
 {
  "content": "保险公司、商业险"
 },
 {
  "content": "保险公司及后车"
 },
 {
  "content": "侵权人按"
 },
 {
  "content": "法定顺序共同"
 },
 {
  "content": "承担。\n风险"
 },
 {
  "content": "提示：若后"
 },
 {
  "content": "车存在"
 },
 {
  "content": "未投保交强"
 },
 {
  "content": "险、保额"
 },
 {
  "content": "不足或肇事逃逸"
 },
 {
  "content": "等情形，前"
 },
 {
  "content": "车的索赔可能面临"
 },
 {
  "content": "侵权人无力"
 },
 {
  "content": "赔偿的执行风险"
 },
 {
  "content": "。此时前车"
 },
 {
  "content": "方可依据保险"
 },
 {
  "content": "法相关规定"
 },
 {
  "content": "向己方保险公司申请"
 },
 {
  "content": "代位求偿"
 },
 {
  "content": "，或在符合条件时"
 },
 {
  "content": "申请道路交通事故社会救助"
 },
 {
  "content": "基金垫付。"
 },
