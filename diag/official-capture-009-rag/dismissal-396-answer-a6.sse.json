 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n案情：员工"
 },
 {
  "content": "多次旷工，"
 },
 {
  "content": "公司依据经民主"
 },
 {
  "content": "程序制定并已公示"
 },
 {
  "content": "的规章制度解除劳动合同"
 },
 {
  "content": "，解除前已"
 },
 {
  "content": "通知工会并留存"
 },
 {
  "content": "证据。\n争议"
 },
 {
  "content": "焦点：公司据此"
 },
 {
  "content": "解除劳动合同是否需要支付"
 },
 {
  "content": "经济补偿或赔偿"
 },
 {
  "content": "金。\n\n②"
 },
 {
  "content": "法律依据\n《"
 },
 {
  "content": "劳动合同法》第三"
 },
 {
  "content": "十九条第（二"
 },
 {
  "content": "）项：劳动者"
 },
 {
  "content": "严重违反用人单位的"
 },
 {
  "content": "规章制度的，用人单位"
 },
 {
  "content": "可以解除劳动合同。"
 },
 {
  "content": "\n《劳动合同法"
 },
 {
  "content": "》第四十三条："
 },
 {
  "content": "用人单位单方解除"
 },
 {
  "content": "劳动合同，应当事先"
 },
 {
  "content": "将理由通知工会"
 },
 {
  "content": "。\n《劳动合同"
 },
 {
  "content": "法》第四十六条"
 },
 {
  "content": "：列举了用人单位"
 },
 {
  "content": "应当支付经济补偿"
 },
 {
  "content": "的法定情形。"
 },
 {
  "content": "\n《劳动合同法"
 },
 {
  "content": "》第八十七条："
 },
 {
  "content": "用人单位违反本法规定"
 },
 {
  "content": "解除或者终止劳动合同"
 },
 {
  "content": "的，应当依照"
 },
 {
  "content": "经济补偿标准的二"
 },
 {
  "content": "倍支付"
 },
 {
  "content": "赔偿金。\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n关于解除性质"
 },
 {
  "content": "：员工多次旷"
 },
 {
  "content": "工属于严重违反"
 },
 {
  "content": "规章制度，公司规章制度"
 },
 {
  "content": "经民主程序制定"
 },
 {
  "content": "且已公示，"
 },
 {
  "content": "解除前已通知"
 },
 {
  "content": "工会，符合《"
 },
 {
  "content": "劳动合同法》第三"
 },
 {
  "content": "十九条及第四十三条"
 },
 {
  "content": "规定的合法解除要件"
 },
 {
  "content": "，属于过失"
 },
 {
  "content": "性辞退。\n"
 },
 {
  "content": "关于经济补偿："
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第四十六条，"
 },
 {
  "content": "用人单位需支付经济"
 },
 {
  "content": "补偿的情形包括劳动者"
 },
 {
  "content": "被迫解除、协商"
 },
 {
  "content": "解除、无过失"
 },
 {
  "content": "性解除及经济性"
 },
 {
  "content": "裁员等，并不"
 },
 {
  "content": "包含第三十九条规定的"
 },
 {
  "content": "过失性辞退。"
 },
 {
  "content": "因此，公司无需"
 },
 {
  "content": "支付经济补偿。"
 },
 {
  "content": "\n关于赔偿金"
 },
 {
  "content": "：根据《劳动合同"
 },
 {
  "content": "法》第八十七条"
 },
 {
  "content": "，赔偿金仅"
 },
 {
  "content": "适用于违法解除或"
 },
 {
  "content": "终止劳动合同的情形。"
 },
 {
  "content": "本案解除行为合法"
 },
 {
  "content": "，故不适用该"
 },
 {
  "content": "条款，无需支付"
 },
 {
  "content": "赔偿金。\n\n"
 },
 {
  "content": "④结论与风险"
 },
 {
  "content": "\n结论：公司"
 },
 {
  "content": "无需支付经济补偿"
 },
 {
  "content": "或赔偿金。"
 },
 {
  "content": "\n风险：需"
 },
 {
  "content": "确保“多次旷"
 },
 {
  "content": "工”确已达到"
 },
 {
  "content": "规章制度中“"
 },
 {
  "content": "严重”的程度，"
 },
 {
  "content": "且考勤记录"
 },
 {
  "content": "等证据确凿"
 },
 {
  "content": "。若规章制度未"
 },
 {
  "content": "明确旷工多少次"
 },
 {
  "content": "构成“严重”，"
 },
 {
  "content": "或公司无法充分"
 },
 {
  "content": "举证旷"
 },
 {
  "content": "工事实，解除"
 },
 {
  "content": "存在被认定为违法"
 },
 {
  "content": "解除的风险，届时"
 },
 {
  "content": "需依照《劳动合同"
 },
 {
  "content": "法》第八十七条"
 },
 {
  "content": "支付赔偿金。"
 },
