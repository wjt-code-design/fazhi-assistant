 {
  "content": "①案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，房屋买卖"
 },
 {
  "content": "合同的"
 },
 {
  "content": "标的"
 },
 {
  "content": "额为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，双方约定的定金"
 },
 {
  "content": "数额为80"
 },
 {
  "content": "万元。争议焦点"
 },
 {
  "content": "在于：定金数额"
 },
 {
  "content": "远超主合同标的"
 },
 {
  "content": "额20%"
 },
 {
  "content": "的法定上限时"
 },
 {
  "content": "，该定金条款"
 },
 {
  "content": "的效力如何认定"
 },
 {
  "content": "以及"
 },
 {
  "content": "超出部分如何处理"
 },
 {
  "content": "。\n\n②法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第五百八"
 },
 {
  "content": "十六条第二款的规定：“"
 },
 {
  "content": "定金的数额由"
 },
 {
  "content": "当事人约定；但是"
 },
 {
  "content": "，不得超过主合同"
 },
 {
  "content": "标的额的百分之二十"
 },
 {
  "content": "，超过部分不"
 },
 {
  "content": "产生定金的效力"
 },
 {
  "content": "。实际交付的"
 },
 {
  "content": "定金数额多于或者"
 },
 {
  "content": "少于约定数额的"
 },
 {
  "content": "，视为变更约定的"
 },
 {
  "content": "定金数额。”\n\n"
 },
 {
  "content": "③逐项论证"
 },
 {
  "content": "\n首先，计算"
 },
 {
  "content": "法定定金上限。"
 },
 {
  "content": "房屋总价款为"
 },
 {
  "content": "100万元"
 },
 {
  "content": "，其20"
 },
 {
  "content": "%为20"
 },
 {
  "content": "万元。因此，"
 },
 {
  "content": "本案中产生"
 },
 {
  "content": "定金"
 },
 {
  "content": "效力的法定上限为"
 },
 {
  "content": "20万元。"
 },
 {
  "content": "\n其次，认定"
 },
 {
  "content": "超出部分的效力。"
 },
 {
  "content": "双方约定的定金"
 },
 {
  "content": "为80万元"
 },
 {
  "content": "，超出法定上限"
 },
 {
  "content": "的部分为60"
 },
 {
  "content": "万元。根据上述"
 },
 {
  "content": "法律规定，该6"
 },
 {
  "content": "0万元不产生"
 },
 {
  "content": "定金的效力。"
 },
 {
  "content": "\n最后，分析"
 },
 {
  "content": "超出部分的法律性质"
 },
 {
  "content": "。虽然超出"
 },
 {
  "content": "部分不适用"
 },
 {
  "content": "定金罚则，"
 },
 {
  "content": "但这60万元"
 },
 {
  "content": "通常被视为"
 },
 {
  "content": "预付款。若收受"
 },
 {
  "content": "定金的一方"
 },
 {
  "content": "违约，其应当"
 },
 {
  "content": "返还该6"
 },
 {
  "content": "0万元预付款，"
 },
 {
  "content": "而不能适用“双倍"
 },
 {
  "content": "返还”的定金"
 },
 {
  "content": "罚则；若"
 },
 {
  "content": "给付定金的一方违约"
 },
 {
  "content": "，对方也不能直接"
 },
 {
  "content": "没收该60"
 },
 {
  "content": "万元适用"
 },
 {
  "content": "定金罚则，"
 },
 {
  "content": "只能依据实际损失"
 },
 {
  "content": "主张相应"
 },
 {
  "content": "赔偿。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：该定金"
 },
 {
  "content": "条款并非全部无效"
 },
 {
  "content": "，而是部分有效"
 },
 {
  "content": "、部分不产生"
 },
 {
  "content": "定金效力。其中"
 },
 {
  "content": "20万元产生"
 },
 {
  "content": "定金效力，可"
 },
 {
  "content": "适用定金罚则"
 },
 {
  "content": "；超出法定上限"
 },
 {
  "content": "的60万元"
 },
 {
  "content": "不产生定金效力"
 },
 {
  "content": "，视为预付款。"
 },
 {
  "content": "\n风险提示："
 },
 {
  "content": "由于定金比例严重"
 },
 {
  "content": "超标，若发生"
 },
 {
  "content": "违约，"
 },
 {
  "content": "守约方将无法"
 },
 {
  "content": "就超出20"
 },
 {
  "content": "万元的60万元"
 },
 {
  "content": "部分主张双倍返还"
 },
 {
  "content": "的定金罚则"
 },
 {
  "content": "，可能面临无法"
 },
 {
  "content": "获得足额惩罚性"
 },
 {
  "content": "赔偿的风险。建议在"
 },
 {
  "content": "签订合同时将"
 },
 {
  "content": "定金数额控制在法定"
 },
 {
  "content": "上限以内，或"
 },
 {
  "content": "考虑通过"
 },
 {
  "content": "增加违约金条款来"
 },
 {
  "content": "弥补高"
 },
 {
  "content": "额定金无法"
 },
 {
  "content": "适用罚则的"
 },
 {
  "content": "保障缺失。\n\n"
 },
 {
  "content": "本答复仅供参考，"
 },
 {
  "content": "不构成正式法律"
 },
 {
  "content": "意见。"
 },
