 },
 {
  "content": "协议不成的，"
 },
 {
  "content": "由人民法院根据财产"
 },
 {
  "content": "的具体情况判决。"
 },
 {
  "content": "\n根据《民法典"
 },
 {
  "content": "》第一千零九"
 },
 {
  "content": "十二条，夫妻一方"
 },
 {
  "content": "隐藏、转移夫妻"
 },
 {
  "content": "共同财产的，"
 },
 {
  "content": "在离婚分割夫妻"
 },
 {
  "content": "共同财产时，"
 },
 {
  "content": "对该方可以少"
 },
 {
  "content": "分或者不分。"
 },
 {
  "content": "\n\n③逐项"
 },
 {
  "content": "论证\n首先，"
 },
 {
  "content": "婚后父母出资购房"
 },
 {
  "content": "，其性质认定"
 },
 {
  "content": "取决于是否有明确的赠与"
 },
 {
  "content": "对象约定。如果"
 },
 {
  "content": "父母在转账时"
 },
 {
  "content": "明确表示该3"
 },
 {
  "content": "0万仅赠与"
 },
 {
  "content": "给子女个人，"
 },
 {
  "content": "则属于该"
 },
 {
  "content": "方个人财产，"
 },
 {
  "content": "配偶离婚时要求"
 },
 {
  "content": "分一半缺乏依据"
 },
 {
  "content": "。\n其次，"
 },
 {
  "content": "如果父母出资时"
 },
 {
  "content": "没有明确约定或"
 },
 {
  "content": "约定不明，由于"
 },
 {
  "content": "该款项取得于"
 },
 {
  "content": "婚姻关系存续期间"
 },
 {
  "content": "，存在被认定为"
 },
 {
  "content": "夫妻共同财产的风险"
 },
 {
  "content": "，离婚时配偶"
 },
 {
  "content": "有权要求分割。"
 },
 {
  "content": "\n最后，若"
 },
 {
  "content": "该方在婚姻"
 },
 {
  "content": "期间将这3"
 },
 {
  "content": "0万或所"
 },
 {
  "content": "购房产隐藏、"
 },
 {
  "content": "转移，根据《"
 },
 {
  "content": "民法典》第一千零"
 },
 {
  "content": "九十二条，在"
 },
 {
  "content": "分割时对该方"
 },
 {
  "content": "可以少分或者"
 },
 {
  "content": "不分。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：配偶能否"
 },
 {
  "content": "分一半，关键在于"
 },
 {
  "content": "是否有证据证明父母"
 },
 {
  "content": "明确表示该3"
 },
 {
  "content": "0万仅赠与"
 },
 {
  "content": "给出资方"
 },
 {
  "content": "子女个人。\n"
 },
 {
  "content": "风险提示：若"
 },
 {
  "content": "无法提供书面"
 },
 {
  "content": "赠与协议等明确"
 },
 {
  "content": "约定证据，该"
 },
 {
  "content": "30万及"
 },
 {
  "content": "所购房产极"
 },
 {
  "content": "有可能被认定为夫妻"
 },
 {
  "content": "共同财产而面临"
 },
 {
  "content": "分割。此外，"
 },
 {
  "content": "若存在转移、"
 },
 {
  "content": "隐匿该财产的行为"
 },
 {
  "content": "，过错方可能"
 },
 {
  "content": "面临少分或"
 },
 {
  "content": "不分的不利后果"
 },
 {
  "content": "。由于父母出资"
 },
 {
  "content": "购房的性质认定存在"
 },
 {
  "content": "法律不确定性，具体"
 },
 {
  "content": "认定需结合证据"
 },
 {
