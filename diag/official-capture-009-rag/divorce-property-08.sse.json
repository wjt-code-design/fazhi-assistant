 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n本案中，"
 },
 {
  "content": "婚后一方父母转账"
 },
 {
  "content": "30万用于"
 },
 {
  "content": "买房，离婚时"
 },
 {
  "content": "配偶要求分割。"
 },
 {
  "content": "核心争议焦点在于"
 },
 {
  "content": "该30万"
 },
 {
  "content": "购房款及所"
 },
 {
  "content": "购房屋属于夫妻"
 },
 {
  "content": "共同财产还是一方"
 },
 {
  "content": "个人财产。\n\n"
 },
 {
  "content": "②法律依据\n"
 },
 {
  "content": "根据《民法典》"
