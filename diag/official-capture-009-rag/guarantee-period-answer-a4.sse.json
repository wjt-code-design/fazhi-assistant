[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "针对您"
 },
 {
  "content": "的问题，分析如下"
 },
 {
  "content": "：\n\n一、"
 },
 {
  "content": "结论认定"
 },
 {
  "content": "\n合同中“保证"
 },
 {
  "content": "人承担保证责任"
 },
 {
  "content": "直至借款本息"
 },
 {
  "content": "还清为止”"
 },
 {
  "content": "的写法，属于"
 },
 {
  "content": "对保证期间的"
 },
 {
  "content": "约定不明确，"
 },
 {
  "content": "依法应认定保证"
 },
 {
  "content": "期间为主债务履行"
 },
 {
  "content": "期限届满之日起六个月"
 },
 {
  "content": "。\n\n二、"
 },
 {
  "content": "法律依据与"
 },
 {
  "content": "论证\n1."
 },
 {
  "content": " 法律依据："
 },
 {
  "content": "根据《民法典》"
 },
 {
  "content": "第六百九十二条规定"
 },
 {
  "content": "，债权人与保证"
 },
 {
  "content": "人可以约定保证期间"
 },
 {
  "content": "，但是约定的保证"
 },
 {
  "content": "期间早于主"
 },
 {
  "content": "债务履行期限或者"
 },
 {
  "content": "与主债务履行"
 },
 {
  "content": "期限同时届满的"
 },
 {
  "content": "，视为没有约定"
 },
 {
  "content": "；没有约定或者"
 },
 {
  "content": "约定不明确的，"
 },
 {
  "content": "保证期间为主债务"
 },
 {
  "content": "履行期限届满之日起"
 },
 {
  "content": "六个月。\n2"
 },
 {
  "content": ". 具体论证"
 },
 {
  "content": "：合同条款中"
 },
 {
  "content": "“承担保证责任"
 },
 {
  "content": "直至借款本息"
 },
 {
  "content": "还清为止”"
 },
 {
  "content": "的表述，实质"
 },
 {
  "content": "上是将保证期间"
 },
 {
  "content": "设定为一个不"
 },
 {
  "content": "确定的、依附于"
 },
 {
  "content": "债务实际"
 },
 {
  "content": "清偿时间的期间"
 },
 {
  "content": "，导致保证期间"
 },
 {
  "content": "无法明确界定"
 },
 {
  "content": "，在法律"
 },
 {
  "content": "上属于“约定"
 },
 {
  "content": "不明确”的情形"
 },
 {
  "content": "。因此，直接"
 },
 {
  "content": "适用《民法典》"
 },
 {
  "content": "第六百九十二条的"
 },
 {
  "content": "法定保证期间，"
 },
 {
  "content": "即主债务履行"
 },
 {
  "content": "期限届满之日起六个月"
 },
 {
  "content": "。\n\n三、"
 },
 {
  "content": "风险提示\n1"
 },
 {
  "content": ". 根据《"
 },
 {
  "content": "民法典》第六百九"
 },
 {
  "content": "十三条规定，一般"
 },
 {
  "content": "保证的债权人未"
 },
 {
  "content": "在保证期间对债务人"
 },
 {
  "content": "提起诉讼或者申请仲裁"
 },
 {
  "content": "的，保证人"
 },
 {
  "content": "不再承担保证责任"
 },
 {
  "content": "；连带责任保证"
 },
 {
  "content": "的债权人未在保证"
 },
 {
  "content": "期间请求保证人"
 },
 {
  "content": "承担保证责任的，"
 },
 {
  "content": "保证人不再承担"
 },
 {
  "content": "保证责任。\n"
 },
 {
  "content": "2. 由于"
 },
 {
  "content": "保证期间被认定为"
 },
 {
  "content": "六个月，且该"
 },
 {
  "content": "期间不发生中止"
 },
 {
  "content": "、中断和延长"
 },
 {
  "content": "（《民法典》"
 },
 {
  "content": "第六百九十二条），"
 },
 {
  "content": "债权人必须在主"
 },
 {
  "content": "债务履行期限届满"
 },
 {
  "content": "之日起六个月内，"
 },
 {
  "content": "根据保证方式的不同"
 },
 {
  "content": "采取相应行动（"
 },
 {
  "content": "一般保证需起诉"
 },
 {
  "content": "或仲裁，连带"
 },
 {
  "content": "责任保证需向"
 },
 {
  "content": "保证人主张权利"
 },
 {
  "content": "），否则将面临"
 },
 {
  "content": "保证人免除"
 },
 {
  "content": "保证责任的法律风险"
 },
 {
  "content": "。"
 },
