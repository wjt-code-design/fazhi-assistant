 },
 {
  "content": "，"
 },
 {
  "content": "符合《"
 },
 {
  "content": "劳动合同法》第十九条"
 },
 {
  "content": "关于"
 },
 {
  "content": "“三年以上固定期限"
 },
 {
  "content": "劳动合同试用期"
 },
 {
  "content": "不得超过六个月”的规定"
 },
 {
  "content": "。"
