 },
 {
  "content": "合理期限内支付；"
 },
 {
  "content": "承租人逾期不支付的，"
 },
 {
  "content": "出租人可以解除合同"
 },
 {
  "content": "。\n《电子商务"
 },
 {
  "content": "法》第二十一条："
 },
 {
  "content": "电子商务经营者按照约定"
 },
 {
  "content": "向消费者收取押"
 },
 {
  "content": "金的，应当明"
 },
 {
  "content": "示押金退还的方式"
 },
 {
  "content": "、程序，不得"
 },
 {
  "content": "对押金退还设置"
 },
 {
  "content": "不合理条件。消费者"
 },
 {
  "content": "申请退还押金，"
 },
 {
  "content": "符合押金退还条件的"
 },
 {
  "content": "，电子商务经营者应当及时"
 },
 {
  "content": "退还。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "关于换锁行为"
 },
 {
  "content": "：根据《民法典"
 },
 {
  "content": "》第七百二十二条"
 },
 {
  "content": "，即使租客存在"
 },
 {
  "content": "迟延支付租金"
 },
 {
  "content": "的情形，出租人也"
 },
 {
  "content": "仅享有“先"
 },
 {
  "content": "请求在合理期限内"
 },
 {
  "content": "支付，逾期不"
 },
 {
  "content": "付才可"
 },
 {
  "content": "解除合同”的权利"
 },
 {
  "content": "。晚交两天"
 },
 {
  "content": "房租属于轻微违约"
 },
 {
  "content": "，房东未履行"
 },
 {
  "content": "催告义务即"
 },
 {
  "content": "直接换锁，"
 },
 {
  "content": "导致租客无法正常使用"
 },
 {
  "content": "租赁物，该"
 },
 {
  "content": "行为缺乏法律依据"
 },
 {
  "content": "，构成对租客"
 },
 {
  "content": "合法权益"
 },
 {
  "content": "的侵害。\n"
 },
 {
