# 法智同源反代（2026-08-08，手机端上线）：/api/* → backend:8000，其余 → frontend:3000
#
# 用法（通过 DOMAIN 环境变量切换）：
#   默认（不设 DOMAIN）：Caddy 监听 :80（HTTP），供内网/穿透层转发。
#   云服务器 + 自有域名：DOMAIN=fazhi.你的域名.com → Caddy 监听 443 自动 Let's Encrypt 证书。
#
{$DOMAIN::80} {
	encode gzip

	# 安全响应头（公网暴露防护，2026-08-08）
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API/SSE/媒体 → 后端
	handle /api/* {
		reverse_proxy backend:8000
	}

	# 其余（页面/静态资源）→ 前端
	handle {
		reverse_proxy frontend:3000
	}
}
