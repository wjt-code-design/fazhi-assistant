# LLM API (OpenAI-compatible). e.g. Aliyun Model Studio compatible-mode.
# Keep this file ASCII-only: non-ASCII chars can break .env parsing on Windows (GBK)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://your-gateway.example.com/compatible-mode/v1
LLM_MODEL=your-model-id

# JWT signing secret (generate with: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=

# Initial admin account (change password after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
