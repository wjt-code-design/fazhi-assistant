# LLM API (OpenAI-compatible). e.g. Aliyun Model Studio compatible-mode.
# Keep this file ASCII-only: non-ASCII chars can break .env parsing on Windows (GBK)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://your-gateway.example.com/compatible-mode/v1

# Self-registration (2026-08-08, scheme C): default false = registration closed,
# accounts are created by admin only (管理端「用户管理」→ 创建账号). Set true to reopen public signup.
SELF_REGISTER=false

# Vector embedding (ADR-011): local=on-device BGE CPU (default, zero-config fallback);
# aliyun=text-embedding-v4 via DashScope OpenAI-compatible endpoint (needs EMBEDDING_API_KEY).
# When switching to aliyun you must rebuild the vector DB (scripts/rebuild_embeddings.py).
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=768
# Quota monitoring (0=disabled; set total to your token grant, e.g. 1000000)
EMBEDDING_QUOTA_TOTAL=0
EMBEDDING_QUOTA_INITIAL=0

# Rerank (precision): qwen3-rerank via DashScope OpenAI-compatible /reranks endpoint.
# Costs input tokens only. Set RERANK_ENABLED=true to activate.
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_QUOTA_TOTAL=0
RERANK_QUOTA_INITIAL=0

# JWT signing secret (generate with: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=

# Initial admin account (REQUIRED: must set a real password, seed_admin refuses empty / default)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
