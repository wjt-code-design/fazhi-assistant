{
  "schema_version": "legal-agent-capture-protocol/v1",
  "protocol_id": "legal-agent-dual-run-YYYYMMDD-NNN",
  "case_set_sha256": "<sha256-of-raw-frozen-case-file>",
  "modes": ["existing_rag", "agent"],
  "controls": {
    "timeout_seconds": 90,
    "total_timeout_seconds": 3600,
    "max_retries": 1,
    "concurrency": 1,
    "cache_policy": "disabled",
    "network_policy": "frozen-knowledge-only",
    "max_output_tokens": 4096,
    "max_tool_calls": 8,
    "retain_failure_rows": true
  }
}
