[
 {
  "type": "status",
  "msg": "正在思考…"
 },
 {
  "content": "①"
 },
 {
  "content": " 案情与争议"
 },
 {
  "content": "焦点\n本案中"
 },
 {
  "content": "，父亲去世时"
 },
 {
  "content": "遗留了房产（"
 },
 {
  "content": "积极财产）与"
 },
 {
  "content": "信用卡欠款（消极"
 },
 {
  "content": "财产）。争议焦点"
 },
 {
  "content": "在于：子女作为"
 },
 {
  "content": "继承人，是否"
 },
 {
  "content": "必须动用个人自有"
 },
 {
  "content": "财产来清偿"
 },
 {
  "content": "父亲的信用卡债务。"
 },
 {
  "content": "\n\n② 法律"
 },
 {
  "content": "依据\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "二十二条，遗产"
 },
 {
  "content": "是自然人死亡时"
 },
 {
  "content": "遗留的个人合法财产"
 },
 {
  "content": "。\n根据《"
 },
 {
  "content": "民法典》第一千一百"
 },
 {
  "content": "六十一条，继承"
 },
 {
  "content": "人以所得遗产实际"
 },
 {
  "content": "价值为限清偿"
 },
 {
  "content": "被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务。超过遗产"
 },
 {
  "content": "实际价值部分，"
 },
 {
  "content": "继承人自愿偿还的不"
 },
 {
  "content": "在此限。继承人"
 },
 {
  "content": "放弃继承的，"
 },
 {
  "content": "对被继承人依法应当"
 },
 {
  "content": "缴纳的税款和"
 },
 {
  "content": "债务可以不负清偿"
 },
 {
  "content": "责任。\n根据"
 },
 {
  "content": "《民事诉讼法》"
 },
 {
  "content": "第二百四十三条，作为"
 },
 {
  "content": "被执行人的公民死亡的"
 },
 {
  "content": "，以其遗产偿还"
 },
 {
  "content": "债务。\n\n③"
 },
 {
  "content": " 逐项论证"
 },
 {
  "content": "\n第一，我国"
 },
 {
  "content": "实行限定"
 },
 {
  "content": "继承原则，子女"
 },
 {
  "content": "无需必须"
 },
 {
  "content": "拿自己的钱还"
 },
 {
  "content": "债。子女仅在"
 },
 {
  "content": "继承遗产的实际价值"
 },
 {
  "content": "范围内承担清偿责任"
 },
 {
  "content": "。若房产变"
 },
 {
  "content": "卖"
 },
 {
  "content": "所得"
 },
 {
  "content": "价款"
 },
 {
  "content": "低于"
 },
 {
  "content": "信用卡欠款，子女"
 },
 {
  "content": "仅需"
 },
 {
  "content": "将遗产"
 },
 {
  "content": "用于偿债，不足"
 },
 {
  "content": "部分"
 },
 {
  "content": "原则上无需用"
 },
 {
  "content": "个人财产补"
 },
 {
  "content": "足。\n第二"
 },
 {
  "content": "，放弃继承可"
 },
 {
  "content": "免除清偿"
 },
 {
  "content": "义务"
 },
 {
  "content": "。若子女选择"
 },
 {
  "content": "放弃继承父亲的房产"
 },
 {
  "content": "，则对父亲的"
 },
 {
  "content": "信用卡欠款可以不负"
 },
 {
  "content": "清偿责任。\n"
 },
 {
  "content": "第三，遗产是"
 },
 {
  "content": "偿债的首要"
 },
 {
  "content": "来源。父亲的"
 },
 {
  "content": "信用卡欠款应当先用"
 },
 {
  "content": "其遗留"
 },
 {
  "content": "的房产折"
 },
 {
  "content": "价、"
 },
 {
  "content": "拍卖"
 },
 {
  "content": "或变卖所得"
 },
 {
  "content": "价款"
 },
 {
  "content": "来偿还，继承"
 },
 {
  "content": "人不直接"
 },
 {
  "content": "对"
 },
 {
  "content": "债务承担无限连带"
 },
 {
  "content": "责任。\n\n④"
 },
 {
  "content": " 结论与风险"
 },
 {
  "content": "\n结论：子女"
 },
 {
  "content": "并非必须拿自己的"
 },
 {
  "content": "钱偿还父亲的信用卡"
 },
 {
  "content": "欠款，仅在继承"
 },
 {
  "content": "遗产价值"
 },
 {
  "content": "范围内承担清偿"
 },
 {
  "content": "义务。\n风险"
 },
 {
  "content": "提示：如果子女"
 },
 {
  "content": "已经继承了房产，"
 },
 {
  "content": "在未清偿"
 },
 {
  "content": "债务前，"
 },
 {
  "content": "不能直接将"
 },
 {
  "content": "房产过户到自己名下"
 },
 {
  "content": "而拒绝承担遗产"
 },
 {
  "content": "债务；若存在"
 },
 {
  "content": "故意隐匿"
 },
 {
  "content": "、转移遗产以"
 },
 {
  "content": "逃避债务的行为，"
 },
 {
  "content": "债权人可能依法"
 },
 {
  "content": "主张"
 },
 {
  "content": "权利。此外，"
 },
 {
  "content": "如果"
 },
 {
  "content": "子女"
 },
 {
  "content": "曾为"
 },
 {
  "content": "该笔"
 },
 {
  "content": "信用卡欠款"
 },
 {
  "content": "提供连带责任"
 },
 {
  "content": "担保"
 },
 {
  "content": "，则需依据"
 },
 {
  "content": "担保法律关系"
 },
 {
  "content": "承担还款责任，"
 },
 {
  "content": "这属于另一层面的"
 },
 {
  "content": "法律义务"
 },
 {
  "content": "。"
 },
