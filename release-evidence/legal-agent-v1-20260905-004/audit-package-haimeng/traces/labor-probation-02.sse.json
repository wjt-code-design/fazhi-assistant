 {
  "content": "①"
 },
 {
  "content": "案情与争议焦点"
 },
 {
  "content": "\n案情：劳动者"
 },
 {
  "content": "与公司签订了"
 },
 {
  "content": "三年期劳动合同，"
 },
 {
  "content": "双方约定试用"
 },
 {
  "content": "期为6个月，"
 },
 {
  "content": "后公司又单"
 },
 {
  "content": "方延长2个月"
 },
 {
  "content": "试用期。\n争议"
 },
 {
  "content": "焦点：公司延长"
 },
 {
  "content": "试用期的行为是否"
 },
 {
  "content": "合法；若违法"
 },
 {
  "content": "，劳动者有何救济"
 },
 {
  "content": "途径。\n\n②"
 },
 {
  "content": "法律依据\n根据"
 },
 {
  "content": "《劳动合同法》"
 },
 {
  "content": "第十九条，三年以上固定"
 },
 {
  "content": "期限和无"
 },
 {
  "content": "固定期限的劳动合同"
 },
 {
  "content": "，试用期不得超过六个月"
 },
 {
  "content": "；同一用人单位与"
 },
 {
  "content": "同一劳动者只能约定"
 },
 {
  "content": "一次试用期。\n"
 },
 {
  "content": "根据《劳动合同法"
 },
 {
  "content": "》第八十三条，"
 },
 {
  "content": "用人单位违反本法规定"
 },
 {
  "content": "与劳动者约定试用"
 },
 {
  "content": "期的，由劳动"
 },
 {
  "content": "行政部门责令改正；违法"
 },
 {
  "content": "约定的试用期已经履"
 },
 {
  "content": "行的，由用人单位"
 },
 {
  "content": "以劳动者试用期满月"
 },
 {
  "content": "工资为标准，按"
 },
 {
  "content": "已经履行的超过"
 },
 {
  "content": "法定试用期的期间"
 },
 {
  "content": "向劳动者支付赔偿"
 },
 {
  "content": "金。\n\n③"
 },
 {
  "content": "逐项论证\n"
 },
 {
  "content": "首先，关于试用期"
 },
 {
  "content": "最长期限。"
 },
 {
  "content": "三年期劳动合同的"
 },
 {
  "content": "试用期法定上限为"
 },
 {
  "content": "6个月。公司在"
 },
 {
  "content": "约定6个月后又"
 },
 {
  "content": "延长2个月，"
 },
 {
  "content": "总计8个月，"
 },
 {
  "content": "明显超过了法定"
 },
 {
  "content": "最长期限。"
 },
 {
  "content": "\n其次，关于"
 },
 {
  "content": "试用期约定次数。"
 },
 {
  "content": "法律明确规定同一用人单位"
 },
 {
  "content": "与同一劳动者只能"
 },
 {
  "content": "约定一次试用期。"
 },
 {
  "content": "延长试用期实质上"
 },
 {
  "content": "属于二次约定试用期"
 },
 {
  "content": "，违反了法律的"
 },
 {
  "content": "强制性规定。\n"
 },
 {
  "content": "因此，公司延长"
 },
 {
  "content": "试用期的行为缺乏"
 },
 {
  "content": "法律依据，属于"
 },
 {
  "content": "违法行为。\n\n④"
 },
 {
  "content": "结论与风险\n"
 },
 {
  "content": "结论：公司约定"
 },
 {
  "content": "6个月试用期后又"
 },
 {
  "content": "延长2个月的行为"
 },
 {
  "content": "不合法。\n"
 },
 {
  "content": "风险提示：\n"
 },
 {
  "content": "第一，赔偿金"
 },
 {
  "content": "风险。根据《"
 },
 {
  "content": "劳动合同法》第八"
 },
 {
  "content": "十三条，违法履"
 },
 {
  "content": "行的试用期（即超期的"
 },
 {
  "content": "2个月），劳动者"
 },
 {
  "content": "有权要求公司按照"
 },
 {
  "content": "试用期满月工资标准"
 },
 {
  "content": "支付赔偿金。"
 },
 {
  "content": "\n第二，违法"
 },
 {
  "content": "解除风险。若"
 },
 {
  "content": "公司在延长的2"
 },
 {
  "content": "个月内以“试用"
 },
 {
  "content": "期间不符合录用条件"
 },
 {
  "content": "”为由解除劳动合同"
 },
 {
  "content": "，该解除行为"
 },
 {
  "content": "存在被认定为违法"
 },
 {
  "content": "解除的极大风险"
 },
 {
  "content": "，劳动者可"
 },
 {
  "content": "主张违法"
 },
 {
  "content": "解除劳动合同赔偿金"
 },
 {
  "content": "或要求继续履行"
 },
 {
  "content": "合同。\n第三"
 },
 {
  "content": "，行政查处"
 },
 {
  "content": "风险。劳动行政部门"
 },
 {
  "content": "可责令公司改正"
 },
 {
  "content": "违法行为。\n\n本"
 },
 {
  "content": "答复仅供参考，不构成正式法律意见"
 },
 {
  "content": "。"
 },
