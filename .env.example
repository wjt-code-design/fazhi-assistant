# 法智 · Docker 部署配置（docker compose 自动读取根目录 .env）
# 用法：cp .env.example .env && 填入真实值 → docker compose up -d --build

# 后端 LLM API（OpenAI 兼容，Aliyun Model Studio 等）
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://your-gateway.example.com/compatible-mode/v1
LLM_MODEL=qwen3.5-omni-plus-2026-03-15

# JWT 签名密钥（生成：python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=

# 管理员初始账号（首次登录后请修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# HuggingFace 镜像（国内构建/运行时拉 BGE 模型；可留默认）
HF_ENDPOINT=https://hf-mirror.com
