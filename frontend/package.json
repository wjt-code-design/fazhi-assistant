{
  "name": "ai-legal-helper-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/write-build-id.mjs",
    "start": "next start",
    "lint": "next lint --dir app --dir components --dir lib",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.tsx\" \"lib/**/*.ts\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check": "npm run lint && npx tsc --noEmit && npm run test"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.1.0",
    "postcss": "8.4.35",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  }
}
